@import '../../../../styles/mch-craft.wxss';

page {
  background: var(--color-mch-bg);
}

.mch-albums.is-blurred {
  filter: blur(12px);
}

.mch-albums {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  color: var(--color-text-primary);
  background: var(--color-mch-bg);
}

.mch-top {
  padding: var(--space-xs) var(--page-padding-x);
}

.mch-brand {
  font-size: var(--font-mch-page);
  font-weight: var(--font-weight-semibold);
  line-height: 1.25;
}

.mch-searchbox {
  margin: var(--space-md) var(--page-padding-x) 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-full);
  box-shadow: var(--mch-shadow-card);
  overflow: hidden;
}

.mch-searchbox.is-open {
  border-radius: var(--mch-radius);
}

.mch-searchbox__field {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-height: 80rpx;
  padding: var(--space-sm) var(--space-md);
}

.mch-searchbox__field--press {
  opacity: 0.7;
}

.mch-searchbox__ico {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

.mch-searchbox__input {
  flex: 1;
  min-width: 0;
  color: var(--color-text-primary);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
}

.mch-searchbox__ph {
  color: var(--color-mch-muted);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
}

.mch-searchbox__text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--color-text-primary);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
}

.mch-searchbox__text--muted {
  color: var(--color-mch-muted);
}

.mch-searchbox__tags {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex: none;
}

.mch-searchbox__tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx var(--space-sm);
  border-radius: var(--radius-full);
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-size: var(--font-mch-badge);
  font-weight: var(--font-weight-medium);
  line-height: var(--font-caption-lh);
}

.mch-searchbox__tag-x {
  width: 20rpx;
  height: 20rpx;
}

.mch-searchbox__cue {
  width: 24rpx;
  height: 24rpx;
  flex: none;
}

.mch-searchbox__clear {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.mch-searchbox__clear-ico {
  width: 22rpx;
  height: 22rpx;
}

.mch-searchbox__panel {
  padding: 0 var(--space-md) var(--space-sm);
  border-top: 2rpx solid var(--color-mch-line);
}

.mch-panel__row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  padding: var(--space-sm) 0 0;
}

.mch-panel__label {
  flex: none;
  width: 96rpx;
  padding-top: var(--space-xs);
  color: var(--color-mch-muted);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.mch-panel__opts {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.mch-panel__opt {
  display: flex;
  align-items: center;
  gap: 6rpx;
  box-sizing: border-box;
  min-height: 56rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-full);
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.mch-panel__opt.is-on {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-weight: var(--font-weight-medium);
}

.mch-panel__opt-count {
  font-size: var(--font-mch-nano);
  color: var(--color-mch-muted);
  font-variant-numeric: tabular-nums;
}

.mch-panel__opt.is-on .mch-panel__opt-count {
  color: var(--color-text-inverse);
  opacity: 0.8;
}

.mch-panel__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 2rpx solid var(--color-mch-line);
}

.mch-panel__count {
  color: var(--color-mch-muted);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.mch-panel__acts {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.mch-panel__act {
  padding: var(--space-xs) 0;
  color: var(--color-mch-blue);
  font-size: var(--font-sub);
  line-height: var(--font-sub-lh);
}

.mch-panel__act--done {
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
}

.mch-panel__act--press {
  opacity: 0.55;
}

.mch-result {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-sm);
  margin: var(--space-sm) var(--page-padding-x) 0;
  padding: 0 var(--space-xs);
}

.mch-result__text {
  color: var(--color-mch-muted);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.mch-result__note {
  color: var(--color-mch-muted);
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
}

.mch-albums__state {
  padding: 80rpx var(--page-padding-x);
  color: var(--color-text-secondary);
  font-size: var(--font-sub);
}

.mch-albums__empty-btn {
  margin-top: var(--space-md);
}

.mch-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  margin: var(--space-md) var(--page-padding-x) 0;
  padding: var(--space-md);
  background: var(--color-bg-card);
  border-radius: var(--mch-radius);
  box-shadow: var(--shadow-mch-card);
}

.mch-card__close {
  position: absolute;
  top: var(--space-sm);
  right: var(--space-sm);
  z-index: 1;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-muted);
}

.mch-card__close-ico {
  width: 28rpx;
  height: 28rpx;
}

.mch-card__close--press {
  background: var(--color-border);
}

.mch-thumb {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  border-radius: var(--mch-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  overflow: hidden;
}

.mch-thumb--blue {
  background: linear-gradient(160deg, var(--color-primary), var(--color-mch-hero-end));
}

.mch-thumb--gray {
  background: var(--color-mch-thumb-gray);
}

.mch-thumb__car {
  width: 72rpx;
  height: 72rpx;
}

.mch-thumb__photo {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.mch-thumb__count {
  position: absolute;
  left: var(--space-xs);
  bottom: var(--space-xs);
  padding: 2rpx var(--space-xs);
  border-radius: var(--radius-sm);
  background: var(--color-mch-thumb-badge);
  color: var(--color-text-inverse);
  font-size: var(--font-caption);
  line-height: 1.4;
}

.mch-thumb--blue .mch-thumb__count {
  background: var(--color-mch-blue-dark);
}

.mch-card__main {
  flex: 1;
  min-width: 0;
}

.mch-card__main.has-close {
  padding-right: 76rpx;
}

.mch-card__plate {
  display: block;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: var(--font-h3);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.mch-card__title-row {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  margin-top: var(--space-xs);
  min-width: 0;
}

.mch-card__title {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.mch-card__pub {
  flex: none;
  font-size: var(--font-mch-badge);
  color: var(--color-mch-green-deep);
}

.mch-card__meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-top: var(--space-xs);
}

.mch-card__meta {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.mch-pill {
  flex: none;
  border-radius: var(--radius-full);
  padding: var(--space-xs) var(--space-sm);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
}

.mch-pill--blue {
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
}

.mch-pill--green {
  color: var(--color-mch-green-deep);
  background: var(--color-mch-green-soft);
}

.mch-pill--amber {
  color: var(--color-mch-amber-deep);
  background: var(--color-mch-amber-soft);
}

.mch-track {
  height: 8rpx;
  margin-top: var(--space-sm);
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.mch-track__bar {
  height: 100%;
  border-radius: var(--radius-sm);
  background: var(--color-primary);
}

.mch-review-badge {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4rpx;
  border-radius: var(--radius-sm);
  padding: var(--space-xs) var(--space-sm);
  font-size: var(--font-mch-badge);
  font-weight: var(--font-weight-medium);
}

.mch-review-badge__star {
  width: 22rpx;
  height: 22rpx;
}

.mch-review-badge--reviewed {
  color: var(--color-mch-green-deep);
  background: var(--color-mch-green-soft);
}

.mch-review-badge--replied {
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.mch-invite-row {
  margin-top: var(--space-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.mch-invite-hint {
  flex: 1;
  min-width: 0;
  color: var(--color-text-tertiary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.mch-invite-btn {
  flex: none;
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-full);
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
  line-height: var(--font-caption-lh);
}

page {
  background: var(--color-mch-bg);
}

.mch-albums.is-blurred {
  filter: blur(12px);
}

.mch-albums {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  color: var(--color-text-primary);
  background: var(--color-mch-bg);
}

.mch-top {
  padding: 8rpx 32rpx 4rpx;
}

.mch-kicker {
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-semibold);
}

.mch-brand {
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: var(--font-weight-semibold);
  line-height: 1.25;
}

.mch-chips {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 32rpx 0;
}

.mch-chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: var(--font-weight-medium);
}

.mch-chip.is-on {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.mch-search {
  padding: 16rpx 32rpx 0;
}

.mch-albums__state {
  padding: 80rpx 32rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.mch-albums__empty-btn {
  margin-top: 24rpx;
}

.mch-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin: 20rpx 32rpx 0;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: 28rpx;
  box-shadow: var(--shadow-mch-card);
}

.mch-card__close {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
  font-size: 32rpx;
  line-height: 1;
}

.mch-thumb {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  overflow: hidden;
}

.mch-thumb--blue {
  background: linear-gradient(160deg, var(--color-primary), var(--color-mch-hero-end));
}

.mch-thumb--gray {
  background: var(--color-mch-thumb-gray);
}

.mch-thumb--ink {
  background: var(--color-mch-thumb-gray-deep);
}

.mch-thumb__car {
  width: 72rpx;
  height: 72rpx;
}

.mch-thumb__count {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: var(--color-mch-thumb-badge);
  color: var(--color-text-inverse);
  font-size: var(--font-caption);
  line-height: 1.4;
}

.mch-thumb--blue .mch-thumb__count {
  background: var(--color-mch-blue-dark);
}

.mch-card__main {
  flex: 1;
  min-width: 0;
}

.mch-card__main.has-close {
  padding-right: 40rpx;
}

.mch-card__plate {
  display: block;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 32rpx;
  font-weight: var(--font-weight-semibold);
  line-height: 1.3;
}

.mch-card__title {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mch-card__meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 6rpx;
}

.mch-card__title {
  font-size: 24rpx;
  color: var(--color-text-primary);
}

.mch-card__meta {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.mch-pill {
  flex: none;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
}

.mch-pill--blue {
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.mch-pill--green {
  color: var(--color-mch-green);
  background: var(--color-mch-green-soft);
}

.mch-pill--amber {
  color: var(--color-mch-amber);
  background: var(--color-mch-amber-soft);
}

.mch-track {
  height: 8rpx;
  margin-top: 16rpx;
  background: var(--color-bg-muted);
  border-radius: 8rpx;
  overflow: hidden;
}

.mch-track__bar {
  height: 100%;
  border-radius: 8rpx;
  background: var(--color-primary);
}

.mch-track__bar--green {
  background: var(--color-mch-green);
}

.mch-track__bar--amber {
  background: var(--color-mch-amber);
}

.mch-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.mch-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

<view class="mch-albums {{createOpen ? 'is-blurred' : ''}}" style="padding-top: {{statusBarHeight}}px;">
  <view class="mch-top" style="padding-right: {{capsulePad}}px;">
    <text class="mch-kicker">真实记录 · 长期沉淀</text>
    <view class="mch-brand">服务相册</view>
  </view>

  <view class="mch-chips">
    <text
      wx:for="{{statusTabs}}"
      wx:key="key"
      class="mch-chip {{tab === item.key ? 'is-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onChip"
    >{{item.label}} {{item.count}}</text>
  </view>

  <view class="mch-search">
    <ui-search-bar
      value="{{keyword}}"
      placeholder="搜索车牌、车型或车主手机号"
      showSearch="{{false}}"
      bind:input="onKeywordInput"
      bind:confirm="onKeywordSearch"
      bind:search="onKeywordSearch"
      bind:clear="onKeywordClear"
    />
  </view>

  <view wx:if="{{status === 'loading'}}" class="mch-albums__state">加载中</view>
  <view wx:elif="{{status === 'error'}}" class="mch-albums__state" bindtap="onRetry">{{errorMessage || '加载失败'}}，点此重试</view>
  <view wx:elif="{{status === 'empty'}}" class="mch-albums__state">
    <text>还没有相册</text>
    <view class="mch-albums__empty-btn">
      <ui-button type="primary" bind:btntap="onCreate">新建服务相册</ui-button>
    </view>
  </view>

  <block wx:else>
    <view
      wx:for="{{list}}"
      wx:key="albumId"
      class="mch-card"
      data-id="{{item.albumId}}"
      bindtap="onCardTap"
    >
      <view class="mch-thumb mch-thumb--{{item.thumbTone}}">
        <image class="mch-thumb__car" src="/assets/mch/car-white.png" mode="aspectFit" />
        <text class="mch-thumb__count">{{item.imageCount}} 条留证</text>
      </view>
      <view class="mch-card__main">
        <view class="mch-card__head">
          <text class="mch-card__plate">{{item.plate}}</text>
          <text class="mch-pill mch-pill--{{item.pillTone}}">{{item.pill}}</text>
        </view>
        <text wx:if="{{item.titleLine}}" class="mch-card__title">{{item.titleLine}}</text>
        <text wx:if="{{item.metaLine}}" class="mch-card__meta">{{item.metaLine}}</text>
        <view class="mch-track">
          <view class="mch-track__bar mch-track__bar--{{item.pillTone}}" style="width: {{item.progress}}%;" />
        </view>
        <view
          wx:if="{{!item.repairDone}}"
          class="mch-card__delete"
          data-id="{{item.albumId}}"
          catchtap="onDeleteAlbum"
        >删除</view>
        <view wx:if="{{item.chips.length}}" class="mch-tags">
          <text wx:for="{{item.chips}}" wx:for-item="chip" wx:key="*this" class="mch-tag">{{chip}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
<merchant-tab-bar active="albums" />
<merchant-create-sheet show="{{createOpen}}" bind:close="onCloseCreate" />

<view class="vehicle-scan">
  <camera
    wx:if="{{cameraReady}}"
    id="vehicleScanCamera"
    class="vehicle-scan__camera"
    device-position="back"
    flash="{{flash}}"
    resolution="high"
    frame-size="medium"
    binderror="onCameraError"
    bindinitdone="onCameraInit"
  />
  <view wx:else class="vehicle-scan__camera vehicle-scan__camera--fallback" />

  <view class="vehicle-scan__mask">
    <view class="vehicle-scan__status" style="padding-top: {{statusBarHeight}}px;">
      <view class="vehicle-scan__close" bindtap="onClose" aria-role="button" aria-label="关闭">×</view>
      <text class="vehicle-scan__nav-title">{{pageTitle}}</text>
      <view class="vehicle-scan__close vehicle-scan__close--spacer" />
    </view>

    <view class="vehicle-scan__guide">
      <view class="vehicle-scan__frame {{mode === 'vin' ? 'vehicle-scan__frame--vin' : 'vehicle-scan__frame--plate'}}">
        <view class="vehicle-scan__corner vehicle-scan__corner--tl" />
        <view class="vehicle-scan__corner vehicle-scan__corner--tr" />
        <view class="vehicle-scan__corner vehicle-scan__corner--bl" />
        <view class="vehicle-scan__corner vehicle-scan__corner--br" />
        <view wx:if="{{!busy && cameraReady}}" class="vehicle-scan__laser" />
        <view class="vehicle-scan__torch" bindtap="onToggleFlash">
          <view class="vehicle-scan__torch-dot {{flash === 'torch' ? 'is-on' : ''}}" />
          <text class="vehicle-scan__torch-text">{{flash === 'torch' ? '轻触关闭' : '轻触照亮'}}</text>
        </view>
      </view>
      <text class="vehicle-scan__tip">{{pageDesc}}</text>
      <text wx:if="{{resultHint}}" class="vehicle-scan__hint">{{resultHint}}</text>
    </view>

    <view class="vehicle-scan__footer safe-bottom">
      <text class="vehicle-scan__status-pill">{{busy ? '正在识别…' : '自动扫描中'}}</text>
      <view class="vehicle-scan__album" bindtap="onPickAlbum" aria-role="button" aria-label="从相册选择">
        <text class="vehicle-scan__album-text">相册</text>
      </view>
    </view>
  </view>
</view>

.vehicle-scan {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

.vehicle-scan__camera,
.vehicle-scan__camera--fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.vehicle-scan__camera--fallback {
  background: #111;
}

.vehicle-scan__mask {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  z-index: 2;
}

.vehicle-scan__status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-md);
  color: var(--color-text-inverse);
}

.vehicle-scan__close {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 48rpx;
  color: var(--color-text-inverse);
}

.vehicle-scan__close--spacer {
  visibility: hidden;
}

.vehicle-scan__nav-title {
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-inverse);
}

.vehicle-scan__guide {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-lg);
}

.vehicle-scan__frame {
  position: relative;
  width: 78vw;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  box-sizing: border-box;
  overflow: hidden;
}

.vehicle-scan__frame--plate {
  height: 28vw;
  max-height: 220rpx;
}

.vehicle-scan__frame--vin {
  height: 52vw;
  max-height: 420rpx;
}

.vehicle-scan__corner {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border-color: var(--color-success);
  border-style: solid;
}

.vehicle-scan__corner--tl {
  top: 0;
  left: 0;
  border-width: 6rpx 0 0 6rpx;
}

.vehicle-scan__corner--tr {
  top: 0;
  right: 0;
  border-width: 6rpx 6rpx 0 0;
}

.vehicle-scan__corner--bl {
  bottom: 0;
  left: 0;
  border-width: 0 0 6rpx 6rpx;
}

.vehicle-scan__corner--br {
  bottom: 0;
  right: 0;
  border-width: 0 6rpx 6rpx 0;
}

.vehicle-scan__laser {
  position: absolute;
  left: 8%;
  right: 8%;
  height: 4rpx;
  background: linear-gradient(
    90deg,
    transparent,
    var(--color-success),
    transparent
  );
  box-shadow: 0 0 12rpx var(--color-success);
  animation: vehicle-scan-laser 2.2s linear infinite;
}

@keyframes vehicle-scan-laser {
  0% {
    top: 8%;
    opacity: 0.35;
  }
  50% {
    opacity: 1;
  }
  100% {
    top: 88%;
    opacity: 0.35;
  }
}

.vehicle-scan__torch {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.vehicle-scan__torch-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  background: transparent;
}

.vehicle-scan__torch-dot.is-on {
  background: var(--color-success);
  border-color: var(--color-success);
}

.vehicle-scan__torch-text {
  font-size: var(--font-caption);
  color: var(--color-text-inverse);
  opacity: 0.92;
}

.vehicle-scan__tip,
.vehicle-scan__hint {
  display: block;
  margin-top: var(--space-md);
  max-width: 86vw;
  text-align: center;
  font-size: var(--font-caption);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.88);
}

.vehicle-scan__hint {
  color: var(--color-warning);
}

.vehicle-scan__footer {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  padding: var(--space-md) var(--space-xl) var(--space-lg);
}

.vehicle-scan__shutter {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.vehicle-scan__shutter.is-busy {
  opacity: 0.55;
}

.vehicle-scan__shutter-ring {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--color-text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vehicle-scan__shutter-text {
  font-size: var(--font-caption);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

.vehicle-scan__album {
  position: absolute;
  right: var(--space-xl);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vehicle-scan__album-text {
  font-size: var(--font-caption);
  color: var(--color-text-inverse);
}

.vehicle-scan__loading {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
}

.vehicle-scan__loading-text {
  padding: var(--space-sm) var(--space-lg);
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.62);
  color: var(--color-text-inverse);
  font-size: var(--font-caption);
}

.vehicle-scan {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

.vehicle-scan__camera,
.vehicle-scan__camera--fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.vehicle-scan__camera--fallback {
  background: #111;
}

.vehicle-scan__mask {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  z-index: 2;
}

.vehicle-scan__mask-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.5) 0%,
    rgba(0, 0, 0, 0.16) 26%,
    rgba(0, 0, 0, 0.16) 68%,
    rgba(0, 0, 0, 0.62) 100%
  );
  pointer-events: none;
}

.vehicle-scan__status {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-md);
  color: var(--color-text-inverse);
}

.vehicle-scan__close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vehicle-scan__close-ico {
  width: 36rpx;
  height: 36rpx;
}

.vehicle-scan__close--spacer {
  visibility: hidden;
}

.vehicle-scan__nav-title {
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-inverse);
}

.vehicle-scan__guide {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-lg);
}

.vehicle-scan__frame {
  position: relative;
  width: 78vw;
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.03);
  box-shadow: inset 0 0 40rpx rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
  overflow: hidden;
}

.vehicle-scan__frame--plate {
  height: 28vw;
  max-height: 220rpx;
}

.vehicle-scan__frame--vin {
  height: 52vw;
  max-height: 420rpx;
}

.vehicle-scan__corner {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border-color: var(--color-success);
  border-style: solid;
  border-radius: 6rpx;
  filter: drop-shadow(0 0 6rpx rgba(34, 197, 94, 0.55));
}

.vehicle-scan__corner--tl {
  top: 0;
  left: 0;
  border-width: 6rpx 0 0 6rpx;
}

.vehicle-scan__corner--tr {
  top: 0;
  right: 0;
  border-width: 6rpx 6rpx 0 0;
}

.vehicle-scan__corner--bl {
  bottom: 0;
  left: 0;
  border-width: 0 0 6rpx 6rpx;
}

.vehicle-scan__corner--br {
  bottom: 0;
  right: 0;
  border-width: 0 6rpx 6rpx 0;
}

.vehicle-scan__laser {
  position: absolute;
  left: 8%;
  right: 8%;
  height: 4rpx;
  background: linear-gradient(
    90deg,
    transparent,
    var(--color-success),
    transparent
  );
  box-shadow: 0 0 12rpx var(--color-success);
  animation: vehicle-scan-laser 2.2s linear infinite;
}

@keyframes vehicle-scan-laser {
  0% {
    top: 8%;
    opacity: 0.35;
  }
  50% {
    opacity: 1;
  }
  100% {
    top: 88%;
    opacity: 0.35;
  }
}

.vehicle-scan__footer {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) var(--space-xl) calc(var(--space-lg) + env(safe-area-inset-bottom));
}

.vehicle-scan__tool {
  width: 136rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: rgba(255, 255, 255, 0.92);
}

.vehicle-scan__tool--ghost {
  visibility: hidden;
}

.vehicle-scan__tool-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.vehicle-scan__tool.is-on {
  color: var(--color-success);
}

.vehicle-scan__tool.is-on .vehicle-scan__tool-icon {
  background: rgba(34, 197, 94, 0.18);
  border-color: var(--color-success);
}

.vehicle-scan__tool-text {
  font-size: var(--font-caption);
  color: currentColor;
}

.vehicle-scan__bulb {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.vehicle-scan__bulb::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  transform: translateX(-50%);
  width: 10rpx;
  height: 8rpx;
  border-radius: 0 0 2rpx 2rpx;
  background: currentColor;
}

.vehicle-scan__album-icon {
  position: relative;
  width: 30rpx;
  height: 24rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
}

.vehicle-scan__album-icon::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 6rpx;
  height: 6rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.vehicle-scan__album-icon::after {
  content: '';
  position: absolute;
  left: 4rpx;
  bottom: 3rpx;
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-bottom: 8rpx solid currentColor;
}

.vehicle-scan__tip,
.vehicle-scan__hint {
  display: block;
  margin-top: var(--space-md);
  max-width: 86vw;
  text-align: center;
  font-size: var(--font-caption);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.88);
}

.vehicle-scan__hint {
  color: var(--color-warning);
}

.vehicle-scan__status-pill {
  padding: var(--space-xs) var(--space-lg);
  border-radius: var(--radius-full);
  background: rgba(0, 0, 0, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  color: var(--color-text-inverse);
  font-size: var(--font-caption);
}

.vehicle-scan__processing {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0b0f14;
  overflow: hidden;
}

.vehicle-scan__preview {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.45;
  filter: blur(16rpx);
  transform: scale(1.08);
}

.vehicle-scan__processing-shade {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 45%, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.72));
}

.vehicle-scan__processing-body {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
}

.vehicle-scan__spinner {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.18);
  border-top-color: var(--color-success);
  animation: vehicle-scan-spin 0.9s linear infinite;
}

@keyframes vehicle-scan-spin {
  to {
    transform: rotate(360deg);
  }
}

.vehicle-scan__processing-title {
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-inverse);
}

.vehicle-scan__processing-desc {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.72);
}

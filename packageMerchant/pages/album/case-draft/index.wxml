<view class="page merchant-album-page case-draft page-content">
  <block wx:if="{{status === 'loading'}}">
    <ui-skeleton rows="{{5}}" title="{{true}}" />
  </block>

  <block wx:elif="{{status === 'error'}}">
    <ui-empty title="无法加载案例预览" description="{{errorMessage}}" actionText="重试" bind:action="onRetry" />
  </block>

  <block wx:else>
    <ui-compliance-notice type="displayDisclaimer" />

    <ui-card shadow="{{true}}" padding="{{true}}">
      <text class="text-h3">{{showCompletePrimary ? (resubmit ? '案例预览（重新提交）' : '案例预览（确认完工）') : '公开案例稿'}}</text>
      <view class="case-draft__intro">
        <text wx:if="{{editable && generateMode}}" class="text-caption text-secondary case-draft__hint">
          从已完工相册摘公开稿。可改说明、可去掉不想公开的图，不能再加新图。送审通过后会出现在店页。
        </text>
        <text wx:elif="{{editable}}" class="text-caption text-secondary case-draft__hint">
          本预览由相册节点文字与配图拼接而成，AI 润色可选。点润色只改文字、配图不变；润色后可「恢复润色前」。完工后在相册点「生成案例」才能送审上网。
        </text>
        <text wx:else class="text-caption text-secondary case-draft__hint">
          本预览为已确认或已送审的案例稿（只读）。通过后会出现在店页。
        </text>
        <view wx:if="{{editable}}" class="case-draft__polish-actions">
          <ui-button
            type="secondary"
            size="sm"
            loading="{{polishing}}"
            bind:btntap="onAiPolish"
          >AI 润色</ui-button>
          <ui-button
            wx:if="{{canRevertPolish}}"
            type="ghost"
            size="sm"
            disabled="{{polishing}}"
            bind:btntap="onRevertPolish"
          >恢复润色前</ui-button>
        </view>
      </view>
      <text class="text-caption case-draft__label">标题</text>
      <textarea
        class="case-draft__textarea case-draft__title"
        style="height: {{titleHeight}}px;"
        value="{{title}}"
        disabled="{{!editable}}"
        maxlength="120"
        disable-default-padding
        bindinput="onTitleInput"
        placeholder="门店名｜地址｜车型｜项目"
      />
      <text class="text-caption case-draft__label">案例摘要</text>
      <textarea
        class="case-draft__textarea case-draft__summary"
        style="height: {{summaryHeight}}px;"
        value="{{caseSummary}}"
        disabled="{{!editable}}"
        maxlength="250"
        disable-default-padding
        bindinput="onSummaryInput"
        placeholder="{{editable ? '由章节自动拼接；AI 润色可选。勿写金额。' : '已确认，只读'}}"
      />
      <text class="text-caption text-secondary case-draft__mask-tip">当前配图为原图预览，正式发布时需脱敏。搜索描述由本摘要自动截取，无需另填。</text>
    </ui-card>

    <ui-card
      wx:for="{{sections}}"
      wx:key="key"
      shadow="{{true}}"
      padding="{{true}}"
      class="case-draft__section"
    >
      <text class="text-body case-draft__section-title">{{item.title}}</text>
      <textarea
        class="case-draft__textarea"
        style="height: {{item.bodyHeight}}px;"
        value="{{item.body}}"
        disabled="{{!editable}}"
        maxlength="600"
        disable-default-padding
        data-key="{{item.key}}"
        bindinput="onSectionInput"
        placeholder="根据节点备注生成，可修订；勿写金额"
      />
      <view class="case-draft__section-media">
        <block wx:for="{{media}}" wx:for-item="m" wx:for-index="mi" wx:key="mi">
          <view
            class="case-draft__media-item"
            wx:if="{{m.sectionKey === item.key}}"
          >
            <view class="case-draft__thumb-wrap">
              <image class="case-draft__thumb" src="{{m.displayUrl}}" mode="aspectFill" />
              <view
                wx:if="{{editable}}"
                class="case-draft__thumb-remove"
                data-node-id="{{m.nodeId}}"
                data-idx="{{m.idx}}"
                catchtap="onRemoveMedia"
              >×</view>
            </view>
          </view>
        </block>
      </view>
    </ui-card>

    <ui-card shadow="{{true}}" padding="{{true}}" wx:if="{{!media.length}}">
      <text class="text-caption text-secondary">暂无公开配图。请在相册中将过程图设为可公示，或完工脱敏后再嵌入。</text>
    </ui-card>

    
    <view class="case-draft__spacer" />
  </block>

  <ui-fixed-bottom-bar wx:if="{{status === 'normal'}}" safeArea="{{true}}">
    <view slot="left" class="case-draft__bar-left">
      <ui-button type="ghost" size="sm" bind:btntap="onCopyExport">复制文案</ui-button>
      <ui-button
        wx:if="{{editable}}"
        type="secondary"
        size="sm"
        loading="{{saving}}"
        bind:btntap="onSaveDraft"
      >保存草稿</ui-button>
    </view>
    <ui-button
      wx:if="{{showGeneratePrimary}}"
      slot="right"
      type="primary"
      loading="{{generating}}"
      bind:btntap="onGenerateCase"
    >{{primaryActionText}}</ui-button>
    <ui-button
      wx:elif="{{showCompletePrimary}}"
      slot="right"
      type="primary"
      loading="{{completing}}"
      bind:btntap="onConfirmAndComplete"
    >{{primaryActionText}}</ui-button>
    <ui-button
      wx:elif="{{editable}}"
      slot="right"
      type="primary"
      loading="{{saving}}"
      bind:btntap="onConfirmDraft"
    >确认案例稿</ui-button>
  </ui-fixed-bottom-bar>
</view>

<view class="page merchant-album-page case-draft page-content">
  <block wx:if="{{status === 'loading'}}">
    <ui-skeleton rows="{{5}}" title="{{true}}" />
    <text class="text-caption text-secondary case-draft__loading-hint">{{loadingHint}}</text>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <ui-empty title="无法加载案例预览" description="{{errorMessage}}" actionText="重试" bind:action="onRetry" />
  </block>

  <block wx:else>
    <ui-compliance-notice type="displayDisclaimer" />

    <ui-card shadow="{{true}}" padding="{{true}}">
      <text class="text-h3">{{showCompletePrimary ? (resubmit ? '案例预览（重新提交）' : '案例预览（确认完工）') : '公开案例稿'}}</text>
      <view class="case-draft__intro">
        <text wx:if="{{editable && generateMode}}" class="text-caption text-secondary case-draft__hint">
          下面按即将上网的文章排：先摘要和本单问答，再详情。点「生成并机审」后才会打分；机审过线后可改措辞再「确认发布到店页」。不能在本页加新图。
        </text>
        <text wx:elif="{{editable}}" class="text-caption text-secondary case-draft__hint">
          下面按即将上网的文章排。文案已按相册写顺，可改说明、点缩略图看全图、去掉图、删问答，不能加新图。完工后在相册点「生成案例」才能机审上网。
        </text>
        <text wx:else class="text-caption text-secondary case-draft__hint">
          本预览为已确认或已发布的案例稿（只读）。
        </text>
      </view>
      <view wx:if="{{auditSummary}}" class="case-draft__audit">
        <text class="text-body case-draft__audit-summary">{{auditSummary}}</text>
        <text wx:if="{{auditPainBonus}}" class="text-caption text-secondary">痛点加分 {{auditPainBonus}}（仅展示，不计入过线）</text>
        <block wx:if="{{auditHardBlocks.length}}">
          <text class="text-caption case-draft__audit-label">系统硬拦</text>
          <text
            wx:for="{{auditHardBlocks}}"
            wx:key="issue"
            class="text-caption case-draft__audit-item"
          >· {{item.message}}</text>
        </block>
        <block wx:if="{{auditClaims.length}}">
          <text class="text-caption case-draft__audit-label">不足声称（点条目回相册补证）</text>
          <text
            wx:for="{{auditClaims}}"
            wx:key="label"
            class="text-caption case-draft__audit-item {{item.itemKey ? 'is-link' : ''}}"
            data-key="{{item.itemKey}}"
            data-label="{{item.label}}"
            bindtap="onTapAuditClaim"
          >· {{item.label}}{{item.reason ? '：' + item.reason : ''}}</text>
        </block>
      </view>
      <text class="text-caption case-draft__label">标题</text>
      <textarea
        class="case-draft__textarea case-draft__title"
        style="height: {{titleHeight}}px;"
        value="{{title}}"
        disabled="{{!editable}}"
        maxlength="120"
        disable-default-padding
        bindinput="onTitleInput"
        placeholder="城市 车型 项目：这次做了什么"
      />
      <text class="text-caption case-draft__label">摘要</text>
      <textarea
        class="case-draft__textarea case-draft__summary"
        style="height: {{summaryHeight}}px;"
        value="{{caseSummary}}"
        disabled="{{!editable}}"
        maxlength="250"
        disable-default-padding
        bindinput="onSummaryInput"
        placeholder="{{editable ? '谁的车、什么痛点、这次做了什么。勿把详情整段贴进来，勿写金额。' : '已确认，只读'}}"
      />
    </ui-card>

    <ui-card shadow="{{true}}" padding="{{true}}" class="case-draft__section">
      <text class="text-body case-draft__section-title">本单问答</text>
      <text class="text-caption text-secondary case-draft__hint">这次查了哪些、做了哪些、为什么有的没施工——只保留相册里对得上的。可改表述或删除，不能新增。</text>
      <view wx:if="{{!faq.length}}" class="case-draft__faq-empty">
        <text class="text-caption text-secondary">这单还没有可单独成问的结论。全过程写在下面详情里，不必硬凑。</text>
      </view>
      <view wx:for="{{faq}}" wx:key="index" class="case-draft__faq-item">
        <view class="case-draft__faq-head">
          <textarea
            class="case-draft__faq-q"
            style="height: {{item.qHeight}}px;"
            value="{{item.q}}"
            disabled="{{!editable}}"
            maxlength="80"
            disable-default-padding
            data-index="{{index}}"
            data-field="q"
            bindinput="onFaqInput"
          />
          <text
            wx:if="{{editable}}"
            class="case-draft__faq-remove"
            data-index="{{index}}"
            catchtap="onRemoveFaq"
          >删除</text>
        </view>
        <textarea
          class="case-draft__faq-a"
          style="height: {{item.aHeight}}px;"
          value="{{item.a}}"
          disabled="{{!editable}}"
          maxlength="200"
          disable-default-padding
          data-index="{{index}}"
          data-field="a"
          bindinput="onFaqInput"
        />
      </view>
    </ui-card>

    <text wx:if="{{hasDetailSections}}" class="text-caption text-secondary case-draft__block-label">详情</text>

    <block wx:for="{{sections}}" wx:key="key">
    <ui-card
      wx:if="{{item.hasContent}}"
      shadow="{{true}}"
      padding="{{true}}"
      class="case-draft__section"
    >
      <text class="text-body case-draft__section-title">{{item.title}}</text>
      <textarea
        wx:if="{{item.body}}"
        class="case-draft__textarea"
        style="height: {{item.bodyHeight}}px;"
        value="{{item.body}}"
        disabled="{{!editable}}"
        maxlength="600"
        disable-default-padding
        data-key="{{item.key}}"
        bindinput="onSectionInput"
        placeholder="根据节点备注生成，可修订；勿写金额"
      />
      <view class="case-draft__section-media" wx:if="{{item.media.length}}">
        <block wx:for="{{item.media}}" wx:for-item="m" wx:key="id">
          <view class="case-draft__media-item">
            <view class="case-draft__thumb-wrap" data-node-id="{{m.nodeId}}" data-idx="{{m.idx}}" bindtap="onPreviewMedia">
              <image class="case-draft__thumb" src="{{m.displayUrl}}" mode="aspectFill" />
              <view
                wx:if="{{editable}}"
                class="case-draft__thumb-remove"
                data-node-id="{{m.nodeId}}"
                data-idx="{{m.idx}}"
                catchtap="onRemoveMedia"
              >×</view>
            </view>
            <text wx:if="{{m.caption}}" class="text-caption case-draft__media-caption">{{m.caption}}</text>
            <text wx:if="{{m.hint}}" class="text-caption text-secondary case-draft__media-hint">{{m.hint}}</text>
          </view>
        </block>
      </view>
    </ui-card>
    </block>

    <ui-card shadow="{{true}}" padding="{{true}}" wx:if="{{!media.length}}">
      <text class="text-caption text-secondary">暂无公开配图。请在相册中将过程图设为可公示，或完工脱敏后再嵌入。</text>
    </ui-card>

    
    <view class="case-draft__spacer" />
  </block>

  <ui-fixed-bottom-bar wx:if="{{status === 'normal'}}" safeArea="{{true}}">
    <view slot="left" class="case-draft__bar-left">
      <ui-button type="ghost" size="sm" bind:btntap="onCopyExport">复制文案</ui-button>
      <ui-button
        wx:if="{{editable && showPublishPrimary}}"
        type="secondary"
        size="sm"
        loading="{{generating}}"
        bind:btntap="onGenerateCase"
      >重新机审</ui-button>
      <ui-button
        wx:if="{{editable}}"
        type="secondary"
        size="sm"
        loading="{{saving}}"
        bind:btntap="onSaveDraft"
      >保存草稿</ui-button>
    </view>
    <ui-button
      wx:if="{{showPublishPrimary}}"
      slot="right"
      type="primary"
      loading="{{publishing}}"
      bind:btntap="onPublishCase"
    >{{primaryActionText}}</ui-button>
    <ui-button
      wx:elif="{{showGeneratePrimary}}"
      slot="right"
      type="primary"
      loading="{{generating}}"
      bind:btntap="onGenerateCase"
    >{{primaryActionText}}</ui-button>
    <ui-button
      wx:elif="{{showCompletePrimary}}"
      slot="right"
      type="primary"
      loading="{{completing}}"
      bind:btntap="onConfirmAndComplete"
    >{{primaryActionText}}</ui-button>
    <ui-button
      wx:elif="{{editable}}"
      slot="right"
      type="primary"
      loading="{{saving}}"
      bind:btntap="onConfirmDraft"
    >确认案例稿</ui-button>
  </ui-fixed-bottom-bar>
</view>

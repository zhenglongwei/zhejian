.case-draft {
  padding-bottom: var(--page-fixed-clearance);
}

.case-draft__intro {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
  margin-bottom: var(--space-md);
}

.case-draft__hint {
  display: block;
  margin: 0;
}

.case-draft__loading-hint {
  display: block;
  margin-top: var(--space-md);
  text-align: center;
}

.case-draft__section-media {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.case-draft__label {
  display: block;
  margin: var(--space-md) 0 var(--space-xs);
  color: var(--color-text-secondary);
}

.case-draft__block-label {
  display: block;
  margin: var(--space-lg) 0 var(--space-xs);
}

.case-draft__faq-empty {
  margin-top: var(--space-sm);
}

.case-draft__faq-item {
  margin-top: var(--space-sm);
  padding: var(--space-md);
  background-color: var(--color-bg-muted);
  border-radius: var(--radius-md);
}

.case-draft__faq-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
}

.case-draft__faq-q,
.case-draft__faq-a {
  box-sizing: border-box;
  display: block;
  width: 100%;
  padding: 0;
  border: none;
  background: transparent;
  line-height: 1.5;
}

.case-draft__faq-q {
  flex: 1;
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.case-draft__faq-a {
  margin-top: var(--space-xs);
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.case-draft__faq-remove {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  padding-top: 2rpx;
}

.case-draft__section-title {
  display: block;
  margin-bottom: var(--space-sm);
  font-weight: 600;
}

.case-draft__textarea {
  box-sizing: border-box;
  display: block;
  width: 100%;
  padding: var(--space-sm) var(--space-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-primary);
  background: var(--color-bg-elevated, #fff);
  overflow: hidden;
}

.case-draft__media-item {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  width: 31%;
}

.case-draft__thumb-wrap {
  position: relative;
  width: 100%;
}

.case-draft__thumb {
  display: block;
  width: 100%;
  height: 200rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-muted, #f5f5f5);
}

.case-draft__media-caption,
.case-draft__media-hint {
  display: block;
}

.case-draft__thumb-remove {
  position: absolute;
  top: 0;
  right: 0;
  z-index: var(--z-content);
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background-color: var(--color-mask);
  color: var(--color-text-inverse);
  font-size: var(--font-body);
  border-radius: 0 var(--radius-md) 0 var(--radius-sm);
}

.case-draft__spacer {
  height: var(--space-lg);
}

.case-draft__bar-left {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs);
}

.case-draft__attest {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.case-draft__check {
  flex-shrink: 0;
  color: var(--color-brand);
  font-size: var(--font-size-body);
}

.case-draft__phone {
  width: 100%;
  margin-top: var(--space-xs);
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background: var(--color-bg-muted);
  font-size: var(--font-size-body);
}

.case-draft__audit {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--color-border);
}

.case-draft__audit-summary {
  display: block;
  line-height: 1.45;
}

.case-draft__audit-label {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
}

.case-draft__audit-item {
  display: block;
  line-height: 1.4;
  color: var(--color-text-secondary);
}

.case-draft__audit-item.is-link {
  color: var(--color-primary);
}

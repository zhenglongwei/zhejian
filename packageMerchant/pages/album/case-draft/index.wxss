.case-draft {
  padding-bottom: var(--page-fixed-clearance);
}

.case-draft__intro {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
  margin-bottom: var(--space-md);
}

.case-draft__hint {
  display: block;
  margin: 0;
}

.case-draft__mask-tip {
  display: block;
  margin-top: var(--space-sm);
}

.case-draft__section-media {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.case-draft__label {
  display: block;
  margin: var(--space-md) 0 var(--space-xs);
  color: var(--color-text-secondary);
}

.case-draft__section {
  margin-top: var(--space-md);
}

.case-draft__section-title {
  display: block;
  margin-bottom: var(--space-sm);
  font-weight: 600;
}

.case-draft__textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  padding: var(--space-sm) var(--space-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  line-height: 1.6;
  color: var(--color-text-primary);
  background: var(--color-bg-elevated, #fff);
}

.case-draft__title {
  min-height: 72rpx;
}

.case-draft__summary {
  min-height: 88rpx;
}

.case-draft__media {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-top: var(--space-md);
}

.case-draft__media-group {
  margin-top: var(--space-md);
}

.case-draft__media-item {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.case-draft__thumb-wrap {
  position: relative;
  width: 100%;
}

.case-draft__thumb {
  display: block;
  width: 100%;
  height: 280rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-muted, #f5f5f5);
}

.case-draft__thumb-remove {
  position: absolute;
  top: 0;
  right: 0;
  z-index: var(--z-content);
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background-color: var(--color-mask);
  color: var(--color-text-inverse);
  font-size: var(--font-body);
  border-radius: 0 var(--radius-md) 0 var(--radius-sm);
}

.case-draft__spacer {
  height: var(--space-lg);
}

.case-draft__bar-left {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs);
}

@import '../../../../styles/merchant-album.wxss';
@import '../../../../styles/mch-craft.wxss';

.album-optimize {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding-top: var(--space-md);
  padding-bottom: var(--page-fixed-clearance);
}

.album-optimize__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.album-optimize__section {
  display: block;
  margin-bottom: var(--space-md);
}

.album-optimize__label {
  display: block;
  margin-top: var(--space-md);
  margin-bottom: var(--space-xs);
  color: var(--color-text-secondary);
}

.album-optimize__tip + .album-optimize__tip {
  margin-top: var(--space-sm);
}

.album-optimize__actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-top: var(--space-lg);
  padding-bottom: var(--space-lg);
}

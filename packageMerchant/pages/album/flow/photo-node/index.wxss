.merchant-flow-photo-node {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.merchant-flow-photo-node__pad,
.merchant-flow-photo-node__body {
  padding: var(--space-4);
}

.merchant-flow-photo-node__scroll {
  height: 100vh;
}

.merchant-flow-photo-node__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.merchant-flow-photo-node__hint {
  display: block;
  margin-top: var(--space-2);
}

.merchant-flow-photo-node__uploader {
  margin-top: var(--space-4);
}

.merchant-flow-photo-node__actions {
  margin-top: var(--space-4);
  padding-bottom: env(safe-area-inset-bottom);
}

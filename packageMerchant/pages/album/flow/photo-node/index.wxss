.merchant-flow-photo-node {
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

.merchant-flow-photo-node__pad,
.merchant-flow-photo-node__body {
  padding: var(--space-md);
}

.merchant-flow-photo-node__scroll {
  height: 100vh;
}

.merchant-flow-photo-node__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.merchant-flow-photo-node__hint {
  display: block;
  margin-top: var(--space-sm);
}

.merchant-flow-photo-node__section {
  margin-top: var(--space-md);
}

.merchant-flow-photo-node__note-card {
  margin-top: var(--space-md);
}

.merchant-flow-photo-node__label {
  display: block;
  margin-bottom: var(--space-sm);
  font-weight: 600;
}

.merchant-flow-photo-node__textarea {
  width: 100%;
  min-height: 200rpx;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
  font-size: var(--font-body-size);
  line-height: var(--font-body-line-height);
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.merchant-flow-photo-node__actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
  padding-bottom: env(safe-area-inset-bottom);
}

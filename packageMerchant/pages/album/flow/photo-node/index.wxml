<view class="page merchant-flow-photo-node">
  <block wx:if="{{status === 'loading'}}">
    <view class="page-content merchant-flow-photo-node__pad">
      <ui-skeleton rows="{{6}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty title="无法加载节点" description="{{errorMessage}}" />
    </view>
  </block>

  <block wx:else>
    <scroll-view scroll-y class="merchant-flow-photo-node__scroll">
      <view class="page-content merchant-flow-photo-node__body">
        <ui-card shadow="{{true}}" padding="{{true}}">
          <view class="merchant-flow-photo-node__head">
            <text class="text-h3">{{nodeTitle}}</text>
            <ui-tag variant="info" text="拍照" />
          </view>
          <text wx:if="{{description}}" class="text-caption text-secondary merchant-flow-photo-node__hint">
            {{description}}
          </text>
        </ui-card>

        <view
          wx:for="{{sections}}"
          wx:for-item="section"
          wx:for-index="sectionIndex"
          wx:key="stageId"
          class="merchant-flow-photo-node__section"
        >
          <ui-card shadow="{{true}}" padding="{{true}}">
            <ui-album-node
              mode="edit"
              title="{{section.title}}"
              photoTips="{{section.tips}}"
              captionPlaceholder="本图说明"
              images="{{section.images}}"
              maxCount="{{12}}"
              enableCaption="{{true}}"
              data-index="{{sectionIndex}}"
              bind:imageschange="onSectionImagesChange"
            />
          </ui-card>
        </view>

        <ui-card wx:if="{{nodeKind === 'intake_inspection'}}" shadow="{{true}}" padding="{{true}}" class="merchant-flow-photo-node__note-card">
          <text class="text-body merchant-flow-photo-node__label">检测说明</text>
          <textarea
            class="merchant-flow-photo-node__textarea"
            value="{{note}}"
            maxlength="2000"
            placeholder="填写检测发现、结论与未检项说明（将用于生成检测报告）"
            disabled="{{readOnly}}"
            bindinput="onNoteInput"
          />
        </ui-card>

        <view wx:if="{{!readOnly}}" class="merchant-flow-photo-node__actions safe-bottom">
          <ui-button type="ghost" text="暂存" loading="{{saving}}" disabled="{{saving || completing}}" bind:tap="onSaveDraft" />
          <ui-button type="primary" text="确认本步并继续" loading="{{completing}}" disabled="{{saving || completing}}" bind:tap="onConfirmStep" />
        </view>
      </view>
    </scroll-view>
  </block>
</view>

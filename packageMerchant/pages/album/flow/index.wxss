.merchant-flow-page {
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

.merchant-flow-page__pad {
  padding: var(--space-md);
}

.merchant-flow-page__scroll {
  height: 100vh;
}

.merchant-flow-page__body {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
}

.merchant-flow-page__hero {
  margin-bottom: var(--space-lg);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-bg-card) 100%);
}

.merchant-flow-page__hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.merchant-flow-page__section {
  margin-bottom: var(--space-md);
}

.merchant-flow-page__doc-block {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-flow-page__sheet {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.merchant-flow-page__sheet-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.merchant-flow-page__sheet-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-flow-page__sheet-section--plan {
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--color-border);
}

.merchant-flow-page__sheet-title-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.merchant-flow-page__sheet-rail {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background-color: var(--color-primary);
  flex-shrink: 0;
}

.merchant-flow-page__sheet-rail--plan {
  background-color: var(--color-warning);
}

.merchant-flow-page__sheet-title {
  flex: 1;
  font-weight: 600;
}

.merchant-flow-page__sheet-input {
  width: 100%;
  height: 64rpx;
  padding: 0 var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
  font-size: var(--font-body-size);
  color: var(--color-text-primary);
}

.merchant-flow-page__sheet-input--inline {
  height: 56rpx;
  margin: 0;
}

.merchant-flow-page__sheet-input--amount {
  width: 140rpx;
  height: 56rpx;
  text-align: right;
  padding-right: var(--space-xs);
  background-color: transparent;
}

.merchant-flow-page__sheet-foot {
  display: block;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

.merchant-flow-page__evidence-row {
  display: flex;
  flex-direction: row;
  gap: var(--space-sm);
  padding: var(--space-sm);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-left-width: 6rpx;
  border-left-color: var(--color-border);
}

.merchant-flow-page__evidence-row--ok {
  border-left-color: var(--color-success);
}

.merchant-flow-page__evidence-row--watch {
  border-left-color: var(--color-warning);
}

.merchant-flow-page__evidence-row--action {
  border-left-color: var(--color-danger);
}

.merchant-flow-page__evidence-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.merchant-flow-page__evidence-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.merchant-flow-page__result-seg--compact .merchant-flow-page__result-seg-item {
  padding: 10rpx 4rpx;
  font-size: 22rpx;
}

.merchant-flow-page__result-seg-item--on.merchant-flow-page__result-tone-ok {
  color: var(--color-success);
  background-color: var(--color-success-light);
}

.merchant-flow-page__result-seg-item--on.merchant-flow-page__result-tone-watch {
  color: var(--color-warning);
  background-color: var(--color-warning-light);
}

.merchant-flow-page__result-seg-item--on.merchant-flow-page__result-tone-action {
  color: var(--color-danger);
  background-color: var(--color-danger-light);
}

.merchant-flow-page__plan-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-sm) 0;
  border-bottom: 1rpx dashed var(--color-border);
}

.merchant-flow-page__plan-row-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
}

.merchant-flow-page__plan-name {
  flex: 1;
  min-width: 0;
  font-weight: 500;
}

.merchant-flow-page__plan-amount-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 0 var(--space-xs);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-flow-page__plan-note {
  width: 100%;
  min-height: 64rpx;
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
}

.merchant-flow-page__plan-note--confirm {
  color: var(--color-text-primary);
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
}

.merchant-flow-page__plan-total-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: var(--space-sm) 0;
  margin-top: var(--space-xs);
}

.merchant-flow-page__plan-add {
  padding: var(--space-xs) 0 var(--space-sm);
}

.merchant-flow-page__plan-confirm-label {
  display: block;
  margin-top: var(--space-sm);
}

.merchant-flow-page__auto-save {
  display: block;
  margin-bottom: var(--space-sm);
  text-align: center;
}

.merchant-flow-page__hint {
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-warning-light);
  color: var(--color-text-primary);
}

.merchant-flow-page__finding-tips {
  display: block;
  margin-bottom: var(--space-sm);
}

.merchant-flow-page__finding-empty {
  display: block;
  margin-bottom: var(--space-sm);
}

.merchant-flow-page__finding-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-flow-page__finding-row {
  border-radius: var(--radius-md);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  overflow: hidden;
}

.merchant-flow-page__finding-row--open {
  border-color: var(--color-primary);
}

.merchant-flow-page__finding-summary {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  min-height: 112rpx;
  box-sizing: border-box;
}

.merchant-flow-page__finding-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.merchant-flow-page__finding-summary-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.merchant-flow-page__finding-summary-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-flow-page__finding-gap {
  color: var(--color-danger);
}

.merchant-flow-page__finding-remove {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.merchant-flow-page__field {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}

.merchant-flow-page__field-label {
  display: block;
  font-weight: 500;
}

.merchant-flow-page__input--field {
  margin-bottom: 0;
}

.merchant-flow-page__result-seg {
  display: flex;
  width: 100%;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  overflow: hidden;
  background-color: var(--color-bg-muted);
}

.merchant-flow-page__result-seg-item {
  flex: 1;
  min-width: 0;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
  border-right: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.merchant-flow-page__result-seg-item:last-child {
  border-right: none;
}

.merchant-flow-page__result-seg-item--on {
  background-color: var(--color-bg-card);
  color: var(--color-primary);
  font-weight: 600;
}

.merchant-flow-page__finding-editor {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: var(--space-sm) var(--space-md) var(--space-md);
  border-top: 1rpx solid var(--color-border);
}

.merchant-flow-page__finding-add {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--color-border);
  background-color: var(--color-bg-muted);
}

.merchant-flow-page__finding-add-icon {
  font-size: 48rpx;
  line-height: 1;
  color: var(--color-primary);
}

.merchant-flow-page__finding-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
}

.merchant-flow-page__finding-head {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}

.merchant-flow-page__textarea--short {
  min-height: 120rpx;
}

.merchant-flow-page__disclaimer {
  display: block;
  margin: var(--space-sm) 0;
  color: var(--color-text-tertiary);
}

.merchant-flow-page__label {
  display: block;
  margin-top: var(--space-md);
  font-weight: 600;
}

.merchant-flow-page__textarea {
  width: 100%;
  min-height: 160rpx;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
  font-size: var(--font-body-size);
  color: var(--color-text-primary);
}

.merchant-flow-page__input {
  width: 100%;
  height: 72rpx;
  margin-bottom: var(--space-xs);
  padding: 0 var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
}

.merchant-flow-page__quote-line {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
  padding: var(--space-sm);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
}

.merchant-flow-page__textarea--quote-note {
  min-height: 140rpx;
  margin: 0;
}

.merchant-flow-page__plan-split {
  margin-top: var(--space-lg);
  padding-top: var(--space-lg);
  border-top: 1rpx solid var(--color-border);
}

.merchant-flow-page__quote-total {
  margin: var(--space-sm) 0;
  font-weight: 600;
}

.merchant-flow-page__work-item {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.merchant-flow-page__doc-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.merchant-flow-page__footer-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-xl);
}

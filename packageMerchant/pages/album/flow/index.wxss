  color: var(--color-primary);
}

.merchant-flow-page__ai-status {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}

.merchant-flow-page__ai-status-spin {
  width: 28rpx;
  height: 28rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid var(--color-warning-light);
  border-top-color: var(--color-warning);
  box-sizing: border-box;
  animation: merchant-flow-spin 0.8s linear infinite;
}

.merchant-flow-page__ai-status-text {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-warning);
}

@keyframes merchant-flow-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.merchant-flow-page__orphan-hint {
  margin-bottom: var(--space-sm);
}

.merchant-flow-page__modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: var(--z-popup);
  background-color: var(--color-album-nav-fade-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl);
  box-sizing: border-box;
}

.merchant-flow-page__modal {
  width: 100%;
  max-width: 640rpx;
  padding: var(--space-lg);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-card);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-flow-page__modal-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.merchant-flow-page__await-hint {
  display: block;
  text-align: center;
  margin-bottom: var(--space-xs);
}

.merchant-flow-page__footer-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-xl);
}

.ov {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx calc(160rpx + env(safe-area-inset-bottom));
  background: var(--color-mch-bg);
  color: var(--color-text-primary);
}

.ov-nav {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
}

.ov-back {
  width: 64rpx;
  font-size: 48rpx;
  line-height: 1;
  color: var(--color-text-primary);
}

.ov-nav__text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.ov-kicker {
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
  line-height: var(--font-caption-lh);
}

.ov-plate {
  margin-top: 2rpx;
  font-size: var(--font-h1);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-h1-lh);
  color: var(--color-text-primary);
}

.ov-hero {
  margin-top: 8rpx;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(160deg, var(--color-mch-card-start), var(--color-mch-card-end));
  color: var(--color-text-inverse);
}

.ov-pill {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-primary-dark);
  color: var(--color-text-inverse);
  font-size: var(--font-status);
  font-weight: var(--font-weight-medium);
  line-height: var(--font-status-lh);
}

.ov-hero__name {
  display: block;
  margin-top: 24rpx;
  font-size: var(--font-h1);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-h1-lh);
  color: var(--color-text-inverse);
}

.ov-hero__spec,
.ov-hero__meta {
  display: block;
  color: var(--color-mch-hero-sub);
}

.ov-hero__spec {
  margin-top: 12rpx;
  font-size: var(--font-sub);
  line-height: var(--font-sub-lh);
}

.ov-hero__meta {
  margin-top: 16rpx;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.ov-docs {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.st-field {
  width: 100%;
  height: 96rpx;
  min-height: 96rpx;
  box-sizing: border-box;
  margin-top: 8rpx;
  margin-bottom: var(--space-sm);
  padding: 0 24rpx;
  line-height: 96rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.ov-doc {
  flex: 1;
  min-width: 0;
  padding: 16rpx 4rpx 14rpx;
  border-radius: 28rpx;
  background: var(--color-bg-card);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-mch-card);
  text-align: center;
}

.ov-doc--live {
  border-color: var(--color-primary);
}

.ov-doc__icon {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 12rpx;
  border-radius: 24rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ov-doc__icon image {
  width: 36rpx;
  height: 36rpx;
}

.ov-doc--muted .ov-doc__icon {
  background: var(--color-bg-muted);
}

.ov-doc__name {
  display: block;
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
  line-height: var(--font-caption-lh);
  color: var(--color-text-primary);
}

.ov-doc__label {
  display: block;
  margin-top: 4rpx;
  color: var(--color-mch-caption);
  font-size: var(--font-status);
  line-height: var(--font-status-lh);
}

.ov-doc--live .ov-doc__label {
  color: var(--color-primary);
}

.ov-sec {
  margin-top: 36rpx;
}

.ov-sec__kicker {
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
  line-height: var(--font-caption-lh);
}

.ov-sec__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 4rpx;
}

.ov-sec__title {
  font-size: var(--font-h1);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-h1-lh);
  color: var(--color-text-primary);
}

.ov-sec__count {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--color-mch-caption);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.ov-sec__count image {
  width: 28rpx;
  height: 28rpx;
}

.ov-line {
  margin-top: 24rpx;
}

.ov-row {
  display: flex;
  gap: 16rpx;
}

.ov-row__rail {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: none;
}

.ov-row__dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-status);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-status-lh);
}

.ov-row__dot image {
  width: 26rpx;
  height: 26rpx;
}

.ov-row--todo .ov-row__dot {
  background: var(--color-mch-dot);
  color: var(--color-mch-dot-ink);
}

.ov-row__bar {
  width: 4rpx;
  flex: 1;
  min-height: 28rpx;
  margin: 8rpx 0;
  background: var(--color-border);
}

.ov-row--done .ov-row__bar {
  background: var(--color-primary);
}

.ov-row__main {
  flex: 1;
  min-width: 0;
  padding-bottom: 28rpx;
}

.ov-row__head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.ov-row__title {
  font-size: var(--font-h3);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-h3-lh);
  color: var(--color-text-primary);
}

.ov-row--todo .ov-row__detail {
  color: var(--color-mch-caption);
}

.ov-row__mark,
.ov-row__detail {
  color: var(--color-mch-caption);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.ov-row__detail {
  display: block;
  margin-top: 8rpx;
  line-height: 1.45;
}

.ov-row--current .ov-row__mark {
  color: var(--color-primary);
}

.ov-advice {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--color-primary-light);
}

.ov-advice__mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.ov-advice__mark image {
  width: 32rpx;
  height: 32rpx;
}

.ov-advice__body {
  flex: 1;
  min-width: 0;
}

.ov-advice__kicker {
  display: block;
  color: var(--color-mch-advice);
  font-size: var(--font-sub);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-sub-lh);
}

.ov-advice__text {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.ov-shots {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ov-shot {
  position: relative;
  width: 180rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--color-bg-muted);
}

.ov-shot image {
  width: 100%;
  height: 100%;
}

.ov-shot__cap {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: var(--color-mch-thumb-badge);
  color: var(--color-text-inverse);
  font-size: var(--font-caption);
}

.ov-shot--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx dashed var(--color-border);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  background: var(--color-bg-card);
}

.ov-shot--add image {
  width: 40rpx;
  height: 40rpx;
}

.ov-extra {
  margin-top: 24rpx;
}

.ov-work--top {
  z-index: 30;
}

.ov-work {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  background: var(--color-mch-bg);
}

.ov-work__bar {
  flex: none;
  background: var(--color-bg-card);
}

.ov-work__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding-left: 16rpx;
}

.ov-work .ov-kicker {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  letter-spacing: 2rpx;
}

.ov-work__title {
  font-size: var(--font-mch-page);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-mch-page-lh);
  color: var(--color-text-primary);
}

.ov-work__body {
  flex: 1;
  height: 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ov-done {
  padding-top: 8rpx;
}

.ov-done__line,
.ov-done__count {
  display: block;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.ov-done__photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0;
}

.ov-done__photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-muted);
}

.ov-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  box-shadow: var(--shadow-mch-card);
}

.ov-call,
.ov-go {
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: var(--font-body);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-body-lh);
}

.ov-call image,
.ov-go image {
  width: 32rpx;
  height: 32rpx;
}

.ov-call {
  width: 240rpx;
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  border: 2rpx solid var(--color-border);
}

.ov-go {
  flex: 1;
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.ov-editor-bar {
  background: var(--color-bg-card);
}

.ov-editor-bar__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding-left: 16rpx;
}

.ov-editor-bar__title {
  font-size: 32rpx;
  font-weight: var(--font-weight-semibold);
}

.ov-work__body--bar {
  padding-bottom: 32rpx;
}

.st-tabs {
  flex: none;
  width: 100%;
  white-space: nowrap;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border);
}

.st-tabs__row {
  display: inline-flex;
  min-width: 100%;
  padding: 20rpx 16rpx 16rpx;
  box-sizing: border-box;
}

.st-tab {
  position: relative;
  flex: 1 0 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.st-tab:not(:last-child)::after {
  content: "";
  position: absolute;
  top: 24rpx;
  left: calc(50% + 28rpx);
  width: calc(100% - 56rpx);
  height: 2rpx;
  background: var(--color-mch-rail);
}

.st-tab__dot {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-mch-dot);
  color: var(--color-mch-dot-ink);
  font-size: var(--font-caption);
  line-height: 1;
  font-weight: var(--font-weight-semibold);
}

.st-tab__dot image {
  width: 22rpx;
  height: 22rpx;
}

.st-tab--before .st-tab__dot {
  background: var(--color-mch-green);
}

.st-tab--on .st-tab__dot {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  box-shadow: 0 0 0 8rpx var(--color-primary-light);
}

.st-tab__name {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-primary);
}

.st-tab--on .st-tab__name {
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}

.st-vehicle {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 30rpx;
  background: var(--color-bg-card);
}

.st-vehicle__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.st-vehicle__icon image {
  width: 40rpx;
  height: 40rpx;
}

.st-vehicle__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.st-vehicle__plate {
  font-size: var(--font-status);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-status-lh);
  color: var(--color-text-primary);
}

.st-vehicle__line {
  margin-top: 4rpx;
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
  color: var(--color-mch-meta);
}

.st-pill {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.st-pill--amber {
  color: var(--color-mch-amber);
  background: var(--color-mch-amber-soft);
}

.st-pill--green {
  color: var(--color-mch-green);
  background: var(--color-mch-green-soft);
}

.st-card,
.st-steps,
.st-owner,
.st-warranty,
.st-confirm,
.st-ai,
.st-faultbox {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 34rpx;
  background: var(--color-bg-card);
  box-shadow: 0 12rpx 36rpx rgba(35, 62, 101, 0.04);
}

.st-card__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.st-ai-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-mch-hero);
  background: linear-gradient(135deg, var(--color-mch-card-start), var(--color-mch-card-end));
  position: sticky;
  top: 0;
  z-index: 4;
}

.st-ai-bar image {
  width: 40rpx;
  height: 40rpx;
}

.st-ai-bar text {
  color: var(--color-text-inverse);
  font-size: var(--font-mch-hero-title);
  line-height: var(--font-mch-hero-title-lh);
  font-weight: var(--font-weight-semibold);
}

.st-ai-chip-row {
  display: flex;
  justify-content: flex-end;
}

.st-ai-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
  margin-left: 16rpx;
}

.st-ai-chip__mark {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.st-ai-chip__mark image {
  width: 22rpx;
  height: 22rpx;
}

.st-ai-chip text {
  color: var(--color-mch-advice);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: var(--font-weight-semibold);
}

.st-kicker {
  display: block;
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
  letter-spacing: 2rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}

.st-kicker--light {
  color: var(--color-mch-hero-sub);
}

.st-card__title,
.st-hero__title,
.st-fault__name,
.st-line__name,
.st-task__name,
.st-step__title,
.st-faultbox__title {
  display: block;
  margin-top: 4rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.st-card__title {
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
}

.st-hero__title {
  font-size: var(--font-mch-hero-title);
  line-height: var(--font-mch-hero-title-lh);
  color: var(--color-text-inverse);
}

.st-fault__name,
.st-line__name,
.st-faultbox__title {
  font-size: var(--font-mch-row);
  line-height: var(--font-mch-row-lh);
}

.st-task__name,
.st-step__title {
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
}

.st-count {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--color-mch-meta);
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
}

.st-count image {
  width: 28rpx;
  height: 28rpx;
}

.st-card__hint {
  display: block;
  margin-top: 6rpx;
  color: var(--color-mch-copy);
  font-size: var(--font-sub);
  line-height: var(--font-sub-lh);
}

.st-line__note,
.st-task__note,
.st-step__sub,
.st-fault__body,
.st-hero__sub,
.st-hero__label,
.st-empty {

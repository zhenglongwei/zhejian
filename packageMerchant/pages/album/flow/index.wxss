.merchant-flow-page {
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

.merchant-flow-page__pad {
  padding: var(--space-md);
}

.merchant-flow-page__body {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
}

.merchant-flow-page__hero {
  margin-bottom: var(--space-lg);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-bg-card) 100%);
}

.merchant-flow-page__hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.merchant-flow-page__hero-heading {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--space-xs) var(--space-sm);
}

.merchant-flow-page__hero-vehicle {
  color: var(--color-text-secondary);
}

.merchant-flow-page__section {
  margin-bottom: var(--space-md);
}

.merchant-flow-page__vehicle-row {
  display: flex;
  gap: var(--space-sm);
}

.merchant-flow-page__input--third {
  flex: 1;
  min-width: 0;
}

.merchant-flow-page__sheet {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.merchant-flow-page__sheet-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.merchant-flow-page__sheet-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-flow-page__sheet-section--plan {
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--color-border);
}

.merchant-flow-page__sheet-title-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.merchant-flow-page__sheet-rail {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background-color: var(--color-primary);
  flex-shrink: 0;
}

.merchant-flow-page__sheet-rail--plan {
  background-color: var(--color-warning);
}

.merchant-flow-page__sheet-title {
  flex: 1;
  font-weight: 600;
}

.merchant-flow-page__sheet-input {
  width: 100%;
  height: 64rpx;
  padding: 0 var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
  font-size: var(--font-body-size);
  color: var(--color-text-primary);
}

.merchant-flow-page__sheet-input--inline {
  height: 56rpx;
  margin: 0;
}

.merchant-flow-page__sheet-input--amount {
  width: 140rpx;
  height: 56rpx;
  text-align: right;
  padding-right: var(--space-xs);
  background-color: transparent;
}

.merchant-flow-page__sheet-foot {
  display: block;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

.merchant-flow-page__evidence-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: var(--space-sm);
  padding: var(--space-sm);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-left-width: 6rpx;
  border-left-color: var(--color-border);
}

.merchant-flow-page__evidence-row--ok {
  border-left-color: var(--color-success);
}

.merchant-flow-page__evidence-row--watch {
  border-left-color: var(--color-warning);
}

.merchant-flow-page__evidence-row--action {
  border-left-color: var(--color-danger);
}

.merchant-flow-page__evidence-photos {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--space-xs);
  width: 184rpx;
  flex-shrink: 0;
}

.merchant-flow-page__evidence-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.merchant-flow-page__evidence-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.merchant-flow-page__result-seg--compact .merchant-flow-page__result-seg-item {
  padding: 10rpx 4rpx;
  font-size: var(--font-caption);
}

.merchant-flow-page__result-seg-item--on.merchant-flow-page__result-tone-ok {
  color: var(--color-success);
  background-color: var(--color-success-light);
}

.merchant-flow-page__result-seg-item--on.merchant-flow-page__result-tone-watch {
  color: var(--color-warning);
  background-color: var(--color-warning-light);
}

.merchant-flow-page__result-seg-item--on.merchant-flow-page__result-tone-action {
  color: var(--color-danger);
  background-color: var(--color-danger-light);
}

.merchant-flow-page__plan-row {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md) 0;
  padding-right: 48rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.merchant-flow-page__plan-row-remove {
  position: absolute;
  top: var(--space-sm);
  right: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--color-text-tertiary);
  z-index: 1;
}

.merchant-flow-page__plan-evidence {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs);
  margin-bottom: var(--space-xs);
}

.merchant-flow-page__plan-evidence-block {
  margin-bottom: var(--space-xs);
}

.merchant-flow-page__plan-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--space-xs);
}

.merchant-flow-page__plan-chip {
  width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.merchant-flow-page__plan-chip-img {
  width: 128rpx;
  height: 128rpx;
  display: block;
  border-radius: var(--radius-sm);
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.merchant-flow-page__plan-chip--on .merchant-flow-page__plan-chip-img {
  border-color: var(--color-primary);
}

.merchant-flow-page__plan-chip--taken {
  opacity: 0.4;
}

.merchant-flow-page__plan-chip-name {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  color: var(--color-text-secondary);
}

.merchant-flow-page__plan-evidence-thumb {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.merchant-flow-page__plan-evidence-img {
  width: 128rpx;
  height: 128rpx;
  display: block;
}

.merchant-flow-page__plan-evidence-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
}

.merchant-flow-page__plan-evidence-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-sm);
  border: 1rpx dashed var(--color-border);
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
}

.merchant-flow-page__plan-evidence-add-icon {
  font-size: 40rpx;
  line-height: 1;
  color: var(--color-text-tertiary);
}

.merchant-flow-page__mileage-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: var(--space-sm);
}

.merchant-flow-page__mileage-field {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: var(--input-height);
  padding: 0 var(--space-md);
  border-radius: var(--radius-md);
  overflow: hidden;
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
}

.merchant-flow-page__mileage-input-wrap {
  flex: 1;
  min-width: 0;
  height: 100%;
}

.merchant-flow-page__mileage-input {
  width: 100%;
  height: 100%;
  padding: 0;
  background-color: transparent;
  box-sizing: border-box;
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.merchant-flow-page__mileage-unit {
  flex-shrink: 0;
  margin-left: var(--space-xs);
}

.merchant-flow-page__mileage-shot {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: var(--input-height);
  height: var(--input-height);
  border-radius: var(--radius-md);
  overflow: hidden;
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
}

.merchant-flow-page__mileage-shot--add {
  display: flex;
  flex: 0 0 auto;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  width: auto;
  padding: 0 var(--space-md);
  border: 1rpx dashed var(--color-border);
}

.merchant-flow-page__mileage-shot-img {
  width: 100%;
  height: 100%;
  display: block;
}

.merchant-flow-page__mileage-shot-plus {
  font-size: var(--font-h3);
  line-height: 1;
  color: var(--color-text-tertiary);
}

.merchant-flow-page__mileage-shot-label {
  color: var(--color-text-secondary);
}

.merchant-flow-page__mileage-shot-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
}

.merchant-flow-page__plan-row-top {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: var(--space-sm);
}

.merchant-flow-page__plan-name {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.merchant-flow-page__plan-amount {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  align-items: flex-end;
}

.merchant-flow-page__plan-amount-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-xs);
  min-height: 56rpx;
  padding: 0 var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-flow-page__plan-bands {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--space-xs);
}

.merchant-flow-page__plan-band {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: var(--space-xs);
  height: var(--tag-height);
  padding: 0 var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--tag-reference-bg);
}

.merchant-flow-page__plan-band-k {
  font-size: var(--font-caption);
  line-height: var(--tag-height);
  color: var(--tag-reference-fg);
}

.merchant-flow-page__plan-band-v {
  font-size: var(--font-caption);
  line-height: var(--tag-height);
  color: var(--color-text-primary);
}

.merchant-flow-page__plan-note {
  width: 100%;
  min-height: 64rpx;
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
}

.merchant-flow-page__plan-note--confirm {
  color: var(--color-text-primary);
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
}

.merchant-flow-page__plan-total-bar {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  padding: var(--space-md) 0 var(--space-sm);
  margin-top: var(--space-xs);
  border-top: 1rpx solid var(--color-border);
}

.merchant-flow-page__quote-brief {
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.merchant-flow-page__quote-brief-sec {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-flow-page__ask {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-flow-page__ask-title {
  font-size: var(--font-sub);
  line-height: var(--font-sub-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-mch-advice);
}

.merchant-flow-page__ask-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
}

.merchant-flow-page__ask-q {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.merchant-flow-page__ask-row {
  display: flex;
  gap: var(--space-sm);
  align-items: flex-start;
}

.merchant-flow-page__ask-k {
  flex: none;
  width: 84rpx;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-tertiary);
}

.merchant-flow-page__ask-v {
  flex: 1;
  min-width: 0;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
}

.merchant-flow-page__ask-say {
  margin-top: 4rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--color-border);
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.merchant-flow-page__quote-brief-sec-title {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-tertiary);
  letter-spacing: 0.04em;
}

.merchant-flow-page__quote-brief-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
}

.merchant-flow-page__quote-brief-item-title {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  font-weight: 600;
  color: var(--color-text-primary);
}

.merchant-flow-page__quote-brief-item-body {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
}

.merchant-flow-page__plan-band-block {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.merchant-flow-page__plan-add {
  padding: var(--space-xs) 0 var(--space-sm);
}

.merchant-flow-page__plan-confirm-label {
  display: block;
  margin-top: var(--space-sm);
}

.merchant-flow-page__auto-save {
  display: block;
  text-align: center;
}

.merchant-flow-page__step-foot {
  margin-top: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-flow-page__step-actions {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: var(--space-sm);
}

.merchant-flow-page__step-action {
  flex: 1;
  min-width: 0;
}

.merchant-flow-page__step-action--primary {
  flex: 2;
}

.merchant-flow-page__hint {
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-warning-light);
  color: var(--color-text-primary);
}

.merchant-flow-page__finding-tips {
  display: block;
  margin-bottom: var(--space-sm);
}

.merchant-flow-page__inspect-advice {
  margin: var(--space-md) 0;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
}

.merchant-flow-page__inspect-advice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.merchant-flow-page__inspect-advice-title {
  font-weight: 600;
}

.merchant-flow-page__inspect-advice-head + view {
  margin-top: var(--space-md);
}

.merchant-flow-page__inspect-advice .merchant-flow-page__advice-sec:last-child {
  margin-bottom: 0;
}

.merchant-flow-page__finding-empty {
  display: block;
  margin-bottom: var(--space-sm);
}

.merchant-flow-page__pending {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-card);
}

.merchant-flow-page__organize-wait {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  padding: var(--space-lg) 0;
  color: var(--color-text-secondary);
}

.merchant-flow-page__organize-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  height: 1em;
}

.merchant-flow-page__organize-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-text-secondary);
  opacity: 0.25;
  animation: merchant-flow-organize-dot 1s ease-in-out infinite;
}

.merchant-flow-page__organize-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.merchant-flow-page__organize-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes merchant-flow-organize-dot {
  0%,
  80%,
  100% {
    opacity: 0.25;
  }
  40% {
    opacity: 1;
  }
}

.merchant-flow-page__organize-result {
  margin-bottom: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-primary-light);
  color: var(--color-primary-dark);
}

.merchant-flow-page__library-entry {
  color: var(--color-primary);
  padding: var(--space-xs) 0;
}

.merchant-flow-page__add-finding {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: var(--space-sm) 0;
}

.merchant-flow-page__addon-link {
  color: var(--color-primary);
  text-align: center;
  padding: var(--space-xs) 0;
}

.merchant-flow-page__advice-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: var(--z-popup);
  background-color: var(--color-mask);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.merchant-flow-page__advice {
  width: 100%;
  max-height: 80vh;
  padding: var(--space-lg);
  padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background-color: var(--color-bg-card);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  box-sizing: border-box;
}

.merchant-flow-page__advice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.merchant-flow-page__advice-body {
  min-height: 40vh;
  max-height: 64vh;
}

.merchant-flow-page__advice-body .merchant-flow-page__quote-brief {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.merchant-flow-page__advice-sec {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
  padding-left: var(--space-sm);
  border-left: 4rpx solid var(--color-primary);
}

.merchant-flow-page__advice-sec-title {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: 600;
  color: var(--color-primary);
}

.merchant-flow-page__advice-lead {
  font-size: var(--font-body-size);
  line-height: var(--font-body-lh);
  color: var(--color-text-primary);
}

.merchant-flow-page__advice-ask {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.merchant-flow-page__advice-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: var(--space-sm);
}

.merchant-flow-page__advice-row-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-caption);
  line-height: var(--font-body-lh);
  color: var(--color-text-primary);
}

.merchant-flow-page__advice-apply {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 6rpx 20rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-full);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: 600;
  color: var(--color-primary);
}

.merchant-flow-page__advice-ask-title {

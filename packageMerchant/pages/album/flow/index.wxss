.merchant-flow-page {
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

.merchant-flow-page__pad {
  padding: var(--space-md);
}

.merchant-flow-page__scroll {
  height: 100vh;
}

.merchant-flow-page__body {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
}

.merchant-flow-page__hero {
  margin-bottom: var(--space-lg);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-bg-card) 100%);
}

.merchant-flow-page__hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.merchant-flow-page__section {
  margin-bottom: var(--space-md);
}

.merchant-flow-page__doc-block {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-flow-page__finding {
  display: flex;
  gap: var(--space-sm);
  align-items: center;
}

.merchant-flow-page__finding-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.merchant-flow-page__disclaimer {
  display: block;
  margin: var(--space-sm) 0;
  color: var(--color-text-tertiary);
}

.merchant-flow-page__label {
  display: block;
  margin-top: var(--space-md);
  font-weight: 600;
}

.merchant-flow-page__textarea {
  width: 100%;
  min-height: 160rpx;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
  font-size: var(--font-body-size);
  color: var(--color-text-primary);
}

.merchant-flow-page__input {
  width: 100%;
  height: 72rpx;
  margin-bottom: var(--space-xs);
  padding: 0 var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
}

.merchant-flow-page__quote-line {
  margin-bottom: var(--space-sm);
}

.merchant-flow-page__work-item {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}

.merchant-flow-page__doc-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.merchant-flow-page__footer-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-xl);
}

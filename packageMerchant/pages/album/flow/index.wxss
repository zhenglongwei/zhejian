  line-height: var(--font-sub-lh);
  color: var(--color-mch-copy);
}

.st-fault__body,
.st-quote,
.st-note__body,
.st-ai__body {
  color: var(--color-mch-copy);
}

.st-photos,
.st-compare,
.st-fault__shots {
  display: flex;
  gap: 12rpx;
}

.st-photos--intake {
  flex-wrap: wrap;
}

.st-photos--intake .st-photo {
  flex: none;
  width: calc((100% - 24rpx) / 3);
}

.st-photo,
.st-compare__shot {
  position: relative;
  flex: 1;
  height: 186rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: var(--color-mch-thumb-gray);
}

.st-fault__shots image {
  width: 108rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: var(--color-mch-thumb-gray);
}

.st-photo image,
.st-compare__shot image {
  width: 100%;
  height: 100%;
}

.st-photo__cap,
.st-compare__shot text {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  color: var(--color-text-inverse);
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
}

.st-photo--add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx dashed var(--color-border);
  background: var(--color-bg-page);
  color: var(--color-mch-meta);
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
}

.st-photo--add image {
  width: 36rpx;
  height: 36rpx;
}

.st-mileage {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  color: var(--color-mch-meta);
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
}

.st-mileage input {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
  color: var(--color-text-primary);
  font-size: var(--font-mch-kicker);
}

.st-edit {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--color-primary);
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
}

.st-edit image {
  width: 28rpx;
  height: 28rpx;
}

.st-quote-input {
  width: 100%;
  min-height: 160rpx;
  margin-top: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-left: 6rpx solid var(--color-primary);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
}

.st-photo__badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  color: var(--color-mch-on-card-green);
  background: var(--color-mch-green-deep);
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
}

.st-note,
.st-ai,
.st-confirm,
.st-warranty,
.st-owner,
.st-fault,
.st-line,
.st-task,
.st-step {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.st-note {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: var(--color-primary-light);
}

.st-note image,
.st-ai image,
.st-confirm image {
  width: 36rpx;
  height: 36rpx;
  flex: none;
}

.st-note__title,
.st-ai__title {
  display: block;
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-mch-advice);
}

.st-note__body,
.st-ai__body,
.st-quote {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
  color: var(--color-mch-copy);
}

.st-quote {
  padding: 20rpx;
  border-left: 6rpx solid var(--color-primary);
  border-radius: 0 16rpx 16rpx 0;
  background: var(--color-bg-page);
}

.st-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.st-grid > view {
  width: 50%;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
}

.st-grid text:first-child {
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
  color: var(--color-mch-meta);
}

.st-grid text:last-child {
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
}

.st-confirm {
  align-items: center;
  background: var(--color-mch-green-soft);
  color: var(--color-mch-green);
}

.st-confirm text {
  display: block;
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
  color: var(--color-mch-green);
}

.st-hero {
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 36rpx;
  color: var(--color-text-inverse);
}

.st-hero--inspect,
.st-hero--work {
  background: linear-gradient(135deg, var(--color-mch-card-start), var(--color-mch-card-end));
}

.st-hero--inspect {
  position: sticky;
  top: 0;
  z-index: 4;
}

.st-hero__ai {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.st-hero__ai image {
  width: 32rpx;
  height: 32rpx;
}

.st-hero__ai text {
  color: var(--color-text-inverse);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: var(--font-weight-semibold);
}

.st-hero--inspect .st-kicker--light {
  padding-right: 148rpx;
}

.st-hero--quote {
  position: relative;
  background: linear-gradient(135deg, var(--color-mch-hero-start), var(--color-mch-hero-end));
}

.st-hero--finish {
  background: linear-gradient(135deg, var(--color-mch-green-deep), var(--color-mch-green));
}

.st-hero__title {
  color: var(--color-text-inverse);
}

.st-hero__sub,
.st-hero__label {
  color: var(--color-mch-hero-sub);
}

.st-hero--finish .st-hero__sub,
.st-hero--finish .st-kicker--light,
.st-hero--quote .st-hero__sub,
.st-hero--quote .st-hero__label {
  color: var(--color-mch-ai-note);
}

.st-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.st-figure {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.st-figure text:first-child {
  font-size: var(--font-mch-hero-title);
  line-height: var(--font-mch-hero-title-lh);
}

.st-figure text:last-child {
  font-size: var(--font-mch-figure);
  line-height: var(--font-mch-figure-lh);
  font-weight: var(--font-weight-semibold);
}

.st-hero__foot {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-mch-glass);
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
}

.st-hero .st-pill--blue {
  color: var(--color-text-inverse);
  background: var(--color-mch-glass);
}

.st-fault,
.st-line,
.st-task {
  padding: 16rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.st-fault__no {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-size: var(--font-mch-micro);
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.st-fault__no--amber {
  background: var(--color-mch-amber-soft);
  color: var(--color-mch-amber);
}

.st-fault__main,
.st-line > view,
.st-task > view,
.st-step > view,
.st-note > view,
.st-ai > view,
.st-owner > view,
.st-warranty > view,
.st-confirm > view {
  flex: 1;
  min-width: 0;
}

.st-fault__row,
.st-line,
.st-task {
  align-items: center;
}

.st-fault__row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.st-line__amt,
.st-line__sum,
.st-faultbox__amt {
  font-size: var(--font-mch-row);
  line-height: var(--font-mch-row-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.st-line__main {
  flex: 1;
  min-width: 0;
}

.st-line__name-input,
.st-line__brand-input,
.st-line__amt-input {
  width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-text-primary);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
}

.st-line__brand-input {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.st-line__amt--edit {
  display: flex;
  align-items: center;
  gap: 4rpx;
  width: 160rpx;
  flex: none;
}

.st-line__amt-input {
  text-align: right;
  font-weight: var(--font-weight-semibold);
}

.st-line__remove {
  flex: none;
  color: var(--color-text-secondary);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  padding: 0 4rpx;
}

.st-line__add {
  display: block;
  margin-top: 16rpx;
  color: var(--color-primary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.st-line__sum {
  text-align: right;
  padding-top: 12rpx;
}

.st-ai {
  background: var(--color-primary-light);
  border-color: var(--color-primary-light);
}

.st-ai image {
  width: 64rpx;
  height: 64rpx;
  padding: 14rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--color-primary);
}

.st-task__dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 14rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  flex: none;
}

.st-task__dot--green {
  background: var(--color-mch-green);
}

.st-faultbox {
  background: var(--color-mch-amber-soft);
  border-color: var(--color-mch-amber-soft);
}

.st-faultbox__kicker,
.st-faultbox__amt {
  color: var(--color-mch-amber);
}

.st-faultbox__body {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
  color: var(--color-mch-amber);
}

.st-warranty text,
.st-owner text,
.st-step__title,
.st-step__sub {
  display: block;
}

.st-warranty text:first-child,
.st-owner text:first-child {
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
  color: var(--color-primary);
}

.st-warranty {
  background: var(--color-primary-light);
  border-color: var(--color-primary-light);
}

.st-warranty text:last-child,
.st-owner text:nth-child(2) {
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.st-step__no {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-size: var(--font-mch-micro);
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.st-step.is-done .st-step__no {
  color: var(--color-text-inverse);
  background: var(--color-mch-green);
}

.st-step.is-muted {
  opacity: 0.45;
}

.st-step + .st-step {
  margin-top: 20rpx;
}

.st-empty {
  margin-bottom: 20rpx;
}

.st-bar {
  flex: none;
  display: flex;
  gap: 18rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border);
}

.st-bar__btn {
  flex: 1;
  height: 86rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sub);
  line-height: var(--font-sub-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  background: var(--color-bg-card);
}

.st-bar__btn--go {
  flex: 1.4;
  color: var(--color-text-inverse);
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.merchant-flow-page__finding-remind {
  margin: 0 0 12rpx;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-mch-advice);
}

.sup-steps {
  display: flex;
  margin-bottom: 24rpx;
  padding: 8rpx 0 16rpx;
}

.sup-step {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: var(--color-mch-meta);
  font-size: var(--font-mch-micro);
  line-height: var(--font-mch-micro-lh);
}

.sup-step:not(:last-child)::after {
  content: "";
  position: absolute;
  top: 20rpx;
  left: calc(50% + 24rpx);
  width: calc(100% - 48rpx);
  height: 2rpx;
  background: var(--color-mch-rail);
}

.sup-step__dot {
  position: relative;
  z-index: 1;
  width: 42rpx;
  height: 42rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-mch-dot);
  color: var(--color-mch-dot-ink);
  font-size: var(--font-mch-micro);
}

.sup-step.is-before .sup-step__dot {
  background: var(--color-mch-green);
  color: var(--color-text-inverse);
}

.sup-step.is-on {
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}

.sup-step.is-on .sup-step__dot {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  box-shadow: 0 0 0 8rpx var(--color-primary-light);
}

.doc-brief {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  display: flex;
  align-items: flex-end;
}

.doc-brief__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--color-mask);
}

.doc-brief__sheet {
  position: relative;
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: var(--space-lg) var(--space-md) calc(var(--space-md) + env(safe-area-inset-bottom));
  border-radius: var(--radius-mch-hero) var(--radius-mch-hero) 0 0;
  background: var(--color-bg-muted);
}

.doc-brief__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-md);
}

.doc-brief__kicker {
  display: block;
  color: var(--color-primary);
  font-size: var(--font-mch-kicker);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 1rpx;
}

.doc-brief__title {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-primary);
  font-size: var(--font-h2);
  font-weight: var(--font-weight-semibold);
  line-height: 1.3;
}

.doc-brief__sub {
  display: block;
  margin-top: 4rpx;
  color: var(--color-mch-meta);
  font-size: var(--font-caption);
}

.doc-brief__close {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
  font-size: var(--font-h3);
  line-height: 56rpx;
  text-align: center;
}

.doc-brief__paper {
  margin-top: var(--space-md);
  padding: var(--space-md);
  background: #fff;
  border: 2rpx solid var(--color-text-primary);
}

.doc-brief__shop {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.doc-brief__sq {
  width: 16rpx;
  height: 16rpx;
  background: var(--color-text-primary);
  flex-shrink: 0;
}

.doc-brief__stamp {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border: 2rpx solid var(--color-danger);
  color: var(--color-danger);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.doc-brief__bar {
  width: 72rpx;
  height: 4rpx;
  margin: var(--space-xs) 0;
  background: var(--color-text-primary);
}

.doc-brief__rule {
  height: 2rpx;
  margin: var(--space-sm) 0;
  background: var(--color-text-primary);
}

.doc-brief__sheet-name {
  font-size: var(--font-h3);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.doc-brief__store {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.doc-brief__mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-semibold);
  line-height: 64rpx;
  text-align: center;
}

.doc-brief__store-text {
  flex: 1;
  min-width: 0;
}

.doc-brief__store-name,
.doc-brief__store-sub,
.doc-brief__doc-title,
.doc-brief__empty {
  display: block;
}

.doc-brief__store-name {
  flex: 1;
  min-width: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
}

.doc-brief__store-sub,
.doc-brief__empty {
  color: var(--color-mch-meta);
  font-size: var(--font-caption);
}

.doc-brief__pill {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-mch-kicker);
  font-weight: var(--font-weight-semibold);
}

.doc-brief__pill--ok {
  color: var(--color-success);
  background: var(--color-success-light);
}

.doc-brief__pill--live,
.doc-brief__pill--warn {
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.doc-brief__pill--muted {
  color: var(--color-text-tertiary);
  background: var(--color-bg-card);
}

.doc-brief__doc-title {
  display: block;
  margin: var(--space-sm) 0 var(--space-xs);
  color: var(--color-text-primary);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: var(--font-h1);
  line-height: var(--font-h1-lh);
  font-weight: var(--font-weight-semibold);
  text-align: left;
}

.doc-brief__row,
.doc-brief__line,
.doc-brief__total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
}

.doc-brief__row {
  padding: 12rpx 0;
  border-top: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

.doc-brief__row text:last-child {
  color: var(--color-text-primary);
  text-align: right;
}

.doc-brief__lines {
  padding-top: 8rpx;
}

.doc-brief__line {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.doc-brief__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  flex-shrink: 0;
}

.doc-brief__line-name {
  flex: 1;
  color: var(--color-text-primary);
  font-size: var(--font-caption);
}

.doc-brief__line-amount,
.doc-brief__total text:last-child {
  color: var(--color-text-primary);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-semibold);
}

.doc-brief__total {
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--color-border);
}

.doc-brief__total text:last-child {
  color: var(--color-text-primary);
  font-size: var(--font-h3);
}

.doc-brief__seal {
  margin-top: var(--space-md);
  padding: 12rpx 16rpx;
  border-radius: var(--radius-md);
  background: var(--color-success-light);
  color: var(--color-success);
  font-size: var(--font-mch-kicker);
  text-align: center;
}

.doc-brief__empty {
  padding: var(--space-lg) 0 var(--space-sm);
  text-align: center;
}

.doc-brief__actions {
  display: flex;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.doc-brief__send,
.doc-brief__full {
  height: 88rpx;
  border-radius: var(--radius-lg);
  font-size: var(--font-body);
  font-weight: var(--font-weight-semibold);
  line-height: 88rpx;
  text-align: center;
}

.doc-brief__send {
  flex: 1;
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-border);
}

.doc-brief__full {
  flex: 1.35;
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.ov-work .stage-bar-only {
  display: none;
}

.rec-preview {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

.rec-preview__bar,
.rec-preview__row {
  background: var(--color-bg-card);
}

.rec-preview__row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding-left: var(--space-sm);
}

.rec-preview__body {
  flex: 1;
  height: 0;
  padding: var(--space-md);
  box-sizing: border-box;
}

.rec-preview__note,
.rec-preview__seal,
.rec-preview__scope text:last-child,
.rec-preview__copy,
.rec-preview__label {
  display: block;
}

.rec-preview__note,
.rec-preview__seal {
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-caption);
}

.rec-preview__card {
  margin-top: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
}

.rec-preview__title {
  display: block;
  margin: var(--space-lg) 0 var(--space-md);
  color: var(--color-text-primary);
  font-size: var(--font-h3);
  font-weight: var(--font-weight-semibold);
  text-align: center;
}

.rec-preview__block {
  margin-top: var(--space-md);
}

.rec-preview__label {
  margin-bottom: var(--space-xs);
  color: var(--color-primary);
  font-size: var(--font-mch-kicker);
  font-weight: var(--font-weight-semibold);
}

.rec-preview__copy,
.rec-preview__scope text:last-child {
  color: var(--color-text-primary);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.rec-preview__photos {
  display: flex;
  gap: var(--space-sm);
}

.rec-preview__photos image {
  width: 180rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
}

.rec-preview__seal,
.rec-preview__scope {
  margin-top: var(--space-md);
}

.rec-preview__scope text:first-child {
  display: block;
  margin-bottom: 4rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-mch-kicker);
}

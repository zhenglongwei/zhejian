.merchant-flow-page {
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

.merchant-flow-page__pad {
  padding: var(--space-md);
}

.merchant-flow-page__scroll {
  height: 100vh;
}

.merchant-flow-page__body {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
}

.merchant-flow-page__hero {
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-bg-card) 100%);
  box-shadow: var(--shadow-sm);
}

.merchant-flow-page__hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.merchant-flow-page__progress {
  display: block;
  margin-top: var(--space-sm);
  color: var(--color-text-secondary);
}

.merchant-flow-page__section-title {
  display: block;
  margin-bottom: var(--space-sm);
  color: var(--color-text-tertiary);
  letter-spacing: 0.04em;
}

.merchant-flow-page__done-block {
  margin-top: var(--space-lg);
}

.merchant-flow-page__active-block {
  margin-top: var(--space-lg);
}

.merchant-flow-page__active-card {
  border: 2rpx solid var(--color-primary-light);
}

.merchant-flow-page__active-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
}

.merchant-flow-page__active-desc {
  display: block;
  margin-top: var(--space-sm);
}

.merchant-flow-page__active-summary {
  display: block;
  margin-top: var(--space-md);
  color: var(--color-text-secondary);
}

.merchant-flow-page__thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.merchant-flow-page__thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-md);
}

.merchant-flow-page__cta {
  margin-top: var(--space-lg);
}

.merchant-flow-page__lock-hint {
  margin-top: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
}

.merchant-flow-page__actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-xl);
}

.merchant-flow-doc-node {
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

.merchant-flow-doc-node__pad,
.merchant-flow-doc-node__body {
  padding: var(--space-md);
}

.merchant-flow-doc-node__scroll {
  height: 100vh;
}

.merchant-flow-doc-node__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.merchant-flow-doc-node__meta {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.merchant-flow-doc-node__hint {
  display: block;
  margin-top: var(--space-sm);
}

.merchant-flow-doc-node__form,
.merchant-flow-doc-node__confirm {
  margin-top: var(--space-md);
}

.merchant-flow-doc-node__label {
  display: block;
  margin-bottom: var(--space-sm);
  font-weight: 600;
}

.merchant-flow-doc-node__textarea {
  width: 100%;
  min-height: 240rpx;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
  font-size: var(--font-body-size);
  line-height: var(--font-body-line-height);
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.merchant-flow-doc-node__proof-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
  margin: var(--space-md) 0;
}

.merchant-flow-doc-node__proof-item {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.merchant-flow-doc-node__proof-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
}

.merchant-flow-doc-node__actions {
  margin-top: var(--space-md);
  padding-bottom: env(safe-area-inset-bottom);
}

.merchant-flow-doc-node__confirm-btn {
  margin-top: var(--space-md);
}

.merchant-flow-doc-node__confirm-btn + .merchant-flow-doc-node__confirm-btn {
  margin-top: var(--space-sm);
}

                                src="{{shot.url}}"
                                mode="aspectFill"
                              />
                            </view>
                          </block>
                        </block>
                        <view wx:elif="{{item.url}}" class="merchant-flow-page__work-thumb">
                          <image
                            class="merchant-flow-page__work-thumb-img image-placeholder"
                            src="{{item.url}}"
                            mode="aspectFill"
                          />
                        </view>
                        <view

<view class="page merchant-flow-page">
  <block wx:if="{{status === 'loading'}}">
    <view class="page-content merchant-flow-page__pad">
      <ui-skeleton rows="{{4}}" title="{{true}}" />
      <ui-skeleton rows="{{8}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty title="无法加载服务进度" description="{{errorMessage}}" actionText="重试" bind:action="onRetry" />
    </view>
  </block>

  <block wx:else>
    <scroll-view scroll-y class="merchant-flow-page__scroll" show-scrollbar="{{false}}">
      <view class="page-content merchant-flow-page__body">
        <ui-card shadow="{{true}}" padding="{{true}}">
          <view class="merchant-flow-page__head">
            <text class="text-h3">{{serviceName}}</text>
            <ui-tag variant="{{statusVariant}}" text="{{statusLabel}}" />
          </view>
          <text class="text-caption text-secondary merchant-flow-page__intro">
            按施工顺序填写；拍照节点上传过程图，单据节点生成面向车主的单据。
          </text>
          <view wx:if="{{completeHint}}" class="merchant-flow-page__hint">
            <text class="text-caption">{{completeHint}}</text>
          </view>
        </ui-card>

        <view class="merchant-flow-page__timeline">
          <view
            wx:for="{{flowNodes}}"
            wx:key="id"
            class="merchant-flow-page__item"
            data-path="{{item.detailPath}}"
            bindtap="onOpenNode"
          >
            <view class="merchant-flow-page__rail" aria-hidden="true">
              <view class="merchant-flow-page__dot {{item.isPhoto ? 'merchant-flow-page__dot--photo' : 'merchant-flow-page__dot--doc'}}" />
              <view wx:if="{{index < flowNodes.length - 1}}" class="merchant-flow-page__line" />
            </view>

            <ui-card shadow="{{true}}" padding="{{true}}" class="merchant-flow-page__card">
              <view class="merchant-flow-page__card-head">
                <text class="merchant-flow-page__index text-caption">{{item.indexLabel}}</text>
                <view class="merchant-flow-page__card-title-row">
                  <text class="text-body merchant-flow-page__title">{{item.title}}</text>
                  <ui-tag variant="{{item.isPhoto ? 'info' : 'warning'}}" text="{{item.categoryLabel}}" />
                </view>
              </view>
              <text class="text-caption text-secondary merchant-flow-page__summary">{{item.summary}}</text>
              <view wx:if="{{item.previewImages.length}}" class="merchant-flow-page__thumbs">
                <image
                  wx:for="{{item.previewImages}}"
                  wx:for-item="thumb"
                  wx:key="url"
                  class="merchant-flow-page__thumb"
                  src="{{thumb.url}}"
                  mode="aspectFill"
                />
              </view>
            </ui-card>
          </view>
        </view>

        <view class="merchant-flow-page__actions">
          <ui-button
            wx:if="{{!readOnly}}"
            type="primary"
            text="标记整单完工"
            loading="{{completing}}"
            disabled="{{completing}}"
            bind:tap="onCompleteAlbum"
          />
          <ui-button type="ghost" text="高级编辑（旧版）" bind:tap="onOpenLegacyEdit" />
        </view>
      </view>
    </scroll-view>
  </block>
</view>

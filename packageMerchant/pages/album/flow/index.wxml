                            placeholder="0"
                            type="digit"
                            value="{{item.amount}}"
                            data-index="{{index}}"
                            data-field="amount"
                            disabled="{{readOnly || confirmAwaitingOwner}}"
                            bindinput="onQuoteLineInput"
                          />
                        </view>
                      </view>
                    </view>
                    <view wx:if="{{item.hasBands}}" class="merchant-flow-page__plan-band-block">
                      <text class="text-caption text-secondary merchant-flow-page__field-label">市场参考价</text>
                      <view class="merchant-flow-page__plan-bands">
                        <view
                          wx:for="{{item.bandChips}}"
                          wx:for-item="chip"
                          wx:key="key"
                          class="merchant-flow-page__plan-band"
                        >
                          <text class="merchant-flow-page__plan-band-k">{{chip.k}}</text>
                          <text class="merchant-flow-page__plan-band-v">{{chip.v}}</text>
                        </view>
                      </view>
                    </view>
                    <template is="aiFieldHint" data="{{hint: item.nameHint}}" />
                    <text class="text-caption text-secondary merchant-flow-page__field-label">品牌</text>
                    <input
                      class="merchant-flow-page__sheet-input merchant-flow-page__sheet-input--inline"
                      placeholder="选填"
                      value="{{item.brand}}"
                      data-index="{{index}}"
                      data-field="brand"
                      disabled="{{readOnly || confirmAwaitingOwner}}"
                      bindinput="onQuoteLineInput"
                    />
                    <view wx:if="{{item.evidenceUrls.length}}" class="merchant-flow-page__work-thumbs">
                      <image
                        wx:for="{{item.evidenceUrls}}"
                        wx:for-item="shot"
                        wx:key="*this"
                        class="merchant-flow-page__work-thumb-img image-placeholder"
                        src="{{shot}}"
                        mode="aspectFill"
                        data-url="{{shot}}"
                        bindtap="onPreviewAddonDiscovery"
                      />
                    </view>
                  </view>
                  <view
                    wx:if="{{!readOnly && !confirmAwaitingOwner}}"
                    class="merchant-flow-page__plan-add"
                    bindtap="onAddQuoteLine"
                  >
                    <text class="text-caption text-link">+ 新增项目</text>
                  </view>
                  <view class="merchant-flow-page__plan-total-bar">
                    <text class="text-h3">{{quoteTotalLabel}}</text>
                  </view>
                </view>
              </view>
              <view
                wx:if="{{!readOnly && (!isAddonQuote || addonDiscoveryReady || confirmAwaitingOwner)}}"
                class="merchant-flow-page__doc-actions"
              >
                <text wx:if="{{showAutoSave}}" class="text-caption text-secondary merchant-flow-page__auto-save">{{autoSaveLabel}}</text>
                <view
                  wx:if="{{(quoteAssist.isWaiting || aiReview.isWaiting) && !adviceOpen}}"
                  class="merchant-flow-page__ai-status"
                >
                  <view class="merchant-flow-page__ai-status-spin"></view>
                  <text class="merchant-flow-page__ai-status-text">{{quoteAssist.isWaiting ? quoteAssist.waitHint : '正在出意见'}}</text>
                </view>
                <block wx:if="{{!confirmAwaitingOwner}}">
                  <view wx:if="{{quoteNotifyReady}}" class="stage-bar-only">
                    <ui-button
                      type="primary"
                      block="{{true}}"
                      loading="{{confirming}}"
                      disabled="{{notifyConfirmDisabled}}"
                      bind:btntap="onSendForOwnerConfirm"
                    >发送车主确认</ui-button>
                  </view>
                </block>
                <block wx:else>
                  <text class="text-caption text-secondary merchant-flow-page__await-hint">等待确认</text>
                  <ui-button
                    type="secondary"
                    block="{{true}}"
                    loading="{{confirming}}"
                    bind:btntap="onProxyConfirm"
                  >代车主确认</ui-button>
                </block>
                <ui-button
                  wx:if="{{isAddonQuote}}"
                  type="ghost"
                  block="{{true}}"
                  loading="{{confirming}}"
                  bind:btntap="onOpenCancelAddon"
                >取消本项</ui-button>
              </view>
              <view wx:elif="{{!readOnly && isAddonQuote}}" class="merchant-flow-page__doc-actions">
                <ui-button
                  type="ghost"
                  block="{{true}}"
                  loading="{{confirming}}"
                  bind:btntap="onOpenCancelAddon"
                >取消本项</ui-button>
              </view>
            </block>

            <block wx:elif="{{activeKind === 'repair_report'}}">
              <text class="text-body merchant-flow-page__label">交车报告</text>
              <text wx:if="{{ownerRejectReason && !confirmAwaitingOwner}}" class="text-caption text-secondary">车主未同意。{{ownerRejectReason}}</text>
              <view class="merchant-flow-page__doc-block">
                <text class="text-caption text-secondary">已施工项目</text>
                <view wx:for="{{docPayload.workItems}}" wx:key="name" class="merchant-flow-page__work-item">
                  <text class="text-body">{{item.name}}</text>
                </view>
                <text class="text-body merchant-flow-page__label">交付人</text>
                <input class="st-field" placeholder="例：李师傅" value="{{delivererName}}" data-key="delivererName" disabled="{{readOnly}}" bindinput="onClerkInput" />
                <text class="text-body merchant-flow-page__label">完工时间</text>
                <view class="st-field-row" wx:if="{{!readOnly}}">
                  <picker mode="date" value="{{finishedAtDate}}" data-key="finishedAt" data-part="date" bindchange="onClerkAtPick">
                    <view class="st-field st-field--picker">{{finishedAtDate || '选择日期'}}</view>
                  </picker>
                  <picker mode="time" value="{{finishedAtTime}}" data-key="finishedAt" data-part="time" bindchange="onClerkAtPick">
                    <view class="st-field st-field--picker">{{finishedAtTime || '选择时间'}}</view>
                  </picker>
                </view>
                <text wx:else class="st-quote">{{finishedAt || '未填'}}</text>
                <text class="text-body merchant-flow-page__label">质保期限</text>
                <textarea
                  class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                  placeholder="例：1 年或 5000 公里，以先到为准"
                  value="{{warrantyPeriod}}"
                  maxlength="120"
                  auto-height="{{true}}"
                  data-field="warrantyPeriod"
                  disabled="{{readOnly}}"
                  bindinput="onWarrantyFieldInput"
                />
                <text class="text-body merchant-flow-page__label">注意事项</text>
                <textarea
                  class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                  placeholder="例：仅限本次已确认项目；外力撞击、涉水除外"
                  value="{{warrantyNotes}}"
                  maxlength="300"
                  auto-height="{{true}}"
                  data-field="warrantyNotes"
                  disabled="{{readOnly}}"
                  bindinput="onWarrantyFieldInput"
                />
              </view>
              <view wx:if="{{!readOnly}}" class="merchant-flow-page__doc-actions">
                <view
                  wx:if="{{aiReview.isWaiting}}"
                  class="merchant-flow-page__ai-status"
                >
                  <view class="merchant-flow-page__ai-status-spin"></view>
                  <text class="merchant-flow-page__ai-status-text">{{aiReview.waitHint}}</text>
                </view>
                <block wx:if="{{!confirmAwaitingOwner}}">
                  <view class="stage-bar-only">
                    <ui-button
                      type="primary"
                      block="{{true}}"
                      loading="{{confirming}}"
                      disabled="{{notifyConfirmDisabled}}"
                      bind:btntap="onSendForOwnerConfirm"
                    >发送车主确认</ui-button>
                  </view>
                </block>
                <block wx:else>
                  <text class="text-caption text-secondary merchant-flow-page__await-hint">等车主确认交车</text>
                  <ui-button
                    type="secondary"
                    block="{{true}}"
                    loading="{{confirming}}"
                    bind:btntap="onProxyConfirm"
                  >代车主确认</ui-button>
                </block>
              </view>
            </block>
          </view>
      </scroll-view>
      <view wx:if="{{stageBoard && (stageShowPreview || stagePrimary || (isAddonQuote && stageEditor && !stageLocked))}}" class="st-bar">
        <view wx:if="{{isAddonQuote && stageEditor && !stageLocked}}" class="st-bar__btn" bindtap="onOpenCancelAddon">返回施工</view>
        <view wx:if="{{stageShowPreview && stageBoard.family !== 'work'}}" class="st-bar__btn {{stagePrimary ? '' : 'st-bar__btn--go'}}" bindtap="onOpenOwnerView">预览报告</view>
        <view wx:if="{{stagePrimary}}" class="st-bar__btn st-bar__btn--go" bindtap="onStagePrimary">{{stagePrimary}}</view>
      </view>
    </view>
    <view wx:if="{{recordPreview}}" class="rec-preview" catchtouchmove="true">
      <view class="rec-preview__bar" style="padding-top: {{statusBarHeight}}px;">
        <view class="rec-preview__row" style="padding-right: {{capsulePad}}px;">
          <text class="ov-back" catchtap="onCloseRecordPreview">‹</text>
          <view class="ov-nav__text">
            <text class="ov-work__title">预览报告</text>
          </view>
        </view>
      </view>
      <scroll-view scroll-y class="rec-preview__body" show-scrollbar="{{false}}">
        <service-doc-sheet
          doc="{{recordPreview.doc}}"
          mode="owner"
          quote-lines="{{recordPreview.quoteLines}}"
          show-header="{{true}}"
        />
      </scroll-view>
      <view class="st-bar">
        <block wx:if="{{recordPreview.locked}}">
          <view class="st-bar__btn st-bar__btn--go" catchtap="onCloseRecordPreview">关闭</view>
        </block>
        <block wx:else>
          <view class="st-bar__btn" catchtap="onCloseRecordPreview">返回修改</view>
          <view class="st-bar__btn st-bar__btn--go" catchtap="onAcceptRecordPreview">{{recordPreview.acceptLabel}}</view>
        </block>
      </view>
    </view>
    <view wx:if="{{doneView}}" class="ov-work ov-work--top">
      <view class="ov-work__bar" style="padding-top: {{statusBarHeight}}px;">
        <view class="ov-work__row" style="padding-right: {{capsulePad}}px;">
          <text class="ov-back" bindtap="onCloseDone">‹</text>
          <text class="ov-work__title">{{doneView.title}}</text>
        </view>
      </view>
      <scroll-view scroll-y class="ov-work__body" show-scrollbar="{{false}}">
        <service-doc-sheet wx:if="{{doneView.mode === 'doc'}}" doc="{{doneView.sheetDoc}}" mode="merchant" />
        <view wx:else class="ov-done">
          <text wx:if="{{doneView.complaint}}" class="ov-done__line">{{doneView.complaint}}</text>
          <view wx:if="{{doneView.images.length}}" class="ov-done__photos">
            <image
              wx:for="{{doneView.images}}"
              wx:key="url"
              class="ov-done__photo"
              src="{{item.url}}"
              mode="aspectFill"
              data-url="{{item.url}}"
              bindtap="onPreviewDonePhoto"
            />
          </view>
          <text class="ov-done__count">共 {{doneView.photoCount}} 张</text>
        </view>
      </scroll-view>
    </view>
  </block>

  <ai-fab
    wx:if="{{workOpen && stageBoard}}"
    hidden="{{adviceOpen || recordPreview || docBrief || showCancelAddonModal || showPickSheet}}"
    waiting="{{(stageBoard.family === 'work' && workAdvice.isWaiting) || (stageBoard.family === 'finish' && deliveryAdvice.isWaiting) || (stageBoard.family === 'inspect' && (inspectionAdvice.isWaiting || organizingPhotos)) || (stageBoard.family === 'intake' && intakeAdvice.isWaiting) || (stageBoard.family === 'quote' && quoteAssist.isWaiting)}}"
    bind:tap="onAiFab"
  />

  <view wx:if="{{adviceOpen}}" class="merchant-flow-page__advice-mask" catchtouchmove="true" bindtap="onCloseAdvice">
    <view class="merchant-flow-page__advice" catchtap="onAdvicePanelTap">
      <view class="merchant-flow-page__advice-head">
        <text class="text-h3">AI分析</text>
        <view class="merchant-flow-page__advice-head-actions">
          <text
            wx:if="{{adviceCanRefresh}}"
            class="text-caption merchant-flow-page__advice-refresh"
            catchtap="onRefreshAdvice"
          >刷新</text>
          <text class="text-caption text-secondary" catchtap="onCloseAdvice">收起</text>
        </view>
      </view>
      <scroll-view scroll-y class="merchant-flow-page__advice-body">
        <view wx:if="{{(stageBoard.family === 'work' && workAdvice.isWaiting) || (stageBoard.family === 'finish' && deliveryAdvice.isWaiting) || (stageBoard.family === 'inspect' && (inspectionAdvice.isWaiting || organizingPhotos)) || (stageBoard.family === 'intake' && intakeAdvice.isWaiting) || (stageBoard.family === 'quote' && quoteAssist.isWaiting)}}" class="merchant-flow-page__ai-status">
          <view class="merchant-flow-page__ai-status-spin"></view>
          <text class="merchant-flow-page__ai-status-text">{{adviceWaitHint || '正在出意见'}}</text>
        </view>
        <block wx:if="{{(stageBoard.family === 'work' && workAdvice.hasContent) || (stageBoard.family === 'finish' && deliveryAdvice.hasContent) || (stageBoard.family === 'inspect' && inspectionAdvice.hasContent) || (stageBoard.family === 'intake' && intakeAdvice.hasContent) || (stageBoard.family === 'quote' && quoteAssist.hasContent) || !((stageBoard.family === 'work' && workAdvice.isWaiting) || (stageBoard.family === 'finish' && deliveryAdvice.isWaiting) || (stageBoard.family === 'inspect' && (inspectionAdvice.isWaiting || organizingPhotos)) || (stageBoard.family === 'intake' && intakeAdvice.isWaiting) || (stageBoard.family === 'quote' && quoteAssist.isWaiting))}}">
          <block wx:if="{{stageBoard.family === 'work' && workAdvice.hasContent}}">
            <view wx:if="{{workAdvice.hasPhotoPlan}}" class="merchant-flow-page__advice-sec">
              <text class="merchant-flow-page__advice-sec-title">施工留证建议</text>
              <view wx:for="{{workAdvice.photoPlan}}" wx:key="id" class="merchant-flow-page__advice-ask">
                <text wx:if="{{item.hasTitle}}" class="merchant-flow-page__advice-ask-title">{{item.title}}</text>
                <text wx:if="{{item.hasBody}}" class="merchant-flow-page__advice-ask-body">{{item.body}}</text>
              </view>
            </view>
            <view wx:if="{{workAdvice.hasLines}}" class="merchant-flow-page__advice-sec">
              <view wx:for="{{workAdvice.lines}}" wx:key="id" class="merchant-flow-page__advice-row">
                <image
                  wx:if="{{item.url}}"
                  class="merchant-flow-page__advice-shot"
                  src="{{item.url}}"
                  mode="aspectFill"
                />
                <text class="merchant-flow-page__advice-row-text">{{item.body}}</text>
                <text
                  wx:if="{{item.canApply}}"
                  class="merchant-flow-page__advice-apply"
                  data-id="{{item.id}}"
                  catchtap="onApplyWorkExplain"
                >应用</text>
                <text wx:elif="{{item.applied}}" class="merchant-flow-page__advice-state">已应用</text>
              </view>
            </view>
          </block>
          <block wx:elif="{{stageBoard.family === 'finish' && deliveryAdvice.hasContent}}">
            <template is="deliveryAdvicePanel" data="{{advice: deliveryAdvice}}" />
          </block>
          <block wx:elif="{{stageBoard.family === 'intake' && intakeAdvice.hasContent}}">
            <template is="intakeAdvicePanel" data="{{advice: intakeAdvice, askReadonly: false}}" />
          </block>
          <block wx:elif="{{stageBoard.family === 'quote' && quoteAssist.hasContent}}">
            <template is="quoteMerchantBrief" data="{{brief: quoteAssist}}" />
          </block>
          <block wx:elif="{{stageBoard.family === 'inspect' && inspectionAdvice.hasContent}}">
            <view wx:if="{{inspectionAdvice.hasFault}}" class="merchant-flow-page__advice-sec">
              <text class="merchant-flow-page__advice-sec-title">故障分析</text>
              <text class="merchant-flow-page__advice-ask-body">{{inspectionAdvice.faultAnalysis}}</text>
            </view>
            <view wx:if="{{inspectionAdvice.hasOrder}}" class="merchant-flow-page__advice-sec">
              <text class="merchant-flow-page__advice-sec-title">检测顺序</text>
              <view wx:for="{{inspectionAdvice.inspectOrder}}" wx:key="*this" class="merchant-flow-page__advice-ask">
                <text class="merchant-flow-page__advice-ask-body">{{index + 1}}. {{item}}</text>
              </view>
            </view>
            <view wx:if="{{inspectionAdvice.hasParts}}" class="merchant-flow-page__advice-sec">
              <text class="merchant-flow-page__advice-sec-title">部件参考</text>
              <view wx:for="{{inspectionAdvice.partHints}}" wx:key="id" class="merchant-flow-page__advice-ask">
                <text class="merchant-flow-page__advice-ask-title">{{item.title}}</text>
                <text class="merchant-flow-page__advice-ask-body">{{item.body}}</text>
              </view>
            </view>
            <view wx:if="{{inspectionAdvice.hasLines}}" class="merchant-flow-page__advice-sec">
              <text class="merchant-flow-page__advice-sec-title">本单修改</text>
              <view wx:for="{{inspectionAdvice.lines}}" wx:key="id" class="merchant-flow-page__advice-row">
                <text class="merchant-flow-page__advice-row-text">{{item.body}}</text>
                <text
                  wx:if="{{item.canApply}}"
                  class="merchant-flow-page__advice-apply"
                  data-id="{{item.id}}"
                  catchtap="onApplyOwnerExplain"
                >应用</text>
                <text wx:elif="{{item.applied}}" class="merchant-flow-page__advice-state">已应用</text>
              </view>
            </view>
          </block>
          <view wx:elif="{{inspectionAdvice.isWaiting || intakeAdvice.isWaiting || workAdvice.isWaiting || deliveryAdvice.isWaiting || quoteAssist.isWaiting}}" class="text-caption text-secondary">正在出意见…</view>
          <view wx:elif="{{inspectionAdvice.status === 'failed' || intakeAdvice.status === 'failed' || workAdvice.status === 'failed' || deliveryAdvice.status === 'failed' || quoteAssist.status === 'failed'}}" class="text-caption text-secondary">这次没出成，点刷新再试</view>
          <view wx:else class="text-caption text-secondary">还没有可展示的意见</view>
        </block>
      </scroll-view>
    </view>
  </view>

  <flow-pick-sheet
    visible="{{showPickSheet}}"
    title="{{pickSheetTitle}}"
    groups="{{pickSheetGroups}}"
    extraTitle="{{pickSheetExtra}}"
    bind:close="onClosePickSheet"
    bind:pick="onPickSheetItem"
    bind:extra="onPickSheetExtra"
  />

  <view wx:if="{{docBrief}}" class="doc-brief" catchtouchmove="true">
    <view class="doc-brief__mask" bindtap="onCloseDoc"></view>
    <view class="doc-brief__sheet">
      <view class="doc-brief__top">
        <text class="doc-brief__sheet-name">{{docBrief.title}}</text>
        <text class="doc-brief__close" catchtap="onCloseDoc">×</text>
      </view>
      <service-doc-sheet
        wx:if="{{docBrief.sheetDoc}}"
        doc="{{docBrief.sheetDoc}}"
        mode="merchant"
        quote-lines="{{docBrief.quoteLines}}"
        show-header="{{true}}"
      />
      <text wx:else class="doc-brief__empty">{{docBrief.emptyText || '还没有这份内容'}}</text>
      <view class="doc-brief__actions">
        <view class="doc-brief__send" catchtap="onBriefSend">{{briefSending ? '发送中' : '发送车主'}}</view>
        <view class="doc-brief__full" catchtap="onBriefFull">查看完整文件</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showCancelAddonModal}}" class="merchant-flow-page__modal-mask" catchtouchmove="true">
    <view class="merchant-flow-page__modal">
      <text class="text-h3">取消本项</text>
      <text class="text-caption text-secondary merchant-flow-page__modal-hint">已发给车主，取消后车主可见原因，并回到施工。</text>
      <textarea
        class="merchant-flow-page__textarea merchant-flow-page__textarea--short"
        placeholder="例：沟通后暂不增加 / 误点入口"
        maxlength="200"
        auto-height="{{true}}"
        value="{{cancelAddonReason}}"
        bindinput="onCancelAddonReasonInput"
      />
      <view class="merchant-flow-page__modal-actions">
        <ui-button type="ghost" block="{{true}}" bind:btntap="onCloseCancelAddonModal">返回</ui-button>
        <ui-button type="primary" block="{{true}}" loading="{{confirming}}" bind:btntap="onConfirmCancelAddon">确认取消</ui-button>
      </view>
    </view>
  </view>
</view>

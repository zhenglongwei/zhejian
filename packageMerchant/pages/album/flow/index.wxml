                  <view class="merchant-flow-page__key-fill-body">
                    <view class="merchant-flow-page__key-fill-field">
                      <view class="merchant-flow-page__key-fill-label-row">
                        <text class="text-body merchant-flow-page__label merchant-flow-page__label--key">本次维修简述</text>
                        <text class="merchant-flow-page__key-fill-req">（必填）</text>
                      </view>
                      <textarea
                        class="merchant-flow-page__textarea merchant-flow-page__textarea--key"
                        placeholder="例：更换下摆臂胶套，并完成机油机滤保养"

                        </view>
                        <textarea
                          class="merchant-flow-page__textarea merchant-flow-page__textarea--key"
                          placeholder="回答"
                          value="{{item.answer}}"
                          maxlength="280"
                          auto-height="{{true}}"
                          data-id="{{item.id}}"
                          data-field="answer"
                          disabled="{{readOnly}}"
                          bindinput="onOwnerFaqInput"
                        />
                      </view>
                      <view
                        wx:if="{{!readOnly && ownerFaqs.length < 5}}"
                        class="merchant-flow-page__key-fill-add"
                        bindtap="onAddOwnerFaq"
                      >
                        <text class="merchant-flow-page__key-fill-add-text">加一条</text>
                      </view>
                    </view>
                  </view>
                </view>
                <text class="text-body merchant-flow-page__label">交付人</text>
                <input class="st-field" placeholder="例：李师傅" value="{{delivererName}}" data-key="delivererName" disabled="{{readOnly}}" bindinput="onClerkInput" />

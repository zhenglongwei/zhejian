                  bind:btntap="onOpenCancelAddon"
                >取消本项</ui-button>
              </view>
            </block>

            <block wx:elif="{{activeKind === 'repair_report'}}">
              <text class="text-body merchant-flow-page__label">交车报告</text>
              <text wx:if="{{ownerRejectReason && !confirmAwaitingOwner}}" class="text-caption text-secondary">车主未同意。{{ownerRejectReason}}</text>
              <view class="merchant-flow-page__doc-block">
                <text class="text-caption text-secondary">已施工项目</text>
                <view wx:for="{{docPayload.workItems}}" wx:key="name" class="merchant-flow-page__work-item">
                  <text class="text-body">{{item.name}}</text>
                  <text class="text-caption">¥{{item.amount}}</text>
                </view>
                <text class="text-body merchant-flow-page__label">合计 ¥{{docPayload.totalAmount}}</text>
                <text class="text-body merchant-flow-page__label">质保期限</text>
                <textarea
                  class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                  placeholder="例：1 年或 5000 公里，以先到为准"
                  value="{{warrantyPeriod}}"
                  maxlength="120"
                  auto-height="{{true}}"
                  data-field="warrantyPeriod"
                  disabled="{{readOnly}}"
                  bindinput="onWarrantyFieldInput"
                />
                <text class="text-body merchant-flow-page__label">注意事项</text>
                <textarea
                  class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                  placeholder="例：仅限本次已确认项目；外力撞击、涉水除外"
                  value="{{warrantyNotes}}"
                  maxlength="300"
                  auto-height="{{true}}"
                  data-field="warrantyNotes"
                  disabled="{{readOnly}}"
                  bindinput="onWarrantyFieldInput"
                />
              </view>
              <view wx:if="{{!readOnly}}" class="merchant-flow-page__doc-actions">
                <view
                  wx:if="{{aiReview.isWaiting}}"
                  class="merchant-flow-page__ai-status"
                >
                  <view class="merchant-flow-page__ai-status-spin"></view>
                  <text class="merchant-flow-page__ai-status-text">{{aiReview.waitHint}}</text>
                </view>
                <block wx:if="{{!confirmAwaitingOwner}}">
                  <view class="stage-bar-only">
                    <ui-button
                      type="primary"
                      block="{{true}}"
                      loading="{{confirming}}"
                      disabled="{{notifyConfirmDisabled}}"
                      bind:btntap="onSendForOwnerConfirm"
                    >发送车主确认</ui-button>
                  </view>
                </block>
                <block wx:else>
                  <text class="text-caption text-secondary merchant-flow-page__await-hint">等车主确认交车</text>
                  <ui-button
                    type="secondary"
                    block="{{true}}"
                    loading="{{confirming}}"
                    bind:btntap="onProxyConfirm"
                  >代车主确认</ui-button>
                </block>
              </view>
            </block>
          </view>
      </scroll-view>
      <view wx:if="{{stageBoard}}" class="st-bar">
        <view class="st-bar__btn" bindtap="onOpenRecordPreview">预览记录</view>
        <view wx:if="{{stagePrimary}}" class="st-bar__btn st-bar__btn--go" bindtap="onStagePrimary">{{stagePrimary}}</view>
      </view>
    </view>
    <view wx:if="{{recordPreview}}" class="rec-preview" catchtouchmove="true">
      <view class="rec-preview__bar" style="padding-top: {{statusBarHeight}}px;">
        <view class="rec-preview__row" style="padding-right: {{capsulePad}}px;">
          <text class="ov-back" catchtap="onCloseRecordPreview">‹</text>
          <view class="ov-nav__text">
            <text class="ov-kicker">提交前确认</text>
            <text class="ov-work__title">节点记录预览</text>
          </view>
        </view>
      </view>
      <scroll-view scroll-y class="rec-preview__body" show-scrollbar="{{false}}">
        <view class="rec-preview__note">这是车主将看到的记录</view>
        <view class="rec-preview__card">
          <view class="doc-brief__store">
            <text class="doc-brief__mark">{{recordPreview.mark}}</text>
            <view class="doc-brief__store-text">
              <text class="doc-brief__store-name">{{recordPreview.storeName}}</text>
              <text class="doc-brief__store-sub">全程留证</text>
            </view>
            <text wx:if="{{recordPreview.status}}" class="doc-brief__pill doc-brief__pill--live">{{recordPreview.status}}</text>
          </view>
          <text class="rec-preview__title">{{recordPreview.title}}</text>
          <view wx:if="{{recordPreview.plate || recordPreview.model}}" class="doc-brief__row">
            <text>车辆</text>
            <text>{{recordPreview.plate}}{{recordPreview.model ? ' · ' : ''}}{{recordPreview.model}}</text>
          </view>
          <view wx:if="{{recordPreview.summary}}" class="rec-preview__block">
            <text class="rec-preview__label">节点说明</text>
            <text class="rec-preview__copy">{{recordPreview.summary}}</text>
          </view>
          <view wx:if="{{recordPreview.facts.length}}" class="rec-preview__block">
            <text class="rec-preview__label">关键数据</text>
            <view wx:for="{{recordPreview.facts}}" wx:key="label" class="doc-brief__row">
              <text>{{item.label}}</text>
              <text>{{item.value}}</text>
            </view>
          </view>
          <view wx:if="{{recordPreview.photos.length}}" class="rec-preview__block">
            <text class="rec-preview__label">现场留证</text>
            <view class="rec-preview__photos">
              <image
                wx:for="{{recordPreview.photos}}"
                wx:key="url"
                src="{{item.url}}"
                mode="aspectFill"
                data-url="{{item.url}}"
                bindtap="onPreviewStagePhoto"
              />
            </view>
          </view>
          <view wx:if="{{recordPreview.advice}}" class="rec-preview__block">
            <text class="rec-preview__label">AI 技师意见</text>
            <text class="rec-preview__copy">{{recordPreview.advice}}</text>
          </view>
          <view class="rec-preview__seal">确认后按确认时间留存</view>
          <view class="rec-preview__scope">
            <text>车主可见</text>
            <text>节点说明、关键数据、留证照片、技师意见</text>
          </view>
          <view class="rec-preview__scope">
            <text>隐私已保护</text>
            <text>内部备注不在这份记录里</text>
          </view>
        </view>
      </scroll-view>
      <view class="st-bar">
        <view class="st-bar__btn" catchtap="onCloseRecordPreview">返回修改</view>
        <view class="st-bar__btn st-bar__btn--go" catchtap="onConfirmRecordPreview">确认记录内容</view>
      </view>
    </view>
    <view wx:if="{{doneView}}" class="ov-work ov-work--top">
      <view class="ov-work__bar" style="padding-top: {{statusBarHeight}}px;">
        <view class="ov-work__row" style="padding-right: {{capsulePad}}px;">
          <text class="ov-back" bindtap="onCloseDone">‹</text>
          <text class="ov-work__title">{{doneView.title}}</text>
        </view>
      </view>
      <scroll-view scroll-y class="ov-work__body" show-scrollbar="{{false}}">
        <service-doc-sheet wx:if="{{doneView.mode === 'doc'}}" doc="{{doneView.sheetDoc}}" mode="merchant" />
        <view wx:else class="ov-done">
          <text wx:if="{{doneView.complaint}}" class="ov-done__line">{{doneView.complaint}}</text>
          <view wx:if="{{doneView.images.length}}" class="ov-done__photos">
            <image
              wx:for="{{doneView.images}}"
              wx:key="url"
              class="ov-done__photo"
              src="{{item.url}}"
              mode="aspectFill"
              data-url="{{item.url}}"
              bindtap="onPreviewDonePhoto"
            />
          </view>
          <text class="ov-done__count">共 {{doneView.photoCount}} 张</text>
        </view>
      </scroll-view>
    </view>
  </block>

  <view wx:if="{{showLibrary}}" class="merchant-flow-page__library-mask" catchtouchmove="true" bindtap="onCloseLibrary">
    <view class="merchant-flow-page__library" catchtap="onLibraryPanelTap">
      <view class="merchant-flow-page__library-head">
        <text class="text-h3">本单图库</text>
        <text class="text-caption text-secondary" catchtap="onCloseLibrary">关闭</text>
      </view>
      <scroll-view scroll-y class="merchant-flow-page__library-list">
        <view wx:if="{{libraryBusy}}" class="text-caption text-secondary merchant-flow-page__library-empty">加载中</view>
        <view wx:elif="{{!libraryItems.length}}" class="text-caption text-secondary merchant-flow-page__library-empty">这本相册还没有图</view>
        <view
          wx:for="{{libraryItems}}"
          wx:for-item="shot"
          wx:key="url"
          class="merchant-flow-page__library-row {{shot.picked ? 'is-picked' : ''}} {{shot.inPending ? 'is-used' : ''}}"
          data-url="{{shot.url}}"
          bindtap="onToggleLibraryItem"
        >
          <image class="merchant-flow-page__library-thumb image-placeholder" src="{{shot.url}}" mode="aspectFill" />
          <view class="merchant-flow-page__library-meta">
            <text class="text-caption">{{shot.metaLine}}</text>
            <text wx:if="{{shot.note}}" class="text-caption text-secondary merchant-flow-page__library-note">{{shot.note}}</text>
            <text wx:if="{{shot.inPending}}" class="text-caption text-secondary">已选</text>
          </view>
        </view>
      </scroll-view>
      <ui-button type="primary" block="{{true}}" bind:btntap="onConfirmLibrary">选用</ui-button>
    </view>
  </view>

  <view wx:if="{{adviceOpen}}" class="merchant-flow-page__advice-mask" catchtouchmove="true" bindtap="onCloseAdvice">
    <view class="merchant-flow-page__advice" catchtap="onAdvicePanelTap">
      <view class="merchant-flow-page__advice-head">
        <text class="text-h3">AI意见</text>
        <text class="text-caption text-secondary" catchtap="onCloseAdvice">收起</text>
      </view>
      <scroll-view scroll-y class="merchant-flow-page__advice-body">
        <view wx:if="{{intakeAdvice.isWaiting || quoteAssist.isWaiting || (aiReview && aiReview.isWaiting)}}" class="merchant-flow-page__ai-status">
          <view class="merchant-flow-page__ai-status-spin"></view>
          <text class="merchant-flow-page__ai-status-text">正在出意见</text>
        </view>
        <block wx:elif="{{intakeAdvice.hasContent}}">
          <template is="intakeAdvicePanel" data="{{advice: intakeAdvice, askReadonly: false}}" />
        </block>
        <block wx:elif="{{quoteAssist.hasContent}}">
          <template is="quoteMerchantBrief" data="{{brief: quoteAssist}}" />
        </block>
        <block wx:elif="{{aiReview && aiReview.merchantBrief.hasContent}}">
          <template is="quoteMerchantBrief" data="{{brief: aiReview.merchantBrief}}" />
        </block>
        <view wx:else class="text-caption text-secondary">这次没有额外意见</view>
      </scroll-view>
    </view>
  </view>

  <flow-pick-sheet
    visible="{{showPickSheet}}"
    title="{{pickSheetTitle}}"
    groups="{{pickSheetGroups}}"
    extraTitle="{{pickSheetExtra}}"
    bind:close="onClosePickSheet"
    bind:pick="onPickSheetItem"
    bind:extra="onPickSheetExtra"
  />

  <view wx:if="{{docBrief}}" class="doc-brief" catchtouchmove="true">
    <view class="doc-brief__mask" bindtap="onCloseDoc"></view>
    <view class="doc-brief__sheet">
      <view class="doc-brief__top">
        <view>
          <text class="doc-brief__kicker">SERVICE DOCUMENT</text>
          <text class="doc-brief__title">{{docBrief.title}}</text>
          <text class="doc-brief__sub">{{docBrief.plate}}{{docBrief.vehicleName ? ' · ' : ''}}{{docBrief.vehicleName}}</text>
        </view>
        <text class="doc-brief__close" catchtap="onCloseDoc">×</text>
      </view>
      <view class="doc-brief__card">
        <view class="doc-brief__store">
          <text class="doc-brief__mark">{{docBrief.mark}}</text>
          <view class="doc-brief__store-text">
            <text class="doc-brief__store-name">{{docBrief.storeName || '本店'}}</text>
            <text class="doc-brief__store-sub">全程留证</text>
          </view>
          <text class="doc-brief__pill doc-brief__pill--{{docBrief.statusTone}}">{{docBrief.status}}</text>
        </view>
        <text class="doc-brief__doc-title">{{docBrief.title}}</text>
        <view wx:if="{{docBrief.vehicleLine}}" class="doc-brief__row">
          <text>车辆信息</text>
          <text>{{docBrief.vehicleLine}}</text>
        </view>
        <view wx:if="{{docBrief.serviceName}}" class="doc-brief__row">
          <text>服务项目</text>
          <text>{{docBrief.serviceName}}</text>
        </view>
        <view wx:if="{{docBrief.lines.length}}" class="doc-brief__lines">
          <view wx:for="{{docBrief.lines}}" wx:key="index" class="doc-brief__line">
            <view class="doc-brief__dot"></view>
            <text class="doc-brief__line-name">{{item.name}}</text>
            <text wx:if="{{item.amount}}" class="doc-brief__line-amount">{{item.amount}}</text>
          </view>
        </view>
        <text wx:elif="{{docBrief.emptyText}}" class="doc-brief__empty">{{docBrief.emptyText}}</text>
        <view wx:if="{{docBrief.totalText}}" class="doc-brief__total">
          <text>合计</text>
          <text>{{docBrief.totalText}}</text>
        </view>
        <view wx:if="{{docBrief.sealed}}" class="doc-brief__seal">全流程影像已存证 · 数据不可篡改</view>
      </view>
      <view class="doc-brief__actions">
        <view class="doc-brief__send" catchtap="onBriefSend">{{briefSending ? '发送中' : '发送车主'}}</view>
        <view class="doc-brief__full" catchtap="onBriefFull">查看完整文件</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showCancelAddonModal}}" class="merchant-flow-page__modal-mask" catchtouchmove="true">
    <view class="merchant-flow-page__modal">
      <text class="text-h3">取消本项</text>
      <text class="text-caption text-secondary merchant-flow-page__modal-hint">已发给车主，取消后车主可见原因，并回到施工。</text>
      <textarea
        class="merchant-flow-page__textarea merchant-flow-page__textarea--short"
        placeholder="例：沟通后暂不增加 / 误点入口"
        maxlength="200"
        auto-height="{{true}}"
        value="{{cancelAddonReason}}"
        bindinput="onCancelAddonReasonInput"
      />
      <view class="merchant-flow-page__modal-actions">
        <ui-button type="ghost" block="{{true}}" bind:btntap="onCloseCancelAddonModal">返回</ui-button>
        <ui-button type="primary" block="{{true}}" loading="{{confirming}}" bind:btntap="onConfirmCancelAddon">确认取消</ui-button>
      </view>
    </view>
  </view>
</view>

                  maxlength="300"
                  auto-height="{{true}}"
                  data-field="warrantyNotes"
                  disabled="{{readOnly}}"
                  bindinput="onWarrantyFieldInput"
                />
              </view>
              <view wx:if="{{!readOnly}}" class="merchant-flow-page__doc-actions">
                <view
                  wx:if="{{aiReview.isWaiting}}"
                  class="merchant-flow-page__ai-status"
                >
                  <view class="merchant-flow-page__ai-status-spin"></view>
                  <text class="merchant-flow-page__ai-status-text">{{aiReview.waitHint}}</text>
                </view>
                <template is="aiTextBatchBar" data="{{aiTextBatchCanApply, aiTextBatchCanUndo}}" />
                <block wx:if="{{!confirmAwaitingOwner}}">
                  <ui-button
                    type="primary"
                    block="{{true}}"
                    loading="{{confirming}}"
                    disabled="{{notifyConfirmDisabled}}"
                    bind:btntap="onSendForOwnerConfirm"
                  >发送车主确认</ui-button>
                </block>
                <block wx:else>
                  <text class="text-caption text-secondary merchant-flow-page__await-hint">等待车主确认</text>
                  <ui-button
                    type="secondary"
                    block="{{true}}"
                    loading="{{confirming}}"
                    bind:btntap="onProxyConfirm"
                  >代车主确认</ui-button>
                </block>
              </view>
            </block>
          </view>
        </flow-stepper>

        <view wx:if="{{!readOnly && needManualComplete}}" class="merchant-flow-page__footer-actions">
          <ui-button
            type="primary"
            block="{{true}}"
            loading="{{completing}}"
            bind:btntap="onCompleteAlbum"
          >标记整单完工</ui-button>
        </view>

        <view wx:if="{{showHostEntry}}" class="merchant-flow-page__footer-actions">
          <ui-button
            type="primary"
            block="{{true}}"
            bind:btntap="onGoHostAlbum"
          >{{hosted ? (hostVisibility === 'public' ? '管理托管' : '管理托管') : '托管到案例站'}}</ui-button>
        </view>
      </view>
  </block>

  <view wx:if="{{showLibrary}}" class="merchant-flow-page__library-mask" catchtouchmove="true" bindtap="onCloseLibrary">
    <view class="merchant-flow-page__library" catchtap="onLibraryPanelTap">
      <view class="merchant-flow-page__library-head">
        <text class="text-h3">本单图库</text>
        <text class="text-caption text-secondary" catchtap="onCloseLibrary">关闭</text>
      </view>
      <scroll-view scroll-y class="merchant-flow-page__library-list">
        <view wx:if="{{libraryBusy}}" class="text-caption text-secondary merchant-flow-page__library-empty">加载中</view>
        <view wx:elif="{{!libraryItems.length}}" class="text-caption text-secondary merchant-flow-page__library-empty">这本相册还没有图</view>
        <view
          wx:for="{{libraryItems}}"
          wx:for-item="shot"
          wx:key="url"
          class="merchant-flow-page__library-row {{shot.picked ? 'is-picked' : ''}} {{shot.inPending ? 'is-used' : ''}}"
          data-url="{{shot.url}}"
          bindtap="onToggleLibraryItem"
        >
          <image class="merchant-flow-page__library-thumb image-placeholder" src="{{shot.url}}" mode="aspectFill" />
          <view class="merchant-flow-page__library-meta">
            <text class="text-caption">{{shot.metaLine}}</text>
            <text wx:if="{{shot.note}}" class="text-caption text-secondary merchant-flow-page__library-note">{{shot.note}}</text>
            <text wx:if="{{shot.inPending}}" class="text-caption text-secondary">已选</text>
          </view>
        </view>
      </scroll-view>
      <ui-button type="primary" block="{{true}}" bind:btntap="onConfirmLibrary">选用</ui-button>
    </view>
  </view>

  <view wx:if="{{showAssignSheet}}" class="merchant-flow-page__library-mask" catchtouchmove="true" bindtap="onCloseAssignSheet">
    <view class="merchant-flow-page__library" catchtap="onLibraryPanelTap">
      <view class="merchant-flow-page__library-head">
        <text class="text-h3">归入哪一项</text>
        <text class="text-caption text-secondary" catchtap="onCloseAssignSheet">关闭</text>
      </view>
      <scroll-view scroll-y class="merchant-flow-page__library-list">
        <view
          wx:for="{{assignTargets}}"
          wx:for-item="row"
          wx:key="index"
          class="merchant-flow-page__assign-row"
          data-finding-index="{{row.index}}"
          bindtap="onPickAssignTarget"
        >
          <text class="text-body">{{row.title}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{showCancelAddonModal}}" class="merchant-flow-page__modal-mask" catchtouchmove="true">
    <view class="merchant-flow-page__modal">
      <text class="text-h3">取消本项</text>
      <text class="text-caption text-secondary merchant-flow-page__modal-hint">已发给车主，取消后车主可见原因，并回到施工。</text>
      <textarea
        class="merchant-flow-page__textarea merchant-flow-page__textarea--short"
        placeholder="例：沟通后暂不增加 / 误点入口"
        maxlength="200"
        auto-height="{{true}}"
        value="{{cancelAddonReason}}"
        bindinput="onCancelAddonReasonInput"
      />
      <view class="merchant-flow-page__modal-actions">
        <ui-button type="ghost" block="{{true}}" bind:btntap="onCloseCancelAddonModal">返回</ui-button>
        <ui-button type="primary" block="{{true}}" loading="{{confirming}}" bind:btntap="onConfirmCancelAddon">确认取消</ui-button>
      </view>
    </view>
  </view>
</view>

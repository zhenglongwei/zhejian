<view class="page merchant-flow-page">
  <block wx:if="{{status === 'loading'}}">
    <view class="page-content merchant-flow-page__pad">
      <ui-skeleton rows="{{4}}" title="{{true}}" />
      <ui-skeleton rows="{{6}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty title="无法加载服务进度" description="{{errorMessage}}" actionText="重试" bind:action="onRetry" />
    </view>
  </block>

  <block wx:else>
    <scroll-view scroll-y class="merchant-flow-page__scroll" show-scrollbar="{{false}}">
      <view class="page-content merchant-flow-page__body">
        <view class="merchant-flow-page__hero">
          <view class="merchant-flow-page__hero-top">
            <text class="text-h3">{{serviceName}}</text>
            <ui-tag variant="{{statusVariant}}" text="{{statusLabel}}" />
          </view>
          <text wx:if="{{progressLabel}}" class="merchant-flow-page__progress text-caption">{{progressLabel}}</text>
        </view>

        <view wx:if="{{completedSteps.length}}" class="merchant-flow-page__done-block">
          <text class="merchant-flow-page__section-title text-caption">已完成</text>
          <ui-card shadow="{{true}}" padding="{{true}}">
            <ui-timeline steps="{{completedSteps}}" compact="{{true}}" />
          </ui-card>
        </view>

        <block wx:if="{{activeNode}}">
          <view class="merchant-flow-page__active-block">
            <text class="merchant-flow-page__section-title text-caption">当前步骤</text>
            <ui-card shadow="{{true}}" padding="{{true}}" class="merchant-flow-page__active-card">
              <view class="merchant-flow-page__active-head">
                <text class="text-h3">{{activeNode.title}}</text>
                <ui-tag variant="{{activeNode.isPhoto ? 'info' : 'warning'}}" text="{{activeNode.isPhoto ? '拍照' : '单据'}}" />
              </view>
              <text wx:if="{{activeNode.description}}" class="text-caption text-secondary merchant-flow-page__active-desc">
                {{activeNode.description}}
              </text>
              <text class="text-body merchant-flow-page__active-summary">{{activeNode.summary}}</text>
              <view wx:if="{{activeNode.previewImages.length}}" class="merchant-flow-page__thumbs">
                <image
                  wx:for="{{activeNode.previewImages}}"
                  wx:for-item="thumb"
                  wx:key="url"
                  class="merchant-flow-page__thumb image-placeholder"
                  src="{{thumb.url}}"
                  mode="aspectFill"
                />
              </view>
              <ui-button
                wx:if="{{!readOnly}}"
                class="merchant-flow-page__cta"
                type="primary"
                text="{{activeNode.ctaText || '继续填写'}}"
                bind:tap="onOpenActive"
              />
            </ui-card>
          </view>
          <view wx:if="{{lockedHint}}" class="merchant-flow-page__lock-hint">
            <text class="text-caption text-secondary">{{lockedHint}}</text>
          </view>
        </block>

        <block wx:elif="{{allDone}}">
          <ui-card shadow="{{true}}" padding="{{true}}">
            <text class="text-body">全部步骤已完成，可标记整单完工或继续补充材料。</text>
          </ui-card>
        </block>

        <view class="merchant-flow-page__actions">
          <ui-button
            wx:if="{{!readOnly && (allDone || completedSteps.length)}}"
            type="primary"
            text="标记整单完工"
            loading="{{completing}}"
            disabled="{{completing}}"
            bind:tap="onCompleteAlbum"
          />
          <ui-button type="ghost" text="高级编辑（旧版）" bind:tap="onOpenLegacyEdit" />
        </view>
      </view>
    </scroll-view>
  </block>
</view>

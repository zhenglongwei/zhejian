<template name="quoteMerchantBrief">
  <view wx:if="{{brief.hasContent}}" class="merchant-flow-page__quote-brief">
    <view wx:if="{{brief.hasQuoteRefs}}" class="merchant-flow-page__quote-brief-sec">
      <text class="merchant-flow-page__quote-brief-sec-title">报价参考</text>
      <view wx:for="{{brief.quoteRefs}}" wx:key="lineIndex" class="merchant-flow-page__quote-brief-card">
        <view class="merchant-flow-page__quote-brief-item-title-row">
          <text class="merchant-flow-page__quote-brief-item-title">{{item.name}}</text>
          <text wx:if="{{item.optional}}" class="text-caption merchant-flow-page__quote-optional">可由车主选择</text>
          <text
            wx:if="{{item.canApply}}"
            class="merchant-flow-page__advice-apply"
            data-source="ref"
            data-index="{{item.lineIndex}}"
            catchtap="onApplyQuoteAssistLine"
          >应用</text>
          <text wx:elif="{{item.applied}}" class="merchant-flow-page__advice-state">已应用</text>
        </view>
        <view wx:if="{{item.hasChips}}" class="merchant-flow-page__plan-bands">
          <view wx:for="{{item.bandChips}}" wx:for-item="chip" wx:key="key" class="merchant-flow-page__plan-band">
            <text class="merchant-flow-page__plan-band-k">{{chip.k}}</text>
            <text class="merchant-flow-page__plan-band-v">{{chip.v}}</text>
          </view>
        </view>
        <text wx:if="{{item.reason}}" class="merchant-flow-page__quote-brief-item-body">{{item.reason}}</text>
      </view>
    </view>
    <view wx:if="{{brief.hasOmissions}}" class="merchant-flow-page__quote-brief-sec">
      <text class="merchant-flow-page__quote-brief-sec-title">建议补充</text>
      <view wx:for="{{brief.omissions}}" wx:key="index" class="merchant-flow-page__quote-brief-card">
        <view class="merchant-flow-page__quote-brief-item-title-row">
          <text wx:if="{{item.hasTitle}}" class="merchant-flow-page__quote-brief-item-title">{{item.title}}</text>
          <text
            wx:if="{{item.canApply}}"
            class="merchant-flow-page__advice-apply"
            data-source="omission"
            data-index="{{item.index}}"
            catchtap="onApplyQuoteAssistLine"
          >应用</text>
          <text wx:elif="{{item.applied}}" class="merchant-flow-page__advice-state">已应用</text>
        </view>
        <text wx:if="{{item.hasBody}}" class="merchant-flow-page__quote-brief-item-body">{{item.body}}</text>
      </view>
    </view>
  </view>
</template>
<template name="intakeAdvicePanel">
  <view wx:if="{{advice.noPhotos}}" class="merchant-flow-page__advice-sec">
    <text class="merchant-flow-page__advice-lead">还没有车身照片，先拍车头、车尾、左右</text>
  </view>
  <view wx:elif="{{advice.covered && !advice.hasRisks}}" class="merchant-flow-page__advice-sec">
    <text class="merchant-flow-page__advice-lead">车身四周都拍到了</text>
  </view>
  <view wx:if="{{advice.hasRisks}}" class="merchant-flow-page__advice-sec">
    <text class="merchant-flow-page__advice-sec-title">还缺这些</text>
    <view wx:for="{{advice.risks}}" wx:key="seq" class="merchant-flow-page__advice-ask">
      <text wx:if="{{item.hasTitle}}" class="merchant-flow-page__advice-ask-title">{{item.title}}</text>
      <text wx:if="{{item.hasBody}}" class="merchant-flow-page__advice-ask-body">{{item.body}}</text>
    </view>
  </view>
</template>
<template name="workAdvicePanel">
  <view wx:if="{{advice.hasNote}}" class="merchant-flow-page__advice-sec">
    <text class="merchant-flow-page__advice-lead">{{advice.note}}</text>
  </view>
  <view wx:if="{{advice.hasGaps}}" class="merchant-flow-page__advice-sec">
    <text class="merchant-flow-page__advice-sec-title">和报价不一致</text>
    <view wx:for="{{advice.gaps}}" wx:key="seq" class="merchant-flow-page__advice-ask">
      <text wx:if="{{item.hasTitle}}" class="merchant-flow-page__advice-ask-title">{{item.title}}</text>
      <text wx:if="{{item.hasBody}}" class="merchant-flow-page__advice-ask-body">{{item.body}}</text>
      <text class="text-caption text-secondary">{{item.actionLabel}}</text>
    </view>
  </view>
</template>
<template name="deliveryAdvicePanel">
  <view wx:if="{{advice.repairBrief}}" class="merchant-flow-page__advice-sec">
    <view class="merchant-flow-page__advice-row">
      <view class="merchant-flow-page__advice-row-main">
        <text class="merchant-flow-page__advice-sec-title">本次维修简述</text>
        <text class="merchant-flow-page__advice-ask-body">{{advice.repairBrief}}</text>
      </view>
      <text
        wx:if="{{advice.canApplyBrief}}"
        class="merchant-flow-page__advice-apply"
        data-kind="brief"
        catchtap="onApplyDeliveryAdvice"
      >应用</text>
      <text wx:elif="{{advice.briefApplied}}" class="merchant-flow-page__advice-state">已应用</text>
    </view>
  </view>
  <view wx:if="{{advice.ownerFaqs.length}}" class="merchant-flow-page__advice-sec">
    <view class="merchant-flow-page__advice-row">
      <text class="merchant-flow-page__advice-sec-title">车主关心的问题</text>
      <text
        wx:if="{{advice.canApplyFaqs}}"
        class="merchant-flow-page__advice-apply"
        data-kind="faqs"
        catchtap="onApplyDeliveryAdvice"
      >应用</text>
      <text wx:elif="{{advice.faqsApplied}}" class="merchant-flow-page__advice-state">已应用</text>
    </view>
    <view wx:for="{{advice.ownerFaqs}}" wx:key="id" class="merchant-flow-page__advice-ask">
      <text class="merchant-flow-page__advice-ask-title">{{item.question}}</text>
      <text wx:if="{{item.answer}}" class="merchant-flow-page__advice-ask-body">{{item.answer}}</text>
    </view>
  </view>
  <view wx:if="{{advice.hasTips}}" class="merchant-flow-page__advice-sec">
    <text class="merchant-flow-page__advice-sec-title">本步提醒</text>
    <view wx:for="{{advice.tips}}" wx:key="id" class="merchant-flow-page__advice-ask">
      <text wx:if="{{item.hasTitle}}" class="merchant-flow-page__advice-ask-title">{{item.title}}</text>
      <text wx:if="{{item.hasBody}}" class="merchant-flow-page__advice-ask-body">{{item.body}}</text>
    </view>
  </view>
</template>
<template name="aiFieldHint"></template>
<view class="page merchant-flow-page">
  <block wx:if="{{status === 'loading'}}">
    <view class="page-content merchant-flow-page__pad">
      <ui-skeleton rows="{{4}}" title="{{true}}" />
      <ui-skeleton rows="{{6}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty title="无法加载服务进度" description="{{errorMessage}}" actionText="重试" bind:action="onRetry" />
    </view>
  </block>

  <block wx:else>
    <block wx:if="{{showOverview && overview}}">
      <view class="ov" style="padding-top: {{statusBarHeight}}px;">
        <view class="ov-nav" style="padding-right: {{capsulePad}}px;">
          <text class="ov-back" bindtap="onOverviewBack">‹</text>
          <view class="ov-nav__text">
            <text class="ov-kicker">服务相册详情</text>
            <text class="ov-plate">{{overview.plate}}</text>
          </view>
        </view>

        <view class="ov-hero">
          <text class="ov-pill ov-pill--{{overview.pill.tone}}">{{overview.pill.text}}</text>
          <text class="ov-hero__name">{{overview.vehicleName}}</text>
          <text wx:if="{{overview.spec}}" class="ov-hero__spec">{{overview.spec}}</text>
          <text wx:if="{{overview.meta}}" class="ov-hero__meta">{{overview.meta}}</text>
        </view>

        <view class="ov-docs">
          <view
            wx:for="{{overview.docs}}"
            wx:key="title"
            class="ov-doc ov-doc--{{item.tone}}"
            data-title="{{item.title}}"
            bindtap="onOpenDoc"
          >
            <view class="ov-doc__icon">
              <image wx:if="{{item.tone === 'ok'}}" src="/assets/mch/check-blue.png" mode="aspectFit" />
              <image wx:elif="{{item.tone === 'live'}}" src="/assets/mch/doc-blue.png" mode="aspectFit" />
              <image wx:else src="/assets/mch/clock-gray.png" mode="aspectFit" />
            </view>
            <text class="ov-doc__name">{{item.title}}</text>
            <text class="ov-doc__label">{{item.label}}</text>
          </view>
        </view>

        <view class="ov-sec">
          <text class="ov-sec__kicker">全过程留证</text>
          <view class="ov-sec__row">
            <text class="ov-sec__title">服务时间线</text>
            <view class="ov-sec__count">
              <image src="/assets/mch/tab-albums.png" mode="aspectFit" />
              <text>{{overview.records}} 份记录</text>
            </view>
          </view>
        </view>

        <view class="ov-line">
          <view wx:for="{{overview.timelineRows}}" wx:key="key" class="ov-row ov-row--{{item.state}}">
            <view class="ov-row__rail">
              <view class="ov-row__dot">
                <image wx:if="{{item.state === 'done'}}" src="/assets/mch/check-white.png" mode="aspectFit" />
                <text wx:else>{{item.index}}</text>
              </view>
              <view wx:if="{{index < overview.timelineRows.length - 1}}" class="ov-row__bar" />
            </view>
            <view class="ov-row__main" data-id="{{item.nodeId}}" data-state="{{item.state}}" bindtap="onOpenOverview">
              <view class="ov-row__head">
                <text class="ov-row__title">{{item.title}}</text>
                <text class="ov-row__mark">{{item.mark}}</text>
              </view>
              <text class="ov-row__detail">{{item.detail}}</text>
              <view
                wx:if="{{item.advice}}"
                class="ov-advice"
                catchtap="onOpenStepAdvice"
                data-id="{{item.nodeId}}"
              >
                <view class="ov-advice__mark">
                  <image src="/assets/mch/spark-white.png" mode="aspectFit" />
                </view>
                <view class="ov-advice__body">
                  <text class="ov-advice__kicker">AI 技师意见</text>
                  <text class="ov-advice__text">{{item.advice}}</text>
                </view>
              </view>
              <view wx:if="{{item.shots.length || item.canAddShot}}" class="ov-shots">
                <view wx:for="{{item.shots}}" wx:for-item="shot" wx:key="url" class="ov-shot">
                  <image src="{{shot.url}}" mode="aspectFill" />
                  <text wx:if="{{shot.caption}}" class="ov-shot__cap">{{shot.caption}}</text>
                </view>
                <view
                  wx:if="{{item.canAddShot}}"
                  class="ov-shot ov-shot--add"
                  data-id="{{item.nodeId}}"
                  data-state="current"
                  catchtap="onOpenOverview"
                >
                  <image src="/assets/mch/camera-gray.png" mode="aspectFit" />
                  <text>添加留证</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{!readOnly && needManualComplete}}" class="ov-extra">
          <ui-button
            type="primary"
            block="{{true}}"
            loading="{{completing}}"
            bind:btntap="onCompleteAlbum"
          >标记整单完工</ui-button>
        </view>
        <view wx:if="{{showHostEntry}}" class="ov-extra">
          <ui-button
            type="primary"
            block="{{true}}"
            bind:btntap="onGoHostAlbum"
          >{{hosted ? '管理托管' : '托管到案例站'}}</ui-button>
        </view>

        <view class="ov-foot">
          <view class="ov-call" bindtap="onCallOwner">
            <image src="/assets/mch/phone-ink.png" mode="aspectFit" />
            <text>联系车主</text>
          </view>
          <view
            wx:if="{{overview.action}}"
            class="ov-go"
            data-id="{{overview.actionId}}"
            data-state="current"
            bindtap="onOpenOverview"
          >
            <image wx:if="{{overview.action === '补充施工记录'}}" src="/assets/mch/plus-white.png" mode="aspectFit" />
            <text>{{overview.action}}</text>
          </view>
        </view>
      </view>
    </block>
    <view wx:if="{{workOpen}}" class="ov-work">
      <view class="ov-work__bar" style="padding-top: {{statusBarHeight}}px;">
        <view class="ov-work__row" style="padding-right: {{capsulePad}}px;">
          <text class="ov-back" bindtap="onCloseWork">‹</text>
          <view class="ov-nav__text">
            <text class="ov-kicker">服务节点详情</text>
            <text class="ov-work__title">{{stageBoard.title}}</text>
          </view>
        </view>
      </view>
      <scroll-view wx:if="{{stageBoard}}" scroll-x class="st-tabs" show-scrollbar="{{false}}">
        <view class="st-tabs__row">
        <view
          wx:for="{{stageBoard.tabs}}"
          wx:key="key"
          class="st-tab st-tab--{{item.mark}}"
          data-key="{{item.key}}"
          bindtap="onPickStage"
        >
          <view class="st-tab__dot">
            <image wx:if="{{item.mark === 'before'}}" src="/assets/mch/check-white.png" mode="aspectFit" />
            <text wx:else>{{item.index}}</text>
          </view>
          <text class="st-tab__name">{{item.short}}</text>
        </view>
        </view>
      </scroll-view>
      <scroll-view scroll-y="{{!complaintFocus}}" class="ov-work__body ov-work__body--bar" show-scrollbar="{{false}}">
          <view wx:if="{{stageBoard}}" class="st-vehicle">
            <view class="st-vehicle__icon"><image src="/assets/mch/car-blue.png" mode="aspectFit" /></view>
            <view class="st-vehicle__text">
              <text class="st-vehicle__plate">{{stageBoard.vehicle.plate}}</text>
              <text class="st-vehicle__line">{{stageBoard.vehicle.line}}</text>
            </view>
            <text class="st-pill">{{stageBoard.vehicle.pill}}</text>
          </view>

          <block wx:if="{{stageBoard.intake}}">
            <view class="st-card">
              <view class="st-card__head">
                <view>
                  <text class="st-kicker">VEHICLE CONDITION</text>
                  <text class="st-card__title">车辆入店留证</text>
                  <text class="st-card__hint">里程表、油量表、环车外观、灯光、随车物品、轮胎</text>
                </view>
                <view wx:if="{{intakePile.length}}" class="st-count">
                  <image src="/assets/mch/camera-gray.png" mode="aspectFit" />
                  <text class="st-count__text">{{intakePile.length}}张</text>
                </view>
              </view>
              <view class="st-photos st-photos--intake">
                <view
                  wx:for="{{intakePile}}"
                  wx:key="url"
                  class="st-photo"
                  data-url="{{item.url}}"
                  data-index="{{index}}"
                  bindtap="onPreviewStagePhoto"
                >
                  <image src="{{item.url}}" mode="aspectFill" />
                  <text class="st-photo__cap">{{item.caption}}</text>
                  <text class="st-photo__badge">已留证</text>
                  <view
                    wx:if="{{stageBoard.state === 'current' && !readOnly && !intakeSent}}"
                    class="st-photo__del"
                    data-url="{{item.url}}"
                    data-index="{{index}}"
                    catchtap="onRemoveIntakePhoto"
                  >×</view>
                </view>
                <view
                  wx:if="{{stageBoard.state === 'current' && !readOnly && !intakeSent}}"
                  class="st-photo st-photo--add"
                  bindtap="onIntakeShoot"
                >
                  <image src="/assets/mch/camera-gray.png" mode="aspectFit" />
                  <text>继续拍摄</text>
                </view>
              </view>
              <view wx:if="{{intakeDocStatus === 'pending_confirm'}}" class="st-note">
                <text class="st-note__body">待车主确认</text>
                <text wx:if="{{!readOnly}}" class="st-edit" catchtap="onProxyIntakeConfirm">代车主确认</text>
              </view>
              <view wx:elif="{{intakeDocStatus === 'confirmed' || intakeDocStatus === 'delivered'}}" class="st-note">
                <text class="st-note__body">已发给车主</text>
              </view>
              <view wx:if="{{stageBoard.intake.advice}}" class="st-note">
                <image src="/assets/mch/check-blue.png" mode="aspectFit" />
                <view>
                  <text class="st-note__title">AI 影像检查</text>
                  <text class="st-note__body">{{stageBoard.intake.advice}}</text>
                </view>
              </view>
            </view>
            <view wx:if="{{stageBoard.state === 'current' || stageBoard.intake.complaint || stageBoard.intake.cells.length}}" class="st-card">
              <view class="st-card__head">
                <view>
                  <text class="st-kicker">CUSTOMER REQUEST</text>
                  <text class="st-card__title">车主诉求</text>
                </view>
              </view>
              <textarea
                wx:if="{{stageBoard.state === 'current' && !readOnly && !intakeSent}}"
                class="st-quote-input"
                value="{{chiefComplaint}}"
                maxlength="300"
                auto-height="{{true}}"
                placeholder="车主怎么描述的"
                cursor-spacing="80"
                show-confirm-bar="{{false}}"
                bindfocus="onComplaintFocus"
                bindblur="onComplaintBlur"
                bindinput="onChiefComplaintInput"
              />
              <text wx:elif="{{stageBoard.intake.complaint || chiefComplaint}}" class="st-quote">“{{stageBoard.intake.complaint || chiefComplaint}}”</text>
              <text class="text-body merchant-flow-page__label">接车人</text>
              <input
                class="st-field"
                placeholder="例：李师傅"
                value="{{receiverName}}"
                data-key="receiverName"
                disabled="{{readOnly || intakeSent}}"
                bindinput="onClerkInput"
              />
              <text class="text-body merchant-flow-page__label">时间</text>
              <view class="st-field-row" wx:if="{{!readOnly && !intakeSent}}">
                <picker mode="date" value="{{receivedAtDate}}" data-key="receivedAt" data-part="date" bindchange="onClerkAtPick">
                  <view class="st-field st-field--picker">{{receivedAtDate || '选择日期'}}</view>
                </picker>
                <picker mode="time" value="{{receivedAtTime}}" data-key="receivedAt" data-part="time" bindchange="onClerkAtPick">
                  <view class="st-field st-field--picker">{{receivedAtTime || '选择时间'}}</view>
                </picker>
              </view>
              <text wx:else class="st-quote">{{receivedAt || '未填'}}</text>
              <view wx:if="{{stageBoard.intake.cells.length}}" class="st-grid">
                <view wx:for="{{stageBoard.intake.cells}}" wx:key="label">
                  <text>{{item.label}}</text>
                  <text>{{item.value}}</text>
                </view>
              </view>
            </view>
            <view wx:if="{{stageBoard.intake.confirmed}}" class="st-confirm">
              <image src="/assets/mch/check-green.png" mode="aspectFit" />
              <view>
                <text>{{stageBoard.intake.confirmed.title}}</text>
                <text wx:if="{{stageBoard.intake.confirmed.sub}}">{{stageBoard.intake.confirmed.sub}}</text>
              </view>
            </view>
            <view wx:if="{{stageBoard.intake.empty && stageBoard.state !== 'current'}}" class="st-empty">这一步还没有记录</view>
          </block>

          <block wx:if="{{stageBoard.inspect}}">
            <view class="st-hero st-hero--inspect">
              <text class="st-kicker st-kicker--light">检测</text>
            </view>
            <view class="st-card">
              <text class="text-body merchant-flow-page__label">检测人</text>
              <input
                wx:if="{{stageBoard.state === 'current' && !readOnly}}"
                class="st-field"
                placeholder="例：王师傅"
                value="{{inspectorName}}"
                data-key="inspectorName"
                bindinput="onClerkInput"
              />
              <text wx:else class="st-quote">{{stageBoard.inspect.inspectorName || '未填'}}</text>
              <text class="text-body merchant-flow-page__label">时间</text>
              <view class="st-field-row" wx:if="{{stageBoard.state === 'current' && !readOnly}}">
                <picker mode="date" value="{{inspectedAtDate}}" data-key="inspectedAt" data-part="date" bindchange="onClerkAtPick">
                  <view class="st-field st-field--picker">{{inspectedAtDate || '选择日期'}}</view>
                </picker>
                <picker mode="time" value="{{inspectedAtTime}}" data-key="inspectedAt" data-part="time" bindchange="onClerkAtPick">
                  <view class="st-field st-field--picker">{{inspectedAtTime || '选择时间'}}</view>
                </picker>
              </view>
              <text wx:else class="st-quote">{{stageBoard.inspect.inspectedAt || inspectedAt || '未填'}}</text>
            </view>
            <view wx:if="{{stageBoard.inspect.items.length && !isInspectionPhotoStep}}" class="st-card">
              <view class="st-card__head">
                <view>
                  <text class="st-kicker">ABNORMAL ITEMS</text>
                  <text class="st-card__title">异常项目</text>
                </view>
              </view>
              <view wx:for="{{stageBoard.inspect.items}}" wx:key="no" class="st-fault">
                <text class="st-fault__no st-fault__no--{{item.tone}}">{{item.no}}</text>
                <view class="st-fault__main">
                  <view class="st-fault__row">
                    <text class="st-fault__name">{{item.name}}</text>
                    <text class="st-pill st-pill--{{item.tone}}">{{item.tag}}</text>
                  </view>
                  <text wx:if="{{item.body}}" class="st-fault__body">{{item.body}}</text>
                  <view wx:if="{{item.shots.length}}" class="st-fault__shots">
                    <image wx:for="{{item.shots}}" wx:for-item="shot" wx:key="*this" src="{{shot}}" mode="aspectFill" data-url="{{shot}}" bindtap="onPreviewStagePhoto" />
                  </view>
                </view>
              </view>
            </view>
            <view wx:if="{{stageBoard.inspect.advice && !isInspectionPhotoStep && stageBoard.state !== 'current'}}" class="st-ai">
              <image src="/assets/mch/spark-white.png" mode="aspectFit" />
              <view>
                <text class="st-ai__title">AI 检测意见</text>
                <text class="st-ai__body">{{stageBoard.inspect.advice}}</text>
              </view>
            </view>
            <view wx:if="{{stageBoard.inspect.empty && !isInspectionPhotoStep && stageBoard.state !== 'current'}}" class="st-empty">这一步还没有记录</view>
          </block>

          <block wx:if="{{stageBoard.quote}}">
            <view wx:if="{{stageBoard.quote.amount || (stageEditor && activeKind === 'quote_confirm')}}" class="st-hero st-hero--quote">
              <text class="st-hero__label">{{stageBoard.quoteHeroLabel}}</text>
              <view class="st-figure"><text>¥</text><text>{{stageEditor && activeKind === 'quote_confirm' ? quoteHeroAmount : stageBoard.quote.amount}}</text></view>
              <text class="st-hero__sub">{{stageBoard.quoteHeroSub}}</text>
              <view wx:if="{{stageBoard.quote.note}}" class="st-hero__foot"><text>{{stageBoard.quote.note}}</text></view>
            </view>
            <view wx:if="{{stageEditor && activeKind === 'quote_confirm' && !isAddonQuote}}" class="st-card">
              <view class="st-card__head">
                <view>
                  <text class="st-kicker">QUOTE DETAILS</text>
                  <text class="st-card__title">报价明细</text>
                  <text wx:if="{{quoteDraftHint}}" class="st-card__hint">{{quoteDraftHint}}</text>
                </view>
              </view>
              <view wx:for="{{quoteLines}}" wx:key="lineKey" class="st-line">
                <view class="st-line__main">
                  <input
                    class="st-line__name-input"
                    placeholder="{{quoteJobPlaceholder}}"
                    value="{{item.name}}"
                    data-index="{{index}}"
                    data-field="name"
                    disabled="{{readOnly}}"
                    bindinput="onQuoteLineInput"
                  />
                  <input
                    class="st-line__brand-input"
                    placeholder="品牌"
                    value="{{item.brand}}"
                    data-index="{{index}}"
                    data-field="brand"
                    disabled="{{readOnly}}"
                    bindinput="onQuoteLineInput"
                  />
                  <view wx:if="{{item.hasBands}}" class="merchant-flow-page__plan-bands">
                    <view
                      wx:for="{{item.bandChips}}"
                      wx:for-item="chip"
                      wx:key="key"
                      class="merchant-flow-page__plan-band"
                    >
                      <text class="merchant-flow-page__plan-band-k">{{chip.k}}</text>
                      <text class="merchant-flow-page__plan-band-v">{{chip.v}}</text>
                    </view>
                  </view>
                  <template is="aiFieldHint" data="{{hint: item.nameHint}}" />
                </view>
                <view class="st-line__amt st-line__amt--edit">
                  <text>¥</text>
                  <input
                    class="st-line__amt-input"
                    placeholder="0"
                    type="digit"
                    value="{{item.amount}}"
                    data-index="{{index}}"
                    data-field="amount"
                    disabled="{{readOnly}}"
                    bindinput="onQuoteLineInput"
                  />
                </view>
                <text
                  wx:if="{{!readOnly}}"
                  class="st-line__remove"
                  data-index="{{index}}"
                  catchtap="onRemoveQuoteLine"
                >×</text>
              </view>
              <text wx:if="{{!readOnly}}" class="st-line__add" bindtap="onAddQuoteLine">+ 新增项目</text>
              <view class="st-line__sum">{{quoteTotalLabel}}</view>
            </view>
            <view wx:elif="{{stageBoard.quote.lines.length && !stageEditor}}" class="st-card">
              <view class="st-card__head">
                <view>
                  <text class="st-kicker">QUOTE DETAILS</text>
                  <text class="st-card__title">报价明细</text>
                </view>
              </view>
              <view wx:for="{{stageBoard.quote.lines}}" wx:key="name" class="st-line">
                <view>
                  <text class="st-line__name">{{item.name}}</text>
                  <text wx:if="{{item.brand}}" class="st-line__note">{{item.brand}}</text>
                </view>
                <text class="st-line__amt">{{item.amount}}</text>
              </view>
              <view class="st-line__sum">{{stageBoard.quote.totalText}}</view>
            </view>
            <view
              wx:if="{{(stageBoard.quote.discoveryNote || stageBoard.quote.discoveryPhotos.length) && !stageEditor}}"
              class="st-card"
            >
              <text class="st-card__title">新发现</text>
              <text wx:if="{{stageBoard.quote.discoveryNote}}" class="st-task__note">{{stageBoard.quote.discoveryNote}}</text>
              <view wx:if="{{stageBoard.quote.discoveryPhotos.length}}" class="st-fault__shots">
                <image
                  wx:for="{{stageBoard.quote.discoveryPhotos}}"
                  wx:key="*this"
                  src="{{item}}"
                  mode="aspectFill"
                  data-url="{{item}}"
                  bindtap="onPreviewStagePhoto"
                />
              </view>
            </view>
            <view wx:if="{{stageBoard.quote.advice}}" class="st-ai">
              <image src="/assets/mch/spark-white.png" mode="aspectFit" />
              <view>
                <text class="st-ai__title">AI 报价校验</text>
                <text class="st-ai__body">{{stageBoard.quote.advice}}</text>
              </view>
            </view>
            <view wx:if="{{stageBoard.quote.owner}}" class="st-owner">
              <view>
                <text>车主确认</text>
                <text>{{stageBoard.quote.owner.title}}</text>
                <text>{{stageBoard.quote.owner.sub}}</text>
              </view>
            </view>
            <view wx:if="{{stageBoard.quote.empty && stageBoard.state !== 'current'}}" class="st-empty">这一步还没有记录</view>
          </block>

          <block wx:if="{{stageBoard.work && !isWorkPhotoStep}}">
            <view class="st-hero st-hero--work">
              <text class="st-kicker st-kicker--light">WORK IN PROGRESS</text>
              <text class="st-hero__title">{{stageBoard.work.headline}}</text>
              <text wx:if="{{stageBoard.work.sub}}" class="st-hero__sub">{{stageBoard.work.sub}}</text>
            </view>
            <view class="st-card">
              <text class="text-body merchant-flow-page__label">施工人</text>
              <input
                wx:if="{{stageBoard.state === 'current' && !readOnly}}"
                class="st-field"
                placeholder="例：李师傅"
                value="{{workerName}}"
                data-key="workerName"
                bindinput="onClerkInput"
              />
              <text wx:else class="st-quote">{{stageBoard.work.workerName || '未填'}}</text>
              <text class="text-body merchant-flow-page__label">施工时间</text>
              <view class="st-field-row" wx:if="{{stageBoard.state === 'current' && !readOnly}}">
                <picker mode="date" value="{{workFinishedAtDate}}" data-key="workFinishedAt" data-part="date" bindchange="onClerkAtPick">
                  <view class="st-field st-field--picker">{{workFinishedAtDate || '选择日期'}}</view>
                </picker>
                <picker mode="time" value="{{workFinishedAtTime}}" data-key="workFinishedAt" data-part="time" bindchange="onClerkAtPick">
                  <view class="st-field st-field--picker">{{workFinishedAtTime || '选择时间'}}</view>
                </picker>
              </view>
              <text wx:else class="st-quote">{{workFinishedAt || '未填'}}</text>
            </view>
            <view wx:if="{{stageBoard.work.tasks.length}}" class="st-card">
              <view class="st-card__head">
                <view>
                  <text class="st-kicker">WORK ORDER</text>
                  <text class="st-card__title">工序记录</text>
                </view>
              </view>
              <view wx:for="{{stageBoard.work.tasks}}" wx:key="name" class="st-task">
                <text class="st-task__dot st-task__dot--{{item.tone}}"></text>
                <view>
                  <text class="st-task__name">{{item.name}}</text>
                  <text wx:if="{{item.note}}" class="st-task__note">{{item.note}}</text>
                  <view wx:if="{{item.shots.length}}" class="st-fault__shots">
                    <image
                      wx:for="{{item.shots}}"
                      wx:for-item="shot"
                      wx:key="*this"
                      src="{{shot}}"
                      mode="aspectFill"
                      data-url="{{shot}}"
                      bindtap="onPreviewStagePhoto"
                    />
                  </view>
                </view>
                <text class="st-pill st-pill--{{item.tone}}">{{item.status}}</text>
              </view>
            </view>
            <view wx:if="{{stageBoard.work.fault}}" class="st-faultbox">
              <text class="st-faultbox__title">{{stageBoard.work.fault.title}}</text>
              <text wx:if="{{stageBoard.work.fault.body}}" class="st-faultbox__body">{{stageBoard.work.fault.body}}</text>
              <text wx:if="{{stageBoard.work.fault.amount}}" class="st-faultbox__amt">补充报价 {{stageBoard.work.fault.amount}}</text>
            </view>
            <view wx:if="{{stageBoard.work.empty && stageBoard.state !== 'current'}}" class="st-empty">这一步还没有记录</view>
          </block>

          <block wx:if="{{stageBoard.finish && !isDeliveryPhotoStep && activeKind !== 'repair_report'}}">
            <view class="st-hero st-hero--finish">
              <text class="st-kicker st-kicker--light">READY FOR DELIVERY</text>
              <text class="st-hero__title">{{stageBoard.finish.headline}}</text>
              <text wx:if="{{stageBoard.finish.sub}}" class="st-hero__sub">{{stageBoard.finish.sub}}</text>
            </view>
            <view class="st-card">
              <text class="text-body merchant-flow-page__label">交付人</text>
              <input
                wx:if="{{stageBoard.state === 'current' && !readOnly}}"
                class="st-field"
                placeholder="例：李师傅"
                value="{{delivererName}}"
                data-key="delivererName"
                bindinput="onClerkInput"
              />
              <text wx:else class="st-quote">{{stageBoard.finish.delivererName || '未填'}}</text>
              <text class="text-body merchant-flow-page__label">完工时间</text>
              <view class="st-field-row" wx:if="{{stageBoard.state === 'current' && !readOnly}}">
                <picker mode="date" value="{{finishedAtDate}}" data-key="finishedAt" data-part="date" bindchange="onClerkAtPick">
                  <view class="st-field st-field--picker">{{finishedAtDate || '选择日期'}}</view>
                </picker>
                <picker mode="time" value="{{finishedAtTime}}" data-key="finishedAt" data-part="time" bindchange="onClerkAtPick">
                  <view class="st-field st-field--picker">{{finishedAtTime || '选择时间'}}</view>
                </picker>
              </view>
              <text wx:else class="st-quote">{{stageBoard.finish.finishedAt || finishedAt || '未填'}}</text>
            </view>
            <view wx:if="{{stageBoard.finish.before || stageBoard.finish.after}}" class="st-card">
              <view class="st-card__head">
                <view>
                  <text class="st-kicker">DELIVERY REPORT</text>
                  <text class="st-card__title">交车报告</text>
                </view>
              </view>
              <view class="st-compare">
                <view wx:if="{{stageBoard.finish.before}}" class="st-compare__shot" data-url="{{stageBoard.finish.before.url}}" bindtap="onPreviewStagePhoto">
                  <image src="{{stageBoard.finish.before.url}}" mode="aspectFill" />
                  <text>{{stageBoard.finish.before.caption}}</text>
                </view>
                <view wx:if="{{stageBoard.finish.after}}" class="st-compare__shot" data-url="{{stageBoard.finish.after.url}}" bindtap="onPreviewStagePhoto">
                  <image src="{{stageBoard.finish.after.url}}" mode="aspectFill" />
                  <text>{{stageBoard.finish.after.caption}}</text>
                </view>
              </view>
            </view>
            <view wx:if="{{stageBoard.finish.warranty}}" class="st-warranty">
              <text>本次服务保障</text>
              <text>{{stageBoard.finish.warranty}}</text>
            </view>
            <view class="st-steps">
              <view wx:for="{{stageBoard.finish.steps}}" wx:key="no" class="st-step {{item.done ? 'is-done' : ''}} {{item.muted ? 'is-muted' : ''}}">
                <text class="st-step__no">{{item.done ? '✓' : item.no}}</text>
                <view>
                  <text class="st-step__title">{{item.title}}</text>
                  <text class="st-step__sub">{{item.sub}}</text>
                </view>
              </view>
            </view>
          </block>

          <view wx:if="{{stageEditor}}" class="merchant-flow-page__active">
            <block wx:if="{{activeIsPhoto}}">
              <view wx:if="{{isIntakePhotoStep}}" class="merchant-flow-page__doc-block merchant-flow-page__section">
                <text class="text-body merchant-flow-page__label">车主诉求</text>
                <textarea
                  class="merchant-flow-page__textarea merchant-flow-page__textarea--short"
                  style="height: 160rpx;"
                  value="{{chiefComplaint}}"
                  maxlength="300"
                  disable-default-padding="{{true}}"
                  placeholder="{{chiefComplaintPlaceholder}}"
                  disabled="{{readOnly}}"
                  bindinput="onChiefComplaintInput"
                />
                <template is="aiFieldHint" data="{{hint: chiefComplaintHint}}" />
              </view>

              <view wx:if="{{isWorkPhotoStep}}" class="merchant-flow-page__doc-block merchant-flow-page__section">
                <text class="text-body merchant-flow-page__label">施工人</text>
                <input class="st-field" placeholder="例：李师傅" value="{{workerName}}" data-key="workerName" disabled="{{readOnly}}" bindinput="onClerkInput" />
                <text class="text-body merchant-flow-page__label">施工时间</text>
                <view class="st-field-row" wx:if="{{!readOnly}}">
                  <picker mode="date" value="{{workFinishedAtDate}}" data-key="workFinishedAt" data-part="date" bindchange="onClerkAtPick">
                    <view class="st-field st-field--picker">{{workFinishedAtDate || '选择日期'}}</view>
                  </picker>
                  <picker mode="time" value="{{workFinishedAtTime}}" data-key="workFinishedAt" data-part="time" bindchange="onClerkAtPick">
                    <view class="st-field st-field--picker">{{workFinishedAtTime || '选择时间'}}</view>
                  </picker>
                </view>
                <text wx:else class="st-quote">{{workFinishedAt || '未填'}}</text>
              </view>

              <view
                wx:if="{{isDeliveryPhotoStep}}"
                class="merchant-flow-page__doc-block merchant-flow-page__section merchant-flow-page__delivery"
              >
                <view class="merchant-flow-page__delivery-step">
                  <view class="merchant-flow-page__delivery-head">
                    <text class="text-body merchant-flow-page__delivery-title">交车照</text>
                    <text class="text-caption merchant-flow-page__delivery-flag">至少 1 张</text>
                  </view>
                  <text class="text-caption text-secondary merchant-flow-page__delivery-hint">拍修好后的整车外观（车头或车尾，能看清车身）。修好的部位可再加几张。旧件特写不用传。</text>
                  <view class="merchant-flow-page__delivery-pool">
                    <view
                      wx:for="{{deliveryPhotos}}"
                      wx:for-item="shot"
                      wx:key="url"
                      class="merchant-flow-page__delivery-pool-item {{shot.isExterior ? 'is-current' : ''}}"
                    >
                      <image
                        class="merchant-flow-page__delivery-pool-img image-placeholder"
                        src="{{shot.url}}"
                        mode="aspectFill"
                        data-url="{{shot.url}}"
                        bindtap="onPreviewDeliveryPhoto"
                      />
                      <text
                        wx:if="{{shot.isExterior}}"
                        class="merchant-flow-page__delivery-pool-check"
                      >外观</text>
                      <text
                        wx:if="{{!readOnly}}"
                        class="merchant-flow-page__delivery-pool-remove"
                        data-url="{{shot.url}}"
                        catchtap="onRemoveDeliveryPhoto"
                      >删除</text>
                    </view>
                    <view
                      wx:if="{{!readOnly}}"
                      class="merchant-flow-page__delivery-pool-item merchant-flow-page__delivery-pool-item--add"
                      bindtap="onUploadDeliveryPhotos"
                    >
                      <text class="merchant-flow-page__delivery-add-plus">+</text>
                      <text class="text-caption merchant-flow-page__delivery-add-label">上传交车图</text>
                    </view>
                  </view>
                </view>
              </view>

              <view
                wx:for="{{sections}}"
                wx:for-item="section"
                wx:for-index="sectionIndex"
                wx:key="stageId"
                wx:if="{{!isDeliveryPhotoStep || section.findingMode}}"
                class="merchant-flow-page__section"
              >
                <block wx:if="{{section.findingMode}}">
                  <text wx:if="{{section.title}}" class="text-body merchant-flow-page__label">{{section.title}}</text>
                  <text wx:if="{{section.tips}}" class="text-caption text-secondary merchant-flow-page__finding-tips">{{section.tips}}</text>
                  <view wx:if="{{!hasFindingItems && (!readOnly || pendingImages.length || organizingPhotos)}}" class="merchant-flow-page__pending">
                    <view wx:if="{{organizingPhotos}}" class="merchant-flow-page__organize-wait">
                      <text class="text-body">归组中</text>
                      <view class="merchant-flow-page__organize-dots" aria-hidden="true">
                        <view class="merchant-flow-page__organize-dot"></view>
                        <view class="merchant-flow-page__organize-dot"></view>
                        <view class="merchant-flow-page__organize-dot"></view>
                      </view>
                    </view>
                    <block wx:else>
                    <flow-unmatched-photos
                      wx:if="{{activeKind !== 'inspection' && !isWorkPhotoStep}}"
                      images="{{pendingImages}}"
                      label="本次照片"
                      canAssign="{{canAssignPending}}"
                      canPromote="{{true}}"
                      readOnly="{{readOnly}}"
                      bind:preview="onPreviewPendingPhoto"
                      bind:assign="onOpenAssignPending"
                      bind:promote="onPromotePendingToFinding"
                      bind:remove="onRemovePendingPhoto"
                    />
                    <view wx:if="{{!readOnly && !isWorkPhotoStep && pendingImages.length < 12}}" class="merchant-flow-page__reshoot">
                      <view
                        class="merchant-flow-page__work-thumb merchant-flow-page__work-thumb--add"
                        bindtap="onAddFindingPhotos"
                      >
                        <text class="merchant-flow-page__work-thumb-plus">+</text>
                      </view>
                    </view>
                    <text
                      wx:if="{{!readOnly}}"
                      class="text-caption text-link merchant-flow-page__add-finding"
                      data-section-index="{{sectionIndex}}"
                      bindtap="onAddFindingItem"
                    >加一项</text>
                    </block>
                  </view>
                  <view wx:if="{{isInspectionPhotoStep && checkpointMisses.length}}" class="merchant-flow-page__checkpoint-miss">
                    <text class="text-caption text-secondary">还可以看</text>
                    <view
                      wx:for="{{checkpointMisses}}"
                      wx:key="id"
                      class="merchant-flow-page__checkpoint-miss-item"
                    >
                      <text class="merchant-flow-page__quote-brief-item-title">{{item.partName}}</text>
                      <text wx:if="{{item.why}}" class="merchant-flow-page__quote-brief-item-body">{{item.why}}</text>
                    </view>
                  </view>
                  <view class="merchant-flow-page__finding-list">
                    <view
                      wx:for="{{section.findings}}"
                      wx:for-item="finding"
                      wx:for-index="findingIndex"
                      wx:key="listKey"
                      class="merchant-flow-page__finding-row {{finding.expanded ? 'merchant-flow-page__finding-row--open' : ''}}"
                    >
                      <view wx:if="{{finding.aiRemind}}" class="merchant-flow-page__finding-remind">{{finding.aiRemind}}</view>
                      <flow-finding-card
                        wx:if="{{!finding.expanded}}"
                        title="{{finding.summaryText}}"
                        body="{{finding.summaryBody}}"
                        images="{{finding.images}}"
                        meta="{{finding.completenessLabel}}"
                        metaDanger="{{finding.labelToneDanger}}"
                        showRemove="{{!readOnly}}"
                        showEmptyPhoto="{{!readOnly}}"
                        sectionIndex="{{sectionIndex}}"
                        findingIndex="{{findingIndex}}"
                        data-section-index="{{sectionIndex}}"
                        data-finding-index="{{findingIndex}}"
                        bind:cardtap="onToggleFinding"
                        bind:remove="onRemoveFinding"
                        bind:emptyphoto="onAttachFindingPhoto"
                        bind:preview="onPreviewFindingPhoto"
                      />
                      <view
                        wx:else
                        class="merchant-flow-page__finding-open-bar"
                        data-section-index="{{sectionIndex}}"
                        data-finding-index="{{findingIndex}}"
                        bindtap="onToggleFinding"
                      >
                        <text class="text-caption merchant-flow-page__finding-collapse">收起</text>
                        <text
                          wx:if="{{!readOnly}}"
                          class="merchant-flow-page__finding-remove"
                          data-section-index="{{sectionIndex}}"
                          data-finding-index="{{findingIndex}}"
                          catchtap="onRemoveFinding"
                        >×</text>
                      </view>
                      <text
                        wx:if="{{section.findingKind === 'work' && finding.showQuoteAddon && !readOnly}}"
                        class="text-caption text-link merchant-flow-page__quote-addon"
                        catchtap="onAddAddonPlan"
                      >去补充报价</text>
                      <view wx:if="{{!finding.expanded && finding.hasCollapsedHints}}" class="merchant-flow-page__finding-hints">
                        <template is="aiFieldHint" data="{{hint: finding.photoHint}}" />
                        <template is="aiFieldHint" data="{{hint: finding.captionHint}}" />
                        <template is="aiFieldHint" data="{{hint: finding.adviceHint}}" />
                      </view>
                      <view wx:if="{{finding.expanded}}" class="merchant-flow-page__finding-editor">
                        <block wx:if="{{section.findingKind === 'work'}}">
                          <view class="merchant-flow-page__work-thumbs">
                            <view
                              wx:for="{{finding.images}}"
                              wx:for-item="thumb"
                              wx:for-index="imgIndex"
                              wx:key="url"
                              class="merchant-flow-page__work-thumb"
                            >
                              <image
                                class="merchant-flow-page__work-thumb-img image-placeholder"
                                src="{{thumb.url}}"
                                mode="aspectFill"
                              />
                              <text
                                wx:if="{{!readOnly}}"
                                class="merchant-flow-page__work-thumb-remove"
                                data-section-index="{{sectionIndex}}"
                                data-finding-index="{{findingIndex}}"
                                data-img-index="idx-{{imgIndex}}"
                                catchtap="onRemoveFindingImage"
                              >×</text>
                            </view>
                            <view
                              wx:if="{{!readOnly && finding.images.length < 6}}"
                              class="merchant-flow-page__work-thumb merchant-flow-page__work-thumb--add"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              catchtap="onAttachFindingPhoto"
                            >
                              <text class="merchant-flow-page__work-thumb-plus">+</text>
                            </view>
                          </view>
                          <template is="aiFieldHint" data="{{hint: finding.photoHint}}" />
                          <view wx:if="{{finding.outsideQuote}}" class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">项目</text>
                            <input
                              class="merchant-flow-page__input merchant-flow-page__input--field"
                              placeholder="{{workJobPlaceholder || findingPartPlaceholder}}"
                              value="{{finding.partName}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="partName"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">说明</text>
                            <textarea
                              class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                              placeholder="{{finding.captionPlaceholder || workCaptionPlaceholder}}"
                              value="{{finding.caption}}"
                              maxlength="500"
                              auto-height="{{true}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="caption"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <template is="aiFieldHint" data="{{hint: finding.captionHint}}" />
                        </block>
                        <block wx:else>
                          <view wx:if="{{finding.images.length}}" class="merchant-flow-page__work-thumbs">
                            <view
                              wx:for="{{finding.images}}"
                              wx:for-item="thumb"
                              wx:for-index="imgIndex"
                              wx:key="url"
                              class="merchant-flow-page__work-thumb"
                            >
                              <image
                                class="merchant-flow-page__work-thumb-img image-placeholder"
                                src="{{thumb.url}}"
                                mode="aspectFill"
                              />
                              <text
                                wx:if="{{!readOnly}}"
                                class="merchant-flow-page__work-thumb-remove"
                                data-section-index="{{sectionIndex}}"
                                data-finding-index="{{findingIndex}}"
                                data-img-index="idx-{{imgIndex}}"
                                catchtap="onRemoveFindingImage"
                              >×</text>
                            </view>
                            <view
                              wx:if="{{!readOnly}}"
                              class="merchant-flow-page__work-thumb merchant-flow-page__work-thumb--add"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              catchtap="onAttachFindingPhoto"
                            >
                              <text class="merchant-flow-page__work-thumb-plus">+</text>
                            </view>
                          </view>
                          <view
                            wx:else
                            class="merchant-flow-page__pending-photo-btn"
                            data-section-index="{{sectionIndex}}"
                            data-finding-index="{{findingIndex}}"
                            catchtap="onAttachFindingPhoto"
                          >
                            <text class="text-body">上传照片</text>
                          </view>
                          <template is="aiFieldHint" data="{{hint: finding.photoHint}}" />
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">部位</text>
                            <input
                              class="merchant-flow-page__input merchant-flow-page__input--field"
                              placeholder="{{findingPartPlaceholder}}"
                              value="{{finding.partName}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="partName"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">检查结果</text>
                            <view class="merchant-flow-page__result-seg">
                              <view
                                wx:for="{{finding.resultOptions}}"
                                wx:for-item="opt"
                                wx:key="value"
                                class="merchant-flow-page__result-seg-item {{opt.selected ? 'merchant-flow-page__result-seg-item--on' : ''}}"
                                data-section-index="{{sectionIndex}}"
                                data-finding-index="{{findingIndex}}"

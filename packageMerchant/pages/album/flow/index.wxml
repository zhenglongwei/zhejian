                        maxlength="500"
                        auto-height="{{true}}"
                        data-field="repairBrief"
                        disabled="{{readOnly}}"
                        bindinput="onWarrantyFieldInput"
                      />
                    </view>
                    <view class="merchant-flow-page__key-fill-field">
                      <view class="merchant-flow-page__key-fill-label-row">

<template name="aiFieldHint">
  <view wx:if="{{hint && !hint.applied}}" class="merchant-flow-page__ai-hint">
    <view class="merchant-flow-page__ai-hint-body">
      <text class="merchant-flow-page__ai-hint-kicker">{{hint.kicker}}</text>
      <text class="merchant-flow-page__ai-hint-text">{{hint.body}}</text>
    </view>
    <text
      wx:if="{{hint.canApply}}"
      class="merchant-flow-page__ai-hint-action"
      data-id="{{hint.id}}"
      catchtap="onApplyAiSuggestion"
    >应用</text>
    <text
      wx:elif="{{hint.canGoPhoto}}"
      class="merchant-flow-page__ai-hint-action"
      data-id="{{hint.id}}"
      catchtap="onApplyAiSuggestion"
    >补拍</text>
  </view>
</template>
<template name="aiTextBatchBar">
  <view wx:if="{{aiTextBatchCanApply || aiTextBatchCanUndo}}" class="merchant-flow-page__ai-batch">
    <text
      wx:if="{{aiTextBatchCanApply}}"
      class="merchant-flow-page__ai-batch-action"
      catchtap="onApplyAllAiText"
    >采用改法</text>
    <text
      wx:if="{{aiTextBatchCanUndo}}"
      class="merchant-flow-page__ai-batch-undo"
      catchtap="onUndoAiTextBatch"
    >撤回</text>
  </view>
</template>
<view class="page merchant-flow-page">
  <block wx:if="{{status === 'loading'}}">
    <view class="page-content merchant-flow-page__pad">
      <ui-skeleton rows="{{4}}" title="{{true}}" />
      <ui-skeleton rows="{{6}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty title="无法加载服务进度" description="{{errorMessage}}" actionText="重试" bind:action="onRetry" />
    </view>
  </block>

  <block wx:else>
    <view class="page-content merchant-flow-page__body">
        <view class="merchant-flow-page__hero">
          <view class="merchant-flow-page__hero-top">
            <text class="text-h3">{{serviceName}}</text>
            <ui-tag variant="{{statusVariant}}" text="{{statusLabel}}" />
          </view>
        </view>

        <flow-stepper
          completedSteps="{{completedSteps}}"
          activeTitle="{{activeTitle}}"
          activeSummary="{{activeSummary}}"
          activeCategory="{{activeCategory}}"
          progressLabel="{{progressLabel}}"
          showActive="{{showActive}}"
          lockedHint="{{lockedHint}}"
          expandedCompletedId="{{expandedCompletedId}}"
          bind:completedtap="onCompletedTap"
        >
          <view slot="active" class="merchant-flow-page__active">
            <block wx:if="{{activeIsPhoto}}">
              <view wx:if="{{isIntakePhotoStep}}" class="merchant-flow-page__doc-block merchant-flow-page__section">
                <text class="text-body merchant-flow-page__label">问诊登记</text>
                <textarea
                  class="merchant-flow-page__textarea merchant-flow-page__textarea--short"
                  style="height: 160rpx;"
                  value="{{chiefComplaint}}"
                  maxlength="300"
                  disable-default-padding="{{true}}"
                  placeholder="{{chiefComplaintPlaceholder}}"
                  disabled="{{readOnly}}"
                  bindinput="onChiefComplaintInput"
                />
                <template is="aiFieldHint" data="{{hint: chiefComplaintHint}}" />
                <text class="text-body merchant-flow-page__label">品牌车型</text>
                <view class="merchant-flow-page__vehicle-row">
                  <input
                    class="merchant-flow-page__input merchant-flow-page__input--third"
                    value="{{vehicleBrand}}"
                    maxlength="20"
                    placeholder="品牌"
                    disabled="{{readOnly}}"
                    bindinput="onVehicleFieldInput"
                    data-field="vehicleBrand"
                  />
                  <input
                    class="merchant-flow-page__input merchant-flow-page__input--third"
                    value="{{vehicleSeries}}"
                    maxlength="24"
                    placeholder="车系"
                    disabled="{{readOnly}}"
                    bindinput="onVehicleFieldInput"
                    data-field="vehicleSeries"
                  />
                  <input
                    class="merchant-flow-page__input merchant-flow-page__input--third"
                    value="{{vehicleYear}}"
                    maxlength="8"
                    placeholder="年款"
                    disabled="{{readOnly}}"
                    bindinput="onVehicleFieldInput"
                    data-field="vehicleYear"
                  />
                </view>
              </view>

              <view
                wx:if="{{isDeliveryPhotoStep}}"
                class="merchant-flow-page__doc-block merchant-flow-page__section merchant-flow-page__delivery"
              >
                <view class="merchant-flow-page__delivery-step">
                  <view class="merchant-flow-page__delivery-head">
                    <text class="merchant-flow-page__delivery-index">1</text>
                    <text class="text-body merchant-flow-page__delivery-title">全车照片</text>
                    <text class="text-caption merchant-flow-page__delivery-flag">必选</text>
                  </view>

                  <view
                    wx:if="{{deliveryExteriorUrl && deliveryPickMode !== 'exterior'}}"
                    class="merchant-flow-page__exterior-well"
                  >
                    <image
                      class="merchant-flow-page__exterior-well-img image-placeholder"
                      src="{{deliveryExteriorUrl}}"
                      mode="aspectFill"
                      bindtap="onPreviewExterior"
                    />
                    <view wx:if="{{!readOnly}}" class="merchant-flow-page__exterior-well-bar">
                      <text
                        class="text-caption merchant-flow-page__exterior-well-action"
                        catchtap="onCaptureExterior"
                      >补拍</text>
                      <text
                        wx:if="{{workImagePool.length}}"
                        class="text-caption merchant-flow-page__exterior-well-action"
                        catchtap="onStartPickExterior"
                      >从施工图选</text>
                      <text
                        class="text-caption merchant-flow-page__exterior-well-action merchant-flow-page__exterior-well-action--mute"
                        catchtap="onClearExterior"
                      >清除</text>
                    </view>
                  </view>

                  <view
                    wx:elif="{{!deliveryExteriorUrl && deliveryPickMode !== 'exterior' && !readOnly}}"
                    class="merchant-flow-page__exterior-empty"
                  >
                    <text class="merchant-flow-page__exterior-empty-plus">+</text>
                    <text class="text-body merchant-flow-page__exterior-empty-title">全车照片</text>
                    <text class="text-caption text-secondary">拍车身全貌，不要拍码</text>
                    <view class="merchant-flow-page__exterior-empty-actions">
                      <view
                        class="merchant-flow-page__exterior-cta"
                        bindtap="onCaptureExterior"
                      >补拍</view>
                      <view
                        wx:if="{{workImagePool.length}}"
                        class="merchant-flow-page__exterior-cta merchant-flow-page__exterior-cta--ghost"
                        bindtap="onStartPickExterior"
                      >从施工图选</view>
                    </view>
                  </view>

                  <view
                    wx:if="{{deliveryPickMode === 'exterior'}}"
                    class="merchant-flow-page__delivery-pick"
                  >
                    <view class="merchant-flow-page__delivery-pick-head">
                      <text class="text-body">点一张作全车</text>
                      <text
                        class="text-caption merchant-flow-page__link"
                        bindtap="onCancelPickExterior"
                      >取消</text>
                    </view>
                    <view class="merchant-flow-page__delivery-pool">
                      <view
                        wx:for="{{workImagePool}}"
                        wx:for-item="pool"
                        wx:key="url"
                        class="merchant-flow-page__delivery-pool-item {{pool.url === deliveryExteriorUrl ? 'is-current' : ''}}"
                        data-url="{{pool.url}}"
                        bindtap="onToggleDeliveryWorkImage"
                      >
                        <image
                          class="merchant-flow-page__delivery-pool-img image-placeholder"
                          src="{{pool.url}}"
                          mode="aspectFill"
                        />
                        <text
                          wx:if="{{pool.url === deliveryExteriorUrl}}"
                          class="merchant-flow-page__delivery-pool-check"
                        >当前</text>
                      </view>
                    </view>
                  </view>
                </view>

                <view
                  wx:if="{{deliveryExteriorUrl && deliveryPickMode !== 'exterior'}}"
                  class="merchant-flow-page__delivery-step"
                >
                  <view class="merchant-flow-page__delivery-head">
                    <text class="merchant-flow-page__delivery-index">2</text>
                    <text class="text-body merchant-flow-page__delivery-title">其他交车图</text>
                    <text class="text-caption merchant-flow-page__delivery-flag merchant-flow-page__delivery-flag--optional">选填</text>
                  </view>
                  <text class="text-caption text-secondary merchant-flow-page__delivery-hint">点选过程图，或补拍</text>
                  <view class="merchant-flow-page__delivery-pool">
                    <block wx:for="{{workImagePool}}" wx:for-item="pool" wx:key="url">
                      <view
                        wx:if="{{!pool.isExterior}}"
                        class="merchant-flow-page__delivery-pool-item {{pool.selected ? 'is-selected' : ''}}"
                        data-url="{{pool.url}}"
                        bindtap="onToggleDeliveryWorkImage"
                      >
                        <image
                          class="merchant-flow-page__delivery-pool-img image-placeholder"
                          src="{{pool.url}}"
                          mode="aspectFill"
                        />
                        <text
                          wx:if="{{pool.selected}}"
                          class="merchant-flow-page__delivery-pool-check"
                        >已选</text>
                      </view>
                    </block>
                    <view
                      wx:if="{{!readOnly}}"
                      class="merchant-flow-page__delivery-pool-item merchant-flow-page__delivery-pool-item--add"
                      bindtap="onCaptureDeliveryExtra"
                    >
                      <text class="merchant-flow-page__delivery-add-plus">+</text>
                      <text class="text-caption merchant-flow-page__delivery-add-label">补拍</text>
                    </view>
                  </view>
                </view>
              </view>

              <view
                wx:for="{{sections}}"
                wx:for-item="section"
                wx:for-index="sectionIndex"
                wx:key="stageId"
                wx:if="{{!isDeliveryPhotoStep || section.findingMode}}"
                class="merchant-flow-page__section"
              >
                <block wx:if="{{section.findingMode}}">
                  <text class="text-body merchant-flow-page__label">{{section.title}}</text>
                  <text wx:if="{{section.tips}}" class="text-caption text-secondary merchant-flow-page__finding-tips">{{section.tips}}</text>
                  <view wx:if="{{!hasFindingItems && (!readOnly || pendingImages.length || organizingPhotos)}}" class="merchant-flow-page__pending">
                    <view wx:if="{{organizingPhotos}}" class="merchant-flow-page__organize-wait">
                      <text class="text-body">归组中</text>
                    </view>
                    <block wx:else>
                    <text class="text-caption text-secondary merchant-flow-page__pending-label">本次照片</text>
                    <view class="merchant-flow-page__work-thumbs">
                      <view
                        wx:for="{{pendingImages}}"
                        wx:for-item="shot"
                        wx:for-index="pendingIndex"
                        wx:key="url"
                        class="merchant-flow-page__work-thumb"
                      >
                        <image
                          class="merchant-flow-page__work-thumb-img image-placeholder"
                          src="{{shot.url}}"
                          mode="aspectFill"
                          data-url="{{shot.url}}"
                          bindtap="onPreviewPendingPhoto"
                        />
                        <text
                          wx:if="{{!readOnly}}"
                          class="merchant-flow-page__work-thumb-remove"
                          data-pending-index="{{pendingIndex}}"
                          catchtap="onRemovePendingPhoto"
                        >×</text>
                      </view>
                      <view
                        wx:if="{{!readOnly && pendingImages.length < 12}}"
                        class="merchant-flow-page__work-thumb merchant-flow-page__work-thumb--add"
                        bindtap="onAddFindingPhotos"
                      >
                        <text class="merchant-flow-page__work-thumb-plus">+</text>
                      </view>
                    </view>
                    <text
                      wx:if="{{!readOnly && canUseLibrary}}"
                      class="text-caption merchant-flow-page__library-entry"
                      bindtap="onOpenLibrary"
                    >从图库选择</text>
                    <text
                      wx:if="{{!readOnly && isInspectionPhotoStep && isAppearanceService}}"
                      class="text-caption text-secondary"
                    >进场外观在图库</text>
                    </block>
                  </view>
                  <view wx:if="{{!section.findings.length && !pendingImages.length && !organizingPhotos}}" class="text-caption text-secondary merchant-flow-page__finding-empty">
                    点加号连拍
                  </view>
                  <view class="merchant-flow-page__finding-list">
                    <view
                      wx:for="{{section.findings}}"
                      wx:for-item="finding"
                      wx:for-index="findingIndex"
                      wx:key="listKey"
                      class="merchant-flow-page__finding-row {{finding.expanded ? 'merchant-flow-page__finding-row--open' : ''}}"
                    >
                      <view
                        wx:if="{{!finding.expanded}}"
                        class="merchant-flow-page__finding-summary"
                        data-section-index="{{sectionIndex}}"
                        data-finding-index="{{findingIndex}}"
                        bindtap="onToggleFinding"
                      >
                        <view class="merchant-flow-page__finding-summary-lead">
                          <text class="text-body merchant-flow-page__finding-summary-title">{{finding.summaryText}}</text>
                          <text class="text-caption {{finding.complete ? 'text-secondary' : 'text-danger'}}">{{finding.completenessLabel}}</text>
                        </view>
                        <view class="merchant-flow-page__finding-summary-shots">
                          <block wx:if="{{finding.images.length}}">
                            <image
                              wx:for="{{finding.images}}"
                              wx:for-item="shot"
                              wx:key="url"
                              class="merchant-flow-page__finding-img image-placeholder"
                              src="{{shot.url}}"
                              mode="aspectFill"
                            />
                          </block>
                          <view
                            wx:else
                            class="merchant-flow-page__finding-img merchant-flow-page__finding-img--pending"
                            data-section-index="{{sectionIndex}}"
                            data-finding-index="{{findingIndex}}"
                            catchtap="onAttachFindingPhoto"
                          >
                            <text class="text-caption text-secondary">拍照</text>
                          </view>
                        </view>
                        <text
                          wx:if="{{!readOnly}}"
                          class="merchant-flow-page__finding-remove"
                          data-section-index="{{sectionIndex}}"
                          data-finding-index="{{findingIndex}}"
                          catchtap="onRemoveFinding"
                        >×</text>
                      </view>
                      <view
                        wx:else
                        class="merchant-flow-page__finding-open-bar"
                        data-section-index="{{sectionIndex}}"
                        data-finding-index="{{findingIndex}}"
                        bindtap="onToggleFinding"
                      >
                        <text class="text-caption merchant-flow-page__finding-collapse">收起</text>
                        <text
                          wx:if="{{!readOnly}}"
                          class="merchant-flow-page__finding-remove"
                          data-section-index="{{sectionIndex}}"
                          data-finding-index="{{findingIndex}}"
                          catchtap="onRemoveFinding"
                        >×</text>
                      </view>
                      <view wx:if="{{!finding.expanded && finding.hasCollapsedHints}}" class="merchant-flow-page__finding-hints">
                        <template is="aiFieldHint" data="{{hint: finding.photoHint}}" />
                        <template is="aiFieldHint" data="{{hint: finding.captionHint}}" />
                        <template is="aiFieldHint" data="{{hint: finding.adviceHint}}" />
                      </view>
                      <view wx:if="{{finding.expanded}}" class="merchant-flow-page__finding-editor">
                        <block wx:if="{{section.findingKind === 'work'}}">
                          <view class="merchant-flow-page__work-thumbs">
                            <view
                              wx:for="{{finding.images}}"
                              wx:for-item="thumb"
                              wx:for-index="imgIndex"
                              wx:key="url"
                              class="merchant-flow-page__work-thumb"
                            >
                              <image
                                class="merchant-flow-page__work-thumb-img image-placeholder"
                                src="{{thumb.url}}"
                                mode="aspectFill"
                              />
                              <text
                                wx:if="{{!readOnly}}"
                                class="merchant-flow-page__work-thumb-remove"
                                data-section-index="{{sectionIndex}}"
                                data-finding-index="{{findingIndex}}"
                                data-img-index="idx-{{imgIndex}}"
                                catchtap="onRemoveFindingImage"
                              >×</text>
                            </view>
                            <view
                              wx:if="{{!readOnly && finding.images.length < 6}}"
                              class="merchant-flow-page__work-thumb merchant-flow-page__work-thumb--add"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              catchtap="onAttachFindingPhoto"
                            >
                              <text class="merchant-flow-page__work-thumb-plus">+</text>
                            </view>
                          </view>
                          <template is="aiFieldHint" data="{{hint: finding.photoHint}}" />
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">项目</text>
                            <input
                              class="merchant-flow-page__input merchant-flow-page__input--field"
                              placeholder="{{workJobPlaceholder || findingPartPlaceholder}}"
                              value="{{finding.partName}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="partName"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">用料</text>
                            <input
                              class="merchant-flow-page__input merchant-flow-page__input--field"
                              placeholder="换了什么件"
                              value="{{finding.material}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="material"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">品牌</text>
                            <input
                              class="merchant-flow-page__input merchant-flow-page__input--field"
                              placeholder="原厂/品牌名"
                              value="{{finding.brand}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="brand"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">数量</text>
                            <input
                              class="merchant-flow-page__input merchant-flow-page__input--field"
                              placeholder="例：1 个 / 2 升"
                              value="{{finding.qty}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="qty"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">说明</text>
                            <textarea
                              class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                              placeholder="{{finding.captionPlaceholder || workCaptionPlaceholder}}"
                              value="{{finding.caption}}"
                              maxlength="500"
                              auto-height="{{true}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="caption"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <template is="aiFieldHint" data="{{hint: finding.captionHint}}" />
                        </block>
                        <block wx:else>
                          <view wx:if="{{finding.images.length}}" class="merchant-flow-page__work-thumbs">
                            <view
                              wx:for="{{finding.images}}"
                              wx:for-item="thumb"
                              wx:for-index="imgIndex"
                              wx:key="url"
                              class="merchant-flow-page__work-thumb"
                            >
                              <image
                                class="merchant-flow-page__work-thumb-img image-placeholder"
                                src="{{thumb.url}}"
                                mode="aspectFill"
                              />
                              <text
                                wx:if="{{!readOnly}}"
                                class="merchant-flow-page__work-thumb-remove"
                                data-section-index="{{sectionIndex}}"
                                data-finding-index="{{findingIndex}}"
                                data-img-index="idx-{{imgIndex}}"
                                catchtap="onRemoveFindingImage"
                              >×</text>
                            </view>
                            <view
                              wx:if="{{!readOnly && finding.images.length < 6}}"
                              class="merchant-flow-page__work-thumb merchant-flow-page__work-thumb--add"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              catchtap="onAttachFindingPhoto"
                            >
                              <text class="merchant-flow-page__work-thumb-plus">+</text>
                            </view>
                          </view>
                          <view
                            wx:else
                            class="merchant-flow-page__pending-photo-btn"
                            data-section-index="{{sectionIndex}}"
                            data-finding-index="{{findingIndex}}"
                            catchtap="onAttachFindingPhoto"
                          >
                            <text class="text-body">上传照片</text>
                          </view>
                          <template is="aiFieldHint" data="{{hint: finding.photoHint}}" />
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">部位</text>
                            <input
                              class="merchant-flow-page__input merchant-flow-page__input--field"
                              placeholder="{{findingPartPlaceholder}}"
                              value="{{finding.partName}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="partName"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">检查结果</text>
                            <view class="merchant-flow-page__result-seg">
                              <view
                                wx:for="{{finding.resultOptions}}"
                                wx:for-item="opt"
                                wx:key="value"
                                class="merchant-flow-page__result-seg-item {{opt.selected ? 'merchant-flow-page__result-seg-item--on' : ''}}"
                                data-section-index="{{sectionIndex}}"
                                data-finding-index="{{findingIndex}}"
                                data-value="{{opt.value}}"
                                bindtap="onSelectFindingResult"
                              >{{opt.value}}</view>
                            </view>
                          </view>
                          <view wx:if="{{finding.result && !finding.recordOnly}}" class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">检查发现</text>
                            <textarea
                              class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                              placeholder="{{finding.advicePlaceholder || (finding.adviceRequired ? findingAdvicePlaceholder : '无需处理')}}"
                              value="{{finding.advice}}"
                              maxlength="500"
                              auto-height="{{true}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="advice"
                              disabled="{{readOnly || !finding.adviceRequired}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <template is="aiFieldHint" data="{{hint: finding.adviceHint}}" />
                        </block>
                      </view>
                    </view>
                  </view>
                  <view wx:if="{{organizeResultHint}}" class="merchant-flow-page__organize-result">
                    <text class="text-body">{{organizeResultHint}}</text>
                  </view>
                  <view wx:if="{{hasFindingItems && (!readOnly || pendingImages.length || organizingPhotos)}}" class="merchant-flow-page__pending merchant-flow-page__pending--after">
                    <view wx:if="{{organizingPhotos}}" class="merchant-flow-page__organize-wait">
                      <text class="text-body">归组中</text>
                    </view>
                    <block wx:else>
                    <block wx:if="{{pendingImages.length}}">
                      <text class="text-caption text-secondary merchant-flow-page__pending-label">未归组</text>
                      <view
                        wx:for="{{pendingImages}}"
                        wx:for-item="shot"
                        wx:for-index="pendingIndex"
                        wx:key="url"
                        class="merchant-flow-page__unmatched"
                      >
                        <view class="merchant-flow-page__work-thumb merchant-flow-page__work-thumb--skip">
                          <image
                            class="merchant-flow-page__work-thumb-img image-placeholder"
                            src="{{shot.url}}"
                            mode="aspectFill"
                            data-url="{{shot.url}}"
                            bindtap="onPreviewPendingPhoto"
                          />
                        </view>
                        <view class="merchant-flow-page__unmatched-actions">
                          <view
                            class="merchant-flow-page__unmatched-btn merchant-flow-page__unmatched-btn--primary"
                            data-pending-index="{{pendingIndex}}"
                            catchtap="onOpenAssignPending"
                          >归入已有项</view>
                          <view
                            class="merchant-flow-page__unmatched-btn"
                            data-pending-index="{{pendingIndex}}"
                            catchtap="onPromotePendingToFinding"
                          >单独成一项</view>
                          <view
                            class="merchant-flow-page__unmatched-btn"

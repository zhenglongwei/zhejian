<template name="aiFieldHint">
  <view wx:if="{{hint && !hint.applied}}" class="merchant-flow-page__ai-hint">
    <view class="merchant-flow-page__ai-hint-body">
      <text class="merchant-flow-page__ai-hint-kicker">{{hint.kicker}}</text>
      <text class="merchant-flow-page__ai-hint-text">{{hint.body}}</text>
    </view>
    <text
      wx:if="{{hint.canApply}}"
      class="merchant-flow-page__ai-hint-action"
      data-id="{{hint.id}}"
      catchtap="onApplyAiSuggestion"
    >应用</text>
  </view>
</template>
<template name="quoteEvidencePicker">
  <view class="merchant-flow-page__plan-evidence-block">
    <block wx:if="{{!locked && item.evidencePool.length}}">
      <view class="merchant-flow-page__plan-chips">
        <view
          wx:for="{{item.evidencePool}}"
          wx:for-item="chip"
          wx:key="url"
          class="merchant-flow-page__plan-chip {{chip.selected ? 'merchant-flow-page__plan-chip--on' : ''}} {{chip.taken ? 'merchant-flow-page__plan-chip--taken' : ''}}"
          data-index="{{index}}"
          data-url="{{chip.url}}"
          bindtap="onToggleQuoteEvidence"
        >
          <image
            class="merchant-flow-page__plan-chip-img image-placeholder"
            src="{{chip.url}}"
            mode="aspectFill"
          />
          <text class="text-caption merchant-flow-page__plan-chip-name">{{chip.partName || '检测图'}}</text>
        </view>
      </view>
    </block>
    <block wx:elif="{{item.evidenceThumbs.length}}">
      <view class="merchant-flow-page__plan-evidence">
        <view
          wx:for="{{item.evidenceThumbs}}"
          wx:for-item="thumb"
          wx:key="url"
          class="merchant-flow-page__plan-evidence-thumb"
          data-index="{{index}}"
          data-url="{{thumb.url}}"
          bindtap="onPreviewQuoteEvidence"
        >
          <image
            class="merchant-flow-page__plan-evidence-img image-placeholder"
            src="{{thumb.url}}"
            mode="aspectFill"
          />
          <text
            wx:if="{{!locked}}"
            class="merchant-flow-page__plan-evidence-remove"
            data-index="{{index}}"
            data-url="{{thumb.url}}"
            catchtap="onToggleQuoteEvidence"
          >×</text>
        </view>
      </view>
    </block>
  </view>
</template>
<view class="page merchant-flow-page">
  <block wx:if="{{status === 'loading'}}">
    <view class="page-content merchant-flow-page__pad">
      <ui-skeleton rows="{{4}}" title="{{true}}" />
      <ui-skeleton rows="{{6}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty title="无法加载服务进度" description="{{errorMessage}}" actionText="重试" bind:action="onRetry" />
    </view>
  </block>

  <block wx:else>
    <view class="page-content merchant-flow-page__body">
        <view class="merchant-flow-page__hero">
          <view class="merchant-flow-page__hero-top">
            <text class="text-h3">{{serviceName}}</text>
            <ui-tag variant="{{statusVariant}}" text="{{statusLabel}}" />
          </view>
        </view>

        <flow-stepper
          completedSteps="{{completedSteps}}"
          activeTitle="{{activeTitle}}"
          activeSummary="{{activeSummary}}"
          activeCategory="{{activeCategory}}"
          progressLabel="{{progressLabel}}"
          showActive="{{showActive}}"
          lockedHint="{{lockedHint}}"
          expandedCompletedId="{{expandedCompletedId}}"
          bind:completedtap="onCompletedTap"
        >
          <view slot="active" class="merchant-flow-page__active">
            <block wx:if="{{activeIsPhoto}}">
              <view wx:if="{{isIntakePhotoStep}}" class="merchant-flow-page__doc-block merchant-flow-page__section">
                <text class="text-body merchant-flow-page__label">进店主诉</text>
                <textarea
                  class="merchant-flow-page__textarea merchant-flow-page__textarea--short"
                  value="{{chiefComplaint}}"
                  maxlength="300"
                  auto-height="{{true}}"
                  placeholder="{{chiefComplaintPlaceholder}}"
                  disabled="{{readOnly}}"
                  bindinput="onChiefComplaintInput"
                />
                <template is="aiFieldHint" data="{{hint: chiefComplaintHint}}" />
                <text class="text-body merchant-flow-page__label">当前里程</text>
                <input
                  class="merchant-flow-page__input"
                  type="number"
                  value="{{mileageKm}}"
                  maxlength="7"
                  placeholder="例：86500"
                  disabled="{{readOnly}}"
                  bindinput="onMileageInput"
                />
                <text class="text-caption text-secondary">公里。仪表照仍要拍，只作证据。</text>
                <text class="text-body merchant-flow-page__label">对外车型</text>
                <view class="merchant-flow-page__vehicle-row">
                  <input
                    class="merchant-flow-page__input merchant-flow-page__input--third"
                    value="{{vehicleBrand}}"
                    maxlength="20"
                    placeholder="品牌"
                    disabled="{{readOnly}}"
                    bindinput="onVehicleFieldInput"
                    data-field="vehicleBrand"
                  />
                  <input
                    class="merchant-flow-page__input merchant-flow-page__input--third"
                    value="{{vehicleSeries}}"
                    maxlength="24"
                    placeholder="车系"
                    disabled="{{readOnly}}"
                    bindinput="onVehicleFieldInput"
                    data-field="vehicleSeries"
                  />
                  <input
                    class="merchant-flow-page__input merchant-flow-page__input--third"
                    value="{{vehicleYear}}"
                    maxlength="8"
                    placeholder="年款"
                    disabled="{{readOnly}}"
                    bindinput="onVehicleFieldInput"
                    data-field="vehicleYear"
                  />
                </view>
              </view>

              <view
                wx:if="{{isDeliveryPhotoStep}}"
                class="merchant-flow-page__doc-block merchant-flow-page__section"
              >
                <text class="text-body merchant-flow-page__label">整车外观（必选）</text>
                <text class="text-caption text-secondary merchant-flow-page__finding-tips">拍车身全貌</text>
                <view wx:if="{{deliveryExteriorUrl}}" class="merchant-flow-page__exterior-slot">
                  <image
                    class="merchant-flow-page__exterior-slot-img image-placeholder"
                    src="{{deliveryExteriorUrl}}"
                    mode="aspectFill"
                  />
                  <view wx:if="{{!readOnly}}" class="merchant-flow-page__exterior-slot-actions">
                    <text
                      class="text-caption merchant-flow-page__link"
                      bindtap="onStartPickExterior"
                    >换施工图</text>
                    <text
                      class="text-caption merchant-flow-page__link"
                      bindtap="onCaptureExterior"
                    >补拍</text>
                    <text
                      class="text-caption text-secondary"
                      bindtap="onClearExterior"
                    >清除</text>
                  </view>
                </view>
                <view wx:else class="merchant-flow-page__exterior-actions">
                  <view
                    class="merchant-flow-page__exterior-btn"
                    bindtap="onStartPickExterior"
                  >
                    <text class="text-body">从施工图选</text>
                  </view>
                  <view
                    class="merchant-flow-page__exterior-btn"
                    bindtap="onCaptureExterior"
                  >
                    <text class="text-body">补拍外观</text>
                  </view>
                </view>
                <text
                  wx:if="{{deliveryPickMode === 'exterior'}}"
                  class="text-caption text-secondary merchant-flow-page__finding-tips"
                >在下方点选一张作为整车外观
                  <text class="merchant-flow-page__link" bindtap="onCancelPickExterior"> 取消</text>
                </text>
              </view>

              <view
                wx:if="{{isDeliveryPhotoStep && workImagePool.length}}"
                class="merchant-flow-page__doc-block merchant-flow-page__section"
              >
                <text class="text-body merchant-flow-page__label">其他交车图（选填）</text>
                <text
                  wx:if="{{deliveryPickMode !== 'exterior'}}"
                  class="text-caption text-secondary merchant-flow-page__finding-tips"
                >需要给车主看的过程图再勾选</text>
                <view class="merchant-flow-page__delivery-pool">
                  <view
                    wx:for="{{workImagePool}}"
                    wx:for-item="pool"
                    wx:key="url"
                    class="merchant-flow-page__delivery-pool-item {{pool.isExterior ? 'is-exterior' : ''}} {{pool.selected ? 'is-selected' : ''}}"
                    data-url="{{pool.url}}"
                    bindtap="onToggleDeliveryWorkImage"
                  >
                    <image
                      class="merchant-flow-page__delivery-pool-img image-placeholder"
                      src="{{pool.url}}"
                      mode="aspectFill"
                    />
                    <text wx:if="{{pool.isExterior}}" class="merchant-flow-page__delivery-pool-check">外观</text>
                    <text wx:elif="{{pool.selected}}" class="merchant-flow-page__delivery-pool-check">✓</text>
                  </view>
                </view>
              </view>

              <view
                wx:for="{{sections}}"
                wx:for-item="section"
                wx:for-index="sectionIndex"
                wx:key="stageId"
                wx:if="{{!isDeliveryPhotoStep || section.findingMode}}"
                class="merchant-flow-page__section"
              >
                <block wx:if="{{section.findingMode}}">
                  <text class="text-body merchant-flow-page__label">{{section.title}}</text>
                  <text wx:if="{{section.tips}}" class="text-caption text-secondary merchant-flow-page__finding-tips">{{section.tips}}</text>
                  <view wx:if="{{!section.findings.length}}" class="text-caption text-secondary merchant-flow-page__finding-empty">
                    点下方加号上传照片
                  </view>
                  <view class="merchant-flow-page__finding-list">
                    <view
                      wx:for="{{section.findings}}"
                      wx:for-item="finding"
                      wx:for-index="findingIndex"
                      wx:key="listKey"
                      class="merchant-flow-page__finding-row {{finding.expanded ? 'merchant-flow-page__finding-row--open' : ''}}"
                    >
                      <view
                        class="merchant-flow-page__finding-summary"
                        data-section-index="{{sectionIndex}}"
                        data-finding-index="{{findingIndex}}"
                        bindtap="onToggleFinding"
                      >
                        <view
                          wx:if="{{finding.pendingPhoto || !finding.url}}"
                          class="merchant-flow-page__finding-img merchant-flow-page__finding-img--pending"
                          data-section-index="{{sectionIndex}}"
                          data-finding-index="{{findingIndex}}"
                          catchtap="onAttachFindingPhoto"
                        >
                          <text class="text-caption text-secondary">拍照</text>
                        </view>
                        <image
                          wx:else
                          class="merchant-flow-page__finding-img image-placeholder"
                          src="{{finding.url}}"
                          mode="aspectFill"
                        />
                        <view class="merchant-flow-page__finding-summary-main">
                          <text class="text-body merchant-flow-page__finding-summary-title">{{finding.summaryText}}</text>
                          <text class="text-caption {{finding.complete ? 'text-secondary' : 'text-danger'}}">{{finding.completenessLabel}}</text>
                        </view>
                        <text
                          wx:if="{{!readOnly && (section.findingKind === 'work' || finding.url || finding.fromAi)}}"
                          class="merchant-flow-page__finding-remove"
                          data-section-index="{{sectionIndex}}"
                          data-finding-index="{{findingIndex}}"
                          catchtap="onRemoveFinding"
                        >×</text>
                      </view>
                      <view wx:if="{{!finding.expanded && finding.hasCollapsedHints}}" class="merchant-flow-page__finding-hints">
                        <template is="aiFieldHint" data="{{hint: finding.photoHint}}" />
                        <template is="aiFieldHint" data="{{hint: finding.captionHint}}" />
                        <template is="aiFieldHint" data="{{hint: finding.adviceHint}}" />
                      </view>
                      <view wx:if="{{finding.expanded}}" class="merchant-flow-page__finding-editor">
                        <block wx:if="{{section.findingKind === 'work'}}">
                          <view class="merchant-flow-page__work-thumbs">
                            <view
                              wx:for="{{finding.images}}"
                              wx:for-item="thumb"
                              wx:for-index="imgIndex"
                              wx:key="url"
                              class="merchant-flow-page__work-thumb"
                            >
                              <image
                                class="merchant-flow-page__work-thumb-img image-placeholder"
                                src="{{thumb.url}}"
                                mode="aspectFill"
                              />
                              <text
                                wx:if="{{!readOnly}}"
                                class="merchant-flow-page__work-thumb-remove"
                                data-section-index="{{sectionIndex}}"
                                data-finding-index="{{findingIndex}}"
                                data-img-index="idx-{{imgIndex}}"
                                catchtap="onRemoveWorkFindingImage"
                              >×</text>
                            </view>
                            <view
                              wx:if="{{!readOnly && finding.images.length < 6}}"
                              class="merchant-flow-page__work-thumb merchant-flow-page__work-thumb--add"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              catchtap="onAttachFindingPhoto"
                            >
                              <text class="text-caption text-secondary">+</text>
                            </view>
                          </view>
                          <template is="aiFieldHint" data="{{hint: finding.photoHint}}" />
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">项目</text>
                            <input
                              class="merchant-flow-page__input merchant-flow-page__input--field"
                              placeholder="{{workJobPlaceholder || findingPartPlaceholder}}"
                              value="{{finding.partName}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="partName"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">说明</text>
                            <textarea
                              class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                              placeholder="{{finding.captionPlaceholder || workCaptionPlaceholder}}"
                              value="{{finding.caption}}"
                              maxlength="500"
                              auto-height="{{true}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="caption"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <template is="aiFieldHint" data="{{hint: finding.captionHint}}" />
                        </block>
                        <block wx:else>
                          <view
                            wx:if="{{finding.pendingPhoto || !finding.url}}"
                            class="merchant-flow-page__pending-photo-btn"
                            data-section-index="{{sectionIndex}}"
                            data-finding-index="{{findingIndex}}"
                            catchtap="onAttachFindingPhoto"
                          >
                            <text class="text-body">上传照片</text>
                          </view>
                          <template is="aiFieldHint" data="{{hint: finding.photoHint}}" />
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">部位</text>
                            <input
                              class="merchant-flow-page__input merchant-flow-page__input--field"
                              placeholder="{{findingPartPlaceholder}}"
                              value="{{finding.partName}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="partName"
                              disabled="{{readOnly}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <view class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">检查结果</text>
                            <view class="merchant-flow-page__result-seg">
                              <view
                                wx:for="{{finding.resultOptions}}"
                                wx:for-item="opt"
                                wx:key="value"
                                class="merchant-flow-page__result-seg-item {{opt.selected ? 'merchant-flow-page__result-seg-item--on' : ''}}"
                                data-section-index="{{sectionIndex}}"
                                data-finding-index="{{findingIndex}}"
                                data-value="{{opt.value}}"
                                bindtap="onSelectFindingResult"
                              >{{opt.value}}</view>
                            </view>
                          </view>
                          <view wx:if="{{finding.result && !finding.recordOnly}}" class="merchant-flow-page__field">
                            <text class="text-caption text-secondary merchant-flow-page__field-label">检查发现</text>
                            <textarea
                              class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                              placeholder="{{finding.advicePlaceholder || (finding.adviceRequired ? findingAdvicePlaceholder : '无需处理')}}"
                              value="{{finding.advice}}"
                              maxlength="500"
                              auto-height="{{true}}"
                              data-section-index="{{sectionIndex}}"
                              data-finding-index="{{findingIndex}}"
                              data-field="advice"
                              disabled="{{readOnly || !finding.adviceRequired}}"
                              bindinput="onSectionFindingFieldInput"
                            />
                          </view>
                          <template is="aiFieldHint" data="{{hint: finding.adviceHint}}" />
                        </block>
                      </view>
                    </view>
                    <view
                      wx:if="{{!readOnly && section.findings.length < 12}}"
                      class="merchant-flow-page__finding-add"
                      data-index="{{sectionIndex}}"
                      bindtap="onAddFindingPhotos"
                    >
                      <text class="merchant-flow-page__finding-add-icon">+</text>
                    </view>
                  </view>
                </block>
                <ui-album-node
                  wx:elif="{{!isDeliveryPhotoStep}}"
                  mode="edit"
                  title="{{section.title}}"
                  photoTips="{{section.tips}}"
                  captionPlaceholder="{{section.captionPlaceholder}}"
                  images="{{section.images}}"
                  maxCount="{{12}}"
                  enableCaption="{{true}}"
                  data-index="{{sectionIndex}}"
                  bind:imageschange="onSectionImagesChange"
                />
                <template is="aiFieldHint" data="{{hint: section.photoHint}}" />
              </view>

              <view wx:if="{{isDeliveryPhotoStep}}" class="merchant-flow-page__doc-block merchant-flow-page__section">
                <text class="text-body merchant-flow-page__label">质保期限（必填）</text>
                <textarea
                  class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                  placeholder="例：1 年或 5000 公里，以先到为准"
                  value="{{warrantyPeriod}}"
                  maxlength="120"
                  auto-height="{{true}}"
                  data-field="warrantyPeriod"
                  disabled="{{readOnly}}"
                  bindinput="onWarrantyFieldInput"
                />
                <template is="aiFieldHint" data="{{hint: warrantyHint}}" />
                <text class="text-body merchant-flow-page__label">注意事项（选填）</text>
                <textarea
                  class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                  placeholder="例：仅限本次已确认项目；外力撞击、涉水除外"
                  value="{{warrantyNotes}}"
                  maxlength="300"
                  auto-height="{{true}}"
                  data-field="warrantyNotes"
                  disabled="{{readOnly}}"
                  bindinput="onWarrantyFieldInput"
                />
              </view>

              <text wx:if="{{autoSaveLabel}}" class="text-caption text-secondary merchant-flow-page__auto-save">{{autoSaveLabel}}</text>
              <ui-button
                wx:if="{{!readOnly && isWorkPhotoStep}}"
                type="ghost"
                block="{{true}}"
                loading="{{confirming}}"
                bind:btntap="onAddAddonPlan"
              >发现新的待处理项目</ui-button>
              <text
                wx:if="{{!readOnly && isWorkPhotoStep}}"
                class="text-caption text-secondary merchant-flow-page__finding-tips"
              >先征得车主同意再做</text>
              <text
                wx:if="{{aiReview.isWaiting}}"
                class="text-caption merchant-flow-page__ai-status"
              >{{aiReview.waitHint}}</text>
              <view wx:for="{{orphanPhotoHints}}" wx:key="id" class="merchant-flow-page__orphan-hint">
                <template is="aiFieldHint" data="{{hint: item}}" />
              </view>
              <ui-button
                wx:if="{{!readOnly}}"
                type="primary"
                block="{{true}}"
                loading="{{confirming || photoConfirmDisabled}}"
                disabled="{{confirming || photoConfirmDisabled}}"
                bind:btntap="onConfirmPhotoStep"
              >{{photoConfirmLabel}}</ui-button>
            </block>

            <block wx:elif="{{activeKind === 'inspection_report'}}">
              <view class="merchant-flow-page__sheet">
                <view class="merchant-flow-page__sheet-meta">
                  <text class="text-caption text-secondary">{{docPayload.vehicleBrand}} {{docPayload.vehicleSeries}}</text>
                  <text wx:if="{{docPayload.mileageText}}" class="text-caption text-secondary">{{docPayload.mileageText}}</text>
                </view>

                <view class="merchant-flow-page__sheet-section">
                  <view class="merchant-flow-page__sheet-title-row">
                    <view class="merchant-flow-page__sheet-rail" />
                    <text class="text-body merchant-flow-page__sheet-title">进店主诉</text>
                  </view>
                  <textarea
                    class="merchant-flow-page__sheet-textarea"
                    value="{{chiefComplaint}}"
                    maxlength="300"
                    auto-height="{{true}}"
                    placeholder="{{chiefComplaintPlaceholder}}"
                    disabled="{{readOnly}}"
                    bindinput="onChiefComplaintInput"
                  />
                  <template is="aiFieldHint" data="{{hint: chiefComplaintHint}}" />
                </view>

                <view class="merchant-flow-page__sheet-section">
                  <view class="merchant-flow-page__sheet-title-row">
                    <view class="merchant-flow-page__sheet-rail" />
                    <text class="text-body merchant-flow-page__sheet-title">检测发现</text>
                    <text class="text-caption text-secondary">{{findings.length}} 项</text>
                  </view>
                  <view wx:if="{{!findings.length}}" class="text-caption text-secondary">暂无发现项</view>
                  <view
                    wx:for="{{findings}}"
                    wx:key="url"
                    class="merchant-flow-page__evidence-row {{item.evidenceRowClass}}"
                  >
                    <image
                      class="merchant-flow-page__evidence-img image-placeholder"
                      src="{{item.url}}"
                      mode="aspectFill"
                    />
                    <view class="merchant-flow-page__evidence-body">
                      <input
                        class="merchant-flow-page__sheet-input merchant-flow-page__sheet-input--inline"
                        placeholder="{{findingPartPlaceholder}}"
                        value="{{item.partName}}"
                        data-index="{{index}}"
                        data-field="partName"
                        disabled="{{readOnly}}"
                        bindinput="onFindingFieldInput"
                      />
                      <view class="merchant-flow-page__result-seg merchant-flow-page__result-seg--compact">
                        <view
                          wx:for="{{item.resultOptions}}"
                          wx:for-item="opt"
                          wx:key="value"
                          class="merchant-flow-page__result-seg-item {{opt.selected ? 'merchant-flow-page__result-seg-item--on' : ''}} {{opt.selected ? item.resultToneClass : ''}}"
                          data-index="{{index}}"
                          data-value="{{opt.value}}"
                          bindtap="onSelectReportFindingResult"
                        >{{opt.shortLabel || opt.value}}</view>
                      </view>
                      <textarea
                        wx:if="{{item.result && !item.recordOnly}}"
                        class="merchant-flow-page__sheet-textarea"
                        placeholder="{{item.advicePlaceholder || (item.adviceRequired ? findingAdvicePlaceholder : '无需处理')}}"
                        value="{{item.advice}}"
                        maxlength="500"
                        auto-height="{{true}}"
                        data-index="{{index}}"
                        data-field="advice"
                        disabled="{{readOnly || !item.adviceRequired}}"
                        bindinput="onFindingFieldInput"
                      />
                      <template is="aiFieldHint" data="{{hint: item.adviceHint}}" />
                    </view>
                  </view>
                  <text class="text-caption merchant-flow-page__sheet-foot">{{docPayload.disclaimer}}</text>
                </view>

                <view class="merchant-flow-page__sheet-section merchant-flow-page__sheet-section--plan">
                  <view class="merchant-flow-page__sheet-title-row">
                    <view class="merchant-flow-page__sheet-rail merchant-flow-page__sheet-rail--plan" />
                    <text class="text-body merchant-flow-page__sheet-title">方案与费用</text>
                  </view>
                  <view wx:for="{{quoteLines}}" wx:key="index" class="merchant-flow-page__plan-row">
                    <view
                      wx:if="{{!readOnly}}"
                      class="merchant-flow-page__plan-row-remove"
                      data-index="{{index}}"
                      catchtap="onRemoveQuoteLine"
                    >×</view>
                    <template is="quoteEvidencePicker" data="{{item, index, locked: quoteEvidenceLocked}}" />
                    <view class="merchant-flow-page__plan-row-top">
                      <input
                        class="merchant-flow-page__sheet-input merchant-flow-page__sheet-input--inline merchant-flow-page__plan-name"
                        placeholder="{{quoteJobPlaceholder}}"
                        value="{{item.name}}"
                        data-index="{{index}}"
                        data-field="name"
                        disabled="{{readOnly}}"
                        bindinput="onQuoteLineInput"
                      />
                      <view class="merchant-flow-page__plan-amount-wrap">
                        <text class="text-caption text-secondary">¥</text>
                        <input
                          class="merchant-flow-page__sheet-input merchant-flow-page__sheet-input--amount"
                          placeholder="0"
                          type="digit"
                          value="{{item.amount}}"
                          data-index="{{index}}"
                          data-field="amount"
                          disabled="{{readOnly}}"
                          bindinput="onQuoteLineInput"
                        />
                      </view>
                    </view>
                    <template is="aiFieldHint" data="{{hint: item.nameHint}}" />
                    <input
                      class="merchant-flow-page__sheet-input merchant-flow-page__sheet-input--inline"
                      placeholder="品牌（选填）"
                      value="{{item.brand}}"
                      data-index="{{index}}"
                      data-field="brand"
                      disabled="{{readOnly}}"
                      bindinput="onQuoteLineInput"
                    />
                    <textarea
                      class="merchant-flow-page__plan-note"
                      placeholder="{{quoteNotePlaceholder}}"
                      value="{{item.note}}"
                      maxlength="500"
                      auto-height="{{true}}"
                      data-index="{{index}}"
                      data-field="note"
                      disabled="{{readOnly}}"
                      bindinput="onQuoteLineInput"
                    />
                  </view>
                  <view class="merchant-flow-page__plan-total-bar">
                    <text class="text-h3">{{quoteTotalLabel}}</text>
                  </view>
                  <view
                    wx:if="{{!readOnly}}"
                    class="merchant-flow-page__plan-add"
                    bindtap="onAddQuoteLine"
                  >
                    <text class="text-caption text-link">+ 添加一行</text>
                  </view>
                </view>
              </view>
              <view wx:if="{{!readOnly}}" class="merchant-flow-page__doc-actions">
                <ui-button type="ghost" block="{{true}}" loading="{{saving}}" bind:btntap="onSaveDocDraft">保存草稿</ui-button>
                <text
                  wx:if="{{aiReview.isWaiting}}"
                  class="text-caption merchant-flow-page__ai-status"
                >{{aiReview.waitHint}}</text>
                <ui-button type="primary" block="{{true}}" loading="{{confirming || notifyConfirmDisabled}}" disabled="{{confirming || notifyConfirmDisabled}}" bind:btntap="onNotifyOwnerPlan">{{notifyOwnerLabel}}</ui-button>
              </view>
            </block>

            <block wx:elif="{{activeKind === 'quote_confirm'}}">
              <view class="merchant-flow-page__sheet">
                <view class="merchant-flow-page__sheet-section merchant-flow-page__sheet-section--plan">
                  <view class="merchant-flow-page__sheet-title-row">
                    <view class="merchant-flow-page__sheet-rail merchant-flow-page__sheet-rail--plan" />
                    <text class="text-body merchant-flow-page__sheet-title">{{isAddonQuote ? '项目与费用' : '方案与费用'}}</text>
                  </view>
                  <view wx:for="{{quoteLines}}" wx:key="index" class="merchant-flow-page__plan-row">
                    <view
                      wx:if="{{!readOnly && !confirmAwaitingOwner}}"
                      class="merchant-flow-page__plan-row-remove"
                      data-index="{{index}}"
                      catchtap="onRemoveQuoteLine"
                    >×</view>
                    <view wx:if="{{isAddonQuote}}" class="merchant-flow-page__plan-evidence">
                      <view
                        wx:if="{{item.evidenceUrl}}"
                        class="merchant-flow-page__plan-evidence-thumb"
                        data-index="{{index}}"
                        bindtap="onPreviewQuoteEvidence"
                      >
                        <image
                          class="merchant-flow-page__plan-evidence-img image-placeholder"
                          src="{{item.evidenceUrl}}"
                          mode="aspectFill"
                        />
                        <text
                          wx:if="{{!readOnly && !confirmAwaitingOwner}}"
                          class="merchant-flow-page__plan-evidence-remove"
                          data-index="{{index}}"
                          catchtap="onRemoveQuoteEvidence"
                        >×</text>
                      </view>
                      <view
                        wx:elif="{{!readOnly && !confirmAwaitingOwner}}"
                        class="merchant-flow-page__plan-evidence-add"
                        data-index="{{index}}"
                        bindtap="onAddQuoteEvidence"
                      >
                        <text class="merchant-flow-page__plan-evidence-add-icon">+</text>
                        <text class="text-caption text-secondary">故障图</text>
                      </view>
                    </view>
                    <view wx:else>
                      <template
                        is="quoteEvidencePicker"
                        data="{{item, index, locked: quoteEvidenceLocked}}"
                      />
                    </view>
                    <view class="merchant-flow-page__plan-row-top">
                      <input
                        class="merchant-flow-page__sheet-input merchant-flow-page__sheet-input--inline merchant-flow-page__plan-name"
                        placeholder="{{quoteJobPlaceholder}}"
                        value="{{item.name}}"
                        data-index="{{index}}"
                        data-field="name"
                        disabled="{{readOnly || confirmAwaitingOwner}}"
                        bindinput="onQuoteLineInput"
                      />
                      <view class="merchant-flow-page__plan-amount-wrap">
                        <text class="text-caption text-secondary">¥</text>
                        <input
                          class="merchant-flow-page__sheet-input merchant-flow-page__sheet-input--amount"
                          placeholder="0"
                          type="digit"
                          value="{{item.amount}}"
                          data-index="{{index}}"
                          data-field="amount"
                          disabled="{{readOnly || confirmAwaitingOwner}}"
                          bindinput="onQuoteLineInput"
                        />
                      </view>
                    </view>
                    <template is="aiFieldHint" data="{{hint: item.nameHint}}" />
                    <input
                      class="merchant-flow-page__sheet-input merchant-flow-page__sheet-input--inline"
                      placeholder="品牌（选填）"
                      value="{{item.brand}}"
                      data-index="{{index}}"
                      data-field="brand"
                      disabled="{{readOnly || confirmAwaitingOwner}}"
                      bindinput="onQuoteLineInput"
                    />
                    <textarea
                      class="merchant-flow-page__plan-note"
                      placeholder="{{quoteNotePlaceholder}}"
                      value="{{item.note}}"
                      maxlength="500"
                      auto-height="{{true}}"
                      data-index="{{index}}"
                      data-field="note"
                      disabled="{{readOnly || confirmAwaitingOwner}}"
                      bindinput="onQuoteLineInput"
                    />
                  </view>
                  <view class="merchant-flow-page__plan-total-bar">
                    <text class="text-h3">{{quoteTotalLabel}}</text>
                  </view>
                  <view
                    wx:if="{{!readOnly && !confirmAwaitingOwner}}"
                    class="merchant-flow-page__plan-add"
                    bindtap="onAddQuoteLine"
                  >
                    <text class="text-caption text-link">+ 添加一行</text>
                  </view>
                </view>
              </view>
              <view wx:if="{{!readOnly}}" class="merchant-flow-page__doc-actions">
                <block wx:if="{{!confirmAwaitingOwner}}">
                  <ui-button
                    type="primary"
                    block="{{true}}"
                    loading="{{confirming}}"
                    bind:btntap="onSendForOwnerConfirm"
                  >发送车主确认</ui-button>
                </block>
                <block wx:else>
                  <text class="text-caption text-secondary merchant-flow-page__await-hint">等待车主确认</text>
                  <ui-button
                    type="secondary"
                    block="{{true}}"
                    loading="{{confirming}}"
                    bind:btntap="onProxyConfirm"
                  >车主已口头确认</ui-button>
                </block>
                <ui-button
                  wx:if="{{isAddonQuote}}"
                  type="ghost"
                  block="{{true}}"
                  loading="{{confirming}}"
                  bind:btntap="onOpenCancelAddon"
                >取消本项</ui-button>
              </view>
            </block>

            <block wx:elif="{{activeKind === 'work_order'}}">
              <view class="merchant-flow-page__doc-block">
                <view wx:for="{{docPayload.items}}" wx:key="name" class="merchant-flow-page__work-item">
                  <text class="text-body">{{item.name}}</text>
                  <text class="text-caption">¥{{item.amount}}</text>
                  <text class="text-caption text-secondary">{{item.note}}</text>
                </view>
                <text wx:if="{{!docPayload.items || !docPayload.items.length}}" class="text-caption text-secondary">方案确认后自动带入</text>
              </view>
              <ui-button
                wx:if="{{!readOnly}}"
                type="primary"
                block="{{true}}"
                loading="{{confirming}}"
                bind:btntap="onMarkWorkOrderDone"
              >开始施工</ui-button>
            </block>

            <block wx:elif="{{activeKind === 'repair_report'}}">
              <view class="merchant-flow-page__doc-block">
                <text class="text-caption text-secondary">已施工项目</text>
                <view wx:for="{{docPayload.workItems}}" wx:key="name" class="merchant-flow-page__work-item">
                  <text class="text-body">{{item.name}}</text>
                  <text class="text-caption">¥{{item.amount}}</text>
                </view>
                <text class="text-body merchant-flow-page__label">合计 ¥{{docPayload.totalAmount}}</text>
                <text class="text-body merchant-flow-page__label">质保期限</text>
                <textarea
                  class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                  placeholder="例：1 年或 5000 公里，以先到为准"
                  value="{{warrantyPeriod}}"
                  maxlength="120"
                  auto-height="{{true}}"
                  data-field="warrantyPeriod"
                  disabled="{{readOnly}}"
                  bindinput="onWarrantyFieldInput"
                />
                <text class="text-body merchant-flow-page__label">注意事项</text>
                <textarea
                  class="merchant-flow-page__textarea merchant-flow-page__textarea--field"
                  placeholder="例：仅限本次已确认项目；外力撞击、涉水除外"
                  value="{{warrantyNotes}}"
                  maxlength="300"
                  auto-height="{{true}}"
                  data-field="warrantyNotes"
                  disabled="{{readOnly}}"
                  bindinput="onWarrantyFieldInput"
                />
              </view>
              <view wx:if="{{!readOnly}}" class="merchant-flow-page__doc-actions">
                <block wx:if="{{!confirmAwaitingOwner}}">
                  <ui-button
                    type="primary"
                    block="{{true}}"
                    loading="{{confirming}}"
                    bind:btntap="onSendForOwnerConfirm"
                  >发送车主确认</ui-button>
                </block>
                <block wx:else>
                  <text class="text-caption text-secondary merchant-flow-page__await-hint">等待车主确认</text>
                  <ui-button
                    type="secondary"
                    block="{{true}}"
                    loading="{{confirming}}"
                    bind:btntap="onProxyConfirm"
                  >车主已口头确认</ui-button>
                </block>
              </view>
            </block>
          </view>
        </flow-stepper>

        <view wx:if="{{!readOnly && needManualComplete}}" class="merchant-flow-page__footer-actions">
          <ui-button
            type="primary"
            block="{{true}}"
            loading="{{completing}}"
            bind:btntap="onCompleteAlbum"
          >标记整单完工</ui-button>
        </view>

        <view wx:if="{{showHostEntry}}" class="merchant-flow-page__footer-actions">
          <ui-button
            type="primary"
            block="{{true}}"
            bind:btntap="onGoHostAlbum"
          >{{hosted ? (hostVisibility === 'public' ? '管理托管' : '管理托管') : '托管到案例站'}}</ui-button>
        </view>
      </view>
  </block>

  <view wx:if="{{showCancelAddonModal}}" class="merchant-flow-page__modal-mask" catchtouchmove="true">
    <view class="merchant-flow-page__modal">
      <text class="text-h3">取消本项</text>
      <text class="text-caption text-secondary merchant-flow-page__modal-hint">已发给车主，取消后车主可见原因，并回到施工。</text>
      <textarea
        class="merchant-flow-page__textarea merchant-flow-page__textarea--short"
        placeholder="例：沟通后暂不增加 / 误点入口"
        maxlength="200"
        auto-height="{{true}}"
        value="{{cancelAddonReason}}"
        bindinput="onCancelAddonReasonInput"
      />
      <view class="merchant-flow-page__modal-actions">
        <ui-button type="ghost" block="{{true}}" bind:btntap="onCloseCancelAddonModal">返回</ui-button>
        <ui-button type="primary" block="{{true}}" loading="{{confirming}}" bind:btntap="onConfirmCancelAddon">确认取消</ui-button>
      </view>
    </view>
  </view>
</view>

.merchant-host-page {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-xl) + 120rpx);
}

.merchant-host-page__intro {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.merchant-host-page__hint {
  line-height: 1.5;
}

.merchant-host-page__status {
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__section {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.merchant-host-page__label {
  font-weight: 600;
}

.merchant-host-page__option {
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.merchant-host-page__option.is-on {
  border-color: var(--color-primary);
}

.merchant-host-page__blocks {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  color: var(--color-danger, #e34);
}

.merchant-host-page__field-label {
  margin-top: var(--space-sm);
}

.merchant-host-page__textarea {
  min-height: 160rpx;
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  font-size: var(--font-size-body, 28rpx);
}

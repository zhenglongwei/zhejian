.merchant-host-page {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-xl) + 140rpx);
}

.merchant-host-page__intro {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.merchant-host-page__hint {
  line-height: 1.5;
}

.merchant-host-page__status {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__section {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.merchant-host-page__label {
  font-weight: 600;
}

.merchant-host-page__option {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.merchant-host-page__option.is-on {
  border-color: var(--color-primary);
}

.merchant-host-page__option.is-busy {
  opacity: 0.72;
  pointer-events: none;
}

.merchant-host-page__wait {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-top: var(--space-xs);
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--color-warning);
  background-color: var(--color-warning-light);
  animation: merchant-host-wait-pulse 1.6s ease-in-out infinite;
}

.merchant-host-page__wait-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-xs);
}

.merchant-host-page__wait-text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-warning);
  line-height: 1.4;
}

.merchant-host-page__wait-hint {
  font-size: var(--font-size-caption);
  color: var(--color-mch-amber);
  line-height: 1.4;
}

.merchant-host-page__wait-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  height: 1em;
}

.merchant-host-page__wait-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-warning);
  opacity: 0.28;
  animation: merchant-host-wait-dot 1s ease-in-out infinite;
}

.merchant-host-page__wait-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.merchant-host-page__wait-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes merchant-host-wait-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.78;
  }
}

@keyframes merchant-host-wait-dot {
  0%,
  80%,
  100% {
    opacity: 0.28;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-2rpx);
  }
}

.merchant-host-page__mask-status {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin: var(--space-sm) 0 var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.merchant-host-page__mask-status.is-warn {
  border-color: var(--color-warning);
  background-color: var(--color-warning-light);
}

.merchant-host-page__mask-status.is-ok {
  border-color: var(--color-success);
  background-color: var(--color-success-light);
}

.merchant-host-page__archive {
  margin-top: var(--space-sm);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
}

.merchant-host-page__mask-board {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin: var(--space-sm) 0 var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.merchant-host-page__mask-board.is-warn {
  border-color: var(--color-warning);
  background-color: var(--color-warning-light);
}

.merchant-host-page__mask-board.is-ok {
  border-color: var(--color-success);
  background-color: var(--color-success-light);
}

.merchant-host-page__mask-title {
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.merchant-host-page__mask-hint {
  color: var(--color-text-secondary);
}

.merchant-host-page__mask-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-sm);
}

.merchant-host-page__mask-cell {
  position: relative;
  height: 196rpx;
  overflow: hidden;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
  border: 4rpx solid transparent;
}

.merchant-host-page__mask-cell.is-open {
  border-color: var(--color-warning);
}

.merchant-host-page__mask-cell.is-done {
  border-color: var(--color-success);
}

.merchant-host-page__mask-img {
  width: 100%;
  height: 100%;
}

.merchant-host-page__mask-tag {
  position: absolute;
  top: var(--space-xs);
  left: var(--space-xs);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: var(--font-weight-semibold);
}

.merchant-host-page__mask-tag.is-open {
  color: var(--color-text-inverse);
  background-color: var(--color-warning);
}

.merchant-host-page__mask-tag.is-done {
  color: var(--color-text-inverse);
  background-color: var(--color-success);
}

.merchant-host-page__actions--mask {
  margin-top: 0;
}

.merchant-host-page__review {
  margin-top: var(--space-sm);
}

.merchant-host-page__empty {
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__tips {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__tips--geo {
  margin-bottom: var(--space-lg);
}

.merchant-host-page__tip {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.merchant-host-page__blocks {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  color: var(--color-danger);
}

.merchant-host-page__actions {
  margin-top: var(--space-sm);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-host-page__field-label {
  margin-top: var(--space-sm);
}

.merchant-host-page__field-hint {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-warning);
}

.merchant-host-page__textarea {
  min-height: 180rpx;
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  font-size: var(--font-size-body);
  box-sizing: border-box;
  width: 100%;
}

.merchant-host-page__textarea--sm {
  min-height: 120rpx;
}

.merchant-host-page__copy {
  margin-top: var(--space-lg);
}

.merchant-host-page__highlights,
.merchant-host-page__faq {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-top: var(--space-md);
}

.merchant-host-page__empty-hint {
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  line-height: 1.5;
}

.merchant-host-page__edit-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__edit-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.merchant-host-page__edit-remove {
  color: var(--color-primary);
  padding: var(--space-xs);
}

.merchant-host-page__input {
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-card);
  font-size: var(--font-size-body);
  box-sizing: border-box;
  width: 100%;
}

.merchant-host-page__agreement {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: var(--z-popup);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background-color: var(--color-mask);
}

.merchant-host-page__agreement-panel {
  display: flex;
  flex-direction: column;
  max-height: 85vh;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  box-shadow: var(--shadow-popup);
  overflow: hidden;
}

.merchant-host-page__agreement-head {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-lg) var(--space-md) var(--space-md);
  border-bottom: 1rpx solid var(--color-border);
}

.merchant-host-page__agreement-title {
  font-weight: 600;
}

.merchant-host-page__agreement-body {
  flex: 1;
  height: 50vh;
  padding: var(--space-md);
  box-sizing: border-box;
}

.merchant-host-page__agreement-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.merchant-host-page__agreement-heading {
  font-weight: 600;
}

.merchant-host-page__agreement-para {
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 核心免责条款（第四/五条）：显著提示，避免埋入滚动正文 */
.merchant-host-page__agreement-section--emphasis {
  padding: var(--space-md);
  background-color: var(--color-warning-light);
  border-radius: var(--radius-md);
}

.merchant-host-page__agreement-section--emphasis .merchant-host-page__agreement-para {
  color: var(--color-text-primary);
}

.merchant-host-page__agreement-foot {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-md);
  border-top: 1rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.merchant-host-page__agreement-btn {
  flex: 1;
  min-width: 0;
}


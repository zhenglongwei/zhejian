.merchant-host-page {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-xl) + 140rpx);
}

.merchant-host-page__intro {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.merchant-host-page__hint {
  line-height: 1.5;
}

.merchant-host-page__steps {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.merchant-host-page__step {
  flex: 1;
  padding: var(--space-xs) 0;
  text-align: center;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  border-bottom: 4rpx solid var(--color-border);
}

.merchant-host-page__step.is-on {
  color: var(--color-primary);
  font-weight: 600;
  border-bottom-color: var(--color-primary);
}

.merchant-host-page__status {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__section {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.merchant-host-page__label {
  font-weight: 600;
}

.merchant-host-page__option {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.merchant-host-page__option.is-on {
  border-color: var(--color-primary);
}

.merchant-host-page__review {
  margin-top: var(--space-sm);
}

.merchant-host-page__empty {
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__blocks {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  color: var(--color-danger);
}

.merchant-host-page__actions {
  margin-top: var(--space-sm);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-host-page__field-label {
  margin-top: var(--space-sm);
}

.merchant-host-page__textarea {
  min-height: 180rpx;
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  font-size: var(--font-size-body);
  box-sizing: border-box;
  width: 100%;
}

.merchant-host-page__textarea--sm {
  min-height: 120rpx;
}

.merchant-host-page__highlights,
.merchant-host-page__faq {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-top: var(--space-md);
}

.merchant-host-page__empty-hint {
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  line-height: 1.5;
}

.merchant-host-page__edit-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__edit-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.merchant-host-page__edit-remove {
  color: var(--color-primary);
  padding: var(--space-xs);
}

.merchant-host-page__input {
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-card);
  font-size: var(--font-size-body);
  box-sizing: border-box;
  width: 100%;
}

.merchant-host-page__mask-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: var(--z-toast);
  background-color: var(--color-mask);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  box-sizing: border-box;
}

.merchant-host-page__mask-panel {
  max-height: 92vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: var(--space-md);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  background-color: var(--color-bg-card);
  box-sizing: border-box;
}

.merchant-host-page__mask-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
}

.merchant-host-page__mask-close {
  color: var(--color-primary);
  font-size: var(--font-size-caption);
  padding: var(--space-xs);
}

.merchant-host-page__mask-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
}

@import '../../../../styles/mch-craft.wxss';

.merchant-host-page {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-xl) + 140rpx);
}

.merchant-host-page__intro {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.merchant-host-page__hint {
  line-height: 1.5;
}

.merchant-host-page__status {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__section {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.merchant-host-page__label {
  font-weight: 600;
}

.merchant-host-page__copy-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.merchant-host-page__option {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.merchant-host-page__option.is-on {
  border-color: var(--color-primary);
  background-color: var(--color-primary-light);
}

.merchant-host-page__option.is-busy {
  opacity: 0.72;
  pointer-events: none;
}

.merchant-host-page__wait {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-top: var(--space-xs);
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--color-warning);
  background-color: var(--color-warning-light);
  animation: merchant-host-wait-pulse 1.6s ease-in-out infinite;
}

.merchant-host-page__wait-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-xs);
}

.merchant-host-page__wait-text {
  font-size: var(--font-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-warning);
  line-height: 1.4;
}

.merchant-host-page__wait-hint {
  font-size: var(--font-caption);
  color: var(--color-mch-amber-deep);
  line-height: 1.4;
}

.merchant-host-page__wait-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  height: 1em;
}

.merchant-host-page__wait-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-warning);
  opacity: 0.28;
  animation: merchant-host-wait-dot 1s ease-in-out infinite;
}

.merchant-host-page__wait-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.merchant-host-page__wait-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes merchant-host-wait-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.78;
  }
}

@keyframes merchant-host-wait-dot {
  0%,
  80%,
  100% {
    opacity: 0.28;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-2rpx);
  }
}

.merchant-host-page__mask-status {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin: var(--space-sm) 0 var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.merchant-host-page__mask-status.is-warn {
  border-color: var(--color-warning);
  background-color: var(--color-warning-light);
}

.merchant-host-page__mask-status.is-ok {
  border-color: var(--color-success);
  background-color: var(--color-success-light);
}

.merchant-host-page__archive {
  margin-top: var(--space-sm);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  box-shadow: var(--mch-shadow-card);
}

.merchant-host-page__mask-hint {
  color: var(--color-text-secondary);
}

.merchant-host-page__empty {
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__tips {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__tip {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.merchant-host-page__blocks {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  color: var(--color-danger);
}

.merchant-host-page__actions {
  margin-top: var(--space-sm);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-host-page__field-label {
  margin-top: var(--space-sm);
}

.merchant-host-page__field-hint {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-warning);
}

.merchant-host-page__textarea {
  min-height: 180rpx;
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  font-size: var(--font-body);
  box-sizing: border-box;
  width: 100%;
}

.merchant-host-page__textarea--sm {
  min-height: 120rpx;
}

.merchant-host-page__copy {
  margin-top: var(--space-lg);
}

/* 店页摘要正文（只读）：与下方问答用发丝线分段 */
.merchant-host-page__summary {
  display: block;
  padding-bottom: var(--space-md);
  border-bottom: 1rpx solid var(--color-border);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-primary);
}

/* 常见问法（只读）：蓝色 Q 编号打头，问题作扫读锚点，答案缩进对齐到问题文字下方 */
.merchant-host-page__qa {
  display: flex;
  flex-direction: column;
}

.merchant-host-page__qa-item {
  display: flex;
  flex-direction: column;
  padding: var(--space-md) 0;
}

.merchant-host-page__qa-item:first-child {
  padding-top: var(--space-xs);
}

.merchant-host-page__qa-item:last-child {
  padding-bottom: 0;
}

/* 只在条目之间画发丝线，首条上方不留孤线 */
.merchant-host-page__qa-item + .merchant-host-page__qa-item {
  border-top: 1rpx solid var(--color-border);
}

.merchant-host-page__qa-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: var(--space-sm);
}

.merchant-host-page__qa-no {
  flex: none;
  width: 44rpx;
  font-size: var(--font-caption);
  line-height: var(--font-h3-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}

.merchant-host-page__qa-q {
  flex: 1;
  min-width: 0;
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 缩进 = Q 编号宽(44) + 间隙(16)，答案左缘对齐问题文字 */
.merchant-host-page__qa-a {
  margin-top: var(--space-xs);
  padding-left: 60rpx;
  font-size: var(--font-sub);
  line-height: var(--font-sub-lh);
  color: var(--color-text-secondary);
}

.merchant-host-page__faq {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-top: var(--space-md);
}

.merchant-host-page__empty-hint {
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  line-height: 1.5;
}

.merchant-host-page__edit-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__edit-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.merchant-host-page__edit-remove {
  color: var(--color-primary);
  padding: var(--space-xs);
}

.merchant-host-page__input {
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-card);
  font-size: var(--font-body);
  box-sizing: border-box;
  width: 100%;
}

.merchant-host-page__agreement {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: var(--z-popup);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background-color: var(--color-mask);
}

.merchant-host-page__agreement-panel {
  display: flex;
  flex-direction: column;
  height: 88vh;
  max-height: 88vh;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  box-shadow: var(--shadow-popup);
  overflow: hidden;
}

/* 协议头：居中标题，和页面里左对齐的文案标签区分开 */
.merchant-host-page__agreement-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  padding: var(--space-lg) var(--space-lg) var(--space-md);
  border-bottom: 1rpx solid var(--color-border);
}

.merchant-host-page__agreement-title {
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  text-align: center;
}

.merchant-host-page__agreement-body {
  flex: 1;
  height: 0;
  padding: var(--space-md);
  box-sizing: border-box;
  background-color: var(--color-bg-page);
}

/* 整份协议排成一张「纸」：连续正文 + 条款分隔线，不再用页面卡片样式 */
.merchant-host-page__agreement-paper {
  padding: var(--space-lg) var(--space-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-card);
}

.merchant-host-page__agreement-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding-bottom: var(--space-md);
  margin-bottom: var(--space-md);
  border-bottom: 1rpx dashed var(--color-border);
}

.merchant-host-page__agreement-section:last-child {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: 0;
}

.merchant-host-page__agreement-heading {
  font-size: var(--font-sub);
  line-height: var(--font-sub-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.merchant-host-page__agreement-para {
  font-size: var(--font-sub);
  line-height: 1.9;
  color: var(--color-text-secondary);
}

/* 核心免责条款：左侧警示条 + 浅底，提示但不做整块橙色卡片 */
.merchant-host-page__agreement-section--emphasis {
  padding: var(--space-sm) var(--space-md);
  border-bottom: 0;
  border-left: 6rpx solid var(--color-warning);
  border-radius: var(--radius-sm);
  background-color: var(--color-warning-light);
}

.merchant-host-page__agreement-section--emphasis .merchant-host-page__agreement-heading {
  color: var(--color-text-primary);
}

.merchant-host-page__agreement-section--emphasis .merchant-host-page__agreement-para {
  color: var(--color-text-primary);
}

.merchant-host-page__agreement-foot {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-md);
  border-top: 1rpx solid var(--color-border);
  background-color: var(--color-bg-card);
  box-shadow: var(--shadow-card-soft);
}

.merchant-host-page__agreement-btn {
  flex: 1;
  min-width: 0;
}


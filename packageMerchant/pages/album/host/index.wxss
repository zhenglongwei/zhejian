.merchant-host-page {
  padding: var(--space-md);
  padding-bottom: calc(var(--space-xl) + 140rpx);
}

.merchant-host-page__intro {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.merchant-host-page__hint {
  line-height: 1.5;
}

.merchant-host-page__steps {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.merchant-host-page__step {
  flex: 1;
  padding: var(--space-xs) 0;
  text-align: center;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  border-bottom: 4rpx solid var(--color-border);
}

.merchant-host-page__step.is-on {
  color: var(--color-primary);
  font-weight: 600;
  border-bottom-color: var(--color-primary);
}

.merchant-host-page__step.is-reached {
  color: var(--color-text-primary);
}

.merchant-host-page__step.is-locked {
  color: var(--color-text-tertiary);
}

.merchant-host-page__status {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__section {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.merchant-host-page__label {
  font-weight: 600;
}

.merchant-host-page__option {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.merchant-host-page__option.is-on {
  border-color: var(--color-primary);
}

.merchant-host-page__mask-status {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin: var(--space-sm) 0 var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.merchant-host-page__mask-status.is-warn {
  border-color: var(--color-warning);
  background-color: var(--color-warning-light);
}

.merchant-host-page__mask-status.is-ok {
  border-color: var(--color-success);
  background-color: var(--color-success-light);
}

.merchant-host-page__archive {
  margin-top: var(--space-sm);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
}

.merchant-host-page__mask-board {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin: var(--space-sm) 0 var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.merchant-host-page__mask-board.is-warn {
  border-color: var(--color-warning);
  background-color: var(--color-warning-light);
}

.merchant-host-page__mask-board.is-ok {
  border-color: var(--color-success);
  background-color: var(--color-success-light);
}

.merchant-host-page__mask-title {
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.merchant-host-page__mask-hint {
  color: var(--color-text-secondary);
}

.merchant-host-page__mask-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-sm);
}

.merchant-host-page__mask-cell {
  position: relative;
  height: 196rpx;
  overflow: hidden;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
  border: 4rpx solid transparent;
}

.merchant-host-page__mask-cell.is-open {
  border-color: var(--color-warning);
}

.merchant-host-page__mask-cell.is-done {
  border-color: var(--color-success);
}

.merchant-host-page__mask-img {
  width: 100%;
  height: 100%;
}

.merchant-host-page__mask-tag {
  position: absolute;
  top: var(--space-xs);
  left: var(--space-xs);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: var(--font-weight-semibold);
}

.merchant-host-page__mask-tag.is-open {
  color: var(--color-text-inverse);
  background-color: var(--color-warning);
}

.merchant-host-page__mask-tag.is-done {
  color: var(--color-text-inverse);
  background-color: var(--color-success);
}

.merchant-host-page__actions--mask {
  margin-top: 0;
}

.merchant-host-page__review {
  margin-top: var(--space-sm);
}

.merchant-host-page__empty {
  padding: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__tips {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__tips--geo {
  margin-bottom: var(--space-lg);
}

.merchant-host-page__tip {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.merchant-host-page__blocks {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  color: var(--color-danger);
}

.merchant-host-page__actions {
  margin-top: var(--space-sm);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.merchant-host-page__field-label {
  margin-top: var(--space-sm);
}

.merchant-host-page__field-hint {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-warning);
}

.merchant-host-page__textarea {
  min-height: 180rpx;
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  font-size: var(--font-size-body);
  box-sizing: border-box;
  width: 100%;
}

.merchant-host-page__textarea--sm {
  min-height: 120rpx;
}

.merchant-host-page__highlights,
.merchant-host-page__faq {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-top: var(--space-md);
}

.merchant-host-page__empty-hint {
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
  line-height: 1.5;
}

.merchant-host-page__edit-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

.merchant-host-page__edit-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.merchant-host-page__edit-remove {
  color: var(--color-primary);
  padding: var(--space-xs);
}

.merchant-host-page__input {
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-card);
  font-size: var(--font-size-body);
  box-sizing: border-box;
  width: 100%;
}


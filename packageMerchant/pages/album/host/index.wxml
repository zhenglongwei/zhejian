<page-meta page-style="{{maskEditorVisible ? 'overflow: hidden;' : ''}}" />
<view class="page merchant-host-page page-content">
  <block wx:if="{{status === 'loading'}}">
    <text class="text-caption text-secondary">加载中…</text>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <text class="text-body">{{errorMessage}}</text>
    <ui-button type="ghost" block="{{true}}" bind:btntap="onRetry">重试</ui-button>
  </block>

  <block wx:else>
    <view class="merchant-host-page__intro">
      <text class="text-body">{{serviceName}}</text>
      <text class="text-caption text-secondary merchant-host-page__hint">
        把本单原始档案存到案例站；要上店页时，再核对将公开的内容并写好说明。
      </text>
    </view>

    <view class="merchant-host-page__steps">
      <text class="merchant-host-page__step {{wizardStep === 1 ? 'is-on' : ''}}">1 存档</text>
      <text class="merchant-host-page__step {{wizardStep === 2 ? 'is-on' : ''}}">2 核对内容</text>
      <text class="merchant-host-page__step {{wizardStep === 3 ? 'is-on' : ''}}">3 店页说明</text>
    </view>

    <!-- 步骤 1：存档 -->
    <block wx:if="{{wizardStep === 1}}">
      <view wx:if="{{hosted && hostVisibility === 'public'}}" class="merchant-host-page__status">
        <text class="text-body">已在店页公开</text>
        <text class="text-caption text-secondary">可取消公开，档案仍保留。</text>
      </view>
      <view wx:elif="{{hosted}}" class="merchant-host-page__status">
        <text class="text-body">已私密托管</text>
        <text class="text-caption text-secondary">仅案例站存档，店页不展示。</text>
      </view>

      <view wx:if="{{!hosted}}" class="merchant-host-page__section">
        <text class="text-body merchant-host-page__label">存档方式</text>
        <view
          class="merchant-host-page__option {{hostMode === 'private' ? 'is-on' : ''}}"
          data-mode="private"
          bindtap="onSelectMode"
        >
          <text class="text-body">仅私密</text>
          <text class="text-caption text-secondary">存档备查，不上店页</text>
        </view>
        <view
          class="merchant-host-page__option {{hostMode === 'public' ? 'is-on' : ''}}"
          data-mode="public"
          bindtap="onSelectMode"
        >
          <text class="text-body">准备公开</text>
          <text class="text-caption text-secondary">下一步核对将公开的图文，再写店页说明</text>
        </view>
      </view>
    </block>

    <!-- 步骤 2：通读本单报告，再脱敏 -->
    <block wx:elif="{{wizardStep === 2}}">
      <view class="merchant-host-page__section">
        <text class="text-body merchant-host-page__label">通读本单内容</text>
        <text class="text-caption text-secondary">点图片在本页打码；打完后直接显示打码图。也可一键 AI 脱敏。</text>

        <view wx:if="{{reviewDocs.length}}" class="merchant-host-page__review">
          <album-service-flow
            docs="{{reviewDocs}}"
            imageTapMode="edit"
            bind:imageedit="onReviewImageEdit"
          />
        </view>
        <view wx:else class="merchant-host-page__empty">
          <text class="text-caption text-secondary">暂无报告内容。请先在服务进度里完成检测/方案/工单/完工后再来。</text>
        </view>

        <view wx:if="{{privacyBlocks.length}}" class="merchant-host-page__blocks">
          <text wx:for="{{privacyBlocks}}" wx:key="issue" class="text-caption">{{item.message}}</text>
        </view>

        <view class="merchant-host-page__actions">
          <ui-button type="primary" block="{{true}}" loading="{{working}}" bind:btntap="onRunHostAutoMask">
            一键 AI 脱敏
          </ui-button>
        </view>
      </view>
    </block>

    <!-- 步骤 3：店页说明 -->
    <block wx:elif="{{wizardStep === 3}}">
      <view class="merchant-host-page__section">
        <text class="text-body merchant-host-page__label">将出现在店页上的说明</text>
        <text class="text-caption text-secondary">可改；确认后才会公开展示。</text>

        <text class="text-caption merchant-host-page__field-label">摘要</text>
        <textarea
          class="merchant-host-page__textarea"
          value="{{geoSummary}}"
          maxlength="500"
          bindinput="onGeoSummaryInput"
          placeholder="本单做了什么、查到什么、怎么处理"
        />

        <view class="merchant-host-page__highlights">
          <text class="text-caption merchant-host-page__field-label">要点</text>
          <text wx:if="{{geoHighlightsEmpty}}" class="text-caption text-secondary merchant-host-page__empty-hint">
            {{geoHighlightsEmptyHint}}
          </text>
          <view wx:for="{{geoHighlights}}" wx:key="_k" class="merchant-host-page__edit-row">
            <view class="merchant-host-page__edit-row-head">
              <text class="text-caption text-secondary">要点 {{index + 1}}</text>
              <text
                class="text-caption merchant-host-page__edit-remove"
                data-index="{{index}}"
                bindtap="onRemoveHighlight"
              >删除</text>
            </view>
            <input
              class="merchant-host-page__input"
              value="{{item.label}}"
              data-index="{{index}}"
              data-field="label"
              bindinput="onHighlightFieldInput"
              maxlength="12"
              placeholder="标签，如车型 / 检测"
            />
            <input
              class="merchant-host-page__input"
              value="{{item.value}}"
              data-index="{{index}}"
              data-field="value"
              bindinput="onHighlightFieldInput"
              maxlength="40"
              placeholder="对应内容"
            />
          </view>
          <ui-button type="ghost" size="sm" bind:btntap="onAddHighlight">添加要点</ui-button>
        </view>

        <view class="merchant-host-page__faq">
          <text class="text-caption merchant-host-page__field-label">常见问法</text>
          <text
            wx:if="{{geoFaqEmpty || geoFaqUnanswered}}"
            class="text-caption text-secondary merchant-host-page__empty-hint"
          >
            {{geoFaqEmptyHint}}
          </text>
          <view wx:for="{{geoFaq}}" wx:key="_k" class="merchant-host-page__edit-row">
            <view class="merchant-host-page__edit-row-head">
              <text class="text-caption text-secondary">问答 {{index + 1}}{{item.needsAnswer || !item.a ? ' · 待填答' : ''}}</text>
              <text
                class="text-caption merchant-host-page__edit-remove"
                data-index="{{index}}"
                bindtap="onRemoveFaq"
              >删除</text>
            </view>
            <input
              class="merchant-host-page__input"
              value="{{item.q}}"
              data-index="{{index}}"
              data-field="q"
              bindinput="onFaqFieldInput"
              maxlength="40"
              placeholder="车主可能怎么问"
            />
            <textarea
              class="merchant-host-page__textarea merchant-host-page__textarea--sm"
              value="{{item.a}}"
              data-index="{{index}}"
              data-field="a"
              bindinput="onFaqFieldInput"
              maxlength="280"
              placeholder="可写：行业惯例 → 本单怎么做 → 差别或优势；空着则公开页不展示"
            />
          </view>
          <ui-button type="ghost" size="sm" bind:btntap="onAddFaq">添加问法</ui-button>
        </view>

        <ui-button type="ghost" block="{{true}}" loading="{{working}}" bind:btntap="onRegenerateCopy">
          重新生成说明
        </ui-button>
      </view>
    </block>
  </block>

  <ui-fixed-bottom-bar wx:if="{{status === 'ready'}}" safeArea="{{true}}">
    <block wx:if="{{wizardStep === 1}}">
      <ui-button
        wx:if="{{!hosted}}"
        type="primary"
        block="{{true}}"
        loading="{{working}}"
        bind:btntap="onSubmitHost"
      >确认存档</ui-button>
      <ui-button
        wx:elif="{{hostVisibility === 'public'}}"
        type="ghost"
        block="{{true}}"
        loading="{{working}}"
        bind:btntap="onCancelPublicIntent"
      >取消公开</ui-button>
      <ui-button
        wx:else
        type="primary"
        block="{{true}}"
        loading="{{working}}"
        bind:btntap="onSwitchToPublic"
      >准备公开</ui-button>
    </block>

    <block wx:elif="{{wizardStep === 2}}">
      <ui-button
        slot="left"
        type="ghost"
        size="sm"
        loading="{{working}}"
        bind:btntap="onCancelPublicIntent"
      >改回仅私密</ui-button>
      <ui-button
        slot="right"
        type="primary"
        loading="{{working}}"
        bind:btntap="onContinueAfterReview"
      >我已核对，继续</ui-button>
    </block>

    <block wx:elif="{{wizardStep === 3}}">
      <ui-button
        slot="left"
        type="ghost"
        size="sm"
        loading="{{working}}"
        bind:btntap="onCancelPublicIntent"
      >改回仅私密</ui-button>
      <ui-button
        slot="right"
        type="primary"
        loading="{{working}}"
        bind:btntap="onConfirmPublic"
      >确认并上店页</ui-button>
    </block>
  </ui-fixed-bottom-bar>

  <view
    wx:if="{{maskEditorVisible}}"
    class="merchant-host-page__mask-layer"
    catchtouchmove="onPreventTouchMove"
  >
    <view class="merchant-host-page__mask-panel" catchtouchmove="onPreventTouchMove">
      <view class="merchant-host-page__mask-head">
        <text class="text-body">打码 · {{maskEditorTitle}}</text>
        <text class="merchant-host-page__mask-close" bindtap="onCloseMaskEditor">关闭</text>
      </view>
      <view class="merchant-host-page__mask-body">
        <ui-image-mask-editor
          imageUrl="{{maskEditorUrl}}"
          nodeTitle="{{maskEditorTitle}}"
          submitting="{{maskEditorSubmitting}}"
          bind:submit="onMaskEditorSubmit"
        />
      </view>
    </view>
  </view>
</view>

<view class="page merchant-host-page page-content">
  <block wx:if="{{status === 'loading'}}">
    <text class="text-caption text-secondary">加载中…</text>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <text class="text-body">{{errorMessage}}</text>
    <ui-button type="ghost" block="{{true}}" bind:btntap="onRetry">重试</ui-button>
  </block>

  <block wx:else>
    <view class="merchant-host-page__intro">
      <text class="text-body">{{serviceName}}</text>
      <text class="text-caption text-secondary merchant-host-page__hint">
        把本单档案存到案例站；公开前预览店页稿，同意责任说明后即可上店页。
      </text>
    </view>

    <view class="merchant-host-page__steps">
      <view
        class="merchant-host-page__step {{wizardStep === 1 ? 'is-on' : ''}} {{wizardMaxStep >= 1 && wizardStep !== 1 ? 'is-reached' : ''}}"
        data-step="1"
        bindtap="onWizardStepTap"
      >1 存档</view>
      <view
        class="merchant-host-page__step {{wizardStep === 2 ? 'is-on' : ''}} {{wizardMaxStep >= 2 && wizardStep !== 2 ? 'is-reached' : ''}} {{wizardMaxStep < 2 ? 'is-locked' : ''}}"
        data-step="2"
        bindtap="onWizardStepTap"
      >2 预览公开</view>
    </view>

    <!-- 步骤 1：存档 -->
    <block wx:if="{{wizardStep === 1}}">
      <view wx:if="{{hosted && hostVisibility === 'public'}}" class="merchant-host-page__status">
        <text class="text-body">已在店页公开</text>
        <text class="text-caption text-secondary">可取消公开，档案仍保留。</text>
      </view>
      <view wx:elif="{{preparingPublicPreview || maskAutoRunning}}" class="merchant-host-page__status">
        <text class="text-body">正在处理图片…</text>
        <text class="text-caption text-secondary">打码完成后再进入预览。</text>
      </view>
      <view wx:elif="{{hosted && wizardMaxStep >= 2}}" class="merchant-host-page__status">
        <text class="text-body">正在准备公开</text>
        <text class="text-caption text-secondary">点上方「预览公开」继续。</text>
      </view>
      <view wx:elif="{{hosted}}" class="merchant-host-page__status">
        <text class="text-body">已私密托管</text>
        <text class="text-caption text-secondary">仅案例站存档，店页不展示。</text>
      </view>

      <view wx:if="{{!hosted}}" class="merchant-host-page__section">
        <text class="text-body merchant-host-page__label">存档方式</text>
        <view
          class="merchant-host-page__option {{hostMode === 'private' ? 'is-on' : ''}}"
          data-mode="private"
          bindtap="onSelectMode"
        >
          <text class="text-body">仅私密</text>
          <text class="text-caption text-secondary">存档备查，不上店页</text>
        </view>
        <view
          class="merchant-host-page__option {{hostMode === 'public' ? 'is-on' : ''}}"
          data-mode="public"
          bindtap="onSelectMode"
        >
          <text class="text-body">公开托管</text>
          <text class="text-caption text-secondary">自动打码后预览店页稿，同意责任说明即可公开</text>
        </view>
      </view>
    </block>

    <!-- 步骤 2：打码后网页预览 + 摘要微调 → 协议后直公开 -->
    <block wx:elif="{{wizardStep === 2}}">
      <view class="merchant-host-page__section">
        <view
          wx:if="{{showMaskBanner}}"
          class="merchant-host-page__mask-status is-ok"
        >
          <text class="text-body">{{maskStatusTitle}}</text>
          <text class="text-caption merchant-host-page__mask-hint">{{maskStatusHint}}</text>
        </view>

        <text class="text-body merchant-host-page__label">将公开的档案预览</text>
        <text class="text-caption text-secondary merchant-host-page__hint">版式接近店页；点图可改码，公开前将确认图文隐私责任。</text>

        <view wx:if="{{archiveChapters.length}}" class="merchant-host-page__archive">
          <host-archive-preview
            chapters="{{archiveChapters}}"
            imageTapMode="edit"
            bind:imageedit="onReviewImageEdit"
          />
        </view>
        <view wx:else class="merchant-host-page__empty">
          <text class="text-caption text-secondary">暂无可公开内容。请先在服务进度里完成检测、方案、工单与交车后再来。</text>
        </view>

        <view wx:if="{{privacyBlocks.length}}" class="merchant-host-page__blocks">
          <text wx:for="{{privacyBlocks}}" wx:key="issue" class="text-caption">{{item.message}}</text>
        </view>

        <view class="merchant-host-page__copy">
          <text class="text-body merchant-host-page__label">店页摘要</text>
          <textarea
            class="merchant-host-page__textarea"
            value="{{geoSummary}}"
            maxlength="500"
            bindinput="onGeoSummaryInput"
            placeholder="什么车、什么问题、怎么处理、结果如何"
          />
          <text wx:if="{{summaryHint}}" class="text-caption merchant-host-page__field-hint">{{summaryHint}}</text>

          <view class="merchant-host-page__faq">
            <text class="text-caption merchant-host-page__field-label">常见问法</text>
            <text
              wx:if="{{faqHint}}"
              class="text-caption merchant-host-page__field-hint"
            >{{faqHint}}</text>
            <text
              wx:elif="{{geoFaqEmpty || geoFaqUnanswered}}"
              class="text-caption text-secondary merchant-host-page__empty-hint"
            >
              {{geoFaqEmptyHint}}
            </text>
            <view wx:for="{{geoFaq}}" wx:key="_k" class="merchant-host-page__edit-row">
              <view class="merchant-host-page__edit-row-head">
                <text class="text-caption text-secondary">问答 {{index + 1}}{{item.needsAnswer || !item.a ? ' · 待填答' : ''}}</text>
                <text
                  class="text-caption merchant-host-page__edit-remove"
                  data-index="{{index}}"
                  bindtap="onRemoveFaq"
                >删除</text>
              </view>
              <input
                class="merchant-host-page__input"
                value="{{item.q}}"
                data-index="{{index}}"
                data-field="q"
                bindinput="onFaqFieldInput"
                maxlength="40"
                placeholder="车主可能怎么问"
              />
              <textarea
                class="merchant-host-page__textarea merchant-host-page__textarea--sm"
                value="{{item.a}}"
                data-index="{{index}}"
                data-field="a"
                bindinput="onFaqFieldInput"
                maxlength="280"
                placeholder="本单怎么做；空着则店页不展示"
              />
            </view>
            <ui-button type="ghost" size="sm" bind:btntap="onAddFaq">添加问法</ui-button>
          </view>
        </view>

        <view wx:if="{{qualitySuggestions.length}}" class="merchant-host-page__tips">
          <text class="text-body merchant-host-page__label">可优化</text>
          <view
            wx:for="{{qualitySuggestions}}"
            wx:key="issue"
            class="merchant-host-page__tip"
          >
            <text class="text-body">{{item.title}}</text>
            <text class="text-caption text-secondary">{{item.suggestion}}</text>
          </view>
        </view>
      </view>
    </block>
  </block>

  <!-- 公开隐私责任协议（完整可滚动；正文可整段替换） -->
  <view wx:if="{{showPrivacyAgreement}}" class="merchant-host-page__agreement">
    <view class="merchant-host-page__agreement-panel">
      <view class="merchant-host-page__agreement-head">
        <text class="text-body merchant-host-page__agreement-title">{{privacyAgreementTitle}}</text>
        <text class="text-caption text-secondary">版本 {{privacyAgreementVersion}}</text>
      </view>
      <scroll-view scroll-y class="merchant-host-page__agreement-body" enhanced="{{true}}" show-scrollbar="{{true}}">
        <view
          wx:for="{{privacyAgreementSections}}"
          wx:key="heading"
          class="merchant-host-page__agreement-section"
        >
          <text class="text-body merchant-host-page__agreement-heading">{{item.heading}}</text>
          <text
            wx:for="{{item.paragraphs}}"
            wx:for-item="para"
            wx:key="*this"
            class="text-caption merchant-host-page__agreement-para"
          >{{para}}</text>
        </view>
      </scroll-view>
      <view class="merchant-host-page__agreement-foot safe-bottom">
        <view class="merchant-host-page__agreement-btn">
          <ui-button type="ghost" block="{{true}}" loading="{{working}}" bind:btntap="onDismissPrivacyAgreement">再看看</ui-button>
        </view>
        <view class="merchant-host-page__agreement-btn">
          <ui-button type="primary" block="{{true}}" loading="{{working}}" bind:btntap="onAcceptPrivacyAgreement">同意公开</ui-button>
        </view>
      </view>
    </view>
  </view>

  <ui-fixed-bottom-bar wx:if="{{status === 'ready' && !showPrivacyAgreement}}" safeArea="{{true}}">
    <block wx:if="{{wizardStep === 1}}">
      <ui-button
        wx:if="{{!hosted}}"
        type="primary"
        block="{{true}}"
        loading="{{working || preparingPublicPreview || maskAutoRunning}}"
        bind:btntap="onSubmitHost"
      >确认存档</ui-button>
      <ui-button
        wx:elif="{{hostVisibility === 'public'}}"
        type="ghost"
        block="{{true}}"
        loading="{{working}}"
        bind:btntap="onCancelPublicIntent"
      >取消公开</ui-button>
      <ui-button
        wx:elif="{{wizardMaxStep >= 2}}"
        type="ghost"
        block="{{true}}"
        loading="{{working || preparingPublicPreview || maskAutoRunning}}"
        bind:btntap="onCancelPublicIntent"
      >改回仅私密</ui-button>
      <ui-button
        wx:else
        type="primary"
        block="{{true}}"
        loading="{{working || preparingPublicPreview || maskAutoRunning}}"
        bind:btntap="onSwitchToPublic"
      >公开托管</ui-button>
    </block>

    <block wx:elif="{{wizardStep === 2}}">
      <ui-button
        slot="left"
        type="ghost"
        size="sm"
        loading="{{working}}"
        bind:btntap="onCancelPublicIntent"
      >改回仅私密</ui-button>
      <ui-button
        slot="right"
        type="primary"
        loading="{{working}}"
        bind:btntap="onContinuePublish"
      >继续公开</ui-button>
    </block>
  </ui-fixed-bottom-bar>
</view>

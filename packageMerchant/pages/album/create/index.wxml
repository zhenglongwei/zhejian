<view class="page merchant-album-page album-create page-content merchant-form-page">
  <ui-privacy-banner scene="albumMerchant" />

  <block wx:if="{{status === 'loading'}}">
    <ui-skeleton rows="{{5}}" title="{{true}}" />
  </block>

  <block wx:else>
    <view class="merchant-form__section">
      <text class="merchant-form__label">所属门店</text>
      <text class="merchant-form__readonly">{{storeName}}</text>
    </view>

    <view class="merchant-form__section album-create__service-section">
      <text class="merchant-form__label">服务项目（必填）</text>
      <input
        class="merchant-form__input album-create__service-input"
        placeholder="点击输入，可选择常见服务或直接填写"
        value="{{form.serviceName}}"
        maxlength="{{16}}"
        bindfocus="onServiceFocus"
        bindblur="onServiceBlur"
        bindinput="onServiceInput"
      />
      <view
        wx:if="{{serviceSuggestVisible && serviceSuggestTags.length}}"
        class="album-create__suggest"
      >
        <text class="album-create__suggest-label text-caption">常见服务</text>
        <view class="album-create__suggest-chips">
          <view
            wx:for="{{serviceSuggestTags}}"
            wx:key="name"
            class="album-create__chip {{item.selected ? 'album-create__chip--on' : ''}}"
            data-name="{{item.name}}"
            catchtap="onPickServiceSuggest"
          >{{item.name}}</view>
        </view>
      </view>
    </view>

    <view class="merchant-form__section">
      <text class="merchant-form__label">车牌号（必填，用作商家侧相册标题）</text>
      <view class="merchant-form__row album-create__scan-row">
        <input
          class="merchant-form__input album-create__scan-input"
          placeholder="如：浙A12345"
          value="{{form.plate}}"
          maxlength="12"
          data-field="plate"
          bindinput="onInput"
        />
        <view class="album-create__scan-btn" bindtap="onScanPlate">扫描</view>
      </view>
    </view>

    <view class="merchant-form__section">
      <text class="merchant-form__label">车架号 VIN（建议填写，可解析车型）</text>
      <view class="merchant-form__row album-create__scan-row">
        <input
          class="merchant-form__input album-create__scan-input"
          placeholder="17 位车架号"
          value="{{form.vin}}"
          maxlength="17"
          data-field="vin"
          bindinput="onInput"
        />
        <view class="album-create__scan-btn" bindtap="onScanVin">扫描</view>
      </view>
      <text wx:if="{{vehiclePreview}}" class="text-caption album-create__vehicle-preview">{{vehiclePreview}}</text>
    </view>

    <view class="merchant-form__section">
      <text class="merchant-form__label">车主手机号</text>
      <text class="text-caption album-create__scan-hint">默认请车主扫码或分享链接关联；也可直接填写，填写后视为已关联，可立即拍摄过程图。</text>
      <input
        class="merchant-form__input"
        type="number"
        maxlength="11"
        placeholder="选填；不填则创建后进入扫码页"
        value="{{form.userPhone}}"
        data-field="userPhone"
        bindinput="onInput"
      />
    </view>
  </block>

  <view class="merchant-form__spacer" />
  <ui-fixed-bottom-bar>
    <ui-button
      type="primary"
      slot="right"
      loading="{{submitting}}"
      disabled="{{status === 'loading'}}"
      bind:btntap="onSubmit"
    >{{submitLabel}}</ui-button>
  </ui-fixed-bottom-bar>
</view>

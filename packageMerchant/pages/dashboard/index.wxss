@import '../../../styles/mch-craft.wxss';

.merchant-dash__cockpit {
  min-height: 100vh;
  background-color: var(--color-bg-album);
}

.merchant-dash__topbar {
  padding: var(--space-sm) var(--page-padding-x) var(--space-md);
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.merchant-dash__topbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.merchant-dash__topbar-main {
  display: flex;
  align-items: center;
  min-width: 0;
  overflow: hidden;
}

.merchant-dash__topbar-title {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
}

.merchant-dash__topbar-sub {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

.merchant-dash__topbar-hint {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-text-tertiary);
}

.merchant-dash__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: var(--space-md) var(--page-padding-x) var(--space-xl);
  box-sizing: border-box;
}

.merchant-dash__main {
  display: flex;
  flex-direction: column;
}

.merchant-dash__filter-sticky {
  position: sticky;
  top: 0;
  z-index: var(--z-fixed);
  margin: calc(-1 * var(--space-md)) calc(-1 * var(--space-md)) var(--space-md);
  padding: var(--space-md);
  background-color: var(--color-album-frame-inner);
  border-bottom: 1rpx solid var(--color-album-frame-line);
  box-sizing: border-box;
}

.merchant-dash__range {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-text-tertiary);
}

.merchant-dash__metric--pressed {
  background-color: var(--color-bg-page);
}

.merchant-dash__metric-action {
  display: flex;
  align-items: center;
  gap: 2rpx;
  margin-top: 2rpx;
}

.merchant-dash__metric-action-ico {
  width: 20rpx;
  height: 20rpx;
}

.merchant-dash__section-title {
  display: block;
  margin-bottom: var(--space-sm);
}

.merchant-dash__section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.merchant-dash__section-head .merchant-dash__section-title {
  margin-bottom: 0;
}

.merchant-dash__note-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-top: -12rpx;
  margin-right: -12rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.merchant-dash__note-btn--pressed {
  opacity: 0.6;
}

.merchant-dash__note-btn--on {
  background-color: var(--color-mch-blue-soft);
}

.merchant-dash__note-ico {
  width: 30rpx;
  height: 30rpx;
}

.merchant-dash__note {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-album-frame-inner);
  border: 1rpx solid var(--color-album-frame-line);
  box-sizing: border-box;
}

.merchant-dash__note-text {
  color: var(--color-text-secondary);
}

.merchant-dash__facts-note {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-text-tertiary);
}

.merchant-dash__hint {
  display: block;
  margin-top: var(--space-sm);
  color: var(--color-text-tertiary);
}

.merchant-dash__timeline {
  display: flex;
  flex-direction: column;
}

.merchant-dash__timeline-item {
  display: flex;
  gap: var(--space-md);
}

.merchant-dash__timeline-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 48rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.merchant-dash__rank-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-album-frame-inner);
  border: 1rpx solid var(--color-album-frame-line);
  color: var(--color-album-frame-corner);
  font-weight: var(--font-weight-medium);
}

.merchant-dash__timeline-line {
  flex: 1;
  width: 2rpx;
  min-height: 40rpx;
  margin-top: var(--space-xs);
  background-color: var(--color-album-frame-line);
}

.merchant-dash__timeline-body {
  flex: 1;
  min-width: 0;
  padding-bottom: var(--space-md);
}

.merchant-dash__rank-title {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-dash__rank-meta {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-text-tertiary);
}

.merchant-dash__gate,
.merchant-dash__loading-body {
  padding: var(--space-xl) var(--page-padding-x);
  box-sizing: border-box;
}

.merchant-dash__gate--inline {
  padding: var(--space-md) 0 0;
}

.merchant-dash__loading-body {
  padding-top: var(--space-md);
}

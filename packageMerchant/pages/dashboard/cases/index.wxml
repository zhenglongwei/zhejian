<ui-tool-page-shell
  wx:if="{{status !== 'loading'}}"
  show-band="{{false}}"
  show-compliance="{{false}}"
>
  <view class="dash-cases__cockpit">
    <view class="dash-cases__topbar bg-band">
      <view class="dash-cases__topbar-row">
        <view class="dash-cases__topbar-main">
          <text class="dash-cases__topbar-title text-body">案例明细</text>
          <text wx:if="{{storeName}}" class="dash-cases__topbar-sub text-body">· {{storeName}}</text>
        </view>
        <view
          class="dash-cases__note-btn {{noteOpen ? 'dash-cases__note-btn--on' : ''}}"
          hover-class="dash-cases__note-btn--pressed"
          bindtap="onToggleNote"
        >
          <image class="dash-cases__note-ico" src="/assets/mch/info-gray.png" mode="aspectFit" />
        </view>
      </view>
      <text wx:if="{{summaryText}}" class="dash-cases__topbar-hint text-caption">{{caseCountText}} 个公开案例 · {{summaryText}}</text>
      <text wx:if="{{lagHint}}" class="dash-cases__topbar-hint text-caption">{{lagHint}}</text>
    </view>

    <block wx:if="{{status === 'error'}}">
      <view class="dash-cases__gate">
        <ui-empty
          theme="album"
          title="数据加载失败"
          description="{{errorMessage}}"
          actionText="重试"
          bind:action="onRetry"
        />
      </view>
    </block>

    <block wx:elif="{{status === 'empty'}}">
      <view class="dash-cases__body">
        <view class="dash-cases__main surface-album-panel">
          <view class="dash-cases__filter-sticky">
            <ui-tabs
              tabs="{{periodTabs}}"
              activeKey="{{period}}"
              scrollable="{{true}}"
              bind:change="onPeriodChange"
            />
          </view>
          <view class="dash-cases__gate dash-cases__gate--inline">
            <ui-empty
              theme="album"
              title="还没有公开案例"
              description="车主授权公开后，每个案例的浏览、爬虫与星标会在此按所选时间档汇总"
              actionText="去公开案例"
              bind:action="onGoPublish"
            />
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="dash-cases__body">
        <view class="dash-cases__main surface-album-panel">
          <view class="dash-cases__filter-sticky">
            <ui-tabs
              tabs="{{periodTabs}}"
              activeKey="{{period}}"
              scrollable="{{true}}"
              bind:change="onPeriodChange"
            />
            <text wx:if="{{rangeLabel}}" class="dash-cases__range text-caption">{{rangeLabel}}</text>
          </view>

          <view wx:if="{{noteOpen}}" class="dash-cases__note">
            <text class="text-caption dash-cases__note-text">{{metricNotes.userExposure}}</text>
            <text class="text-caption dash-cases__note-text">{{metricNotes.crawlerProxy}}</text>
            <text class="text-caption dash-cases__note-text">{{metricNotes.probeInternal}}</text>
            <text class="text-caption dash-cases__note-text">{{metricNotes.starMetric}}</text>
          </view>

          <view>
            <view class="dash-cases__head">
              <text class="text-caption dash-cases__head-name">案例</text>
              <view class="dash-cases__head-cols">
                <view
                  wx:for="{{sortColumns}}"
                  wx:key="key"
                  class="dash-cases__head-col {{sortKey === item.key ? 'dash-cases__head-col--on' : ''}}"
                  hover-class="dash-cases__head-col--pressed"
                  data-key="{{item.key}}"
                  bindtap="onSortChange"
                >
                  <text class="text-caption">{{item.label}}</text>
                </view>
              </view>
            </view>

            <view class="dash-cases__divider" />

            <view wx:for="{{rows}}" wx:key="key" class="dash-cases__row">
              <view class="dash-cases__row-main">
                <text class="text-body dash-cases__row-title">{{item.title}}</text>
                <text wx:if="{{item.sub}}" class="text-caption dash-cases__row-sub">{{item.sub}}</text>
                <text class="text-caption dash-cases__row-meta">{{item.metaText}}</text>
              </view>
              <view class="dash-cases__row-cols">
                <text class="text-body text-numeric dash-cases__row-num">{{item.viewText}}</text>
                <text class="text-body text-numeric dash-cases__row-num dash-cases__row-num--dim">{{item.crawlerText}}</text>
                <view class="dash-cases__row-star">
                  <image
                    wx:if="{{item.hasStar}}"
                    class="dash-cases__row-star-ico"
                    src="/assets/mch/star-blue.png"
                    mode="aspectFit"
                  />
                  <text class="text-body text-numeric dash-cases__row-num">{{item.starText}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</ui-tool-page-shell>

<view wx:else class="page dash-cases dash-cases--loading bg-album">
  <view class="dash-cases__topbar bg-band">
    <text class="dash-cases__topbar-title text-body">案例明细</text>
  </view>
  <view class="page-content dash-cases__loading-body">
    <ui-skeleton rows="{{8}}" title="{{true}}" />
  </view>
</view>

<ui-tool-page-shell
  wx:if="{{status !== 'loading'}}"
  show-band="{{false}}"
  show-compliance="{{false}}"
>
  <view class="merchant-dash__cockpit">
    <view class="merchant-dash__topbar bg-band">
      <view class="merchant-dash__topbar-row">
        <view class="merchant-dash__topbar-main">
          <text class="merchant-dash__topbar-title text-body">数据概览</text>
          <text wx:if="{{storeName}}" class="merchant-dash__topbar-sub text-body">· {{storeName}}</text>
        </view>
      </view>
      <text wx:if="{{lagHint}}" class="merchant-dash__topbar-hint text-caption">{{lagHint}}</text>
    </view>

    <block wx:if="{{status === 'error'}}">
      <view class="merchant-dash__gate">
        <ui-empty
          theme="album"
          title="数据加载失败"
          description="{{errorMessage}}"
          actionText="重试"
          bind:action="onRetry"
        />
      </view>
    </block>

    <block wx:else>
      <view class="merchant-dash__body">
        <view class="merchant-dash__main surface-album-panel">
          <view class="merchant-dash__filter-sticky">
            <ui-tabs
              tabs="{{periodTabs}}"
              activeKey="{{period}}"
              scrollable="{{true}}"
              bind:change="onPeriodChange"
            />
            <text wx:if="{{rangeLabel}}" class="merchant-dash__range text-caption">{{rangeLabel}}</text>
          </view>

          <view wx:if="{{status === 'empty'}}" class="merchant-dash__gate merchant-dash__gate--inline">
            <ui-empty
              theme="album"
              title="本期没有站外数据"
              description="所选时间档内还没有浏览记录，换个时间档或下拉刷新试试"
              actionText="刷新"
              bind:action="onRetry"
            />
          </view>

          <block wx:else>
            <view class="merchant-dash__section-head">
              <text class="text-h3 merchant-dash__section-title">站外曝光</text>
              <view
                class="merchant-dash__note-btn {{noteOpen.exposure ? 'merchant-dash__note-btn--on' : ''}}"
                hover-class="merchant-dash__note-btn--pressed"
                data-key="exposure"
                bindtap="onToggleNote"
              >
                <image class="merchant-dash__note-ico" src="/assets/mch/info-gray.png" mode="aspectFit" />
              </view>
            </view>
            <view wx:if="{{noteOpen.exposure}}" class="merchant-dash__note">
              <text class="text-caption merchant-dash__note-text">{{metricNotes.userExposure}}</text>
              <text class="text-caption merchant-dash__note-text">{{metricNotes.crawlerProxy}}</text>
              <text class="text-caption merchant-dash__note-text">{{metricNotes.probeInternal}}</text>
              <text class="text-caption merchant-dash__note-text">{{metricNotes.starMetric}}</text>
            </view>

            <view class="surface-album-metric-grid">
              <view
                wx:for="{{heroKpis}}"
                wx:key="key"
                class="surface-album-metric-cell"
                hover-class="merchant-dash__metric--pressed"
                data-sort="{{item.sort}}"
                bindtap="onCaseMetricsTap"
              >
                <text class="surface-album-metric-num text-h2 text-numeric">{{item.value}}</text>
                <text class="text-caption surface-album-metric-label">{{item.label}}</text>
                <view class="merchant-dash__metric-action">
                  <text class="text-caption text-link">{{item.action}}</text>
                  <image class="merchant-dash__metric-action-ico" src="/assets/mch/chevron-right-blue.png" mode="aspectFit" />
                </view>
              </view>
            </view>

            <block wx:if="{{topServices.length}}">
              <view class="surface-album-inset-divider" />
              <text class="text-h3 merchant-dash__section-title">服务访问</text>
              <text class="text-caption merchant-dash__hint">按站外浏览统计</text>
              <view class="merchant-dash__timeline">
                <view wx:for="{{topServices}}" wx:key="rank" class="merchant-dash__timeline-item">
                  <view class="merchant-dash__timeline-rail">
                    <text class="merchant-dash__rank-badge text-caption">{{item.rank}}</text>
                    <view wx:if="{{index < topServices.length - 1}}" class="merchant-dash__timeline-line" />
                  </view>
                  <view class="merchant-dash__timeline-body">
                    <text class="text-body merchant-dash__rank-title">{{item.title}}</text>
                    <text class="text-caption merchant-dash__rank-meta">浏览 {{item.viewCountText}}{{item.viewDetailText ? '（' + item.viewDetailText + '）' : ''}}</text>
                  </view>
                </view>
              </view>
            </block>
          </block>
        </view>

        <view class="surface-album-panel">
          <view class="merchant-dash__section-head">
            <text class="text-h3 merchant-dash__section-title">门店基础</text>
            <text class="text-caption merchant-dash__facts-note">不随时间筛选变化</text>
          </view>
          <view class="surface-album-metric-grid">
            <view
              wx:for="{{storeKpis}}"
              wx:key="key"
              class="surface-album-metric-cell"
              hover-class="merchant-dash__metric--pressed"
              data-url="{{item.url}}"
              bindtap="onKpiTap"
            >
              <text class="surface-album-metric-num text-h2 text-numeric">{{item.value}}</text>
              <text class="text-caption surface-album-metric-label">{{item.label}}</text>
              <view class="merchant-dash__metric-action">
                <text class="text-caption text-link">{{item.action}}</text>
                <image class="merchant-dash__metric-action-ico" src="/assets/mch/chevron-right-blue.png" mode="aspectFit" />
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</ui-tool-page-shell>

<view wx:else class="page merchant-dash merchant-dash--loading bg-album">
  <view class="merchant-dash__topbar bg-band">
    <text class="merchant-dash__topbar-title text-body">数据概览</text>
  </view>
  <view class="page-content merchant-dash__loading-body">
    <ui-skeleton rows="{{6}}" title="{{true}}" />
  </view>
</view>

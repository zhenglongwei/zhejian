<view class="page merchant-review-detail">
  <block wx:if="{{status === 'loading'}}">
    <view class="page-content merchant-review-detail__pad">
      <ui-skeleton rows="{{5}}" title="{{true}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty
        title="加载失败"
        description="{{errorMessage}}"
        actionText="重试"
        bind:action="onRetry"
      />
    </view>
  </block>

  <block wx:elif="{{review}}">
    <view class="page-content merchant-review-detail__body">
      <ui-card shadow="{{true}}" padding="{{true}}">
        <view class="merchant-review-detail__head">
          <text class="merchant-review-detail__title text-h3">{{review.serviceName}}</text>
          <text class="merchant-review-detail__time text-caption">{{review.createdAtText || review.createdAt}}</text>
        </view>
        <view wx:if="{{review.plate || review.model}}" class="merchant-review-detail__vehicle">
          <text wx:if="{{review.plate}}" class="merchant-review-detail__plate">{{review.plate}}</text>
          <text wx:if="{{review.model}}" class="merchant-review-detail__model">{{review.model}}</text>
        </view>
        <text class="merchant-review-detail__meta text-caption text-secondary">{{review.ownerHint}}</text>
        <view class="merchant-review-detail__tags">
          <ui-tag wx:if="{{review.hasFollowUp}}" variant="info" text="已追评" />
        </view>
        <view class="merchant-review-detail__divider" />
        <view class="merchant-review-detail__rate">
          <text class="merchant-review-detail__rate-label">维修服务</text>
          <view class="merchant-review-detail__rate-right">
            <view class="merchant-review-detail__stars">
              <image
                wx:for="{{starRange}}"
                wx:key="*this"
                src="{{review.repairScoreRounded >= item ? '/assets/mch/star-warning.png' : '/assets/mch/star-faint.png'}}"
                mode="aspectFit"
              />
            </view>
            <text class="merchant-review-detail__score">{{review.repairScoreText}}</text>
          </view>
        </view>
        <view class="merchant-review-detail__rate">
          <text class="merchant-review-detail__rate-label">过程相册</text>
          <view class="merchant-review-detail__rate-right">
            <view class="merchant-review-detail__stars">
              <image
                wx:for="{{starRange}}"
                wx:key="*this"
                src="{{review.albumScoreRounded >= item ? '/assets/mch/star-warning.png' : '/assets/mch/star-faint.png'}}"
                mode="aspectFit"
              />
            </view>
            <text class="merchant-review-detail__score">{{review.albumScoreText}}</text>
          </view>
        </view>
      </ui-card>

      <ui-card shadow="{{true}}" padding="{{true}}">
        <text class="merchant-review-detail__section text-h3">评分明细</text>
        <view
          wx:for="{{scoreRows}}"
          wx:key="label"
          class="merchant-review-detail__score-row"
        >
          <view class="merchant-review-detail__score-copy">
            <text class="text-body">{{item.label}}</text>
            <text wx:if="{{item.hint}}" class="text-caption text-secondary">{{item.hint}}</text>
          </view>
          <view class="merchant-review-detail__stars merchant-review-detail__stars--sm">
            <image
              wx:for="{{starRange}}"
              wx:for-item="star"
              wx:key="*this"
              src="{{item.value >= star ? '/assets/mch/star-warning.png' : '/assets/mch/star-faint.png'}}"
              mode="aspectFit"
            />
          </view>
        </view>
      </ui-card>

      <ui-card wx:if="{{review}}" shadow="{{true}}" padding="{{true}}">
        <text class="merchant-review-detail__section text-h3">车主评价</text>
        <text wx:if="{{review.content}}" class="text-body">{{review.content}}</text>
        <text wx:else class="merchant-review-detail__empty text-body text-secondary">车主未填写文字评价</text>
        <view wx:if="{{review.tags.length}}" class="merchant-review-detail__tag-row">
          <ui-tag
            wx:for="{{review.tags}}"
            wx:key="*this"
            variant="default"
            text="{{item}}"
          />
        </view>
      </ui-card>

      <ui-card wx:if="{{review.hasFollowUp}}" shadow="{{true}}" padding="{{true}}">
        <text class="merchant-review-detail__section text-h3">车主追评</text>
        <text wx:if="{{review.followUpContent}}" class="text-body">{{review.followUpContent}}</text>
        <text wx:if="{{review.followUpAtText || review.followUpAt}}" class="text-caption text-secondary">追评于 {{review.followUpAtText || review.followUpAt}}</text>
      </ui-card>

      <ui-card shadow="{{true}}" padding="{{true}}">
        <text class="merchant-review-detail__section text-h3">门店回复</text>
        <text wx:if="{{review.merchantReplyAtText}}" class="text-caption text-secondary">上次回复于 {{review.merchantReplyAtText}}</text>
        <textarea
          class="merchant-review-detail__textarea text-body"
          placeholder="可说明处理情况或补充说明，将展示给车主与公开案例读者"
          value="{{replyDraft}}"
          maxlength="500"
          bindinput="onReplyInput"
        />
        <text class="text-caption merchant-review-detail__counter">{{replyLength}}/500</text>
        <ui-compliance-notice type="history" text="回复须基于事实，不得含诱导好评或攻击性内容。" />
      </ui-card>
    </view>

    <ui-fixed-bottom-bar>
      <ui-button
        type="primary"
        slot="right"
        block
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:btntap="onSubmitReply"
      >提交回复</ui-button>
    </ui-fixed-bottom-bar>
  </block>
</view>

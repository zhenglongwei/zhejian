@import '../../../../styles/mch-craft.wxss';

.merchant-review-detail__pad,
.merchant-review-detail__body {
  padding: var(--space-md) var(--page-padding-x) calc(var(--space-xl) + var(--fixed-bottom-bar-height));
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.merchant-review-detail__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-sm);
}

.merchant-review-detail__title {
  min-width: 0;
}

.merchant-review-detail__time {
  flex: none;
  color: var(--color-mch-caption);
  font-family: 'DIN Alternate', 'Roboto Mono', 'Menlo', 'Consolas', monospace;
  font-variant-numeric: tabular-nums;
}

.merchant-review-detail__vehicle {
  display: flex;
  align-items: baseline;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
  min-width: 0;
}

.merchant-review-detail__plate {
  color: var(--color-text-primary);
  font-family: 'DIN Alternate', 'Roboto Mono', 'Menlo', 'Consolas', monospace;
  font-size: var(--font-h3);
  font-weight: var(--font-weight-bold);
  letter-spacing: 2rpx;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.merchant-review-detail__model {
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: var(--font-sub);
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.merchant-review-detail__meta {
  display: block;
  margin-top: var(--space-xs);
}

.merchant-review-detail__divider {
  height: 2rpx;
  margin: var(--space-md) 0 var(--space-xs);
  background: #eef1f6;
}

.merchant-review-detail__rate {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  padding: var(--space-xs) 0;
}

.merchant-review-detail__rate-label {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
  line-height: 1.4;
}

.merchant-review-detail__rate-right {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.merchant-review-detail__stars {
  display: flex;
  gap: var(--space-star-gap);
}

.merchant-review-detail__stars image {
  width: 28rpx;
  height: 28rpx;
}

.merchant-review-detail__stars--sm image {
  width: 24rpx;
  height: 24rpx;
}

.merchant-review-detail__score {
  min-width: 56rpx;
  color: var(--color-text-primary);
  font-family: 'DIN Alternate', 'Roboto Mono', 'Menlo', 'Consolas', monospace;
  font-size: var(--font-body);
  font-weight: var(--font-weight-semibold);
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.merchant-review-detail__section {
  display: block;
  margin-bottom: var(--space-sm);
}

.merchant-review-detail__score-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-md);
  padding: var(--space-xs) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.merchant-review-detail__score-row .merchant-review-detail__stars {
  padding-top: 4rpx;
}

.merchant-review-detail__score-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.merchant-review-detail__score-row:last-child {
  border-bottom: none;
}

.merchant-review-detail__tags,
.merchant-review-detail__tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.merchant-review-detail__textarea {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  margin-bottom: var(--space-xs);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
  line-height: 1.5;
}

.merchant-review-detail__counter {
  display: block;
  text-align: right;
  color: var(--color-text-tertiary);
  margin-bottom: var(--space-sm);
}

.merchant-review-detail__empty {
  display: block;
}

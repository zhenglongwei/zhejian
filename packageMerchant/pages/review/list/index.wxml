<view class="page merchant-review-list">
  <ui-tabs
    tabs="{{tabs}}"
    activeKey="{{activeTab}}"
    bind:change="onTabChange"
  />

  <block wx:if="{{status === 'loading'}}">
    <view class="merchant-review-list__pad page-content">
      <ui-skeleton wx:for="{{skeletonItems}}" wx:key="*this" rows="{{3}}" title="{{true}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty
        title="加载失败"
        description="{{errorMessage}}"
        actionText="重试"
        bind:action="onRetry"
      />
    </view>
  </block>

  <block wx:elif="{{status === 'empty'}}">
    <view class="page-content">
      <ui-empty title="{{emptyTitle}}" description="{{emptyDescription}}" />
    </view>
  </block>

  <block wx:else>
    <view class="page-content merchant-review-list__body">
      <ui-card
        wx:for="{{list}}"
        wx:key="id"
        shadow="{{true}}"
        padding="{{true}}"
        data-id="{{item.id}}"
        bindtap="onOpenDetail"
      >
        <view class="merchant-review-list__head">
          <text class="text-h3">{{item.serviceName}}</text>
          <text class="merchant-review-list__time text-caption">{{item.createdAtText || item.createdAt}}</text>
        </view>
        <view wx:if="{{item.plate || item.model}}" class="merchant-review-list__vehicle">
          <text wx:if="{{item.plate}}" class="merchant-review-list__plate">{{item.plate}}</text>
          <text wx:if="{{item.model}}" class="merchant-review-list__model">{{item.model}}</text>
        </view>
        <view class="merchant-review-list__rates">
          <text class="merchant-review-list__rate-label text-caption">维修服务</text>
          <view class="merchant-review-list__stars">
            <image
              wx:for="{{starRange}}"
              wx:for-item="star"
              wx:key="*this"
              src="{{item.repairScoreRounded >= star ? '/assets/mch/star-warning.png' : '/assets/mch/star-faint.png'}}"
              mode="aspectFit"
            />
          </view>
          <text class="merchant-review-list__rate-label text-caption">过程相册</text>
          <view class="merchant-review-list__stars">
            <image
              wx:for="{{starRange}}"
              wx:for-item="star"
              wx:key="*this"
              src="{{item.albumScoreRounded >= star ? '/assets/mch/star-warning.png' : '/assets/mch/star-faint.png'}}"
              mode="aspectFit"
            />
          </view>
        </view>
        <text class="merchant-review-list__meta text-caption text-secondary">{{item.ownerHint}}</text>
        <text wx:if="{{item.contentPreview}}" class="text-body merchant-review-list__preview">
          {{item.contentPreview}}
        </text>
        <text wx:else class="text-body text-secondary merchant-review-list__preview">车主未填写文字评价</text>
        <view class="merchant-review-list__tags">
          <ui-tag wx:if="{{item.hasFollowUp}}" variant="info" text="已追评" />
          <ui-tag wx:if="{{item.hasReply}}" variant="success" text="已回复" />
          <ui-tag wx:else variant="warning" text="待回复" />
        </view>
      </ui-card>
    </view>
  </block>
</view>

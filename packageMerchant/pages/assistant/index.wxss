@import '../../../styles/mch-craft.wxss';

page {
  background: var(--color-mch-bg);
}

.mch-ai {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  color: var(--color-text-primary);
  background: var(--color-mch-bg);
}

.mch-top {
  padding: var(--space-xs) var(--page-padding-x);
}

.mch-brand {
  margin-top: 4rpx;
  font-size: var(--font-h1);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-h1-lh);
}

.mch-ai__state,
.mch-ai__empty {
  padding: var(--space-xl) var(--page-padding-x);
}

.mch-ai-hero {
  position: relative;
  margin: var(--space-md) var(--page-padding-x) 0;
  padding: var(--space-lg) var(--space-md);
  border-radius: var(--mch-radius-hero);
  color: var(--color-mch-ink);
  background: var(--color-bg-card);
  box-shadow: var(--mch-shadow-hero);
  overflow: hidden;
}

.mch-ai-hero__orb {
  position: absolute;
  right: var(--space-md);
  top: var(--space-md);
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--mch-radius);
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mch-ai-hero__orb image {
  width: 48rpx;
  height: 48rpx;
}

.mch-ai-hero__label {
  display: block;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.mch-ai-hero__count {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-h1);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-h1-lh);
}

.mch-ai-hero__from {
  display: block;
  margin-top: var(--space-sm);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.mch-ai-sec {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: var(--space-lg) var(--page-padding-x) var(--space-sm);
}

.mch-ai-sec__title {
  font-size: var(--font-h1);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-h1-lh);
}

.mch-ai-sec__count {
  color: var(--color-primary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.mch-ai-card {
  margin: 0 var(--page-padding-x) var(--space-md);
  padding: var(--space-md);
  border-radius: var(--mch-radius);
  background: var(--color-bg-card);
  box-shadow: var(--mch-shadow-card);
}

.mch-ai-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.mch-ai-card__kind {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  min-width: 0;
  color: var(--color-mch-insight);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-caption-lh);
}

.mch-ai-card__kind image {
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

.mch-ai-card__when,
.mch-ai-card__plate {
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.mch-ai-card__plate {
  display: block;
  margin-top: var(--space-xs);
}

.mch-ai-card__title {
  display: block;
  margin-top: var(--space-sm);
  font-size: var(--font-h3);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-h3-lh);
}

.mch-ai-card__body {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.mch-ai-card__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: var(--space-md);
}

.mch-ai-card__btn {
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-caption-lh);
}

.mch-ai-note {
  display: block;
  margin: var(--space-sm) var(--space-xl) 0;
  text-align: center;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

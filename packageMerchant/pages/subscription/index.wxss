.merchant-sub {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  padding: var(--space-md) 0 calc(var(--space-xl) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.merchant-sub__card {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: var(--space-lg);
  border-radius: var(--radius-mch-card);
  background-color: var(--color-bg-card);
  box-shadow: var(--shadow-mch-card);
  box-sizing: border-box;
}

.merchant-sub__section {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-primary);
}

.merchant-sub__quota {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
}

.merchant-sub__table {
  width: 100%;
  display: flex;
  flex-direction: column;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.merchant-sub__tr {
  display: flex;
  align-items: stretch;
}

.merchant-sub__tr--head {
  background-color: var(--color-bg-muted);
}

.merchant-sub__tr.is-current {
  background-color: var(--color-primary-light);
}

.merchant-sub__th,
.merchant-sub__td {
  flex: 1;
  min-width: 0;
  padding: var(--space-sm) 6rpx;
  box-sizing: border-box;
  text-align: center;
  border-right: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-primary);
  word-break: break-all;
  display: flex;
  align-items: center;
  justify-content: center;
}

.merchant-sub__tr:last-child .merchant-sub__td {
  border-bottom: none;
}

.merchant-sub__th:last-child,
.merchant-sub__td:last-child {
  border-right: none;
}

.merchant-sub__plan {
  flex: 1.15;
  text-align: left;
  justify-content: flex-start;
  padding-left: var(--space-sm);
  font-weight: var(--font-weight-medium);
}

.merchant-sub__quota-col {
  flex: 1.1;
}

.merchant-sub__price-col {
  flex: 1.15;
}

.merchant-sub__action-col {
  flex: 1.2;
}

.merchant-sub__th {
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.merchant-sub__price-cell {
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}

.merchant-sub__tr.is-current .merchant-sub__td {
  color: var(--color-primary);
}

.merchant-sub__action {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
  padding: 4rpx 0;
}

.merchant-sub__action.is-disabled {
  color: var(--color-text-secondary);
}

.merchant-sub__consent {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
}

.merchant-sub__check {
  width: 32rpx;
  height: 32rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
  background-color: var(--color-bg-card);
}

.merchant-sub__check.is-on {
  border-color: var(--color-primary);
  background-color: var(--color-primary);
}

.merchant-sub__consent-text {
  flex: 1;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
}

.merchant-sub__link {
  align-self: center;
  padding: var(--space-xs) 0;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-primary);
}

.merchant-sub__link--inline {
  align-self: flex-start;
  padding-top: 0;
}

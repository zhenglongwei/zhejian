.merchant-sub {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  padding: var(--space-md) 0 calc(var(--space-xl) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.merchant-sub__hero {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-xl) var(--space-lg);
  border-radius: var(--radius-mch-hero);
  background: linear-gradient(
    135deg,
    var(--color-mch-hero-start),
    var(--color-mch-hero-mid) 60%,
    var(--color-mch-hero-end)
  );
  box-shadow: var(--shadow-mch-hero);
  box-sizing: border-box;
}

.merchant-sub__kicker {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-inverse);
}

.merchant-sub__price {
  display: flex;
  align-items: flex-end;
  gap: var(--space-sm);
  min-height: var(--font-mch-figure-lh);
}

.merchant-sub__yen {
  font-size: var(--font-h2);
  line-height: var(--font-h2-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-inverse);
}

.merchant-sub__price-blank {
  flex: 1;
  height: 56rpx;
  margin-bottom: 8rpx;
  border-bottom: 2rpx solid var(--color-text-inverse);
  opacity: 0.55;
}

.merchant-sub__card {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: var(--space-lg);
  border-radius: var(--radius-mch-card);
  background-color: var(--color-bg-card);
  box-shadow: var(--shadow-mch-card);
  box-sizing: border-box;
}

.merchant-sub__section {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-primary);
}

.merchant-sub__benefits {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.merchant-sub__benefit {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
}

.merchant-sub__check {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-top: 2rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.merchant-sub__check-mark {
  font-size: var(--font-caption);
  line-height: 1;
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}

.merchant-sub__benefit-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.merchant-sub__link {
  align-self: center;
  padding: var(--space-xs) 0;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-primary);
}

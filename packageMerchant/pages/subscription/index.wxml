<ui-tool-page-shell showBand="{{false}}" showCompliance="{{false}}">
  <view class="merchant-sub">
    <view class="merchant-sub__hero">
      <text class="merchant-sub__kicker">{{amountLabel}}</text>
      <view class="merchant-sub__price">
        <text class="merchant-sub__yen">{{priceMark}}</text>
        <view class="merchant-sub__price-blank" />
      </view>
    </view>

    <view class="merchant-sub__card">
      <text class="merchant-sub__section">{{benefitsTitle}}</text>
      <view class="merchant-sub__benefits">
        <view
          wx:for="{{benefits}}"
          wx:for-item="title"
          wx:key="*this"
          class="merchant-sub__benefit"
        >
          <view class="merchant-sub__check">
            <text class="merchant-sub__check-mark">✓</text>
          </view>
          <text class="merchant-sub__benefit-text">{{title}}</text>
        </view>
      </view>
    </view>

    <text class="merchant-sub__link" bindtap="onOpenSubscriptionAgreement">{{agreementLink}}</text>
  </view>
</ui-tool-page-shell>

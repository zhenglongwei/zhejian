<view class="page merchant-store-edit page-content merchant-form-page" wx:if="{{status === 'loading'}}">
  <ui-skeleton rows="{{6}}" title="{{true}}" />
</view>

<view class="page merchant-store-edit page-content merchant-form-page" wx:elif="{{status === 'forbidden'}}">
  <ui-empty
    title="仅主账号可编辑"
    description="门店资料变更需由店铺管理员操作"
    actionText="返回工作台"
    bind:action="onBackWorkbench"
  />
</view>

<view class="page merchant-store-edit page-content merchant-form-page" wx:elif="{{status === 'normal'}}">
  <view wx:if="{{section}}" class="merchant-store-edit__focus">
    <text class="merchant-store-edit__focus-kicker">门店资料完善</text>
  </view>
  <view wx:if="{{showScore}}" class="merchant-store-edit__score">
    <view class="merchant-store-edit__score-copy">
      <text class="merchant-store-edit__score-kicker">资料完善度</text>
      <text wx:if="{{profileScoreLabel}}" class="merchant-store-edit__score-title">{{profileScoreLabel}}</text>
      <text wx:for="{{profileGaps}}" wx:key="key" class="merchant-store-edit__score-gap">{{item.note}}</text>
    </view>
    <view class="merchant-store-edit__score-num">
      <text>{{profileScore}}</text>
      <text class="merchant-store-edit__score-unit">分</text>
    </view>
  </view>
  <view wx:if="{{showBasic}}" class="merchant-store-edit__panel surface-album-panel">
    <view class="merchant-store-edit__head">
      <view>
        <text class="merchant-store-edit__kicker">BASIC</text>
        <text class="merchant-store-edit__panel-title text-h3">基础资料</text>
      </view>
    </view>

    <view class="merchant-form__section">
      <text class="merchant-form__label">门店名称 *</text>
      <text wx:if="{{gapNote.name}}" class="merchant-store-edit__gap">{{gapNote.name}}</text>
      <input class="merchant-form__input" placeholder="对外展示的店名" value="{{form.storeName}}" data-field="storeName" bindinput="onInput" maxlength="40" />
    </view>
    <view class="merchant-form__section">
      <text class="merchant-form__label">地址</text>
      <text wx:if="{{gapNote.address}}" class="merchant-store-edit__gap">{{gapNote.address}}</text>
      <view
        class="merchant-form__input merchant-onboard__address-picker {{form.address ? '' : 'merchant-onboard__address-picker--empty'}}"
        hover-class="merchant-onboard__address-picker--active"
        catchtap="onChooseLocation"
      >
        <text class="merchant-onboard__address-text">{{form.address || '点击选择地址'}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showIntro}}" class="merchant-store-edit__panel surface-album-panel">
    <view class="merchant-store-edit__head merchant-store-edit__head--spread">
      <view>
        <text class="merchant-store-edit__kicker">ABOUT US</text>
        <text class="merchant-store-edit__panel-title text-h3">门店介绍</text>
        <text wx:if="{{gapNote.intro}}" class="merchant-store-edit__gap">{{gapNote.intro}}</text>
      </view>
      <view class="merchant-store-edit__polish" hover-class="merchant-store-edit__polish--on" catchtap="onPolish">AI 润色</view>
    </view>
    <view class="merchant-form__section">
      <textarea class="merchant-form__textarea" placeholder="一段即可，如主营项目" value="{{form.intro}}" data-field="intro" bindinput="onInput" maxlength="500" />
      <text class="merchant-store-edit__count">{{form.intro.length || 0}} / 500</text>
    </view>
  </view>

  <view wx:if="{{showHours}}" class="merchant-store-edit__panel surface-album-panel">
    <view class="merchant-store-edit__head">
      <view class="surface-album-section-accent" />
      <text class="merchant-store-edit__panel-title text-h3">联系与时间</text>
    </view>

    <view class="merchant-form__section">
      <text class="merchant-form__label">负责人</text>
      <input class="merchant-form__input" placeholder="姓名" value="{{form.contactName}}" data-field="contactName" bindinput="onInput" />
    </view>
    <view class="merchant-form__section">
      <text class="merchant-form__label">负责人手机</text>
      <input class="merchant-form__input" type="number" placeholder="11 位手机号" value="{{form.phone}}" data-field="phone" bindinput="onInput" maxlength="11" />
    </view>
    <view class="merchant-form__section">
      <text class="merchant-form__label">门店电话</text>
      <text wx:if="{{gapNote.phone}}" class="merchant-store-edit__gap">{{gapNote.phone}}</text>
      <input class="merchant-form__input" type="number" placeholder="对外拨打" value="{{form.storePhone}}" data-field="storePhone" bindinput="onInput" />
    </view>

    <view class="merchant-form__section">
      <text class="merchant-form__label">营业时间</text>
      <text wx:if="{{gapNote.hours}}" class="merchant-store-edit__gap">{{gapNote.hours}}</text>

      <view class="merchant-hours__daily">
        <text class="merchant-hours__daily-label">每日营业</text>
        <view class="merchant-hours__daily-times">
          <picker mode="time" value="{{businessHoursDaily.start}}" data-field="start" bindchange="onDailyTimeChange">
            <view class="merchant-hours__time">{{businessHoursDaily.start || '09:00'}}</view>
          </picker>
          <text class="merchant-hours__sep">至</text>
          <picker mode="time" value="{{businessHoursDaily.end}}" data-field="end" bindchange="onDailyTimeChange">
            <view class="merchant-hours__time">{{businessHoursDaily.end || '18:00'}}</view>
          </picker>
        </view>
      </view>

      <view class="merchant-hours__closures">
        <view class="merchant-hours__closures-head">
          <text class="merchant-form__label merchant-form__label--sub">临时休息</text>
          <text class="merchant-hours__add" bindtap="onToggleClosureForm">{{showClosureForm ? '收起' : '+ 添加'}}</text>
        </view>

        <view wx:if="{{showClosureForm}}" class="merchant-hours__closure-form">
          <view class="merchant-hours__closure-row">
            <text class="merchant-hours__closure-label">开始</text>
            <picker mode="date" value="{{closureDraft.startDate}}" data-field="startDate" bindchange="onClosureDraftDateChange">
              <view class="merchant-hours__date">{{closureDraft.startDate || '选择日期'}}</view>
            </picker>
          </view>
          <view class="merchant-hours__closure-row">
            <text class="merchant-hours__closure-label">结束</text>
            <picker mode="date" value="{{closureDraft.endDate}}" data-field="endDate" bindchange="onClosureDraftDateChange">
              <view class="merchant-hours__date">{{closureDraft.endDate || '选择日期'}}</view>
            </picker>
          </view>
          <input
            class="merchant-form__input"
            placeholder="说明（选填），如：春节、国庆"
            value="{{closureDraft.note}}"
            bindinput="onClosureDraftNoteInput"
          />
          <view class="merchant-hours__closure-actions">
            <ui-button type="secondary" size="sm" bind:btntap="onCancelClosureForm">取消</ui-button>
            <ui-button type="primary" size="sm" bind:btntap="onConfirmClosure">确认</ui-button>
          </view>
        </view>

        <text wx:if="{{!businessHoursClosures.length && !showClosureForm}}" class="merchant-hours__closure-empty text-caption">暂无临时休息</text>

        <view
          wx:for="{{businessHoursClosures}}"
          wx:key="id"
          class="merchant-hours__closure-item"
        >
          <text class="merchant-hours__closure-text">{{item.displayText}}</text>
          <text class="merchant-hours__closure-remove" data-id="{{item.id}}" bindtap="onRemoveClosure">删除</text>
        </view>
      </view>

      <view class="merchant-hours__preview">
        <text class="merchant-hours__preview-label text-caption">展示文案</text>
        <text class="merchant-hours__preview-value text-body">{{businessHoursPreview || '请设置营业时间'}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showEnv}}" class="merchant-store-edit__panel surface-album-panel">
    <view class="merchant-store-edit__head">
      <view>
        <text class="merchant-store-edit__kicker">PHOTOS</text>
        <text class="merchant-store-edit__panel-title text-h3">门店环境</text>
      </view>
    </view>
    <view class="merchant-store-edit__photo-strip">
      <view class="merchant-store-edit__photo-cell">
        <text class="merchant-form__label">门头</text>
        <text wx:if="{{gapNote.facade}}" class="merchant-store-edit__gap">{{gapNote.facade}}</text>
        <view class="merchant-onboard__photo-slot" bindtap="onPickFacade">
          <image wx:if="{{form.facadePhotoUrl}}" class="merchant-onboard__photo" src="{{form.facadePhotoUrl}}" mode="aspectFill" />
          <text wx:else class="text-caption">上传</text>
        </view>
      </view>
      <view class="merchant-store-edit__photo-cell">
        <text class="merchant-form__label">工位</text>
        <text wx:if="{{gapNote.workshop}}" class="merchant-store-edit__gap">{{gapNote.workshop}}</text>
        <view class="merchant-onboard__photo-grid">
          <view wx:for="{{form.workshopPhotoUrls}}" wx:key="index" class="merchant-onboard__photo-wrap">
            <image class="merchant-onboard__photo" src="{{item}}" mode="aspectFill" />
            <text class="merchant-onboard__photo-del" data-index="{{index}}" catchtap="onRemoveWorkshop">×</text>
          </view>
          <view wx:if="{{form.workshopPhotoUrls.length < 6}}" class="merchant-onboard__photo-slot merchant-onboard__photo-slot--add" bindtap="onPickWorkshop">
            <text class="text-caption">添加</text>
          </view>
        </view>
      </view>
      <view class="merchant-store-edit__photo-cell">
        <text class="merchant-form__label">接待区</text>
        <text wx:if="{{gapNote.reception}}" class="merchant-store-edit__gap">{{gapNote.reception}}</text>
        <view class="merchant-onboard__photo-grid">
          <view wx:for="{{form.receptionPhotoUrls}}" wx:key="index" class="merchant-onboard__photo-wrap">
            <image class="merchant-onboard__photo" src="{{item}}" mode="aspectFill" />
            <text class="merchant-onboard__photo-del" data-index="{{index}}" catchtap="onRemoveReception">×</text>
          </view>
          <view wx:if="{{form.receptionPhotoUrls.length < 6}}" class="merchant-onboard__photo-slot merchant-onboard__photo-slot--add" bindtap="onPickReception">
            <text class="text-caption">添加</text>
          </view>
        </view>
      </view>
    </view>
    <view class="merchant-store-edit__advice-btn" hover-class="merchant-store-edit__polish--on" catchtap="onPhotoAdvice">AI 收录建议</view>
    <view wx:if="{{photoAdviceOn && photoTips.length}}" class="merchant-store-edit__advice">
      <text class="merchant-store-edit__advice-title">AI 收录建议</text>
      <text wx:for="{{photoTips}}" wx:key="*this" class="merchant-store-edit__advice-line">{{item}}</text>
    </view>
  </view>

  <block wx:if="{{showSkill}}">
    <view class="merchant-store-edit__skill-hero">
      <image class="merchant-store-edit__skill-ico" src="/assets/mch/car-white.png" mode="aspectFit" />
      <view>
        <text class="merchant-store-edit__skill-kicker">已配置</text>
        <text class="merchant-store-edit__skill-title">{{brandList.length}} 个品牌 · {{form.services.length}} 项服务</text>
      </view>
    </view>

    <view class="merchant-store-edit__panel surface-album-panel">
      <view class="merchant-store-edit__head merchant-store-edit__head--spread">
        <view>
          <text class="merchant-store-edit__kicker">BRANDS</text>
          <text class="merchant-store-edit__panel-title text-h3">擅长品牌</text>
        </view>
      </view>
      <view class="merchant-store-edit__brand-grid">
        <view wx:for="{{brandList}}" wx:key="*this" class="merchant-store-edit__brand">
          <text class="merchant-store-edit__brand-name">{{item}}</text>
          <text class="merchant-store-edit__brand-x" data-name="{{item}}" catchtap="onRemoveBrand">×</text>
        </view>
      </view>
      <view class="merchant-store-edit__add-line">
        <input class="merchant-form__input" placeholder="品牌，如宝马" value="{{brandDraft}}" bindinput="onBrandDraft" confirm-type="done" bindconfirm="onAddBrand" />
        <view class="merchant-store-edit__polish" hover-class="merchant-store-edit__polish--on" catchtap="onAddBrand">添加</view>
      </view>
    </view>

    <view class="merchant-store-edit__panel surface-album-panel">
      <view class="merchant-store-edit__head">
        <view>
          <text class="merchant-store-edit__kicker">SERVICES</text>
          <text class="merchant-store-edit__panel-title text-h3">服务能力</text>
        </view>
      </view>
      <view class="merchant-store-edit__skill-grid">
        <view
          wx:for="{{serviceTags}}"
          wx:key="name"
          class="merchant-store-edit__skill {{item.selected ? 'is-on' : ''}}"
          data-name="{{item.name}}"
          catchtap="onToggleService"
        >
          <text wx:if="{{item.selected}}">✓</text>
          <text>{{item.name}}</text>
        </view>
      </view>
      <view class="merchant-store-edit__add-line">
        <input
          class="merchant-form__input"
          value="{{customServiceInput}}"
          maxlength="16"
          confirm-type="done"
          placeholder="添加一项"
          bindinput="onCustomServiceInput"
          bindconfirm="onCustomServiceCommit"
        />
        <view class="merchant-store-edit__polish" hover-class="merchant-store-edit__polish--on" catchtap="onCustomServiceCommit">添加</view>
      </view>
    </view>

    <view class="merchant-store-edit__stat-row">
      <view class="merchant-store-edit__stat">
        <text class="merchant-store-edit__stat-label">累计案例</text>
        <text class="merchant-store-edit__stat-num">{{albumCount}}</text>
      </view>
      <view class="merchant-store-edit__stat">
        <text class="merchant-store-edit__stat-label">星数</text>
        <text class="merchant-store-edit__stat-num">{{caseStarCount}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{showTech}}" class="merchant-store-edit__panel surface-album-panel">
    <view class="merchant-store-edit__head">
      <view>
        <text class="merchant-store-edit__kicker">TECHNICIANS</text>
        <text class="merchant-store-edit__panel-title text-h3">技师团队</text>
      </view>
    </view>
    <view class="merchant-form__section">
      <view wx:for="{{form.technicians}}" wx:key="id" class="merchant-store-edit__tech-card">
        <view class="merchant-form__row">
          <input class="merchant-form__input merchant-form__input--half" placeholder="称呼 *" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onTechInput" />
          <view class="merchant-store-edit__years-field">
            <input
              class="merchant-form__input merchant-store-edit__years-input"
              type="digit"
              placeholder="年限"
              value="{{item.years}}"
              data-index="{{index}}"
              data-field="years"
              bindinput="onTechYearsInput"
            />
            <text class="merchant-store-edit__years-unit text-body">年</text>
          </view>
        </view>
        <input class="merchant-form__input" placeholder="主修/角色" value="{{item.role}}" data-index="{{index}}" data-field="role" bindinput="onTechInput" />
        <input class="merchant-form__input" placeholder="资质标签" value="{{item.credentialsText}}" data-index="{{index}}" data-field="credentialsText" bindinput="onTechInput" />
        <view class="merchant-store-edit__tech-media">
          <text class="text-caption merchant-store-edit__tech-media-label">头像</text>
          <view class="merchant-store-edit__brand-media">
            <image
              wx:if="{{item.avatarUrl}}"
              class="merchant-store-edit__eq-thumb"
              src="{{item.avatarUrl}}"
              mode="aspectFill"
              data-url="{{item.avatarUrl}}"
              data-index="{{index}}"
              bindtap="onPreviewTechImage"
            />
            <view
              class="merchant-onboard__photo-slot merchant-onboard__photo-slot--add merchant-store-edit__eq-pick"
              data-index="{{index}}"
              bindtap="onPickTechAvatar"
            >
              <text class="text-caption">{{item.avatarUrl ? '更换头像' : '上传头像'}}</text>
            </view>
            <text
              wx:if="{{item.avatarUrl}}"
              class="merchant-store-edit__eq-clear text-caption"
              data-index="{{index}}"
              bindtap="onClearTechAvatar"
            >清除</text>
          </view>
        </view>
        <view class="merchant-store-edit__tech-media">
          <text class="text-caption merchant-store-edit__tech-media-label">资质证明（选填，最多 6 张）</text>
          <view class="merchant-onboard__photo-grid">
            <view
              wx:for="{{item.credentialPhotoUrls}}"
              wx:for-item="photo"
              wx:for-index="photoIndex"
              wx:key="photoIndex"
              class="merchant-onboard__photo-wrap"
            >
              <image
                class="merchant-onboard__photo"
                src="{{photo}}"
                mode="aspectFill"
                data-url="{{photo}}"
                data-index="{{index}}"
                bindtap="onPreviewTechImage"
              />
              <text
                class="merchant-onboard__photo-del"
                data-index="{{index}}"
                data-photo-index="{{photoIndex}}"
                catchtap="onRemoveTechCredential"
              >×</text>
            </view>
            <view
              wx:if="{{!item.credentialPhotoUrls || item.credentialPhotoUrls.length < 6}}"
              class="merchant-onboard__photo-slot merchant-onboard__photo-slot--add"
              data-index="{{index}}"
              bindtap="onPickTechCredential"
            >
              <text class="text-caption merchant-store-edit__photo-add-text">添加证明</text>
            </view>
          </view>
        </view>
        <text class="merchant-store-edit__tech-remove text-caption" data-index="{{index}}" bindtap="onRemoveTech">删除该技师</text>
      </view>
      <view class="merchant-store-edit__add-tech">
        <ui-button type="secondary" size="sm" bind:btntap="onAddTech">添加技师</ui-button>
      </view>
    </view>

  </view>

  <view wx:if="{{showPublic}}" class="merchant-store-edit__panel surface-album-panel">
    <view class="merchant-store-edit__head">
      <view class="surface-album-section-accent" />
      <text class="merchant-store-edit__panel-title text-h3">门店资质</text>
    </view>

    <view class="merchant-store-edit__publish-group {{form.publishLicense ? '' : 'is-off'}}">
    <view class="merchant-form__switch-row merchant-store-edit__switch-head">
      <text class="text-body">执照 · 网站展示</text>
      <switch checked="{{form.publishLicense}}" data-field="publishLicense" bindchange="onPublishFlag" color="{{switchColor}}" />
    </view>
    <view class="merchant-store-edit__publish-body">
    <view class="merchant-form__section">
      <text class="merchant-form__label">营业执照</text>
      <view class="merchant-onboard__photo-slot" data-field="licensePhotoUrl" bindtap="onPickSingle">
        <image wx:if="{{form.licensePhotoUrl}}" class="merchant-onboard__photo" src="{{form.licensePhotoUrl}}" mode="aspectFill" />
        <text wx:else class="text-caption">上传执照</text>
      </view>
    </view>
    <view class="merchant-form__section">
      <text class="merchant-form__label">主体名称</text>
      <input class="merchant-form__input" placeholder="与执照一致" value="{{form.legalName}}" data-field="legalName" bindinput="onInput" />
    </view>
    <view class="merchant-form__section">
      <text class="merchant-form__label">统一社会信用代码</text>
      <input class="merchant-form__input" placeholder="18 位" value="{{form.creditCode}}" data-field="creditCode" bindinput="onInput" maxlength="18" />
    </view>
    <view class="merchant-form__section">
      <text class="merchant-form__label">成立日期</text>
      <picker mode="date" value="{{form.licenseEstablishedOn || today}}" start="1950-01-01" end="{{today}}" bindchange="onLicenseEstablishedChange">
        <view class="merchant-form__picker {{form.licenseEstablishedOn ? '' : 'merchant-form__picker--placeholder'}}">
          {{form.licenseEstablishedOn || '选择日期'}}
        </view>
      </picker>
    </view>
    </view>
    </view>
    <view class="merchant-form__section">
      <text class="merchant-form__label">法人身份证</text>
      <text class="text-caption merchant-store-edit__field-tip">不对外</text>
      <view class="merchant-onboard__photo-slot" data-field="legalIdPhotoUrl" bindtap="onPickSingle">
        <image wx:if="{{form.legalIdPhotoUrl}}" class="merchant-onboard__photo" src="{{form.legalIdPhotoUrl}}" mode="aspectFill" />
        <text wx:else class="text-caption">上传身份证</text>
      </view>
    </view>

    <view class="merchant-store-edit__publish-group {{form.publishQualification ? '' : 'is-off'}}">
    <view class="merchant-form__switch-row merchant-store-edit__switch-head">
      <text class="text-body">维修资质 · 网站展示</text>
      <switch checked="{{form.publishQualification}}" data-field="publishQualification" bindchange="onPublishFlag" color="{{switchColor}}" />
    </view>
    <view class="merchant-store-edit__publish-body">
    <view class="merchant-form__section">
      <text class="merchant-form__label">维修资质</text>
      <picker mode="selector" range="{{qualificationOptions}}" range-key="label" value="{{qualificationIndex}}" bindchange="onQualificationChange">
        <view class="merchant-form__picker {{qualificationLabel ? '' : 'merchant-form__picker--placeholder'}}">
          {{qualificationLabel || '选择资质类型'}}
        </view>
      </picker>
    </view>
    <view class="merchant-form__section">
      <text class="merchant-form__label">资质照片</text>
      <view class="merchant-onboard__photo-slot" data-field="qualificationPhotoUrl" bindtap="onPickSingle">
        <image wx:if="{{form.qualificationPhotoUrl}}" class="merchant-onboard__photo" src="{{form.qualificationPhotoUrl}}" mode="aspectFill" />
        <text wx:else class="text-caption">上传照片</text>
      </view>
    </view>
    <view class="merchant-form__section">
      <text class="merchant-form__label">资质编号</text>
      <input class="merchant-form__input" placeholder="选填" value="{{form.qualificationNo}}" data-field="qualificationNo" bindinput="onInput" />
    </view>
    <view class="merchant-form__section">
      <text class="merchant-form__label">有效期至</text>
      <picker mode="date" value="{{form.qualificationValidUntil || today}}" bindchange="onValidUntilChange">
        <view class="merchant-form__picker {{form.qualificationValidUntil ? '' : 'merchant-form__picker--placeholder'}}">
          {{form.qualificationValidUntil || '选择日期'}}
        </view>
      </picker>
    </view>
    <view class="merchant-form__switch-row">
      <text class="text-body">新能源专项资质</text>
      <switch checked="{{form.newEnergyEnabled}}" bindchange="onNewEnergyToggle" color="{{switchColor}}" />
    </view>
    <block wx:if="{{form.newEnergyEnabled}}">
      <view class="merchant-form__section">
        <text class="merchant-form__label">新能源资质照片</text>
        <view class="merchant-onboard__photo-slot" data-field="newEnergyPhotoUrl" bindtap="onPickSingle">
          <image wx:if="{{form.newEnergyPhotoUrl}}" class="merchant-onboard__photo" src="{{form.newEnergyPhotoUrl}}" mode="aspectFill" />
          <text wx:else class="text-caption">上传照片</text>
        </view>
      </view>
      <view class="merchant-form__section">
        <text class="merchant-form__label">编号</text>
        <input class="merchant-form__input" placeholder="选填" value="{{form.newEnergyNo}}" data-field="newEnergyNo" bindinput="onInput" />
      </view>
      <view class="merchant-form__section">
        <text class="merchant-form__label">有效期至</text>
        <picker mode="date" value="{{form.newEnergyValidUntil || today}}" bindchange="onNewEnergyValidUntilChange">
          <view class="merchant-form__picker {{form.newEnergyValidUntil ? '' : 'merchant-form__picker--placeholder'}}">
            {{form.newEnergyValidUntil || '选择日期'}}
          </view>
        </picker>
      </view>
    </block>
    </view>
    </view>

    <view class="merchant-form__section">
      <text class="merchant-form__label">品牌授权（最多 8 个）</text>
      <view
        wx:for="{{form.brandAuthItems}}"
        wx:key="id"
        class="merchant-store-edit__brand-card"
      >
        <input
          class="merchant-form__input"
          placeholder="品牌名称 *，如：宝马"
          value="{{item.brandName}}"
          data-index="{{index}}"
          data-field="brandName"
          bindinput="onBrandAuthInput"
        />
        <picker
          mode="date"
          value="{{item.validUntil}}"
          data-index="{{index}}"
          bindchange="onBrandAuthDateChange"
        >
          <view class="merchant-form__picker merchant-store-edit__auth-date {{item.validUntil ? '' : 'merchant-form__picker--placeholder'}}">
            {{item.validUntil || '选择授权有效期 *'}}
          </view>
        </picker>
        <view class="merchant-store-edit__brand-media">
          <image
            wx:if="{{item.imageUrl}}"
            class="merchant-store-edit__eq-thumb"
            src="{{item.imageUrl}}"
            mode="aspectFill"
          />
          <view
            class="merchant-onboard__photo-slot merchant-onboard__photo-slot--add merchant-store-edit__eq-pick"
            data-index="{{index}}"
            bindtap="onPickBrandAuthImage"
          >
            <text class="text-caption">{{item.imageUrl ? '更换证明' : '上传证明'}}</text>
          </view>
          <text
            wx:if="{{item.imageUrl}}"
            class="merchant-store-edit__eq-clear text-caption"
            data-index="{{index}}"
            bindtap="onClearBrandAuthImage"
          >清除图片</text>
        </view>
        <text class="merchant-store-edit__tech-remove text-caption" data-index="{{index}}" bindtap="onRemoveBrandAuth">删除该品牌授权</text>
      </view>
      <view wx:if="{{form.brandAuthItems.length < 8}}" class="merchant-store-edit__add-tech">
        <ui-button type="secondary" size="sm" bind:btntap="onAddBrandAuth">添加品牌授权</ui-button>
      </view>
    </view>
  </view>

  <view class="merchant-form__spacer" />
  <ui-fixed-bottom-bar>
    <ui-button type="secondary" size="sm" slot="left" bind:btntap="onPreview">预览</ui-button>
    <ui-button type="primary" slot="right" loading="{{submitting}}" bind:btntap="onSave">{{section ? '保存并更新公开资料' : '保存'}}</ui-button>
  </ui-fixed-bottom-bar>
  <privacy-authorize-popup id="privacyAuthorizePopup" />
</view>

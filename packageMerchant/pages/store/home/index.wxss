@import '../../../../styles/mch-craft.wxss';

page {
  background: var(--color-mch-bg);
}

.mch-store {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  color: var(--color-mch-ink);
}

.mch-top {
  padding: var(--space-xs) var(--page-padding-x);
}

.mch-brand {
  font-size: var(--font-mch-page);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-mch-page-lh);
}

.mch-store__headline {
  font-size: var(--font-h2);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-h2-lh);
}

.mch-store__loading {
  padding: var(--space-xl) var(--page-padding-x);
  color: var(--color-mch-muted);
  font-size: var(--font-sub);
}

.mch-store__state {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: var(--space-xl) var(--page-padding-x) 0;
  padding: var(--space-xl) var(--space-lg);
  background: var(--color-bg-card);
  border-radius: var(--radius-mch-card);
  box-shadow: var(--shadow-mch-card);
}

.mch-store__state-title {
  font-size: var(--font-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-mch-ink);
}

.mch-store__state-desc {
  margin-top: var(--space-xs);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-mch-muted);
  text-align: center;
}

.mch-store__retry {
  height: 88rpx;
  margin-top: var(--space-lg);
  padding: 0 var(--space-lg);
  border-radius: var(--radius-full);
  background: var(--color-mch-blue);
  color: var(--color-text-inverse);
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  line-height: 88rpx;
}

.mch-store__retry--pressed {
  opacity: 0.85;
}

.mch-store__card {
  margin: var(--space-md) var(--page-padding-x) 0;
  padding: var(--space-lg) var(--space-md);
  border-radius: var(--mch-radius-hero);
  color: var(--color-mch-ink);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-mch-card);
}

.mch-store__identity {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.mch-store__logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  background: var(--color-mch-blue-soft);
  color: var(--color-mch-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sub);
  font-weight: var(--font-weight-semibold);
  flex: none;
}

.mch-store__logo--pressed {
  opacity: 0.85;
}

.mch-store__main {
  flex: 1;
  min-width: 0;
}

.mch-store__main--pressed {
  opacity: 0.85;
}

.mch-store__name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs);
}

.mch-store__name {
  max-width: 100%;
  font-size: var(--font-h1);
  font-weight: var(--font-weight-semibold);
  line-height: var(--font-h1-lh);
}

.mch-store__pill {
  flex: none;
  margin-top: 2rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  background: var(--color-bg-muted);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-semibold);
}

.mch-store__pill.is-ok {
  background: var(--color-mch-green-soft);
  color: var(--color-mch-green-deep);
}

.mch-store__pill.is-warn {
  background: var(--color-mch-amber-soft);
  color: var(--color-mch-amber-deep);
}

.mch-store__addr {
  display: flex;
  align-items: flex-start;
  gap: var(--space-xs);
  margin-top: var(--space-xs);
}

.mch-store__pin {
  width: 20rpx;
  height: 20rpx;
  margin-top: 6rpx;
  flex: none;
}

.mch-store__addr-text {
  flex: 1;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
}

.mch-store__panel {
  margin: var(--space-md) var(--page-padding-x) 0;
  padding: var(--space-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-mch-card);
  box-shadow: var(--shadow-mch-card);
  display: flex;
  gap: var(--space-md);
  align-items: center;
}

.mch-store__list {
  display: block;
}

.mch-ring {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.mch-ring__hole {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mch-ring__num {
  font-size: var(--font-price);
  font-weight: var(--font-weight-semibold);
  color: var(--color-mch-blue);
}

.mch-ring__unit {
  font-size: var(--font-caption);
  color: var(--color-mch-blue);
}

.mch-store__copy {
  flex: 1;
  min-width: 0;
}

.mch-store__hint,
.mch-store__miss {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-caption);
  color: var(--color-mch-muted);
  line-height: var(--font-caption-lh);
}

.mch-store__section {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: var(--space-xs);
}

.mch-store__preview {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: var(--space-xs) 0 var(--space-xs) var(--space-lg);
  color: var(--color-mch-blue);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
}

.mch-store__preview-ico {
  width: 24rpx;
  height: 24rpx;
}

.mch-store__preview--pressed {
  opacity: 0.6;
}

.mch-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-md) 0;
  border-top: 1rpx solid var(--color-mch-line);
}

.mch-row--pressed {
  background: var(--color-bg-page);
}

.mch-row__well {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--color-mch-blue-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.mch-row__well.is-done {
  background: var(--color-mch-green-soft);
}

.mch-row__ico {
  width: 28rpx;
  height: 28rpx;
}

.mch-row__plus {
  width: 32rpx;
  height: 32rpx;
}

.mch-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mch-row__title {
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-mch-ink);
}

.mch-row__value {
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-mch-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mch-row__chev {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}

.mch-board {
  margin: var(--space-md) var(--page-padding-x) 0;
  padding: var(--space-md);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-mch-card);
}

.mch-board--pressed {
  background: var(--color-bg-page);
}

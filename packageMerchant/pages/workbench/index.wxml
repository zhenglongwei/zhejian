<view class="mch-stage {{createOpen ? 'is-blurred' : ''}}">
<view class="mch-home" style="padding-top: {{statusBarHeight}}px;">
    <block wx:if="{{status === 'loading'}}">
      <view class="merchant-hub__pad">
        <ui-skeleton rows="{{2}}" title="{{true}}" avatar="{{false}}" />
        <view class="merchant-hub__sk-gap">
          <ui-skeleton rows="{{4}}" title="{{false}}" />
        </view>
      </view>
    </block>

    <block wx:elif="{{status === 'pending'}}">
      <view class="merchant-hub__gate">
        <ui-empty
          theme="album"
          title="{{gatePending.title}}"
          description="{{gatePending.description}}"
          actionText="{{archiveIntent ? '开通后继续' : '进入工作台'}}"
          bind:action="onQuickOpen"
        />
        <view class="merchant-hub__role-switch" bindtap="onSwitchToOwner">
          <text class="text-caption text-link">切换为车主</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{status === 'none'}}">
      <view class="merchant-hub__gate">
        <ui-empty
          theme="album"
          title="{{gateNone.title}}"
          description="{{gateNone.description}}"
          actionText="一键开通"
          bind:action="onQuickOpen"
        />
        <view class="merchant-hub__role-switch" bindtap="onSwitchToOwner">
          <text class="text-caption text-link">切换为车主</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{status === 'guest'}}">
      <view class="merchant-hub__gate">
        <ui-empty
          theme="album"
          title="{{gateGuest.title}}"
          description="{{gateGuest.description}}"
          actionText="微信登录"
          bind:action="onGuestLogin"
        />
        <view class="merchant-hub__role-switch" bindtap="onSwitchToOwner">
          <text class="text-caption text-link">切换为车主</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="mch-top" style="padding-right: {{capsulePad}}px;">
        <view>
          <text class="mch-kicker">服务相册 · 商家端</text>
          <view class="mch-brand">{{profile.storeName}}</view>
        </view>
        <view class="mch-bell" bindtap="onOpenMessage">消息</view>
      </view>

      <view class="mch-hero">
        <image class="mch-hero__car" src="/assets/mch/car-white.png" mode="aspectFit" />
        <view class="mch-hero__copy">
          <block wx:if="{{home.heroCount}}">
            <view class="mch-hero__title">今天，有 <text class="mch-hero__em">{{home.heroCount}} 台车</text></view>
            <view class="mch-hero__title">等待继续服务</view>
          </block>
          <view wx:else class="mch-hero__title">今天没有车在服务</view>
          <view class="mch-hero__desc">记录过程，沉淀信任，让每一次维修都成为门店的数字口碑。</view>
          <view class="mch-hero__btn" bindtap="onCreateAlbum">+ 新建服务相册</view>
        </view>
      </view>

      <view class="mch-metrics">
        <view class="mch-metric">
          <text class="mch-metric__label">进行中</text>
          <text class="mch-metric__num">{{home.activeCountText}}</text>
          <text class="mch-metric__hint mch-metric__hint--green">本店进行中</text>
        </view>
        <view class="mch-metric">
          <text class="mch-metric__label">待确认</text>
          <text class="mch-metric__num">{{home.pendingCountText}}</text>
          <text class="mch-metric__hint">{{home.pendingHint}}</text>
        </view>
        <view class="mch-metric">
          <text class="mch-metric__label">本月案例</text>
          <text class="mch-metric__num">{{home.monthCountText}}</text>
          <text class="mch-metric__hint">{{home.monthPublicText}}</text>
        </view>
      </view>

      <view class="mch-section-head">
        <view>
          <text class="mch-kicker">今日进度</text>
          <view class="mch-section-title">正在服务</view>
        </view>
        <text class="mch-more" bindtap="onAlbumList">查看全部</text>
      </view>

      <block wx:if="{{home.featured}}">
        <view class="mch-order" data-id="{{home.featured.albumId}}" bindtap="onHomeAlbumTap">
          <view class="mch-order__top">
            <view class="mch-order__avatar">
              <image class="mch-mark__img" src="/assets/mch/car-blue.png" mode="aspectFit" />
            </view>
            <view class="mch-order__main">
              <text class="mch-order__plate">{{home.featured.plate}}</text>
              <text class="mch-order__model">{{home.featured.modelLine}}</text>
            </view>
            <text class="mch-pill mch-pill--{{home.featured.pillTone}}">{{home.featured.pill}}</text>
          </view>
          <view class="mch-track"><view class="mch-track__bar" style="width: {{home.featured.progress}}%;" /></view>
          <view class="mch-steps">
            <view
              wx:for="{{home.featured.steps}}"
              wx:key="label"
              class="mch-step {{item.state === 'done' || item.state === 'current' ? 'is-on' : ''}}"
            >
              <text wx:if="{{item.state === 'done'}}" class="mch-step__mark">✓</text>
              <text wx:else class="mch-step__dot" />
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="mch-empty">暂无服务相册。点上方按钮新建一本。</view>

      <view
        wx:for="{{home.compact}}"
        wx:key="albumId"
        class="mch-compact"
        data-id="{{item.albumId}}"
        bindtap="onHomeAlbumTap"
      >
        <view class="mch-compact__mark mch-compact__mark--{{item.pillTone}}">
          <image class="mch-mark__img mch-mark__img--sm" src="{{item.markIcon}}" mode="aspectFit" />
        </view>
        <view class="mch-compact__main">
          <text class="mch-compact__plate">{{item.plate}}</text>
          <text class="mch-compact__sub">{{item.subLine}}</text>
        </view>
        <text class="mch-pill mch-pill--{{item.pillTone}}">{{item.pill}}</text>
      </view>
    </block>
</view>
<merchant-tab-bar wx:if="{{status === 'normal'}}" active="home" />
</view>
<merchant-create-sheet show="{{createOpen}}" bind:close="onCloseCreate" />
<privacy-authorize-popup id="privacyAuthorizePopup" />

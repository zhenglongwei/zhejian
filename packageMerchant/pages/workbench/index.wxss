page {
  background: var(--color-mch-bg);
}

.merchant-hub__pad {
  padding: var(--space-md) 32rpx 0;
}

.merchant-hub__sk-gap {
  margin-top: var(--space-md);
}

.merchant-hub__gate {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: var(--space-xl) 32rpx;
  box-sizing: border-box;
}

.merchant-hub__role-switch {
  margin-top: var(--space-lg);
  text-align: center;
}

.mch-stage.is-blurred {
  filter: blur(12px);
}

.mch-home {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-mch-bg);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  color: var(--color-mch-ink);
}

.mch-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 8rpx;
  background: var(--color-bg-card);
}

.mch-kicker {
  color: var(--color-mch-blue);
  font-size: 20rpx;
  font-weight: var(--font-weight-semibold);
  letter-spacing: 2rpx;
}

.mch-brand {
  font-size: 36rpx;
  font-weight: var(--font-weight-semibold);
  line-height: 1.35;
}

.mch-bell {
  height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-mch-line);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  color: var(--color-mch-blue);
  font-size: 24rpx;
  font-weight: var(--font-weight-semibold);
  flex: none;
}

.mch-hero {
  position: relative;
  margin: 24rpx 32rpx 0;
  min-height: 360rpx;
  border-radius: var(--radius-mch-hero);
  color: var(--color-text-inverse);
  background: linear-gradient(135deg, var(--color-mch-hero-start), var(--color-mch-hero-mid) 60%, var(--color-mch-hero-end));
  box-shadow: var(--shadow-mch-hero);
  overflow: hidden;
}

.mch-hero__car {
  position: absolute;
  right: 12rpx;
  bottom: 36rpx;
  width: 200rpx;
  height: 140rpx;
}

.mch-hero__copy {
  padding: 40rpx 36rpx;
}

.mch-hero__title {
  font-size: 44rpx;
  line-height: 1.35;
  font-weight: 500;
}

.mch-hero__em {
  font-weight: var(--font-weight-semibold);
}

.mch-hero__desc {
  margin: 16rpx 0 28rpx;
  width: 78%;
  color: var(--color-text-inverse);
  opacity: 0.78;
  font-size: 22rpx;
  line-height: 1.6;
}

.mch-hero__btn {
  display: inline-flex;
  align-items: center;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  color: var(--color-mch-blue-dark);
  font-size: 26rpx;
  font-weight: var(--font-weight-semibold);
}

.mch-metrics {
  display: flex;
  margin: 24rpx 32rpx 0;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-mch-line);
  border-radius: 36rpx;
  padding: 24rpx 0;
  box-shadow: var(--shadow-mch-card);
}

.mch-metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 24rpx;
  border-right: 1rpx solid var(--color-mch-line);
}

.mch-metric:last-child {
  border-right: 0;
}

.mch-metric__label {
  font-size: 22rpx;
  color: var(--color-mch-muted);
}

.mch-metric__num {
  margin: 4rpx 0;
  font-size: 44rpx;
  font-weight: var(--font-weight-semibold);
  letter-spacing: -1rpx;
  color: var(--color-primary);
}

.mch-metric__hint {
  min-height: 28rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.mch-metric__hint--green {
  color: var(--color-mch-green);
}

.mch-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 36rpx 32rpx 16rpx;
}

.mch-section-title {
  font-size: 36rpx;
  font-weight: var(--font-weight-semibold);
}

.mch-more {
  color: var(--color-mch-muted);
  font-size: 22rpx;
  padding-bottom: 6rpx;
}

.mch-order,
.mch-compact {
  margin: 0 32rpx 16rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-mch-line);
  box-shadow: var(--shadow-mch-card);
}

.mch-order {
  border-radius: var(--radius-mch-card);
  padding: 28rpx;
}

.mch-order__top,
.mch-compact {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mch-order__avatar,
.mch-compact__mark {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: var(--color-mch-blue-soft);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mch-mark__img {
  width: 48rpx;
  height: 48rpx;
}

.mch-mark__img--sm {
  width: 36rpx;
  height: 36rpx;
}

.mch-compact__mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
}

.mch-compact__mark--amber {
  background: var(--color-mch-amber-soft);
}

.mch-compact__mark--green {
  background: var(--color-mch-green-soft);
}

.mch-order__main,
.mch-compact__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mch-order__plate,
.mch-compact__plate {
  font-size: 28rpx;
  font-weight: var(--font-weight-semibold);
}

.mch-order__model,
.mch-compact__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-mch-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mch-pill {
  flex: none;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  font-weight: var(--font-weight-semibold);
}

.mch-pill--blue {
  color: var(--color-mch-blue-dark);
  background: var(--color-mch-blue-soft);
}

.mch-pill--green {
  color: var(--color-mch-green);
  background: var(--color-mch-green-soft);
}

.mch-pill--amber {
  color: var(--color-mch-amber);
  background: var(--color-mch-amber-soft);
}

.mch-track {
  height: 6rpx;
  margin: 28rpx 8rpx 12rpx;
  background: var(--color-bg-muted);
  border-radius: 8rpx;
  overflow: hidden;
}

.mch-track__bar {
  height: 100%;
  background: linear-gradient(90deg, var(--color-mch-blue), var(--color-mch-hero-end));
}

.mch-steps {
  display: flex;
  justify-content: space-between;
}

.mch-step {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-disabled);
}

.mch-step.is-on {
  color: var(--color-mch-blue);
}

.mch-step__mark,
.mch-step__dot {
  width: 16rpx;
  text-align: center;
}

.mch-step__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-border);
}

.mch-step.is-on .mch-step__dot {
  background: var(--color-mch-blue);
}

.mch-compact {
  border-radius: 30rpx;
  padding: 22rpx;
}

.mch-empty {
  margin: 0 32rpx;
  color: var(--color-mch-muted);
  font-size: 26rpx;
}

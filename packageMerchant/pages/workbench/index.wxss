@import '../../../styles/mch-craft.wxss';

page {
  background: var(--color-mch-bg);
}

.merchant-hub__pad {
  padding: var(--space-md) 32rpx 0;
}

.merchant-hub__sk-gap {
  margin-top: var(--space-md);
}

.merchant-hub__gate {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: var(--space-xl) 32rpx;
  box-sizing: border-box;
}

.merchant-hub__role-switch {
  margin-top: var(--space-lg);
  text-align: center;
}

.mch-stage {
  transition: filter var(--mch-motion);
}

.mch-stage.is-blurred {
  filter: blur(12px);
}

.mch-home {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-mch-bg);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  color: var(--color-mch-ink);
}

.mch-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 8rpx;
  background: var(--color-bg-card);
}

.mch-top__main {
  min-width: 0;
  flex: 1;
}

.mch-brand-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  min-width: 0;
}

.mch-brand {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--font-mch-page);
  font-weight: var(--font-weight-semibold);
  line-height: 1.35;
}

.mch-pricing {
  max-width: 100%;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
  line-height: 1.3;
}

.mch-pricing.is-alert {
  color: var(--color-mch-amber-deep);
}

.mch-bell {
  height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-mch-line);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  color: var(--color-mch-blue);
  font-size: var(--font-mch-micro);
  font-weight: var(--font-weight-semibold);
  flex: none;
}

.mch-hero {
  margin: 24rpx 32rpx 0;
  border-radius: var(--mch-radius-hero);
  color: var(--color-mch-ink);
  background: linear-gradient(180deg, #ffffff 0%, #f4f8fe 100%);
  box-shadow: var(--mch-shadow-hero);
}

.mch-hero__copy {
  padding: 40rpx 36rpx;
}

.mch-hero__title {
  font-size: var(--font-mch-display);
  line-height: 1.35;
  font-weight: var(--font-weight-semibold);
}

.mch-hero__em {
  font-size: var(--font-mch-figure-sm);
  font-weight: var(--font-weight-semibold);
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.mch-hero__desc {
  margin: 16rpx 0 28rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: 1.6;
}

.mch-hero__btn {
  display: inline-flex;
  align-items: center;
  height: 72rpx;
  padding: 0 30rpx;
  border-radius: 20rpx;
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  box-sizing: border-box;
  font-size: var(--font-sub);
  font-weight: var(--font-weight-semibold);
}

.mch-hero__btn-plus {
  width: 22rpx;
  height: 22rpx;
  margin-right: 10rpx;
  background-image:
    linear-gradient(var(--color-primary), var(--color-primary)),
    linear-gradient(var(--color-primary), var(--color-primary));
  background-size: 20rpx 3rpx, 3rpx 20rpx;
  background-position: center, center;
  background-repeat: no-repeat;
}

.mch-metrics {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
  background: var(--color-bg-card);
  border-radius: var(--mch-radius);
  padding: 24rpx 0;
  box-shadow: var(--mch-shadow-card);
}

.mch-metrics--press {
  opacity: 0.7;
}

.mch-metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 24rpx;
}

.mch-metric + .mch-metric {
  border-left: 1rpx solid var(--color-mch-line);
}

.mch-metric__label {
  font-size: var(--font-caption);
  color: var(--color-mch-muted);
}

.mch-metric__num {
  margin: 4rpx 0;
  font-size: var(--font-mch-display);
  font-weight: var(--font-weight-semibold);
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
  color: var(--color-text-primary);
}

.mch-metric__num.is-zero {
  color: var(--color-text-tertiary);
  font-weight: var(--font-weight-medium);
}

.mch-metric__unit {
  margin-left: 4rpx;
  font-size: var(--font-caption);
  font-weight: var(--font-weight-regular);
  letter-spacing: 0;
  color: var(--color-mch-muted);
}

.mch-metrics__go {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 0 24rpx 0 8rpx;
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-mch-blue);
}

.mch-metrics__go-ico {
  width: 22rpx;
  height: 22rpx;
}

.mch-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 36rpx 32rpx 16rpx;
}

.mch-section-title {
  font-size: var(--font-mch-page);
  font-weight: var(--font-weight-semibold);
}

.mch-more {
  color: var(--color-mch-muted);
  font-size: var(--font-caption);
  padding-bottom: 6rpx;
}

.mch-order,
.mch-compact {
  margin: 0 32rpx 16rpx;
  background: var(--color-bg-card);
  box-shadow: var(--mch-shadow-card);
  transition: transform var(--mch-motion), box-shadow var(--mch-motion);
}

.mch-order--press,
.mch-compact--press {
  transform: scale(0.99);
  box-shadow: var(--mch-shadow-press);
}

.mch-order {
  border-radius: var(--mch-radius);
  padding: 28rpx;
}

.mch-order__top,
.mch-compact {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mch-order__avatar,
.mch-compact__mark {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: var(--color-mch-blue-soft);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mch-mark__img {
  width: 48rpx;
  height: 48rpx;
}

.mch-mark__img--sm {
  width: 36rpx;
  height: 36rpx;
}

.mch-compact__mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
}

.mch-order__main,
.mch-compact__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mch-order__plate,
.mch-compact__plate {
  font-size: var(--font-h3);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}

.mch-order__model,
.mch-compact__sub {
  margin-top: 6rpx;
  font-size: var(--font-caption);
  color: var(--color-mch-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mch-pill {
  flex: none;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  font-size: var(--font-caption);
  font-weight: var(--font-weight-semibold);
}

.mch-pill--blue {
  color: var(--color-mch-blue-dark);
  background: var(--color-mch-blue-soft);
}

.mch-pill--green {
  color: var(--color-mch-green-deep);
  background: var(--color-mch-green-soft);
}

.mch-pill--amber {
  color: var(--color-mch-amber-deep);
  background: var(--color-mch-amber-soft);
}

.mch-track {
  height: 6rpx;
  margin: 28rpx 8rpx 12rpx;
  background: var(--color-bg-muted);
  border-radius: 8rpx;
  overflow: hidden;
}

.mch-track__bar {
  height: 100%;
  background: var(--color-primary);
}

.mch-steps {
  display: flex;
  justify-content: space-between;
}

.mch-step {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
}

.mch-step.is-done {
  color: var(--color-mch-green-deep);
}

.mch-step.is-current {
  color: var(--color-mch-blue);
}

.mch-step__check {
  position: relative;
  width: 16rpx;
  height: 16rpx;
  flex: none;
}

.mch-step__check::after {
  content: "";
  position: absolute;
  left: 5rpx;
  top: 1rpx;
  width: 6rpx;
  height: 11rpx;
  border: solid currentColor;
  border-width: 0 2rpx 2rpx 0;
  transform: rotate(45deg);
}

.mch-step__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-border);
}

.mch-step.is-current .mch-step__dot {
  background: var(--color-mch-blue);
}

.mch-compact {
  border-radius: var(--mch-radius);
  padding: 22rpx;
}

.mch-empty {
  margin: 0 32rpx;
  color: var(--color-mch-muted);
  font-size: var(--font-sub);
}

.mch-empty--error {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.mch-empty__retry {
  padding: 6rpx 4rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}

.mch-empty__retry--press {
  opacity: 0.55;
}

@import '../../../styles/deep-link-detail.wxss';

.store-detail__hero {
  width: 100%;
  height: 360rpx;
  margin-top: var(--space-md);
  background-color: var(--color-bg-muted);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.store-detail__hero-img {
  width: 100%;
  height: 100%;
}

.store-detail__hero-swiper {
  width: 100%;
  height: 100%;
}

.store-detail__body {
  padding-top: var(--space-md);
}

.store-detail__panel--top {
  margin-top: 0;
}

.store-detail__head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.store-detail__head {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.store-detail__head-actions {
  flex-shrink: 0;
  padding-top: var(--space-xs);
}

.store-detail__panel {
  margin-bottom: var(--space-lg);
}

.store-detail__panel:last-child {
  margin-bottom: 0;
}

.store-detail__notice-gap {
  margin-bottom: var(--space-md);
}

.store-detail__preview-edit {
  margin-top: var(--space-sm);
}

.store-detail__section-head {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.store-detail__line {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: var(--space-sm) 0;
}

.store-detail__line + .store-detail__line {
  border-top: 1rpx solid var(--color-border);
}

.store-detail__line-label {
  width: 72rpx;
  flex-shrink: 0;
  color: var(--color-text-tertiary);
  padding-top: 4rpx;
}

.store-detail__line-value {
  flex: 1;
  min-width: 0;
  color: var(--color-text-primary);
}

.store-detail__line-value--link {
  color: var(--color-primary);
}

.store-detail__chip-block + .store-detail__chip-block {
  margin-top: var(--space-md);
}

.store-detail__chip-label {
  display: block;
  margin-bottom: var(--space-xs);
  color: var(--color-text-tertiary);
}

.store-detail__chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
}

.store-detail__name {
  display: block;
  margin-bottom: var(--space-sm);
}

.store-detail__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}

.store-detail__status-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-sm);
}

.store-detail__status {
  color: var(--color-success);
}

.store-detail__cert-wall {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-md);
  margin-top: var(--space-md);
}

.store-detail__cert-wall-item {
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-bg-muted);
  border: 1rpx solid var(--color-border);
}

.store-detail__cert-wall-img {
  width: 100%;
  height: 200rpx;
  display: block;
}

.store-detail__cert-wall-caption {
  display: block;
  padding: var(--space-sm) var(--space-md);
  color: var(--color-text-secondary);
}

.store-detail__staff-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.store-detail__staff-card {
  padding: var(--space-md);
}

.store-detail__staff-head {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.store-detail__staff-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-bg-muted);
  flex-shrink: 0;
}

.store-detail__staff-meta {
  flex: 1;
  min-width: 0;
}

.store-detail__staff-name {
  display: block;
  font-weight: 600;
}

.store-detail__staff-role {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
}

.store-detail__staff-creds {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-top: var(--space-sm);
}

.store-detail__staff-cred {
  padding: var(--space-xs) var(--space-sm);
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
}

.store-detail__section-links {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.store-detail__evidence {
  margin-top: 0;
}

.store-detail__evidence-stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-top: var(--space-md);
}

.store-detail__evidence-cell {
  padding: var(--space-md);
}

<ui-tool-page-shell
  showBand="{{false}}"
  showCompliance="{{status === 'normal'}}"
>
  <block wx:if="{{status === 'loading'}}">
    <view class="deep-link-detail__pad">
      <ui-skeleton rows="{{6}}" title="{{true}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <ui-empty
      title="无法加载门店"
      description="{{errorMessage}}"
      actionText="重试"
      bind:action="onRetry"
    />
  </block>

  <block wx:elif="{{store}}">
    <view class="deep-link-detail__body store-detail__body">
      <view wx:if="{{isPreview}}" class="notice store-detail__notice-gap">
        <text>{{previewBannerText}}</text>
        <view wx:if="{{canEditStore}}" class="store-detail__preview-edit">
          <ui-button type="secondary" size="sm" bind:btntap="onEditStore">编辑门店资料</ui-button>
        </view>
      </view>

      <view class="surface-album-panel store-detail__panel store-detail__panel--top">
        <view class="store-detail__head-row">
          <view class="store-detail__head">
            <text class="store-detail__name text-h1">{{store.name}}</text>
            <view class="store-detail__tags">
              <ui-tag
                wx:for="{{headTags}}"
                wx:key="text"
                variant="{{item.variant}}"
                text="{{item.text}}"
              />
            </view>
            <view class="store-detail__status-row">
              <text class="store-detail__status text-body">{{statusText}}</text>
            </view>
          </view>
          <ui-detail-top-actions
            wx:if="{{status === 'normal'}}"
            class="store-detail__head-actions"
            showFavorite="{{!isPreview}}"
            isFavorited="{{isFavorited}}"
            showShare="{{showTopShare}}"
            shareDisabled="{{shareActionsDisabled}}"
            bind:favorite="onTopFavoriteTap"
            bind:share="onOpenShareSheet"
          />
        </view>

        <view wx:if="{{heroImages.length}}" class="store-detail__hero">
        <swiper
          wx:if="{{heroImages.length > 1}}"
          class="store-detail__hero-swiper"
          indicator-dots
          autoplay
          circular
          interval="4000"
        >
          <swiper-item wx:for="{{heroImages}}" wx:key="*this">
            <image
              class="store-detail__hero-img"
              src="{{item}}"
              mode="aspectFill"
              data-url="{{item}}"
              bindtap="onPreviewEnvironment"
            />
          </swiper-item>
        </swiper>
        <image
          wx:else
          class="store-detail__hero-img"
          src="{{heroImages[0]}}"
          mode="aspectFill"
          data-url="{{heroImages[0]}}"
          bindtap="onPreviewEnvironment"
        />
        </view>
      </view>

      <view
        wx:if="{{storeAddress || storePhone || storeBusinessHours || storeIntro}}"
        class="surface-album-panel store-detail__panel"
      >
        <view wx:if="{{storeAddress}}" class="store-detail__line" bindtap="onNavigateTap">
          <text class="store-detail__line-label text-caption">地址</text>
          <text class="store-detail__line-value text-body {{showStoreNavigate ? 'store-detail__line-value--link' : ''}}">{{storeAddress}}</text>
        </view>
        <view wx:if="{{storePhone}}" class="store-detail__line" bindtap="onCallStore">
          <text class="store-detail__line-label text-caption">电话</text>
          <text class="store-detail__line-value store-detail__line-value--link text-body">{{storePhoneDisplay}}</text>
        </view>
        <view wx:if="{{storeBusinessHours}}" class="store-detail__line">
          <text class="store-detail__line-label text-caption">营业</text>
          <text class="store-detail__line-value text-body">{{storeBusinessHours}}</text>
        </view>
        <view wx:if="{{storeIntro}}" class="store-detail__line">
          <text class="store-detail__line-label text-caption">简介</text>
          <text class="store-detail__line-value text-body">{{storeIntro}}</text>
        </view>
      </view>

      <view
        wx:if="{{serviceChips.length || brandChips.length || vehicleChips.length || notAcceptingChips.length || equipmentChips.length}}"
        class="surface-album-panel store-detail__panel"
      >
        <view class="store-detail__section-head">
          <view class="surface-album-section-accent" />
          <text class="deep-link-detail__section-title text-h2">擅长</text>
        </view>
        <view wx:if="{{serviceChips.length}}" class="store-detail__chip-block">
          <text class="store-detail__chip-label text-caption">服务</text>
          <view class="store-detail__chips">
            <ui-tag wx:for="{{serviceChips}}" wx:key="*this" variant="default" text="{{item}}" />
          </view>
        </view>
        <view wx:if="{{brandChips.length}}" class="store-detail__chip-block">
          <text class="store-detail__chip-label text-caption">品牌</text>
          <view class="store-detail__chips">
            <ui-tag wx:for="{{brandChips}}" wx:key="*this" variant="default" text="{{item}}" />
          </view>
        </view>
        <view wx:if="{{vehicleChips.length}}" class="store-detail__chip-block">
          <text class="store-detail__chip-label text-caption">车型</text>
          <view class="store-detail__chips">
            <ui-tag wx:for="{{vehicleChips}}" wx:key="*this" variant="default" text="{{item}}" />
          </view>
        </view>
        <view wx:if="{{equipmentChips.length}}" class="store-detail__chip-block">
          <text class="store-detail__chip-label text-caption">设备</text>
          <view class="store-detail__chips">
            <ui-tag wx:for="{{equipmentChips}}" wx:key="*this" variant="default" text="{{item}}" />
          </view>
        </view>
        <view wx:if="{{notAcceptingChips.length}}" class="store-detail__chip-block">
          <text class="store-detail__chip-label text-caption">暂不承接</text>
          <view class="store-detail__chips">
            <ui-tag wx:for="{{notAcceptingChips}}" wx:key="*this" variant="default" text="{{item}}" />
          </view>
        </view>
      </view>

      <view wx:if="{{certWall.length || certNameTags.length}}" class="surface-album-panel store-detail__panel">
        <view class="store-detail__section-head">
          <view class="surface-album-section-accent" />
          <text class="deep-link-detail__section-title text-h2">门店资质</text>
        </view>
        <view wx:if="{{certWall.length}}" class="store-detail__cert-wall">
          <view
            wx:for="{{certWall}}"
            wx:key="id"
            class="store-detail__cert-wall-item"
            bindtap="onPreviewCert"
            data-url="{{item.imageUrl}}"
            data-label="{{item.label}}"
          >
            <image class="store-detail__cert-wall-img" src="{{item.imageUrl}}" mode="aspectFill" />
            <text class="store-detail__cert-wall-caption text-caption">{{item.label}}</text>
          </view>
        </view>
        <view wx:if="{{certNameTags.length}}" class="store-detail__chips">
          <ui-tag wx:for="{{certNameTags}}" wx:key="*this" variant="default" text="{{item}}" />
        </view>
      </view>

      <view wx:if="{{staffPublic.length}}" class="surface-album-panel store-detail__panel" id="store-staff">
        <view class="store-detail__section-head">
          <view class="surface-album-section-accent" />
          <text class="deep-link-detail__section-title text-h2">技师</text>
        </view>
        <view class="store-detail__staff-list">
          <view
            wx:for="{{staffPublic}}"
            wx:key="id"
            class="surface-record-card store-detail__staff-card"
          >
            <view class="store-detail__staff-head">
              <image
                wx:if="{{item.avatarUrl}}"
                class="store-detail__staff-avatar"
                src="{{item.avatarUrl}}"
                mode="aspectFill"
              />
              <view class="store-detail__staff-meta">
                <text class="store-detail__staff-name text-body">{{item.name}}</text>
                <text class="store-detail__staff-role text-caption">{{item.role}}{{item.years ? ' · ' + item.years : ''}}</text>
              </view>
            </view>
            <view wx:if="{{item.credentials.length}}" class="store-detail__staff-creds">
              <text
                wx:for="{{item.credentials}}"
                wx:for-item="cred"
                wx:key="*this"
                class="store-detail__staff-cred text-caption"
              >{{cred}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{services.length}}" class="surface-album-panel store-detail__panel store-detail__evidence">
        <view class="deep-link-detail__section-head">
          <view class="surface-album-section-accent" />
          <text class="deep-link-detail__section-title text-h2">服务方案</text>
          <view wx:if="{{!isPreview && services.length}}" class="store-detail__section-links">
            <text class="deep-link-detail__more text-caption" bindtap="onSearchStore">搜索本店</text>
            <text class="deep-link-detail__more text-caption" bindtap="onViewAllServices">查看更多</text>
          </view>
        </view>
        <view class="deep-link-detail__notice">
          <ui-compliance-notice type="price" />
        </view>
        <view class="store-detail__evidence-stack">
          <view
            wx:for="{{services}}"
            wx:key="id"
            class="surface-record-card store-detail__evidence-cell"
          >
            <ui-service-card
              embedded="{{true}}"
              showTags="{{false}}"
              serviceId="{{item.id}}"
              name="{{item.name}}"
              categoryName="{{item.categoryName}}"
              summary="{{item.summary}}"
              priceMode="{{item.priceMode}}"
              amount="{{item.amount}}"
              minAmount="{{item.minAmount}}"
              maxAmount="{{item.maxAmount}}"
              storeName="{{item.storeName}}"
              showStoreName="{{false}}"
              bind:cardtap="onServiceTap"
            />
          </view>
        </view>
      </view>

      <view wx:if="{{!isPreview}}" class="deep-link-detail__section deep-link-detail__report">
        <ui-detail-report-entry
          targetType="store"
          targetId="{{store.id}}"
          targetTitle="{{store.name}}"
          attached="{{true}}"
        />
      </view>
    </view>
  </block>
</ui-tool-page-shell>

<block wx:if="{{store && status === 'normal'}}">
  <ui-share-sheet
    visible="{{shareSheetVisible}}"
    showOwnerShare="{{false}}"
    shareIntent="publicStore"
    actionsDisabled="{{shareActionsDisabled}}"
    bind:close="onCloseShareSheet"
    bind:copypublicweblink="onCopyPublicWebLink"
    bind:sharetimeline="onShareTimelineGuide"
  />

  <ui-login-sheet
    visible="{{loginSheetVisible}}"
    mode="{{loginSheetMode}}"
    bindContext="{{loginSheetBindContext}}"
    bind:close="closeLoginSheet"
    bind:cancel="closeLoginSheet"
    bind:success="onLoginSheetSuccess"
  />
</block>

.desensitize-preview__banner {
  display: block;
  margin-bottom: var(--space-md);
}

.desensitize-preview__summary {
  margin-bottom: var(--space-md);
}

.desensitize-preview__draft-missing {
  margin-bottom: var(--space-md);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle);
  color: var(--color-warning, #b45309);
  line-height: 1.5;
}

.desensitize-preview__case-draft {
  margin-bottom: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-elevated, #fff);
  border: 1rpx solid var(--color-border);
}

.desensitize-preview__case-title {
  display: block;
  margin-bottom: var(--space-sm);
}

.desensitize-preview__case-hint {
  display: block;
  margin-bottom: var(--space-md);
  line-height: 1.5;
}

.desensitize-preview__case-summary {
  margin-bottom: var(--space-md);
}

.desensitize-preview__case-heading {
  display: block;
  margin-bottom: var(--space-md);
  font-weight: 600;
}

.desensitize-preview__case-section {
  margin-bottom: var(--space-md);
}

.desensitize-preview__case-sec-title {
  display: block;
  margin-bottom: var(--space-xs);
  font-weight: 600;
}

.desensitize-preview__case-sec-body {
  display: block;
  color: var(--color-text-secondary);
  line-height: 1.6;
  white-space: pre-wrap;
}

.desensitize-preview__case-media {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.desensitize-preview__case-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-muted);
}

.desensitize-preview__public-hint,
.desensitize-preview__public-count {
  margin-bottom: var(--space-md);
  padding: var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.desensitize-preview__ready {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.desensitize-preview__ready-hint {
  flex: 1;
  min-width: 0;
  color: var(--color-text-secondary);
}

.desensitize-preview__preview-hint {
  margin-bottom: var(--space-md);
  color: var(--color-text-secondary);
}

.desensitize-preview__bar-left {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-xs);
}

.desensitize-preview__empty-auth {
  margin: var(--space-4) 0;
  padding: var(--space-3);
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.desensitize-preview__consent {
  padding: var(--space-sm) var(--page-padding-x) 0;
}

.desensitize-preview__dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-fixed);
  background: var(--color-bg-card);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.desensitize-preview__dock-actions {
  padding: var(--space-sm) var(--page-padding-x) var(--space-md);
}

.desensitize-preview__dock-actions--row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.desensitize-preview__dock-btn {
  flex: 1;
  min-width: 0;
}

.desensitize-preview__share-panel {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: var(--space-sm) 0 var(--space-xs);
}

.desensitize-preview__share-channels {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
}

.desensitize-preview__share-channel {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  min-width: 0;
  padding: var(--space-md) var(--space-xs);
  border-radius: var(--radius-md);
  background: var(--color-bg-muted);
  box-sizing: border-box;
}

.desensitize-preview__share-channel--active {
  background: var(--color-bg-active);
}

.desensitize-preview__share-channel-btn {
  margin: 0;
  border: none;
  line-height: inherit;
  font-size: inherit;
}

.desensitize-preview__share-channel-btn::after {
  border: none;
}

.desensitize-preview__share-icon {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-card);
  color: var(--color-primary);
  box-shadow: var(--shadow-card-soft);
}

.desensitize-preview__share-icon--site {
  background: var(--color-primary-light);
}

.desensitize-preview__share-icon-text {
  font-size: var(--font-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  line-height: 1;
}

.desensitize-preview__share-img {
  width: 48rpx;
  height: 48rpx;
}

.desensitize-preview__share-label {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
  line-height: 1.4;
}

.desensitize-preview__share-desc {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--color-text-tertiary);
  line-height: 1.4;
}

.desensitize-preview__share-foot {
  display: block;
  text-align: center;
  padding: var(--space-sm) 0 var(--space-xs);
  color: var(--color-text-secondary);
}

.desensitize-preview__spacer {
  height: var(--page-fixed-clearance);
}

.desensitize-preview__spacer--dock {
  height: calc(360rpx + env(safe-area-inset-bottom));
}

<view class="page desensitize-preview page-content">
  <block wx:if="{{status === 'loading'}}">
    <ui-skeleton rows="{{4}}" title="{{true}}" />
  </block>

  <block wx:elif="{{status === 'error'}}">
    <ui-empty
      title="无法加载预览"
      description="{{errorMessage}}"
      actionText="重试"
      bind:action="onRetryLoad"
    />
  </block>

  <block wx:elif="{{status === 'empty' && !isDraftOnly}}">
    <ui-empty
      title="暂无待核对图片"
      description="请返回服务相册重试"
      actionText="返回相册"
      bind:action="onBackAlbum"
    />
  </block>

  <block wx:else>
    <!-- 车主发布：只读预览将上网案例文案（不含原图/脱敏对比工作台） -->
    <block wx:if="{{isDraftOnly}}">
      <view class="desensitize-preview__banner">
        <ui-privacy-banner text="以下为即将发布到公开网站的案例文案。我们筛选了关键节点照片，删除了可能暴露您隐私的照片，并对一部分照片进行了马赛克处理。请您确认。公开以后，您可随时撤回您的案例。" />
      </view>
      <view wx:if="{{caseDraftMissing}}" class="desensitize-preview__draft-missing text-caption">
        案例稿暂时无法加载，请稍后重试。若持续出现，请联系门店或客服。
      </view>
      <view wx:elif="{{caseDraftTitle || caseDraftSections.length || caseDraftSummary}}" class="desensitize-preview__case-draft">
        <text wx:if="{{caseDraftTitle}}" class="text-body desensitize-preview__case-heading">{{caseDraftTitle}}</text>
        <view wx:if="{{caseDraftSummary}}" class="desensitize-preview__case-summary">
          <text class="text-body desensitize-preview__case-sec-title">案例摘要</text>
          <text class="text-caption desensitize-preview__case-sec-body">{{caseDraftSummary}}</text>
        </view>
        <block wx:for="{{caseDraftSections}}" wx:key="key">
          <view class="desensitize-preview__case-section">
            <text class="text-body desensitize-preview__case-sec-title">{{item.title}}</text>
            <text class="text-caption desensitize-preview__case-sec-body">{{item.body}}</text>
            <view class="desensitize-preview__case-media">
              <block wx:for="{{caseDraftMedia}}" wx:for-item="m" wx:for-index="mi" wx:key="mi">
                <image
                  wx:if="{{m.sectionKey === item.key && m.displayUrl}}"
                  class="desensitize-preview__case-thumb"
                  src="{{m.displayUrl}}"
                  mode="aspectFill"
                  data-url="{{m.displayUrl}}"
                  bindtap="onDraftImageTap"
                />
              </block>
            </view>
          </view>
        </block>
      </view>
      <view wx:elif="{{aiSummary}}" class="desensitize-preview__summary">
        <ui-ai-summary-block content="{{aiSummary}}" />
      </view>

      <view class="desensitize-preview__spacer desensitize-preview__spacer--dock" />
      <view class="desensitize-preview__dock safe-bottom">
        <view class="desensitize-preview__consent">
          <ui-checkbox-row checked="{{liabilityAccepted}}" bind:toggle="onConsentToggle">
            <text>{{liabilityText}}</text>
            <text
              wx:if="{{policyLinkText}}"
              class="text-link"
              catchtap="onOpenPolicy"
            >{{policyLinkText}}</text>
            <text wx:if="{{liabilityTextAfter}}">{{liabilityTextAfter}}</text>
          </ui-checkbox-row>
        </view>
        <view class="desensitize-preview__dock-actions">
          <ui-button
            type="primary"
            block
            loading="{{confirmLoading}}"
            disabled="{{confirmLoading || caseDraftMissing}}"
            bind:btntap="onShareReportTap"
          >{{confirmLabelShort}}</ui-button>
        </view>
      </view>

      <ui-bottom-sheet
        visible="{{shareSheetVisible}}"
        title="分享报告"
        hint="发给微信不会自动上网；仅「官方网站」会发布到公开站。"
        showActions="{{false}}"
        bind:close="onCloseShareSheet"
      >
        <view class="desensitize-preview__share-panel">
          <view class="desensitize-preview__share-channels">
            <view class="desensitize-preview__share-channel" bindtap="onPublishOfficial">
              <view class="desensitize-preview__share-icon desensitize-preview__share-icon--site">
                <text class="desensitize-preview__share-icon-text">站</text>
              </view>
              <text class="desensitize-preview__share-label text-caption">官方网站</text>
              <text class="desensitize-preview__share-desc text-caption">发布到公开站</text>
            </view>

            <view class="desensitize-preview__share-channel" bindtap="onShareTimelineGuide">
              <view class="desensitize-preview__share-icon">
                <image class="desensitize-preview__share-img" src="/assets/share/icon-moments.svg" mode="aspectFit" />
              </view>
              <text class="desensitize-preview__share-label text-caption">朋友圈</text>
              <text class="desensitize-preview__share-desc text-caption">右上角发出</text>
            </view>

            <button
              class="desensitize-preview__share-channel desensitize-preview__share-channel-btn"
              open-type="share"
              hover-class="desensitize-preview__share-channel--active"
            >
              <view class="desensitize-preview__share-icon">
                <image class="desensitize-preview__share-img" src="/assets/share/icon-friend.svg" mode="aspectFit" />
              </view>
              <text class="desensitize-preview__share-label text-caption">转发给朋友</text>
              <text class="desensitize-preview__share-desc text-caption">好友或群</text>
            </button>
          </view>
          <text class="desensitize-preview__share-foot text-caption text-secondary" bindtap="onCloseShareSheet">取消</text>
        </view>
      </ui-bottom-sheet>
    </block>

    <!-- 订单授权 / 评价配图等：保留脱敏对比工作台 -->
    <block wx:else>
      <view class="desensitize-preview__banner">
        <ui-privacy-banner scene="desensitize" />
      </view>
      <view wx:if="{{aiSummary}}" class="desensitize-preview__summary">
        <ui-ai-summary-block content="{{aiSummary}}" />
      </view>
      <view wx:if="{{publicViewHint}}" class="desensitize-preview__public-hint text-caption">
        {{publicViewHint}}
      </view>
      <view wx:if="{{fromPreMask}}" class="desensitize-preview__ready">
        <ui-tag variant="desensitized" text="已自动脱敏" />
        <text class="desensitize-preview__ready-hint text-caption">敏感信息已预处理，请逐张核对后再授权公示。</text>
      </view>
      <view wx:if="{{needPreviewHint}}" class="desensitize-preview__preview-hint text-caption">
        建议逐张查看右侧脱敏图，确认效果符合预期后再授权公示。
      </view>
      <ui-desensitize-workbench
        items="{{workbenchItems}}"
        processedCount="{{stats.processed}}"
        totalCount="{{stats.total}}"
        failedCount="{{stats.failed}}"
        liabilityText="{{liabilityText}}"
        liabilityTextAfter="{{liabilityTextAfter}}"
        liabilityAccepted="{{liabilityAccepted}}"
        policyLinkText="{{policyLinkText}}"
        bind:liabilitychange="onLiabilityChange"
        bind:policy="onOpenPolicy"
        bind:preview="onPreview"
        bind:retry="onRetryAsset"
        bind:manualmask="onManualMaskItem"
        bind:exclude="onExcludeAsset"
      />
      <view class="desensitize-preview__spacer" />
      <ui-fixed-bottom-bar>
        <view slot="left" class="desensitize-preview__bar-left">
          <ui-button
            wx:if="{{!fromPreMask}}"
            type="primary"
            size="sm"
            loading="{{autoMaskLoading}}"
            bind:btntap="onAutoMask"
          >一键 AI 脱敏</ui-button>
          <ui-button
            type="ghost"
            size="sm"
            bind:btntap="onManualMask"
          >手工打码</ui-button>
        </view>
        <ui-button
          type="primary"
          slot="right"
          loading="{{confirmLoading}}"
          disabled="{{confirmLoading}}"
          bind:btntap="onConfirm"
        >{{confirmLabelShort}}</ui-button>
      </ui-fixed-bottom-bar>
    </block>
  </block>
</view>

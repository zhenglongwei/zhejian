<ui-tool-page-shell showBand="{{false}}" showCompliance="{{false}}">
  <block wx:if="{{status === 'loading'}}">
    <view class="mine__pad">
      <ui-skeleton rows="{{4}}" title="{{true}}" avatar="{{true}}" />
      <ui-skeleton rows="{{5}}" title="{{false}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <ui-empty
      theme="album"
      title="加载失败"
      description="{{errorMessage}}"
      actionText="重试"
      bind:action="onRetry"
    />
  </block>

  <block wx:else>
    <view class="mine__hub">
      <view class="mine__hello" bindtap="onHelloTap">
        <text class="mine__kicker">服务相册 · 车主</text>
        <text class="mine__name">{{isLoggedIn ? (user.nickname || user.phoneDisplay || '你好') : guestLoginTitle}}</text>
      </view>
      <view wx:if="{{isLoggedIn && heroLine}}" class="mine__hero-line">
        <text>{{heroLine}}</text>
      </view>
      <view wx:if="{{needPhoneHint}}" class="mine__phone-hint" bindtap="onBindPhoneHintTap">
        <text class="mine__phone-hint__text">绑定手机号后可查看门店为你创建的服务相册</text>
        <text class="mine__phone-hint__action">去绑定</text>
      </view>
      <view class="mine__section-head">
        <text class="mine__section-title">{{albumSectionTitle}}</text>
      </view>
      <view wx:if="{{isLoggedIn}}" class="mine__chips">
        <text
          wx:for="{{hubFilters}}"
          wx:key="key"
          class="mine__chip {{hubFilter === item.key ? 'is-on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onHubFilterTap"
        >{{item.label}}</text>
      </view>
      <block wx:if="{{isLoggedIn && albumHeroCards.length}}">
        <view class="mine__album-stack">
          <ui-album-card
            wx:for="{{albumHeroCards}}"
            wx:key="albumId"
            item="{{item}}"
            audience="user"
            layout="board"
            showQuickActions="{{true}}"
            embedded="{{true}}"
            data-id="{{item.albumId}}"
            bind:tap="onAlbumCardTap"
            bind:ownerreview="onAlbumOwnerReview"
          />
        </view>
      </block>
      <block wx:elif="{{isLoggedIn && hubAlbums.length && hubFilter !== 'preview'}}">
        <ui-empty theme="album" title="{{hubEmptyTitle}}" />
      </block>
      <block wx:else>
        <ui-empty
          theme="album"
          title="{{albumEmptyTitle}}"
          description="{{albumEmptyDesc}}"
        />
        <view wx:if="{{isLoggedIn}}" class="mine__empty-alt" bindtap="onEmptyH5Tap">
          <text class="text-caption text-link">{{albumEmptyH5Link}}</text>
        </view>
      </block>
      <view class="mine__links">
        <view
          wx:for="{{hubLinks}}"
          wx:key="key"
          class="mine__link"
          data-key="{{item.key}}"
          bindtap="onHubLinkTap"
        >
          <text>{{item.label}}</text>
          <text class="mine__link-arrow">›</text>
        </view>
      </view>

      <view
        wx:if="{{showGuestH5Link}}"
        class="mine__h5-outlet"
        bindtap="onH5OutletTap"
      >
        <text class="text-caption text-link">{{h5OutletText}}</text>
      </view>
    </view>
  </block>
</ui-tool-page-shell>

<privacy-authorize-popup id="privacyAuthorizePopup" />
<ui-login-sheet
  visible="{{loginSheetVisible}}"
  mode="{{loginSheetMode}}"
  bindContext="{{loginSheetBindContext}}"
  bind:close="closeLoginSheet"
  bind:cancel="closeLoginSheet"
  bind:success="onLoginSheetSuccess"
/>

@import '../../styles/own-craft.wxss';

.mine__pad {
  padding-top: var(--space-md);
}

/* V3 深蓝 hero：自定义导航下渐变铺到屏幕顶，padding-top 由行内状态栏高度接管 */
.mine__hero {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  margin: calc(-1 * var(--space-sm)) calc(-1 * var(--page-padding-x)) 0;
  padding: 24rpx calc(var(--page-padding-x) + 8rpx) 132rpx;
  background: linear-gradient(163deg, #0c3f83 0%, #12579f 58%, #0e4a90 100%);
}

.mine__hero-ring {
  position: absolute;
  top: -100rpx;
  right: -140rpx;
  width: 500rpx;
  height: 500rpx;
  border: 56rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.mine__who {
  position: relative;
  display: block;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: var(--font-h3);
  line-height: 1.5;
}

.mine__name {
  position: relative;
  display: block;
  margin-top: 10rpx;
  color: var(--color-text-inverse);
  font-size: var(--own-font-hero-name);
  font-weight: var(--font-weight-semibold);
  line-height: 1.25;
}

.mine__odo {
  position: relative;
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin-top: 40rpx;
}

.mine__odo-num {
  color: var(--color-text-inverse);
  font-family: 'DIN Alternate', 'Roboto Mono', 'Menlo', 'Consolas', monospace;
  font-size: var(--own-font-hero-figure);
  font-weight: var(--font-weight-semibold);
  line-height: 1.1;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.mine__odo-unit {
  color: rgba(255, 255, 255, 0.7);
  font-size: var(--font-body);
  line-height: 1.4;
}

/* 白卡叠压 hero 底缘 */
.mine__lift {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: -94rpx;
  padding-bottom: var(--space-md);
}

.mine__album-stack {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.mine__phone-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  padding: 20rpx 28rpx;
  border-radius: var(--own-radius);
  background: var(--color-bg-card);
  box-shadow: var(--own-shadow-card);
}

.mine__phone-hint__text {
  flex: 1;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.mine__phone-hint__action {
  flex-shrink: 0;
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-primary);
}

.mine__links {
  padding: 0 42rpx;
  border-radius: 36rpx;
  background: var(--color-bg-card);
  box-shadow: 0 4rpx 20rpx rgba(20, 27, 45, 0.06);
}

.mine__link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-text-primary);
  font-size: var(--own-font-row);
  line-height: 1.4;
}

.mine__link:last-child {
  border-bottom: none;
}

.mine__link-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.mine__empty-card {
  padding: var(--space-md);
  border-radius: 36rpx;
  background: var(--color-bg-card);
  box-shadow: var(--own-shadow-card);
}

.mine__empty-alt {
  min-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine__h5-outlet {
  padding: var(--space-sm) var(--space-md);
  text-align: center;
  box-sizing: border-box;
}

.mine__h5-outlet:active {
  opacity: 0.72;
}

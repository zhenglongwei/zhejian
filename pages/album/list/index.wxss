@import '../../../styles/own-craft.wxss';

page {
  background: var(--color-bg-page);
}

.album-list__chips {
  display: flex;
  gap: 18rpx;
  padding: 8rpx 0 4rpx;
}

.album-list__chip {
  padding: 12rpx 28rpx;
  border-radius: var(--radius-full);
  background: transparent;
  color: #626e80;
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  line-height: 1.5;
  border: 1rpx solid transparent;
  transition: background-color var(--own-motion), border-color var(--own-motion), color var(--own-motion);
}

.album-list__chip.is-on {
  background: #0c3f83;
  border-color: #0c3f83;
  color: #ffffff;
  font-weight: var(--font-weight-semibold);
}

.album-list__download-hint {
  margin: var(--space-xs) 0 var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  color: var(--color-text-secondary);
  line-height: 1.5;
  background-color: var(--color-bg-muted);
  border-radius: var(--radius-md);
}

.album-list__board {
  margin-top: var(--space-sm);
  margin-bottom: var(--space-xl);
}

.album-list__board .album-list__list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.album-list__catalog--with-bar {
  margin-bottom: calc(var(--space-xl) + 140rpx);
  padding-bottom: env(safe-area-inset-bottom);
}

.album-list__list {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding-bottom: var(--space-xs);
}

.album-list__state {
  padding-top: var(--space-lg);
  padding-bottom: var(--space-xl);
}

.album-list__empty-alt {
  margin-top: var(--space-sm);
  min-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.album-list__auth-submit {
  margin-top: var(--space-md);
}

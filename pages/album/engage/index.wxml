<view class="page album-engage">
  <block wx:if="{{status === 'loading'}}">
    <view class="page-content album-engage__pad">
      <ui-skeleton rows="{{6}}" title="{{true}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty title="无法打开" description="{{errorMessage}}" actionText="返回" bind:action="onBack" />
    </view>
  </block>

  <block wx:else>
    <view class="album-engage__header">
      <text class="album-engage__feedback-link text-link text-caption" bindtap="onOpenFeedback">问题反馈</text>
    </view>

    <view class="page-content album-engage__body {{eligible && !hasReview ? 'album-engage__body--with-bar' : ''}}">
      <view class="album-engage__hero">
        <text class="album-engage__album-title text-body">{{albumTitle}}</text>
        <text wx:if="{{gateBanner}}" class="album-engage__gate-banner text-caption text-secondary">{{gateBanner}}</text>
        <text wx:if="{{hasReview}}" class="album-engage__done-hint text-caption text-secondary">评价已保存，可继续分享脱敏报告或发给微信</text>
      </view>

      <block wx:if="{{hasReview}}">
        <view wx:if="{{existingRepairScore > 0 || existingAlbumScore > 0}}" class="album-engage__score-row">
          <text wx:if="{{existingRepairScore > 0}}" class="text-caption text-secondary">维修 {{existingRepairScore}}</text>
          <text wx:if="{{existingAlbumScore > 0}}" class="text-caption text-secondary">记录 {{existingAlbumScore}}</text>
        </view>

        <ui-card wx:if="{{existingContent || existingTags.length}}" shadow="{{true}}" padding="{{true}}">
          <text class="album-engage__section-title text-h3">我的评价</text>
          <text wx:if="{{existingContent}}" class="text-body">{{existingContent}}</text>
          <view wx:if="{{existingTags.length}}" class="album-engage__tags">
            <ui-tag wx:for="{{existingTags}}" wx:key="*this" variant="default" text="{{item}}" />
          </view>
        </ui-card>

        <ui-card wx:if="{{merchantReply}}" shadow="{{true}}" padding="{{true}}">
          <text class="album-engage__section-title text-h3">门店回复</text>
          <text class="text-body">{{merchantReply}}</text>
          <text wx:if="{{merchantReplyAt}}" class="album-engage__action-hint text-caption text-secondary">{{merchantReplyAt}}</text>
        </ui-card>

        <ui-card wx:if="{{hasFollowUp}}" shadow="{{true}}" padding="{{true}}">
          <text class="album-engage__section-title text-h3">我的追评</text>
          <text wx:if="{{followUpContent}}" class="text-body">{{followUpContent}}</text>
          <text wx:if="{{followUpAt}}" class="album-engage__action-hint text-caption text-secondary">{{followUpAt}}</text>
        </ui-card>

        <block wx:if="{{canFollowUp}}">
          <ui-card shadow="{{true}}" padding="{{true}}">
            <text class="album-engage__section-title text-h3">追评（可选，仅一次）</text>
            <textarea
              class="album-engage__textarea text-body"
              placeholder="补充到店后的感受，最多 300 字"
              value="{{followUpDraft}}"
              maxlength="300"
              bindinput="onFollowUpInput"
            />
            <text class="album-engage__counter text-caption">{{followUpDraftLength}}/300</text>
            <ui-image-uploader images="{{followUpForm.images}}" maxCount="{{3}}" bind:change="onFollowUpImagesChange" />
            <view class="album-engage__notice">
              <ui-compliance-notice type="reviewImageTip" />
            </view>
            <ui-button
              type="secondary"
              block
              loading="{{followUpSubmitting}}"
              disabled="{{followUpSubmitting}}"
              bind:btntap="onSubmitFollowUp"
            >提交追评</ui-button>
          </ui-card>
        </block>

        <ui-card wx:if="{{hasReview && (showAuthAction || showShareButton || showStoreBrowse || hasParts || needsReviewImagePreview || gateActions.length)}}" shadow="{{true}}" padding="{{true}}" class="album-engage__actions-card">
          <view class="album-engage__actions">
            <ui-button
              wx:for="{{gateActions}}"
              wx:key="key"
              type="secondary"
              block
              data-key="{{item.key}}"
              bind:btntap="onGateActionTap"
            >{{item.label}}</ui-button>
            <ui-button
              wx:if="{{needsReviewImagePreview}}"
              type="secondary"
              block
              bind:btntap="onOpenReviewImagePreview"
            >核对评价配图</ui-button>
            <block wx:if="{{showAuthAction || showShareButton}}">
              <ui-button
                type="secondary"
                block
                disabled="{{showAuthAction && authDisabled}}"
                bind:btntap="onOpenOwnerSharePage"
              >{{showAuthAction ? authLabel : '分享脱敏报告'}}</ui-button>
              <text wx:if="{{showAuthAction && authDisabled && authHint}}" class="album-engage__action-hint text-caption text-secondary">{{authHint}}</text>
            </block>
            <ui-button
              wx:if="{{showStoreBrowse}}"
              type="secondary"
              block
              bind:btntap="onOpenLinkedStore"
            >查看门店主页</ui-button>
            <block wx:if="{{hasParts}}">
              <ui-button type="secondary" block bind:btntap="onOpenPartVerify">配件验真</ui-button>
              <text wx:if="{{partVerifySummary}}" class="album-engage__action-hint text-caption text-secondary">{{partVerifySummary}}</text>
            </block>
          </view>
        </ui-card>
      </block>

      <block wx:elif="{{!eligible}}">
        <ui-card shadow="{{true}}" padding="{{true}}">
          <view class="album-engage__option-head">
            <text class="text-h3">暂不可评价</text>
            <ui-tag variant="info" text="审核通过后可评" />
          </view>
          <text wx:if="{{ineligibleReason}}" class="text-caption text-secondary album-engage__ineligible">{{ineligibleReason}}</text>
        </ui-card>
      </block>

      <block wx:else>
        <view wx:if="{{repairScore > 0 || albumScore > 0}}" class="album-engage__score-row">
          <text wx:if="{{repairScore > 0}}" class="text-caption text-secondary">维修 {{repairScore}}</text>
          <text wx:if="{{albumScore > 0}}" class="text-caption text-secondary">记录 {{albumScore}}</text>
        </view>

        <block wx:for="{{reviewGroups}}" wx:key="key" wx:for-item="group">
          <ui-card shadow="{{true}}" padding="{{true}}">
            <text class="album-engage__section-title text-h3">{{group.title}}</text>
            <ui-rating-dimensions
              values="{{scores}}"
              dimensions="{{group.dimensions}}"
              collapse-from="{{99}}"
              bind:change="onScoresChange"
            />
          </ui-card>
        </block>

        <ui-card wx:if="{{tagItems.length}}" shadow="{{true}}" padding="{{true}}">
          <text class="album-engage__section-title text-h3">可选标签</text>
          <view class="album-engage__tags">
            <ui-review-tag-chip
              wx:for="{{tagItems}}"
              wx:key="text"
              text="{{item.text}}"
              selected="{{item.selected}}"
              bind:tap="onTagTap"
            />
          </view>
        </ui-card>

        <ui-card shadow="{{true}}" padding="{{true}}">
          <text class="album-engage__section-title text-h3">文字评价（选填）</text>
          <textarea
            class="album-engage__textarea text-body"
            placeholder="补充本次体验，最多 300 字"
            value="{{content}}"
            maxlength="300"
            bindinput="onContentInput"
          />
          <text class="album-engage__counter text-caption">{{contentLength}}/300</text>
        </ui-card>

        <ui-card shadow="{{true}}" padding="{{true}}">
          <text class="album-engage__section-title text-h3">配图（选填）</text>
          <ui-image-uploader images="{{form.images}}" maxCount="{{3}}" bind:change="onImagesChange" />
          <view class="album-engage__notice">
            <ui-compliance-notice type="reviewImageTip" />
          </view>
        </ui-card>
      </block>

    </view>

    <ui-fixed-bottom-bar wx:if="{{eligible && !hasReview}}">
      <ui-button
        type="primary"
        slot="right"
        block
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bind:btntap="onSubmit"
      >提交评价</ui-button>
    </ui-fixed-bottom-bar>

    <ui-bottom-sheet
      visible="{{authSheetVisible}}"
      title="{{authSheetTitle}}"
      showActions="{{false}}"
      scrollable="{{true}}"
      bind:close="onCloseAuthSheet"
    >
      <ui-album-authorize-section
        title="{{authSheetTitle}}"
        pitch="{{authPitch}}"
        benefitLine="{{authBenefitLine}}"
        controlLine="{{authControlLine}}"
        disclaimer="{{authDisclaimer}}"
        consentText="{{authConsentText}}"
        confirmText="{{authConfirmText}}"
        rejectText="{{authRejectText}}"
        checked="{{authChecked}}"
        authTier="{{authTier}}"
        submitting="{{authSubmitting}}"
        showActions="{{false}}"
        showRejectLink="{{true}}"
        bind:toggle="onAuthCheckToggle"
        bind:tierchange="onAuthTierChange"
        bind:reject="onRejectAuth"
        bind:policy="onOpenBenefitPolicy"
      />
      <view class="album-engage__auth-submit">
        <ui-button
          type="primary"
          block
          disabled="{{authSubmitting}}"
          loading="{{authSubmitting}}"
          bind:btntap="onSubmitAuth"
        >{{authConfirmText}}</ui-button>
      </view>
    </ui-bottom-sheet>

    <ui-share-sheet
      visible="{{shareSheetVisible}}"
      showOwnerShare="{{showShareEntry}}"
      shareIntent="{{shareSheetIntent}}"
      ownerSharePreparing="{{sharePreparing}}"
      actionsDisabled="{{shareActionsDisabled}}"
      bind:close="onCloseShareSheet"
      bind:copyownerlink="onCopyOwnerShareLink"
      bind:copypublicweblink="onCopyPublicWebLink"
      bind:sharetimeline="onShareTimelineGuide"
    />

    <ui-login-sheet
      visible="{{loginSheetVisible}}"
      mode="auto"
      bindContext="album"
      bind:close="closeLoginSheet"
      bind:cancel="closeLoginSheet"
      bind:success="onLoginSuccess"
    />
  </block>
</view>

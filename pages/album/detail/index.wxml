<view class="album-detail page {{detail ? 'bg-album album-detail--checklist' : 'bg-album'}}">
  <block wx:if="{{status === 'loading'}}">
    <tool-immersive-nav title="服务进度" />
    <view class="album-detail__empty-wrap">
      <ui-empty theme="album" title="加载中" description="正在打开服务进度…" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <tool-immersive-nav title="服务进度" />
    <view class="album-detail__empty-wrap">
      <ui-empty
        theme="album"
        title="无法打开服务进度"
        description="{{errorMessage}}"
        actionText="重试"
        bind:action="onRetry"
      />
    </view>
  </block>

  <block wx:elif="{{status === 'empty'}}">
    <tool-immersive-nav title="服务进度" />
    <view class="album-detail__empty-wrap">
      <ui-empty
        theme="album"
        title="暂无服务进度"
        description="如你对维修进度有疑问，可联系门店。"
        actionText="联系门店"
        bind:action="onContactStore"
      />
    </view>
  </block>

  <block wx:elif="{{detail && showOwnerFlow && ownerBoard}}">
    <view class="op" style="padding-top: {{statusBarHeight}}px;">
      <view class="op-nav" style="padding-right: {{capsulePad}}px;">
        <text class="op-back" bindtap="onBack">‹</text>
        <view class="op-nav__text">
          <text class="op-kicker">服务进度</text>
          <text class="op-plate">{{ownerBoard.plate}}</text>
        </view>
      </view>
      <scroll-view
        scroll-y
        class="op-scroll"
        show-scrollbar="{{false}}"
        scroll-into-view="{{flowScrollIntoView}}"
        scroll-with-animation="{{true}}"
      >
        <view class="op-hero">
          <text class="op-pill op-pill--{{ownerBoard.pill.tone}}">{{ownerBoard.pill.text}}</text>
          <text class="op-hero__name">{{ownerBoard.vehicleName}}</text>
          <text wx:if="{{ownerBoard.spec}}" class="op-hero__spec">{{ownerBoard.spec}}</text>
          <text wx:if="{{ownerBoard.meta}}" class="op-hero__meta">{{ownerBoard.meta}}</text>
        </view>

        <view class="op-docs">
          <view
            wx:for="{{ownerBoard.tiles}}"
            wx:key="id"
            class="op-doc op-doc--{{item.tone}}"
            data-id="{{item.id}}"
            data-locked="{{item.locked}}"
            bindtap="onOpenOwnerDoc"
          >
            <view class="op-doc__icon">
              <image wx:if="{{item.tone === 'ok'}}" src="/assets/mch/check-blue.png" mode="aspectFit" />
              <image wx:elif="{{item.tone === 'live'}}" src="/assets/mch/doc-blue.png" mode="aspectFit" />
              <image wx:else src="/assets/mch/clock-gray.png" mode="aspectFit" />
            </view>
            <text class="op-doc__name">{{item.title}}</text>
            <text class="op-doc__label">{{item.label}}</text>
          </view>
        </view>

        <view wx:if="{{archiveCopy && archiveCopy.summary}}" class="op-sec op-archive">
          <text class="op-sec__kicker">本单说明</text>
          <view class="op-sec__row">
            <text class="op-sec__title">摘要</text>
          </view>
          <text class="op-archive__summary">{{archiveCopy.summary}}</text>
          <block wx:if="{{archiveCopy.faq && archiveCopy.faq.length}}">
            <text class="op-sec__title op-archive__faq-title">常见问法</text>
            <view
              wx:for="{{archiveCopy.faq}}"
              wx:key="q"
              class="op-archive__faq"
            >
              <text class="op-archive__q">{{item.q}}</text>
              <text wx:if="{{item.a}}" class="op-archive__a">{{item.a}}</text>
            </view>
          </block>
        </view>

        <view class="op-sec">
          <text class="op-sec__kicker">服务单据</text>
          <view class="op-sec__row">
            <text class="op-sec__title">进度</text>
            <text wx:if="{{ownerBoard.deliveredCount}}" class="op-sec__count">已送达 {{ownerBoard.deliveredCount}} 份</text>
          </view>
        </view>

        <view class="op-line">
          <view
            wx:for="{{ownerBoard.rows}}"
            wx:key="id"
            id="op-row-{{item.id}}"
            class="op-row op-row--{{item.state}}"
            data-id="{{item.id}}"
            data-locked="{{item.locked}}"
            bindtap="onOpenOwnerDoc"
          >
            <view class="op-row__rail">
              <view class="op-row__dot">
                <image wx:if="{{item.state === 'done'}}" src="/assets/mch/check-white.png" mode="aspectFit" />
                <text wx:else>{{item.index}}</text>
              </view>
              <view wx:if="{{index < ownerBoard.rows.length - 1}}" class="op-row__bar" />
            </view>
            <view class="op-row__main">
              <view class="op-row__head">
                <text class="op-row__title">{{item.title}}</text>
                <text class="op-row__mark">{{item.mark}}</text>
              </view>
              <text class="op-row__detail">{{item.detail}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{ownerBoard.protocol}}" class="op-protocol">
          <text>{{ownerBoard.protocol}}</text>
        </view>
        <view class="op-spacer" />
      </scroll-view>

      <view wx:if="{{!openDoc && (hasStorePhone || ownerBoard.pendingId || pendingOwnerReview)}}" class="op-foot">
        <view wx:if="{{hasStorePhone}}" class="op-call" bindtap="onContactStore">
          <image src="/assets/mch/phone-ink.png" mode="aspectFit" />
          <text>电话联系门店</text>
        </view>
        <view wx:if="{{ownerBoard.pendingId}}" class="op-no" bindtap="onOwnerBoardReject">不同意</view>
        <view wx:if="{{ownerBoard.pendingId}}" class="op-yes" bindtap="onOwnerBoardConfirm">确认</view>
        <view wx:elif="{{pendingOwnerReview}}" class="op-yes" bindtap="onEndPageFeedback">去评价</view>
      </view>
    </view>

    <view wx:if="{{openDoc}}" class="op-paper" style="padding-top: {{statusBarHeight}}px;">
      <view class="op-nav" style="padding-right: {{capsulePad}}px;">
        <text class="op-back" bindtap="onCloseOwnerDoc">‹</text>
        <view class="op-nav__text">
          <text class="op-kicker">服务进度</text>
          <text class="op-plate">{{openDoc.title}}</text>
        </view>
      </view>
      <scroll-view scroll-y class="op-paper__body" show-scrollbar="{{false}}">
        <service-doc-sheet
          doc="{{openDoc}}"
          mode="owner"
          storePhone="{{storePhone}}"
          confirming="{{flowConfirmingId === openDoc.id}}"
          bind:confirm="onOwnerFlowConfirm"
          bind:reject="onOwnerFlowReject"
        />
      </scroll-view>
    </view>
  </block>

  <block wx:elif="{{detail}}">
    <view class="album-detail__shell album-detail__shell--checklist">
      <tool-immersive-nav title="服务进度" />
      <scroll-view
        scroll-y
        class="album-detail__checklist-scroll"
        show-scrollbar="{{false}}"
        scroll-into-view="{{flowScrollIntoView}}"
        scroll-with-animation="{{true}}"
      >
        <album-work-checklist
          wx:if="{{hasWorkChecklist && !showOwnerFlow}}"
          categoryLabel="{{workChecklistCategoryLabel}}"
          cards="{{workChecklistCards}}"
          items="{{workChecklistItems}}"
          warrantyText="{{warrantyText}}"
          warrantyImages="{{warrantyImages}}"
          bind:aiinterpret="onWorkChecklistAiInterpret"
        />
        <view class="album-detail__read-footer">
          <album-end-page
            album-id="{{albumId}}"
            album-title="{{showOwnerFlow ? '' : (detail.serviceName || '')}}"
            hide-finisher="{{showOwnerFlow}}"
            contact-as-link="{{showOwnerFlow}}"
            contact-label="{{showOwnerFlow ? '电话联系门店' : '联系门店'}}"
            invite-pitch="{{endPageInvitePitch}}"
            invite-eyebrow="{{endPageInviteEyebrow}}"
            control-line="{{endPageControlLine}}"
            show-preview="{{endPageShowPreview}}"
            preview-label="{{endPagePreviewLabel}}"
            preview-disabled="{{endPagePreviewDisabled}}"
            preview-hint="{{endPagePreviewHint}}"
            show-withdraw="{{endPageShowWithdraw}}"
            withdraw-label="{{endPageWithdrawLabel}}"
            status-hint="{{showCompliancePending ? compliancePendingHint : endPageStatusHint}}"
            gate-actions="{{endPageGateActions}}"
            show-feedback="{{pendingOwnerReview || hasOwnerReview}}"
            pending-owner-review="{{pendingOwnerReview}}"
            show-contact="{{hasStorePhone}}"
            show-store-browse="{{false}}"
            bind:preview="onEndPagePreview"
            bind:withdraw="onEndPageWithdraw"
            bind:feedback="onEndPageFeedback"
            bind:gateaction="onEndPageGateAction"
            bind:contact="onContactStore"
          />
        </view>
        <view class="album-detail__checklist-spacer" style="height: {{toolbarBottomPadPx + 24}}px;" />
      </scroll-view>
    </view>
  </block>

  <ui-login-sheet
    visible="{{loginSheetVisible}}"
    mode="{{loginSheetMode}}"
    bindContext="album"
    bind:close="closeLoginSheet"
    bind:cancel="closeLoginSheet"
    bind:success="onLoginSheetSuccess"
  />

  <ui-bottom-sheet
    visible="{{visionSheetVisible}}"
    title="{{visionSheetTitle}}"
    hint="{{visionSheetDisclaimer}}"
    showActions="{{true}}"
    scrollable="{{true}}"
    confirmText="知道了"
    cancelText="关闭"
    loading="{{visionSheetLoading}}"
    bind:close="onCloseVisionSheet"
    bind:cancel="onCloseVisionSheet"
    bind:confirm="onCloseVisionSheet"
  >
    <view class="album-detail__vision" wx:if="{{visionSheetLoading}}">
      <text class="text-caption text-secondary">正在解读本项照片…</text>
    </view>
    <view class="album-detail__vision" wx:elif="{{visionSheetError}}">
      <text class="text-body">{{visionSheetError}}</text>
    </view>
    <view class="album-detail__vision" wx:else>
      <text wx:if="{{visionSheetCardTitle}}" class="text-caption text-secondary">{{visionSheetCardTitle}}</text>
      <text class="text-body album-detail__vision-summary" selectable>{{visionSheetSummary}}</text>
    </view>
  </ui-bottom-sheet>

  <ui-bottom-sheet
    visible="{{withdrawSheetVisible}}"
    title="撤回授权"
    hint="撤回后公开案例将下架，已产生的传播数据保留后台记录。私密服务相册仍保留。"
    confirmText="确认撤回"
    cancelText="取消"
    loading="{{withdrawSheetLoading}}"
    bind:close="onWithdrawSheetClose"
    bind:cancel="onWithdrawSheetClose"
    bind:confirm="onWithdrawSheetConfirm"
  />
</view>

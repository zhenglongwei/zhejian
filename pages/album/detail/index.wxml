<view class="album-detail page {{detail ? 'bg-album album-detail--checklist' : 'bg-album'}}">
  <block wx:if="{{status === 'loading'}}">
    <tool-immersive-nav title="服务相册" />
    <view class="album-detail__empty-wrap">
      <ui-empty theme="album" title="加载中" description="正在打开服务相册…" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <tool-immersive-nav title="服务相册" />
    <view class="album-detail__empty-wrap">
      <ui-empty
        theme="album"
        title="无法加载服务相册"
        description="{{errorMessage}}"
        actionText="重试"
        bind:action="onRetry"
      />
    </view>
  </block>

  <block wx:elif="{{status === 'empty'}}">
    <tool-immersive-nav title="服务相册" />
    <view class="album-detail__empty-wrap">
      <ui-empty
        theme="album"
        title="门店暂未上传服务相册"
        description="如你对维修进度有疑问，可联系门店。"
        actionText="联系门店"
        bind:action="onContactStore"
      />
    </view>
  </block>

  <block wx:elif="{{detail}}">
    <view class="album-detail__shell album-detail__shell--checklist">
      <tool-immersive-nav title="服务相册" />
      <scroll-view
        scroll-y
        class="album-detail__checklist-scroll"
        show-scrollbar="{{false}}"
      >
        <album-work-checklist
          categoryLabel="{{workChecklistCategoryLabel}}"
          cards="{{workChecklistCards}}"
          items="{{workChecklistItems}}"
          warrantyText="{{warrantyText}}"
          warrantyImages="{{warrantyImages}}"
        />
        <view class="album-detail__read-footer">
          <album-end-page
            album-id="{{albumId}}"
            album-title="{{detail.serviceName || ''}}"
            invite-pitch="{{endPageInvitePitch}}"
            invite-eyebrow="{{endPageInviteEyebrow}}"
            control-line="{{endPageControlLine}}"
            show-preview="{{endPageShowPreview}}"
            preview-label="{{endPagePreviewLabel}}"
            preview-disabled="{{endPagePreviewDisabled}}"
            preview-hint="{{endPagePreviewHint}}"
            show-withdraw="{{endPageShowWithdraw}}"
            withdraw-label="{{endPageWithdrawLabel}}"
            status-hint="{{showCompliancePending ? compliancePendingHint : endPageStatusHint}}"
            gate-actions="{{endPageGateActions}}"
            show-feedback="{{pendingOwnerReview || hasOwnerReview}}"
            pending-owner-review="{{pendingOwnerReview}}"
            show-contact="{{true}}"
            show-store-browse="{{false}}"
            bind:preview="onEndPagePreview"
            bind:withdraw="onEndPageWithdraw"
            bind:feedback="onEndPageFeedback"
            bind:gateaction="onEndPageGateAction"
            bind:contact="onContactStore"
          />
        </view>
        <view class="album-detail__checklist-spacer" style="height: {{toolbarBottomPadPx + 24}}px;" />
      </scroll-view>
    </view>
  </block>

  <ui-bottom-sheet
    visible="{{authSheetVisible}}"
    title="{{authSheetTitle}}"
    showActions="{{false}}"
    scrollable="{{true}}"
    bind:close="onCloseAuthSheet"
  >
    <ui-album-authorize-section
      title="{{authSheetTitle}}"
      pitch="{{authPitch}}"
      benefitLine="{{authBenefitLine}}"
      controlLine="{{authControlLine}}"
      disclaimer="{{authDisclaimer}}"
      consentText="{{authConsentText}}"
      confirmText="{{authConfirmText}}"
      rejectText="{{authRejectText}}"
      checked="{{authChecked}}"
      authTier="{{authTier}}"
      submitting="{{authSubmitting}}"
      showActions="{{false}}"
      showRejectLink="{{true}}"
      bind:toggle="onAuthCheckToggle"
      bind:tierchange="onAuthTierChange"
      bind:reject="onRejectAuth"
      bind:policy="onOpenBenefitPolicy"
    />
    <view class="album-detail__auth-submit">
      <ui-button
        type="primary"
        block
        disabled="{{authSubmitting}}"
        loading="{{authSubmitting}}"
        bind:btntap="onSubmitAuth"
      >{{authConfirmText}}</ui-button>
    </view>
  </ui-bottom-sheet>

  <ui-share-sheet
    visible="{{shareSheetVisible}}"
    variant="owner"
    showOwnerShare="{{showShareEntry}}"
    shareIntent="{{shareSheetIntent}}"
    shareUseOriginal="{{shareUseOriginal}}"
    ownerSharePreparing="{{sharePreparing}}"
    actionsDisabled="{{shareActionsDisabled}}"
    honorHint="{{shareHonorHint}}"
    socialPlatform="{{socialPlatform}}"
  socialDraftText="{{socialDraftText}}"
  socialDraftLoading="{{socialDraftLoading}}"
  socialDraftWaitHint="{{socialDraftWaitHint}}"
    publishState="{{publishSheetState}}"
    publishDisabled="{{publishSheetDisabled}}"
    showPublishSection="{{showPublishSection}}"
    publishHint="{{publishSheetHint}}"
    showPublicWebLink="{{showPublicCaseShare}}"
    bind:close="onCloseShareSheet"
    bind:toggleoriginal="onShareOriginalToggle"
    bind:copyownerlink="onCopyOwnerShareLink"
    bind:copypublicweblink="onCopyPublicWebLink"
    bind:sharetimeline="onShareTimelineGuide"
    bind:socialplatformchange="onSocialPlatformChange"
    bind:copysocial="onCopySocialDraft"
    bind:publish="onSharePublish"
  />

  <ui-login-sheet
    visible="{{loginSheetVisible}}"
    mode="{{loginSheetMode}}"
    bindContext="album"
    bind:close="closeLoginSheet"
    bind:cancel="closeLoginSheet"
    bind:success="onLoginSheetSuccess"
  />

  <ui-bottom-sheet
    visible="{{withdrawSheetVisible}}"
    title="撤回授权"
    hint="撤回后公开案例将下架，已产生的传播数据保留后台记录。私密服务相册仍保留。"
    confirmText="确认撤回"
    cancelText="取消"
    loading="{{withdrawSheetLoading}}"
    bind:close="onWithdrawSheetClose"
    bind:cancel="onWithdrawSheetClose"
    bind:confirm="onWithdrawSheetConfirm"
  />
</view>

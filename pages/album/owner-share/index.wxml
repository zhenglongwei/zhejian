<view class="page album-owner-share">
  <block wx:if="{{status === 'loading'}}">
    <view class="page-content">
      <ui-skeleton rows="{{5}}" title="{{true}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty
        title="暂时无法打开"
        description="{{errorMessage}}"
        actionText="返回"
        bind:action="onBack"
      />
    </view>
  </block>

  <block wx:else>
    <view class="page-content album-owner-share__body album-owner-share__body--ritual">
      <view class="album-owner-share__hero album-owner-share__hero--invite">
        <view class="album-owner-share__avatar-wrap" aria-hidden="true">
          <image
            class="album-owner-share__avatar"
            src="/assets/share/officer-avatar.jpg"
            mode="aspectFit"
          />
        </view>
        <text class="album-owner-share__officer text-body">{{officerTitle}}</text>
        <text class="album-owner-share__pitch text-body">{{heroPitch}}</text>
        <view class="notice notice--info album-owner-share__tip">
          <text class="album-owner-share__tip-text">{{heroTip}}</text>
        </view>

        <!-- published / private：仅私人发给微信；不展示「预览脱敏案例」发布入口 -->
        <view
          wx:if="{{mode === 'published' || mode === 'private'}}"
          class="album-owner-share__channels album-owner-share__channels--in-hero"
        >
          <view class="album-owner-share__channel" bindtap="onTimelineTap">
            <view class="album-owner-share__channel-icon">
              <image class="album-owner-share__channel-img" src="/assets/share/icon-moments.svg" mode="aspectFit" />
            </view>
            <view class="album-owner-share__channel-copy">
              <text class="text-body">分享到朋友圈</text>
              <text class="text-caption text-secondary">按提示从右上角发出</text>
            </view>
          </view>
          <button class="album-owner-share__channel album-owner-share__channel-btn" open-type="share">
            <view class="album-owner-share__channel-icon">
              <image class="album-owner-share__channel-img" src="/assets/share/icon-friend.svg" mode="aspectFit" />
            </view>
            <view class="album-owner-share__channel-copy">
              <text class="text-body">分享给朋友</text>
              <text class="text-caption text-secondary">发给微信好友或群</text>
            </view>
          </button>
        </view>
      </view>
    </view>

    <ui-fixed-bottom-bar wx:if="{{mode === 'invite'}}">
      <ui-button type="primary" block bind:btntap="onPreviewTap" loading="{{previewLoading}}">{{previewLabel}}</ui-button>
    </ui-fixed-bottom-bar>
    <ui-fixed-bottom-bar wx:elif="{{mode === 'pending'}}">
      <ui-button type="secondary" block bind:btntap="onBack">知道了</ui-button>
    </ui-fixed-bottom-bar>
  </block>
</view>

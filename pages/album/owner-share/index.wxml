<view class="page album-owner-share">
  <block wx:if="{{status === 'loading'}}">
    <view class="page-content">
      <ui-skeleton rows="{{5}}" title="{{true}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty
        title="暂时无法打开"
        description="{{errorMessage}}"
        actionText="返回"
        bind:action="onBack"
      />
    </view>
  </block>

  <block wx:else>
    <view class="page-content album-owner-share__body">
      <text wx:if="{{cardError}}" class="text-body">{{cardError}}</text>
      <social-card
        id="socialPosterCard"
        wx:else
        platforms="{{socialPlatforms}}"
        active-id="{{socialPlatform}}"
        images="{{socialImages}}"
        text="{{socialText}}"
        caption="{{socialCaption}}"
        loading="{{socialLoading}}"
        refreshing="{{socialRefreshing}}"
        revision="{{socialRevision}}"
        empty-text="照片还在处理"
        show-actions="{{false}}"
        bind:platformchange="onSocialPlatform"
        bind:imagetoggle="onSocialToggle"
        bind:textinput="onSocialText"
        bind:captioninput="onSocialCaption"
        bind:refresh="onRefreshSocial"
      />

      <view wx:if="{{!cardError}}" class="album-owner-share__quiet">
        <button class="album-owner-share__quiet-btn text-caption" open-type="share">发给微信好友</button>
        <text class="text-caption text-link" bindtap="onCopyLinkTap">复制相册链接</text>
      </view>
    </view>

    <ui-fixed-bottom-bar wx:if="{{!cardError}}" safeArea="{{true}}">
      <ui-button type="primary" block bind:btntap="onDownloadPoster">下载图文</ui-button>
    </ui-fixed-bottom-bar>
  </block>
</view>

<view class="page album-owner-share">
  <block wx:if="{{status === 'loading'}}">
    <view class="page-content">
      <ui-skeleton rows="{{5}}" title="{{true}}" />
    </view>
  </block>

  <block wx:elif="{{status === 'error'}}">
    <view class="page-content">
      <ui-empty
        title="暂时无法打开"
        description="{{errorMessage}}"
        actionText="返回"
        bind:action="onBack"
      />
    </view>
  </block>

  <block wx:elif="{{mode === 'invite'}}">
    <view class="page-content album-owner-share__body">
      <view class="surface-album-catalog album-owner-share__hero">
        <view class="album-owner-share__seal" aria-hidden="true">
          <view class="album-owner-share__seal-ring">
            <text class="album-owner-share__seal-mark">证</text>
          </view>
        </view>
        <ui-tag wx:if="{{officerTitle}}" variant="order" text="{{officerTitle}}" />
        <text class="album-owner-share__hero-title text-h2">{{inviteHeroTitle}}</text>
        <text class="album-owner-share__hero-sub text-caption">{{inviteHeroSub}}</text>
      </view>

      <ui-card shadow="{{true}}" padding="{{true}}">
        <text class="album-owner-share__pitch text-body">{{invitePitch}}</text>
        <view class="album-owner-share__control-bar">
          <text class="album-owner-share__control text-caption">{{controlLine}}</text>
        </view>
      </ui-card>
    </view>

    <ui-fixed-bottom-bar>
      <ui-button type="primary" block bind:btntap="onPreviewTap" loading="{{previewLoading}}">{{previewLabel}}</ui-button>
    </ui-fixed-bottom-bar>
  </block>

  <block wx:elif="{{mode === 'published'}}">
    <view class="page-content album-owner-share__body">
      <view class="surface-album-catalog album-owner-share__hero album-owner-share__hero--ready">
        <view class="album-owner-share__seal album-owner-share__seal--ready" aria-hidden="true">
          <view class="album-owner-share__seal-ring album-owner-share__seal-ring--ready">
            <text class="album-owner-share__seal-mark album-owner-share__seal-mark--ready">✓</text>
          </view>
        </view>
        <ui-tag variant="audited" text="已通过审核" />
        <text class="album-owner-share__hero-title text-h2">{{publishedHeroTitle}}</text>
        <text class="album-owner-share__hero-sub text-caption">{{publishedHeroSub}}</text>
      </view>

      <ui-card shadow="{{true}}" padding="{{true}}">
        <text class="album-owner-share__section-title text-body">选一个方式发出去</text>
        <text class="text-caption text-secondary album-owner-share__published-hint">{{publishedHint}}</text>

        <view class="album-owner-share__channels">
          <view class="album-owner-share__channel" bindtap="onTimelineTap">
            <view class="album-owner-share__channel-icon">
              <image class="album-owner-share__channel-img" src="/assets/share/icon-moments.svg" mode="aspectFit" />
            </view>
            <view class="album-owner-share__channel-copy">
              <text class="text-body">分享到朋友圈</text>
              <text class="text-caption text-secondary">按提示从右上角发出</text>
            </view>
          </view>
          <button class="album-owner-share__channel album-owner-share__channel-btn" open-type="share">
            <view class="album-owner-share__channel-icon">
              <image class="album-owner-share__channel-img" src="/assets/share/icon-friend.svg" mode="aspectFit" />
            </view>
            <view class="album-owner-share__channel-copy">
              <text class="text-body">分享给朋友</text>
              <text class="text-caption text-secondary">发给微信好友或群</text>
            </view>
          </button>
          <view class="album-owner-share__channel" bindtap="onOpenSocial">
            <view class="album-owner-share__channel-icon">
              <image class="album-owner-share__channel-img" src="/assets/share/icon-social.svg" mode="aspectFit" />
            </view>
            <view class="album-owner-share__channel-copy">
              <text class="text-body">分享到自媒体</text>
              <text class="text-caption text-secondary">生成文章并复制</text>
            </view>
          </view>
        </view>
      </ui-card>
    </view>

    <ui-share-sheet
      visible="{{shareSheetVisible}}"
      variant="owner"
      showOwnerShare="{{true}}"
      shareIntent="owner"
      honorHint=""
      publishState="approved"
      showPublicWebLink="{{true}}"
      socialPlatform="{{socialPlatform}}"
      socialDraftText="{{socialDraftText}}"
      socialDraftLoading="{{socialDraftLoading}}"
      socialDraftWaitHint="{{socialDraftWaitHint}}"
      bind:close="onCloseShareSheet"
      bind:timeline="onShareTimelineGuide"
      bind:copyownerlink="onCopyOwnerShareLink"
      bind:copypublic="onCopyPublicCaseLink"
      bind:socialplatform="onSocialPlatformChange"
      bind:copysocial="onCopySocialDraft"
    />
  </block>

  <block wx:elif="{{mode === 'pending'}}">
    <view class="page-content">
      <ui-empty
        title="审核中"
        description="脱敏案例已提交，通过后即可分享给朋友与自媒体。"
        actionText="返回"
        bind:action="onBack"
      />
    </view>
  </block>
</view>

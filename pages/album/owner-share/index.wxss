@import '../../../styles/tokens.wxss';

.album-owner-share__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.album-owner-share__body--invite {
  min-height: 70vh;
  justify-content: center;
}

.album-owner-share__hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  text-align: center;
  padding-top: var(--space-xl);
  padding-bottom: var(--space-lg);
}

.album-owner-share__hero--invite {
  gap: var(--space-md);
  padding: var(--space-xl) var(--space-md) var(--space-lg);
  border-radius: var(--radius-lg);
  background: linear-gradient(
    180deg,
    var(--color-warning-light) 0%,
    var(--color-album-frame-inner) 55%,
    var(--color-album-frame-inner) 100%
  );
  border: 1rpx solid var(--color-album-frame-line);
  box-shadow: var(--shadow-card-soft);
}

.album-owner-share__hero--ready {
  background: linear-gradient(
    180deg,
    var(--color-album-frame-inner) 0%,
    var(--color-success-light) 200rpx,
    var(--color-album-frame-inner) 100%
  );
}

.album-owner-share__avatar-wrap {
  width: 280rpx;
  height: 280rpx;
  border-radius: var(--radius-full);
  overflow: hidden;
  background: var(--color-album-frame-inner);
  box-shadow: var(--shadow-card-soft);
}

.album-owner-share__avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.album-owner-share__officer {
  display: block;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}

.album-owner-share__pitch {
  display: block;
  line-height: 1.65;
  color: var(--color-text-primary);
  max-width: 560rpx;
  padding: 0 var(--space-sm);
}

.album-owner-share__tip {
  width: 100%;
  box-sizing: border-box;
  text-align: left;
  margin-top: var(--space-xs);
}

.album-owner-share__tip-text {
  display: block;
  font-size: var(--font-caption);
  line-height: 1.55;
}

.album-owner-share__seal {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-xs);
}

.album-owner-share__seal-ring {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-primary);
  box-shadow: var(--shadow-card-soft);
}

.album-owner-share__seal-ring--ready {
  background: var(--color-success-light);
  border-color: var(--color-success);
}

.album-owner-share__seal-mark {
  font-size: var(--font-h2);
  line-height: 1;
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.album-owner-share__seal-mark--ready {
  color: var(--color-success);
  letter-spacing: 0;
}

.album-owner-share__hero-title {
  display: block;
  color: var(--color-text-primary);
}

.album-owner-share__hero-sub {
  display: block;
  color: var(--color-text-secondary);
  line-height: 1.55;
  max-width: 560rpx;
}

.album-owner-share__section-title {
  display: block;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.album-owner-share__published-hint {
  display: block;
  margin-top: var(--space-xs);
  margin-bottom: var(--space-md);
  line-height: 1.5;
}

.album-owner-share__channels {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.album-owner-share__channel {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-album-frame-line);
  background: var(--color-album-frame-inner);
  box-shadow: var(--shadow-album-list-thumb);
}

.album-owner-share__channel-btn {
  margin: 0;
  width: 100%;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-album-frame-line);
  background: var(--color-album-frame-inner);
  box-shadow: var(--shadow-album-list-thumb);
  text-align: left;
  line-height: 1.4;
}

.album-owner-share__channel-btn::after {
  border: none;
}

.album-owner-share__channel-icon {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-album-active-light);
}

.album-owner-share__channel-img {
  width: 44rpx;
  height: 44rpx;
}

.album-owner-share__channel-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

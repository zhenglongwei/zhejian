@import '../../../styles/tokens.wxss';

.album-owner-share__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  padding-bottom: calc(var(--space-xl) * 4 + env(safe-area-inset-bottom));
}

.album-owner-share__quiet {
  display: flex;
  gap: var(--space-lg);
  align-items: center;
}

.album-owner-share__quiet-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--color-primary);
  line-height: inherit;
}

.album-owner-share__quiet-btn::after {
  border: none;
}

<view class="album-work-checklist">
  <view class="album-work-checklist__head">
    <text class="text-h3">本次检查与处理</text>
    <text wx:if="{{categoryLabel}}" class="text-caption text-secondary">{{categoryLabel}}</text>
  </view>
  <text class="text-caption text-secondary album-work-checklist__hint">
    按检查项阅读：类目为分段标题；相关检测与施工合在一张卡。结果只在项上出现一次。点图可全屏查看。
  </text>

  <block wx:for="{{displayCards}}" wx:key="cardKey">
    <view wx:if="{{item.showGroupHeader}}" class="album-work-checklist__group">
      <text class="text-caption album-work-checklist__group-label">{{item.groupLabel}}</text>
    </view>

    <view class="album-work-checklist__card {{item.deferredByOwner ? 'is-deferred' : ''}}">
      <text class="text-body album-work-checklist__card-title">{{item.title}}</text>
      <text
        wx:if="{{item.followUpLabel || item.outcomeLabel}}"
        class="text-caption album-work-checklist__outcome {{item.outcome === 'not_replaced' || item.deferredByOwner ? 'is-warn' : ''}} {{item.outcome === 'normal' ? 'is-ok' : ''}}"
      >{{item.followUpLabel || item.outcomeLabel}}</text>
      <text
        wx:if="{{item.deferNote && item.deferredByOwner && !item.followUpLabel}}"
        class="text-caption album-work-checklist__defer"
      >{{item.deferNote}}</text>
      <text wx:if="{{item.note}}" class="text-caption album-work-checklist__note" selectable>{{item.note}}</text>

      <view
        wx:for="{{item.stageGroups}}"
        wx:for-item="stage"
        wx:key="stageId"
        class="album-work-checklist__stage"
      >
        <view wx:if="{{item.showStageTitles}}" class="album-work-checklist__stage-head">
          <view class="album-work-checklist__stage-bar" />
          <text class="text-caption album-work-checklist__stage-title">{{stage.stageTitle}}</text>
        </view>
        <view class="album-work-checklist__grid">
          <view
            wx:for="{{stage.images}}"
            wx:for-item="img"
            wx:for-index="imgIndex"
            wx:key="url"
            class="album-work-checklist__thumb image-placeholder"
            data-url="{{img.url}}"
            catchtap="onOpenLightbox"
          >
            <image class="album-work-checklist__img" src="{{img.url}}" mode="aspectFill" />
            <text wx:if="{{img.caption}}" class="text-caption album-work-checklist__cap">{{img.caption}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{showWarranty}}" class="album-work-checklist__card album-work-checklist__warranty">
    <text class="text-body album-work-checklist__card-title">质保承诺</text>
    <text wx:if="{{displayWarrantyText}}" class="text-caption album-work-checklist__note" selectable>{{displayWarrantyText}}</text>
    <view wx:if="{{displayWarrantyImages.length}}" class="album-work-checklist__grid">
      <view
        wx:for="{{displayWarrantyImages}}"
        wx:for-item="img"
        wx:key="url"
        class="album-work-checklist__thumb image-placeholder"
        data-url="{{img.url}}"
        catchtap="onOpenLightbox"
      >
        <image class="album-work-checklist__img" src="{{img.url}}" mode="aspectFill" />
        <text wx:if="{{img.caption}}" class="text-caption album-work-checklist__cap">{{img.caption}}</text>
      </view>
    </view>
  </view>

  <view
    wx:if="{{lightboxUrl}}"
    class="album-work-checklist__lightbox"
    catchtouchmove="noop"
    catchtap="onCloseLightbox"
  >
    <image class="album-work-checklist__lightbox-img" src="{{lightboxUrl}}" mode="aspectFit" />
  </view>
</view>

.album-work-checklist {
  padding: var(--space-lg);
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100%;
  background: var(--color-bg-album);
}

.album-work-checklist__head {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}

.album-work-checklist__hint {
  display: block;
  margin-bottom: var(--space-lg);
  line-height: 1.5;
}

.album-work-checklist__item {
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
}

.album-work-checklist__item-top {
  display: flex;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}

.album-work-checklist__outcome {
  display: block;
  color: var(--color-primary);
  margin-bottom: var(--space-xs);
}

.album-work-checklist__outcome.is-warn {
  color: var(--color-warning);
}

.album-work-checklist__note {
  display: block;
  margin-bottom: var(--space-sm);
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.album-work-checklist__grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.album-work-checklist__thumb {
  width: 192rpx;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.album-work-checklist__img {
  width: 192rpx;
  height: 192rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-muted);
}

.album-work-checklist__cap {
  line-height: 1.3;
  color: var(--color-text-secondary);
}

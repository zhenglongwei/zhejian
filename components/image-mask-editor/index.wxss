.mask-editor {
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.mask-editor__hint {
  flex-shrink: 0;
  margin-bottom: var(--space-sm);
  color: var(--color-text-secondary);
}

.mask-editor__canvas-wrap {
  position: relative;
  flex-shrink: 0;
  align-self: center;
  margin: 0 auto;
  border-radius: var(--radius-md);
  overflow: hidden;
  background-color: var(--color-bg-muted);
}

.mask-editor__canvas {
  display: block;
  /* 宽高由 style 像素值固定，禁止 100% 拉伸造成空白错位 */
}

.mask-editor__loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg-card);
  opacity: 0.72;
}

.mask-editor__toolbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.mask-editor__modes {
  display: flex;
  gap: var(--space-xs);
  padding: 4rpx;
  background-color: var(--color-bg-muted);
  border-radius: var(--radius-md);
}

.mask-editor__mode {
  padding: var(--space-xs) var(--space-md);
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  border-radius: var(--radius-sm);
}

.mask-editor__mode--active {
  background-color: var(--color-bg-card);
  color: var(--color-primary);
  font-weight: 500;
}

.mask-editor__actions {
  display: flex;
  gap: var(--space-xs);
}

.mask-editor__footer {
  flex-shrink: 0;
  margin-top: var(--space-md);
}

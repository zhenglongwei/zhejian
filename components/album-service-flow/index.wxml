<view class="album-service-flow" wx:if="{{docs.length}}">
  <view
    wx:for="{{docs}}"
    wx:key="id"
    id="flow-doc-{{item.id}}"
    class="album-service-flow__row {{item.stepState === 'current' ? 'is-current' : ''}} {{item.locked ? 'is-locked' : ''}}"
  >
    <view class="album-service-flow__rail">
      <view class="album-service-flow__dot album-service-flow__dot--{{item.stepState}}"></view>
      <view
        wx:if="{{index < docs.length - 1}}"
        class="album-service-flow__line {{item.locked || item.stepState === 'upcoming' ? 'album-service-flow__line--muted' : ''}}"
      ></view>
    </view>

    <view class="album-service-flow__body">
      <view wx:if="{{item.locked}}" class="album-service-flow__locked-head">
        <text class="text-body album-service-flow__locked-title">{{item.title}}</text>
        <text class="text-caption text-secondary">{{item.statusLabel}}</text>
      </view>

      <service-doc-sheet
        wx:else
        doc="{{item}}"
        mode="owner"
        imageTapMode="{{imageTapMode}}"
        storePhone="{{storePhone}}"
        confirming="{{confirmingId === item.id}}"
        bind:confirm="onConfirmTap"
        bind:imageedit="onImageEdit"
      />
    </view>
  </view>
</view>

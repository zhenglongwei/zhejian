.album-end-page {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 0;
}

.album-end-page__sheet {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  width: 100%;
  min-height: 0;
  padding: var(--space-xl) var(--space-lg) var(--space-md);
  text-align: center;
}

.album-end-page__finisher {
  display: flex;
  gap: var(--space-sm);
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  max-width: 480rpx;
  margin: 0 auto var(--space-lg);
}

.album-end-page__finisher-line {
  flex: 1;
  max-width: 72rpx;
  height: 1rpx;
  background: var(--color-album-end-finish);
  opacity: 0.4;
}

.album-end-page__finisher-label {
  flex-shrink: 0;
  color: var(--color-album-end-finish);
  letter-spacing: 0.2em;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
}

.album-end-page__album-title {
  display: block;
  box-sizing: border-box;
  width: 100%;
  max-width: 480rpx;
  margin: 0 auto var(--space-xl);
  overflow: hidden;
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: var(--font-h2);
  line-height: var(--font-h2-lh);
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 0.02em;
}

.album-end-page__invite {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  box-sizing: border-box;
  width: 100%;
  max-width: 480rpx;
  margin: 0 auto var(--space-lg);
  padding: var(--space-lg);
  text-align: left;
  border-radius: var(--radius-lg);
}

.album-end-page__eyebrow {
  display: block;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  letter-spacing: 0.08em;
  color: var(--color-primary);
}

.album-end-page__pitch {
  display: block;
  font-size: var(--font-body);
  line-height: 1.7;
  color: var(--color-text-primary);
}

.album-end-page__trust {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--color-album-frame-line);
}

.album-end-page__trust-label {
  display: block;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-tertiary);
  letter-spacing: 0.04em;
}

.album-end-page__control {
  display: block;
  font-size: var(--font-caption);
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.album-end-page__status {
  display: block;
  box-sizing: border-box;
  width: 100%;
  max-width: 480rpx;
  margin: 0 auto var(--space-md);
  padding: 0 var(--space-sm);
  text-align: center;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-tertiary);
}

.album-end-page__actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  max-width: 560rpx;
  margin: 0 auto;
  align-self: center;
}

.album-end-page__actions-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: var(--space-md);
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
}

/* 固定等宽，避免 block 按钮把 flex 撑破导致整组偏右 */
.album-end-page__pair-btn {
  width: 220rpx !important;
  min-width: 220rpx;
  max-width: 220rpx;
  padding-left: 0;
  padding-right: 0;
  box-sizing: border-box;
  justify-content: center;
  text-align: center;
}

.album-end-page__actions > ui-button {
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.album-end-page__actions > .btn--block {
  display: flex;
  width: 100%;
  justify-content: center;
}

.album-end-page__preview-wrap {
  display: flex;
  justify-content: center;
  width: 100%;
}

.album-end-page__preview-wrap ui-button {
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.album-end-page__status--tight {
  margin-bottom: 0;
}

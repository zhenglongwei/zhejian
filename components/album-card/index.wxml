<view class="album-card__shell {{embedded ? 'album-card__shell--embedded' : 'album-card__shell--raised'}} {{selectable ? 'album-card__shell--selectable' : ''}} {{selected ? 'is-selected' : ''}} {{selectable && selectDisabled ? 'is-disabled' : ''}}">
  <view class="album-card__inner" data-id="{{item.albumId}}" bindtap="onTap">
    <view
      wx:if="{{selectable}}"
      class="album-card__select {{selected ? 'is-on' : ''}} {{selectDisabled ? 'is-disabled' : ''}}"
      aria-role="radio"
      aria-checked="{{selected}}"
      aria-label="选择下载"
    >
      <view class="album-card__select-dot" />
    </view>
    <view class="album-card__thumb-col">
      <block wx:if="{{framed}}">
        <album-photo-frame variant="thumb">
          <view class="album-card__thumb-wrap">
            <image
              wx:if="{{item.coverUrl}}"
              class="album-card__thumb"
              src="{{item.coverUrl}}"
              mode="aspectFill"
              lazy-load="{{true}}"
            />
            <view wx:else class="album-card__thumb album-card__thumb--placeholder">
              <text class="album-card__thumb-initial text-album-display">{{item.coverInitial || '档'}}</text>
              <view
                wx:if="{{audience !== 'user' && embedded && showProgress && item.stageProgress.length}}"
                class="album-card__thumb-progress"
              >
                <album-progress-segments stages="{{item.stageProgress}}" variant="mini" />
              </view>
            </view>
          </view>
        </album-photo-frame>
      </block>
      <block wx:else>
        <view class="album-card__thumb-wrap album-card__thumb-wrap--plain">
          <image
            wx:if="{{item.coverUrl}}"
            class="album-card__thumb"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            lazy-load="{{true}}"
          />
          <view wx:else class="album-card__thumb album-card__thumb--placeholder">
            <text class="album-card__thumb-initial text-album-display">{{item.coverInitial || '档'}}</text>
            <view
              wx:if="{{audience !== 'user' && embedded && showProgress && item.stageProgress.length}}"
              class="album-card__thumb-progress"
            >
              <album-progress-segments stages="{{item.stageProgress}}" variant="mini" />
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 车主端：车牌 / 类目 / 服务商 / 品牌车型 / 进度；评价在右上 -->
    <view wx:if="{{audience === 'user'}}" class="album-card__body album-card__body--stacked">
      <view class="album-card__head {{showQuickActions && quickReview.show ? 'album-card__head--with-share' : ''}}">
        <text class="album-card__service album-card__service--head {{embedded ? 'text-body' : 'text-album-display'}}">{{item.listTitle}}</text>
        <view
          wx:if="{{showQuickActions && quickReview.show}}"
          class="album-card__head-actions"
          catchtap="onActionAreaTap"
        >
          <view
            class="album-card__share-btn album-card__share-btn--head"
            catchtap="onOwnerReviewTap"
          >{{quickReview.label}}</view>
        </view>
      </view>
      <text wx:if="{{item.serviceName && item.serviceName !== '—'}}" class="album-card__meta text-caption">{{item.serviceName}}</text>
      <text wx:if="{{item.storeName}}" class="album-card__meta album-card__meta--store text-caption">{{item.storeName}}</text>
      <text wx:if="{{item.vehicleModelLine}}" class="album-card__meta text-caption">{{item.vehicleModelLine}}</text>
      <text
        wx:if="{{item.progressLine}}"
        class="album-card__progress-line text-caption {{item.progressTone === 'done' ? 'album-card__progress-line--done' : ''}} {{item.progressTone === 'pending' ? 'album-card__progress-line--pending' : ''}}"
      >{{item.progressLine}}</text>
    </view>

    <!-- 商家端 embedded：工作台/我的 Hero — 标题与正文纵向排列 -->
    <view wx:elif="{{embedded}}" class="album-card__body album-card__body--stacked">
      <view class="album-card__head {{item.canShareToOwner ? 'album-card__head--with-share' : ''}}">
        <text class="album-card__service album-card__service--head text-body">{{item.progressLabel || item.serviceName}}</text>
        <view
          wx:if="{{item.canShareToOwner}}"
          class="album-card__head-actions"
        >
          <button
            class="album-card__share-btn album-card__share-btn--head"
            open-type="share"
            catchtap="onShareTap"
            data-album-id="{{item.albumId}}"
          >分享</button>
        </view>
      </view>

      <text wx:if="{{item.userPhoneDisplay}}" class="album-card__meta text-caption">车主 {{item.userPhoneDisplay}}</text>

      <text wx:if="{{item.metaLine}}" class="album-card__meta text-caption">{{item.metaLine}}</text>
      <text wx:if="{{item.summaryLine}}" class="album-card__summary text-caption">{{item.summaryLine}}</text>

      <view wx:if="{{item.statusLabel || item.hasUnreadUpdate}}" class="album-card__tags">
        <ui-tag
          wx:if="{{item.hasUnreadUpdate}}"
          variant="warning"
          text="有更新"
        />
        <ui-tag
          wx:if="{{item.statusLabel}}"
          variant="{{item.statusVariant}}"
          text="{{item.statusLabel}}"
        />
      </view>

      <text wx:if="{{item.statusHint}}" class="album-card__hint text-caption">{{item.statusHint}}</text>

      <text wx:if="{{item.deliverDateText}}" class="album-card__date text-caption">{{item.deliverDateText}}</text>
      <text
        wx:elif="{{item.updatedAtText}}"
        class="album-card__time text-caption {{item.hasUnreadUpdate ? 'album-card__time--fresh' : ''}}"
      >更新于 {{item.updatedAtText}}</text>
    </view>

    <!-- 商家端 raised：列表卡 -->
    <view wx:else class="album-card__body album-card__body--split">
      <view class="album-card__main">
        <text class="album-card__service text-album-display">{{item.progressLabel || item.serviceName}}</text>

        <text wx:if="{{item.progressLabel && item.serviceName}}" class="album-card__meta text-caption">{{item.serviceName}}</text>
        <text wx:if="{{item.userPhoneDisplay}}" class="album-card__meta text-caption">车主 {{item.userPhoneDisplay}}</text>

        <text wx:if="{{item.metaLine}}" class="album-card__meta text-caption">{{item.metaLine}}</text>
        <text wx:if="{{item.summaryLine}}" class="album-card__summary text-caption">{{item.summaryLine}}</text>

        <view wx:if="{{item.statusLabel || item.hasUnreadUpdate}}" class="album-card__tags">
          <ui-tag
            wx:if="{{item.hasUnreadUpdate}}"
            variant="warning"
            text="有更新"
          />
          <ui-tag
            wx:if="{{item.statusLabel}}"
            variant="{{item.statusVariant}}"
            text="{{item.statusLabel}}"
          />
        </view>

        <text wx:if="{{item.statusHint}}" class="album-card__hint text-caption">{{item.statusHint}}</text>

        <view
          wx:if="{{showProgress && item.stageProgress.length}}"
          class="album-card__progress-wrap"
        >
          <album-progress-segments stages="{{item.stageProgress}}" variant="mini" />
        </view>

        <view wx:if="{{item.archivalDateText || item.updatedAtText}}" class="album-card__footer">
          <text wx:if="{{item.archivalDateText}}" class="text-album-archival-date">{{item.archivalDateText}}</text>
          <text
            wx:elif="{{item.updatedAtText}}"
            class="text-album-archival-date {{item.hasUnreadUpdate ? 'album-card__time--fresh' : ''}}"
          >更新 · {{item.updatedAtText}}</text>
        </view>
      </view>

      <view
        wx:if="{{item.hostedSiteUrl || item.canShareToOwner}}"
        class="album-card__actions album-card__actions--column"
      >
        <view
          wx:if="{{item.hostedSiteUrl}}"
          class="album-card__share-btn"
          catchtap="onOpenSiteTap"
        >打开网站</view>
        <button
          wx:if="{{item.canShareToOwner}}"
          class="album-card__share-btn"
          open-type="share"
          catchtap="onShareTap"
          data-album-id="{{item.albumId}}"
        >分享</button>
      </view>
    </view>
  </view>
</view>

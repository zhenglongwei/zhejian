:host {
  display: block;
  width: 100%;
}

.album-card__shell--raised {
  overflow: hidden;
  background-color: var(--color-album-frame-inner);
  border: 1rpx solid var(--color-album-frame-line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-album-card-raised);
}

.album-card__shell--selectable.is-selected {
  border-color: var(--color-album-active);
  box-shadow: var(--shadow-album-card-raised);
}

.album-card__shell--selectable.is-disabled {
  opacity: 0.55;
}

.album-card__select {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  align-self: center;
}

.album-card__select-dot {
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-full);
  background-color: #fff;
}

.album-card__select.is-on .album-card__select-dot {
  border-color: var(--color-album-active);
  background-color: var(--color-album-active);
  box-shadow: inset 0 0 0 6rpx #fff;
}

.album-card__select.is-disabled .album-card__select-dot {
  border-color: var(--color-border);
  background-color: #fff;
  opacity: 0.6;
}

.album-card__shell--embedded {
  overflow: hidden;
  background-color: var(--color-album-frame-inner);
  border: 1rpx solid var(--color-album-frame-line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-album-list-thumb);
}

.album-card__shell--ledger {
  background-color: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
}

.album-card__inner {
  display: flex;
  flex-direction: row;
  gap: var(--space-md);
  align-items: stretch;
  box-sizing: border-box;
  min-height: var(--size-album-list-card-min-height);
  padding: var(--space-md);
  width: 100%;
}

.album-card__thumb-col {
  flex-shrink: 0;
  width: var(--size-album-list-thumb);
  height: var(--size-album-list-thumb);
}

.album-card__thumb-col .album-photo-frame {
  width: var(--size-album-list-thumb);
  height: var(--size-album-list-thumb);
}

.album-card__thumb-wrap {
  width: var(--size-album-list-thumb);
  height: var(--size-album-list-thumb);
  overflow: hidden;
  border-radius: var(--radius-album-list-thumb);
}

.album-card__thumb-wrap--plain {
  border: 1rpx solid var(--color-album-frame-line);
  background: var(--color-album-frame-inner);
  box-shadow: var(--shadow-album-list-thumb);
}

.album-card__thumb {
  display: block;
  width: var(--size-album-list-thumb);
  height: var(--size-album-list-thumb);
}

.album-card__thumb--placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  padding: var(--space-sm);
  background: linear-gradient(
    180deg,
    var(--color-album-frame-inner) 0%,
    var(--color-album-active-light) 100%
  );
  box-sizing: border-box;
}

.album-card__thumb-initial {
  color: var(--color-album-frame-corner);
  font-size: var(--font-h2);
  line-height: var(--font-h2-lh);
}

.album-card__thumb-progress {
  width: 100%;
  padding: 0 var(--space-xs);
  box-sizing: border-box;
}

.album-card__thumb-ph {
  color: var(--color-text-tertiary);
}

.album-card__body {
  display: flex;
  flex: 1;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
}

.album-card__body--stacked {
  flex: 1;
  flex-direction: column;
  gap: var(--space-xs);
  justify-content: center;
  min-width: 0;
  min-height: var(--size-album-list-thumb);
}

.album-card__body--split {
  flex: 1 1 0%;
  flex-direction: row;
  align-items: flex-start;
  gap: var(--space-sm);
  width: 0;
  min-height: var(--size-album-list-thumb);
}

.album-card__head {
  position: relative;
  display: block;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.album-card__head--with-share {
  padding-right: 96rpx;
}

.album-card__service--head {
  display: block;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.album-card__head-actions {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--space-xs);
  width: 96rpx;
}

.album-card__head-share {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 1;
  width: 96rpx;
  height: var(--font-body-lh);
}

.album-card__share-btn--head {
  position: relative;
  top: auto;
  right: auto;
  width: 96rpx !important;
  min-width: 0 !important;
  max-width: 96rpx;
  height: var(--font-body-lh);
  padding: 0;
  margin: 0;
  font-size: var(--font-sub);
  line-height: var(--font-body-lh);
  text-align: right;
  box-sizing: border-box;
  color: var(--color-primary);
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.album-card__main {
  display: flex;
  flex: 1 1 0%;
  flex-direction: column;
  gap: var(--space-xs);
  justify-content: flex-start;
  width: 0;
  min-width: 0;
  min-height: var(--size-album-list-thumb);
  overflow: hidden;
}

.album-card__service {
  display: block;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.album-card__service.text-body {
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.album-card__shell--raised .album-card__service.text-album-display {
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
  letter-spacing: 3rpx;
  color: var(--color-text-primary);
}

.album-card__actions {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  gap: var(--space-xs);
  align-items: center;
}

.album-card__actions--column {
  flex-direction: column;
  flex-wrap: nowrap;
  align-items: flex-end;
  align-self: flex-start;
  gap: 6rpx;
}

.album-card__actions--column .album-card__action {
  padding: 2rpx 0;
}

.album-card__shell--raised .album-card__actions--column .album-card__action {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-album-active-light);
}

.album-card__shell--raised .album-card__action {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-album-active-light);
}

.album-card__shell--raised .album-card__action--muted {
  background-color: var(--color-bg-muted);
}

.album-card__action {
  padding: 2rpx var(--space-xs);
}

.album-card__action--muted .album-card__action-text {
  color: var(--color-text-tertiary);
}

.album-card__action-text {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.album-card__share-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  width: auto !important;
  min-width: 0 !important;
  font-size: var(--font-caption);
  font-weight: var(--font-weight-medium);
  color: var(--color-primary);
  background: transparent;
  line-height: 1.4;
}

.album-card__share-btn::after {
  border: none;
}

.album-card__meta {
  display: block;
  width: 100%;
  overflow: hidden;
  color: var(--color-text-secondary);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.album-card__meta--store {
  color: var(--color-text-tertiary);
}

.album-card__summary {
  display: block;
  width: 100%;
  overflow: hidden;
  color: var(--color-text-secondary);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.album-card__date {
  margin-top: var(--space-xs);
  color: var(--color-text-tertiary);
}

.album-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-top: var(--space-xs);
}

.album-card__hint {
  display: block;
  margin-top: var(--space-xs);
  color: var(--color-warning);
}

.album-card__progress-wrap {
  width: 100%;
  margin-top: var(--space-xs);
}

.album-card__footer {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--color-album-frame-line);
}

.album-card__time {
  margin-top: var(--space-xs);
  color: var(--color-text-tertiary);
}

.album-card__time--fresh {
  color: var(--color-warning);
  font-weight: var(--font-weight-medium);
}

.album-card__quick {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  width: 100%;
  box-sizing: border-box;
  border-top: 1rpx solid var(--color-album-frame-line);
  background: var(--color-album-frame-inner);
}

.album-card__quick-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: var(--space-sm) var(--space-xs);
  box-sizing: border-box;
}

.album-card__quick-item + .album-card__quick-item {
  border-left: 1rpx solid var(--color-album-frame-line);
}

.album-card__quick-text {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.album-card__shell--board {
  overflow: visible;
  background: transparent;
  border: none;
  box-shadow: none;
}

.album-card__board {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  box-sizing: border-box;
  width: 100%;
  padding: 38rpx 42rpx;
  background: var(--color-bg-card);
  border-radius: 36rpx;
  box-shadow: 0 16rpx 40rpx rgba(20, 27, 45, 0.1), 0 2rpx 8rpx rgba(20, 27, 45, 0.04);
}

.album-card__board-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.album-card__board-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.album-card__board-chip {
  padding: 8rpx 24rpx;
  border-radius: 14rpx;
  background: #eaf2ff;
  color: #074bb8;
  font-family: 'DIN Alternate', 'Roboto Mono', 'Menlo', 'Consolas', monospace;
  font-size: var(--font-h3);
  font-weight: var(--font-weight-semibold);
  line-height: 1.4;
  letter-spacing: 3rpx;
  font-variant-numeric: tabular-nums;
}

.album-card__board-jobrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 24rpx;
}

.album-card__board-job {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.album-card__board-sub {
  display: block;
  overflow: hidden;
  margin-top: 10rpx;
  color: #626e80;
  font-size: var(--font-body);
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.album-card__board-act {
  flex: none;
  color: #1269f2;
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  line-height: 1.4;
}

.album-card__ledger {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  box-sizing: border-box;
  width: 100%;
  padding: 28rpx 34rpx;
  border-bottom: 1rpx solid #eef1f6;
}

.album-card__ledger.is-last {
  border-bottom: none;
}

.album-card__ledger-body {
  flex: 1;
  min-width: 0;
}

.album-card__ledger-r1 {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.album-card__ledger-plate {
  overflow: hidden;
  color: #1f2329;
  font-family: 'DIN Alternate', 'Roboto Mono', 'Menlo', 'Consolas', monospace;
  font-size: var(--font-album-plate);
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 2rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-variant-numeric: tabular-nums;
}

.album-card__ledger-st {
  flex: none;
  font-size: var(--font-sub);
  line-height: 1.4;
  color: #1269f2;
}

.album-card__ledger-st--pending {
  color: #9a5b00;
}

.album-card__ledger-st--done {
  color: #0b6c59;
}

.album-card__ledger-job {
  display: block;
  overflow: hidden;
  margin-top: 9rpx;
  color: #3d4a5c;
  font-size: var(--font-h3);
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.album-card__ledger-r3 {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 7rpx;
}

.album-card__ledger-sub {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #9aa3b0;
  font-size: var(--font-sub);
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.album-card__ledger-act {
  flex: none;
  color: #1269f2;
  font-size: var(--font-sub);
  font-weight: var(--font-weight-medium);
  line-height: 1.4;
}

.album-card__board-pill {
  flex: none;
  padding: 6rpx 22rpx;
  border-radius: var(--radius-full);
  background: #eaf2ff;
  color: #1269f2;
  font-size: var(--font-sub);
  font-weight: var(--font-weight-medium);
  line-height: 1.5;
}

.album-card__board-pill--pending {
  background: var(--color-mch-amber-soft);
  color: var(--color-mch-amber-deep);
}

.album-card__board-pill--done {
  background: var(--color-mch-green-soft);
  color: var(--color-mch-green-deep);
}

.album-card__progress-line {
  display: block;
  width: 100%;
  overflow: hidden;
  margin-top: var(--space-xs);
  color: var(--color-text-secondary);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.album-card__progress-line--done {
  color: var(--color-success);
}

.album-card__progress-line--pending {
  color: var(--color-warning);
}

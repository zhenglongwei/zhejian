.album-compare-pair-editor {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.album-compare-pair-editor__head {
  display: flex;
  gap: var(--space-xs);
  align-items: center;
  justify-content: space-between;
}

.album-compare-pair-editor__title {
  flex: 1;
  min-width: 0;
}

.album-compare-pair-editor__desc {
  color: var(--color-text-secondary);
}

.album-compare-pair-editor__cols {
  display: grid;
  grid-template-columns: 1fr 56rpx 1fr;
  gap: var(--space-sm);
  align-items: center;
  margin-top: var(--space-xs);
}

.album-compare-pair-editor__col-label {
  min-width: 0;
  text-align: center;
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

.album-compare-pair-editor__group {
  padding: var(--space-xs) 0 var(--space-sm);
  border-bottom: 1rpx dashed var(--color-border);
}

.album-compare-pair-editor__group:last-of-type {
  border-bottom: none;
  padding-bottom: 0;
}

.album-compare-pair-editor__group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-xs);
}

.album-compare-pair-editor__group-label {
  color: var(--color-text-tertiary);
}

.album-compare-pair-editor__remove {
  padding: var(--space-xs);
  white-space: nowrap;
}

.album-compare-pair-editor__pair {
  display: grid;
  grid-template-columns: 1fr 56rpx 1fr;
  gap: var(--space-sm);
  align-items: center;
}

.album-compare-pair-editor__cell {
  min-width: 0;
  width: 100%;
}

.album-compare-pair-editor__bridge,
.album-compare-pair-editor__bridge-spacer {
  position: relative;
  width: 56rpx;
  height: 24rpx;
  justify-self: center;
  align-self: center;
}

.album-compare-pair-editor__bridge-line {
  position: absolute;
  top: 50%;
  right: 10rpx;
  left: 10rpx;
  height: 4rpx;
  margin-top: -2rpx;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  opacity: 0.45;
}

.album-compare-pair-editor__bridge-dot {
  position: absolute;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-top: -7rpx;
  border: 3rpx solid var(--color-primary);
  border-radius: var(--radius-full);
  background: var(--color-bg-card);
  box-sizing: border-box;
}

.album-compare-pair-editor__bridge-dot--left {
  left: 0;
}

.album-compare-pair-editor__bridge-dot--right {
  right: 0;
  background: var(--color-primary);
}

.album-compare-pair-editor__actions {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: var(--space-sm);
  margin-top: var(--space-xs);
}

.album-compare-pair-editor__action {
  flex: 1;
  min-width: 0;
}

.album-compare-pair-editor__note {
  width: 100%;
  min-height: 120rpx;
  margin-top: var(--space-sm);
  padding: var(--space-sm);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-album-frame-line);
  background-color: var(--color-album-frame-inner);
  font-size: var(--font-body);
  box-sizing: border-box;
}

.album-compare-pair-editor__upload-hint {
  color: var(--color-text-tertiary);
}

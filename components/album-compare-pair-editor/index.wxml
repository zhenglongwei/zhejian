<view class="album-compare-pair-editor">
  <view class="album-compare-pair-editor__head">
    <text class="album-compare-pair-editor__title text-h3">{{title}}</text>
    <ui-tag
      wx:if="{{requiredLevelLabel}}"
      variant="{{requiredLevelVariant || 'default'}}"
      text="{{requiredLevelLabel}}"
    />
  </view>

  <text wx:if="{{description}}" class="album-compare-pair-editor__desc text-caption">{{description}}</text>

  <view class="album-compare-pair-editor__cols">
    <text class="album-compare-pair-editor__col-label text-caption">{{afterColumnLabel}}</text>
    <view class="album-compare-pair-editor__bridge-spacer" aria-hidden="true" />
    <text class="album-compare-pair-editor__col-label text-caption">{{beforeColumnLabel}}</text>
  </view>

  <view
    wx:for="{{displayRows}}"
    wx:key="index"
    class="album-compare-pair-editor__group"
  >
    <view class="album-compare-pair-editor__group-head" wx:if="{{displayRows.length > 1 || !disabled}}">
      <text class="text-caption album-compare-pair-editor__group-label">{{item.label}}</text>
      <text
        wx:if="{{!disabled && displayRows.length > 1}}"
        class="album-compare-pair-editor__remove text-caption text-link"
        data-index="{{item.index}}"
        catchtap="onRemoveRow"
      >删除</text>
    </view>

    <view class="album-compare-pair-editor__pair {{item.linked ? 'is-linked' : ''}}">
      <view class="album-compare-pair-editor__cell">
        <ui-image-uploader
          images="{{item.after ? [item.after] : []}}"
          maxCount="{{1}}"
          columns="{{1}}"
          variant="album"
          disabled="{{disabled}}"
          data-index="{{item.index}}"
          data-field="after"
          bind:change="onRowImageChange"
        />
      </view>

      <view
        wx:if="{{item.linked}}"
        class="album-compare-pair-editor__bridge"
        aria-hidden="true"
      >
        <view class="album-compare-pair-editor__bridge-line" />
        <view class="album-compare-pair-editor__bridge-dot album-compare-pair-editor__bridge-dot--left" />
        <view class="album-compare-pair-editor__bridge-dot album-compare-pair-editor__bridge-dot--right" />
      </view>
      <view wx:else class="album-compare-pair-editor__bridge-spacer" aria-hidden="true" />

      <view class="album-compare-pair-editor__cell">
        <ui-image-uploader
          images="{{item.before ? [item.before] : []}}"
          maxCount="{{1}}"
          columns="{{1}}"
          variant="album"
          disabled="{{disabled}}"
          data-index="{{item.index}}"
          data-field="before"
          bind:change="onRowImageChange"
        />
      </view>
    </view>
  </view>

  <view
    wx:if="{{!disabled && (displayRows.length < maxCount || showSyncAssessment)}}"
    class="album-compare-pair-editor__actions"
  >
    <view wx:if="{{displayRows.length < maxCount}}" class="album-compare-pair-editor__action">
      <ui-button type="secondary" size="sm" block="{{true}}" bind:btntap="onAddRow">添加一组</ui-button>
    </view>
    <view wx:if="{{showSyncAssessment}}" class="album-compare-pair-editor__action">
      <ui-button type="secondary" size="sm" block="{{true}}" bind:btntap="onSyncFromAssessment">从检测记录填入维修前</ui-button>
    </view>
  </view>

  <textarea
    class="album-compare-pair-editor__note input"
    placeholder="{{notePlaceholder}}"
    value="{{note}}"
    disabled="{{disabled}}"
    bindinput="onNoteInput"
  />
  <text wx:if="{{uploadHint}}" class="album-compare-pair-editor__upload-hint text-caption">{{uploadHint}}</text>
</view>

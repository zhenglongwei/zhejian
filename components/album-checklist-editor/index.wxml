<view class="album-checklist-editor">
  <view class="album-checklist-editor__head">
    <text class="text-body">{{title || (mode === 'work' ? '待处理项目' : mode === 'followup' ? '跟进服务' : '检查项目')}}</text>
    <text wx:if="{{completeness && mode === 'stage'}}" class="text-caption text-secondary">
      已留证 {{completeness.activeCount || 0}}/{{completeness.totalCount || 0}}
    </text>
    <text wx:elif="{{mode === 'work'}}" class="text-caption text-secondary">
      {{items.length}} 项 · 由图注自动生成，可不写价格
    </text>
    <text wx:elif="{{mode === 'followup'}}" class="text-caption text-secondary">
      车主暂缓处理 · {{items.length}} 项
    </text>
  </view>
  <text wx:if="{{hint}}" class="text-caption text-secondary album-checklist-editor__hint">{{hint}}</text>

  <view wx:if="{{!items.length}}" class="album-checklist-editor__empty">
    <text class="text-caption text-secondary">
      {{mode === 'work' ? '暂无待处理项。任一检查图标注「建议更换 / 需处理」等会自动进入；也可手动加入。' : mode === 'followup' ? '暂无跟进项。' : '本阶段暂无检查项。'}}
    </text>
  </view>

  <view
    wx:for="{{items}}"
    wx:key="itemKey"
    class="album-checklist-editor__item {{item.status === 'active' ? 'is-filled' : ''}} {{item.inFollowUp ? 'is-followup' : ''}}"
  >
    <view class="album-checklist-editor__item-top">
      <text class="text-body">{{item.label}}</text>
      <text class="text-caption text-secondary">{{item.group}}</text>
    </view>
    <text wx:if="{{item.strength === 'strong' && mode === 'stage'}}" class="text-caption album-checklist-editor__strong">强烈建议</text>
    <text wx:if="{{item.outcomeLabel}}" class="text-caption album-checklist-editor__outcome">{{item.outcomeLabel}}</text>

    <block wx:if="{{!readOnly}}">
      <view catchtap="noop">
        <view wx:if="{{mode === 'stage' || mode === 'work'}}" class="album-checklist-editor__upload">
          <ui-image-uploader
            images="{{item.stageImages || item.images}}"
            maxCount="{{12}}"
            variant="album"
            enableCaption="{{true}}"
            captionPlaceholder="点上方标签后可在此补充说明"
            captionProminent="{{true}}"
            stackLayout="{{true}}"
            captionQuickTags="{{mode === 'work' ? workQuickTags : stageQuickTags}}"
            stampChecklistItemKey="{{item.itemKey}}"
            data-key="{{item.itemKey}}"
            bind:change="onImagesChange"
          />
        </view>

        <view wx:if="{{mode === 'work'}}" class="album-checklist-editor__outcomes">
          <text
            class="album-checklist-editor__chip album-checklist-editor__chip--danger"
            data-key="{{item.itemKey}}"
            catchtap="onRemoveWork"
          >移出待处理</text>
        </view>

        <view wx:if="{{mode === 'followup'}}" class="album-checklist-editor__outcomes">
          <text
            class="album-checklist-editor__chip is-on"
            data-key="{{item.itemKey}}"
            catchtap="onRestoreFollowUp"
          >重新纳入待处理</text>
        </view>

        <view
          wx:if="{{mode === 'stage' && !item.inWorkQueue && !item.inFollowUp}}"
          class="album-checklist-editor__outcomes"
        >
          <text
            class="album-checklist-editor__chip"
            data-key="{{item.itemKey}}"
            catchtap="onAddWork"
          >加入待处理</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{item.images.length}}" class="album-checklist-editor__readonly-imgs">
        <text class="text-caption">已挂 {{item.images.length}} 张图</text>
      </view>
    </block>
  </view>
</view>

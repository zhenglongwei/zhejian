<view class="chk-editor" wx:if="{{displayItems.length}}">
  <view class="chk-head" wx:if="{{title}}">
    <text class="chk-title">{{title}}</text>
    <text class="chk-hint" wx:if="{{hint}}">{{hint}}</text>
    <text class="chk-progress" wx:if="{{completeness}}">
      已留证 {{completeness.evidencedCount || 0}} / {{completeness.total || displayItems.length}}
    </text>
  </view>

  <view class="chk-list">
    <view
      class="chk-item {{item.expanded ? 'is-open' : 'is-compact'}}"
      wx:for="{{displayItems}}"
      wx:key="itemKey"
    >
      <view
        class="chk-row"
        wx:if="{{mode === 'stage'}}"
        data-key="{{item.itemKey}}"
        bindtap="onToggleItem"
      >
        <text class="chk-row-title">{{item.titleText || item.label}}</text>
        <view class="chk-row-aside">
          <text class="status-pill status-pill--{{item.statusTone}}">{{item.checkStatusLabel}}</text>
          <text
            class="result-pill result-pill--{{item.resultKind}}"
            wx:if="{{item.resultLabel}}"
          >{{item.resultLabel}}</text>
          <text class="chk-toggle">{{item.toggleLabel}}</text>
        </view>
      </view>

      <view class="chk-row chk-row--static" wx:else>
        <text class="chk-row-title">{{item.titleText || item.label}}</text>
        <view class="chk-row-aside">
          <text class="status-pill status-pill--{{item.statusTone}}">{{item.checkStatusLabel}}</text>
          <text
            class="result-pill result-pill--{{item.resultKind}}"
            wx:if="{{item.resultLabel}}"
          >{{item.resultLabel}}</text>
        </view>
      </view>

      <view class="chk-body" wx:if="{{item.expanded}}">
        <ui-image-uploader
          wx:if="{{!readOnly}}"
          images="{{item.displayImages}}"
          max-count="{{6}}"
          enable-caption="{{true}}"
          caption-placeholder="补充说明（选填）"
          caption-quick-tags="{{mode === 'work' ? workQuickTags : stageQuickTags}}"
          stamp-checklist-item-key="{{item.itemKey}}"
          stack-layout="{{true}}"
          data-item-key="{{item.itemKey}}"
          bind:change="onImagesChange"
        />
        <view class="readonly-imgs" wx:else>
          <block wx:for="{{item.displayImages}}" wx:for-item="img" wx:key="url">
            <view class="readonly-img-row">
              <image class="readonly-thumb" src="{{img.url}}" mode="aspectFill" />
              <text class="readonly-cap">{{img.caption || '未标注'}}</text>
            </view>
          </block>
          <view class="empty-tip" wx:if="{{!item.hasImages}}">暂无图片</view>
        </view>

        <view class="follow-actions" wx:if="{{mode === 'followup' && !readOnly}}">
          <button
            class="btn-mini"
            size="mini"
            data-key="{{item.itemKey}}"
            data-reason="mismatch"
            bindtap="onRemoveWork"
          >误判移除</button>
          <button
            class="btn-mini btn-ghost"
            size="mini"
            data-key="{{item.itemKey}}"
            data-reason="owner_declined"
            bindtap="onRemoveWork"
          >车主暂不处理</button>
        </view>
      </view>
    </view>
  </view>
</view>

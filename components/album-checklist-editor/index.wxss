.chk-editor {
  margin-top: var(--space-sm);
}

.chk-head {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}

.chk-title {
  font-size: var(--font-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--font-body-lh);
}

.chk-hint,
.chk-progress {
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
  line-height: var(--font-caption-lh);
}

.chk-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.chk-item {
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.chk-item.is-open {
  border-color: var(--color-border-strong);
}

/* 简洁态：标题 / 状态 / 展开 同一行，压缩高度 */
.chk-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  min-height: 72rpx;
  padding: 12rpx var(--space-sm);
  box-sizing: border-box;
}

.chk-row-title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chk-row-aside {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
}

.status-pill {
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 10rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid transparent;
}

.status-pill--muted {
  color: var(--color-text-tertiary);
  background: var(--color-bg-muted);
  border-color: var(--color-border);
}

.status-pill--hint {
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.status-pill--ok {
  color: var(--color-success);
  background: var(--color-success-light);
}

.status-pill--warn {
  color: var(--color-warning);
  background: var(--color-warning-light);
}

.result-pill {
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 8rpx;
}

.result-pill--ok {
  color: var(--color-success);
}

.result-pill--warn {
  color: var(--color-warning);
}

.chk-toggle {
  font-size: var(--font-caption);
  color: var(--color-primary);
  padding-left: 2rpx;
}

.chk-remove-link {
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
  padding-left: 4rpx;
}

.chk-body {
  padding: 0 var(--space-sm) var(--space-sm);
  border-top: 1rpx solid var(--color-border);
}

.chk-ai-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-xs);
  padding-top: var(--space-sm);
}

.chk-ai-link {
  font-size: var(--font-caption);
  color: var(--color-primary);
  font-weight: 500;
}

.chk-ai-hint {
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
}

.readonly-imgs {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding-top: var(--space-sm);
}

.readonly-img-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
}

.readonly-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg-muted);
  flex-shrink: 0;
}

.readonly-cap {
  flex: 1;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: var(--font-caption-lh);
}

.empty-tip {
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
  padding: var(--space-sm) 0;
}

.follow-actions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-sm);
}

.btn-mini {
  margin: 0 !important;
}

.btn-ghost {
  background: var(--color-bg-muted) !important;
  color: var(--color-text-secondary) !important;
}

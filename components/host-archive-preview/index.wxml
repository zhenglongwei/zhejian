<view class="host-archive-preview" wx:if="{{chapters.length}}">
  <view
    wx:for="{{chapters}}"
    wx:for-item="ch"
    wx:key="id"
    class="host-archive-preview__step {{index === chapters.length - 1 ? 'is-last' : ''}}"
  >
    <view class="host-archive-preview__dot" />
    <view class="host-archive-preview__body">
      <text class="host-archive-preview__title">{{ch.title}}</text>

      <block wx:if="{{ch.chiefComplaint}}">
        <text class="host-archive-preview__k">进店主诉</text>
        <text class="host-archive-preview__p">{{ch.chiefComplaint}}</text>
      </block>

      <block wx:if="{{ch.findings.length}}">
        <text class="host-archive-preview__k">本次检测</text>
        <view
          wx:for="{{ch.findings}}"
          wx:for-item="f"
          wx:for-index="fi"
          wx:key="fi"
          class="host-archive-preview__finding"
        >
          <view class="host-archive-preview__finding-head">
            <text class="host-archive-preview__item-name">{{f.partName}}</text>
            <text
              wx:if="{{f.result}}"
              class="host-archive-preview__result {{f.result === '状态良好' ? 'is-ok' : (f.result === '需处理' ? 'is-action' : '')}}"
            >{{f.result}}</text>
          </view>
          <block wx:if="{{f.images && f.images.length}}">
            <view wx:if="{{f.images.length > 1}}" class="host-archive-preview__finding-grid">
              <image
                wx:for="{{f.images}}"
                wx:for-item="img"
                wx:for-index="ii"
                wx:key="ii"
                class="host-archive-preview__grid-img image-placeholder"
                src="{{img.url}}"
                mode="aspectFill"
                data-url="{{img.url}}"
                bindtap="onImageTap"
              />
            </view>
            <image
              wx:else
              class="host-archive-preview__finding-img image-placeholder"
              src="{{f.images[0].url}}"
              mode="aspectFill"
              data-url="{{f.images[0].url}}"
              bindtap="onImageTap"
            />
          </block>
          <image
            wx:elif="{{f.url}}"
            class="host-archive-preview__finding-img image-placeholder"
            src="{{f.url}}"
            mode="aspectFill"
            data-url="{{f.url}}"
            bindtap="onImageTap"
          />
          <text wx:if="{{f.advice}}" class="host-archive-preview__note">{{f.advice}}</text>
        </view>
      </block>

      <view wx:if="{{ch.items.length}}" class="host-archive-preview__items">
        <view wx:for="{{ch.items}}" wx:for-item="row" wx:for-index="ri" wx:key="ri" class="host-archive-preview__item">
          <text class="host-archive-preview__item-name">{{row.name}}</text>
          <text wx:if="{{row.brand}}" class="host-archive-preview__note">{{row.brand}}</text>
          <text wx:if="{{row.note}}" class="host-archive-preview__note">{{row.note}}</text>
          <image
            wx:if="{{row.evidenceUrl}}"
            class="host-archive-preview__finding-img image-placeholder"
            src="{{row.evidenceUrl}}"
            mode="aspectFill"
            data-url="{{row.evidenceUrl}}"
            bindtap="onImageTap"
          />
        </view>
      </view>

      <block wx:if="{{ch.repairBrief}}">
        <text class="host-archive-preview__k">本次维修简述</text>
        <text class="host-archive-preview__p">{{ch.repairBrief}}</text>
      </block>

      <block wx:if="{{ch.ownerFaqs && ch.ownerFaqs.length}}">
        <text class="host-archive-preview__k">车主关心的问题</text>
        <view
          wx:for="{{ch.ownerFaqs}}"
          wx:for-item="faq"
          wx:for-index="fi"
          wx:key="fi"
          class="host-archive-preview__faq"
        >
          <text class="host-archive-preview__item-name">{{faq.question}}</text>
          <text class="host-archive-preview__note">{{faq.answer}}</text>
        </view>
      </block>

      <view wx:if="{{ch.photos.length}}" class="host-archive-preview__photos">
        <view
          wx:for="{{ch.photos}}"
          wx:for-item="photo"
          wx:key="url"
          class="host-archive-preview__photo-wrap"
        >
          <image
            class="host-archive-preview__photo image-placeholder"
            src="{{photo.url || photo}}"
            mode="aspectFill"
            data-url="{{photo.url || photo}}"
            bindtap="onImageTap"
          />
          <text wx:if="{{photo.caption}}" class="host-archive-preview__caption">{{photo.caption}}</text>
        </view>
      </view>

      <text
        wx:if="{{ch.warrantyPeriod || ch.warrantyNotes}}"
        class="host-archive-preview__note"
      >质保：{{ch.warrantyPeriod}}{{ch.warrantyPeriod && ch.warrantyNotes ? ' · ' : ''}}{{ch.warrantyNotes}}</text>
    </view>
  </view>
</view>

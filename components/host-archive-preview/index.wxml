<view class="host-archive-preview" wx:if="{{chapters.length}}">
  <view
    wx:for="{{chapters}}"
    wx:for-item="ch"
    wx:key="id"
    class="host-archive-preview__step {{index === chapters.length - 1 ? 'is-last' : ''}}"
  >
    <view class="host-archive-preview__dot" />
    <view class="host-archive-preview__body">
      <text class="host-archive-preview__title">{{ch.title}}</text>

      <block wx:if="{{ch.chiefComplaint}}">
        <text class="host-archive-preview__k">进店主诉</text>
        <text class="host-archive-preview__p">{{ch.chiefComplaint}}</text>
      </block>

      <!-- 检测项 -->
      <block wx:if="{{ch.findings.length}}">
        <text class="host-archive-preview__k">本次检测</text>
        <view
          wx:for="{{ch.findings}}"
          wx:for-item="f"
          wx:for-index="fi"
          wx:key="fi"
          class="host-archive-preview__finding"
        >
          <view class="host-archive-preview__row-head">
            <text class="host-archive-preview__row-title">{{f.partName}}</text>
            <text
              wx:if="{{f.result}}"
              class="host-archive-preview__result {{f.result === '状态良好' ? 'is-ok' : (f.result === '需处理' ? 'is-action' : '')}}"
            >{{f.result}}</text>
          </view>
          <view wx:if="{{f.images && f.images.length}}" class="host-archive-preview__img-grid">
            <image
              wx:for="{{f.images}}"
              wx:for-item="img"
              wx:for-index="ii"
              wx:key="ii"
              class="host-archive-preview__grid-img image-placeholder"
              src="{{img.url}}"
              mode="aspectFill"
              data-url="{{img.url}}"
              data-urls="{{f.images}}"
              bindtap="onImageTap"
            />
          </view>
          <view wx:elif="{{f.url}}" class="host-archive-preview__img-grid">
            <image
              class="host-archive-preview__grid-img image-placeholder"
              src="{{f.url}}"
              mode="aspectFill"
              data-url="{{f.url}}"
              bindtap="onImageTap"
            />
          </view>
          <text wx:if="{{f.advice}}" class="host-archive-preview__row-note">{{f.advice}}</text>
        </view>
      </block>

      <!-- 统一项目区：报价项 / 施工项 -->
      <view wx:if="{{ch.items.length}}" class="host-archive-preview__items">
        <view
          wx:for="{{ch.items}}"
          wx:for-item="row"
          wx:for-index="ri"
          wx:key="ri"
          class="host-archive-preview__row"
        >
          <text wx:if="{{row.name}}" class="host-archive-preview__row-title">{{row.name}}</text>
          <view wx:if="{{row.images && row.images.length}}" class="host-archive-preview__img-grid">
            <image
              wx:for="{{row.images}}"
              wx:for-item="img"
              wx:for-index="ii"
              wx:key="ii"
              class="host-archive-preview__grid-img image-placeholder"
              src="{{img.url}}"
              mode="aspectFill"
              data-url="{{img.url}}"
              data-urls="{{row.images}}"
              bindtap="onImageTap"
            />
          </view>
          <view wx:elif="{{row.evidenceUrl}}" class="host-archive-preview__img-grid">
            <image
              class="host-archive-preview__grid-img image-placeholder"
              src="{{row.evidenceUrl}}"
              mode="aspectFill"
              data-url="{{row.evidenceUrl}}"
              bindtap="onImageTap"
            />
          </view>
          <text wx:if="{{row.note}}" class="host-archive-preview__row-note">{{row.note}}</text>
        </view>
      </view>

      <!-- 验收项 -->
      <block wx:if="{{ch.acceptanceItems && ch.acceptanceItems.length}}">
        <text class="host-archive-preview__k">交车验收</text>
        <view
          wx:for="{{ch.acceptanceItems}}"
          wx:for-item="acc"
          wx:for-index="ai"
          wx:key="id"
          class="host-archive-preview__finding"
        >
          <view class="host-archive-preview__row-head">
            <text class="host-archive-preview__row-title">{{acc.name}}</text>
            <text
              wx:if="{{acc.resultLabel}}"
              class="host-archive-preview__result {{acc.result === 'pass' ? 'is-ok' : (acc.result === 'rework' ? 'is-action' : '')}}"
            >{{acc.resultLabel}}</text>
          </view>
          <view wx:if="{{acc.images && acc.images.length}}" class="host-archive-preview__img-grid">
            <image
              wx:for="{{acc.images}}"
              wx:for-item="img"
              wx:for-index="ii"
              wx:key="ii"
              class="host-archive-preview__grid-img image-placeholder"
              src="{{img.url}}"
              mode="aspectFill"
              data-url="{{img.url}}"
              data-urls="{{acc.images}}"
              bindtap="onImageTap"
            />
          </view>
          <text wx:if="{{acc.note}}" class="host-archive-preview__row-note">{{acc.note}}</text>
        </view>
      </block>

      <text
        wx:if="{{ch.warrantyPeriod || ch.warrantyNotes}}"
        class="host-archive-preview__row-note"
      >质保：{{ch.warrantyPeriod}}{{ch.warrantyPeriod && ch.warrantyNotes ? ' · ' : ''}}{{ch.warrantyNotes}}</text>
    </view>
  </view>
</view>

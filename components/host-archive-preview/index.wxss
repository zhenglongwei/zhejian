.host-archive-preview {
  margin: 0;
  padding: 0 0 0 36rpx;
  border-left: 2rpx solid var(--color-border);
}

.host-archive-preview__step {
  position: relative;
  padding: 0 0 var(--space-xl) 40rpx;
}

.host-archive-preview__step.is-last {
  padding-bottom: 0;
}

.host-archive-preview__dot {
  position: absolute;
  left: -10rpx;
  top: 16rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-bg-card);
  border: 4rpx solid var(--color-border);
  box-sizing: border-box;
}

.host-archive-preview__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  min-width: 0;
}

.host-archive-preview__title {
  display: block;
  margin-bottom: var(--space-sm);
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 章节衔接语：人话导语，和证据列表区分开 */
.host-archive-preview__narrative {
  display: block;
  margin: 0 0 var(--space-sm);
  padding-left: 16rpx;
  border-left: 4rpx solid var(--color-border);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}

.host-archive-preview__k {
  display: block;
  margin-top: var(--space-sm);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-tertiary);
}

.host-archive-preview__p {
  display: block;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-primary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 统一行容器：检测项 / 报价项 / 施工项 / 验收项 共用 */
.host-archive-preview__row,
.host-archive-preview__finding {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--space-xs);
  margin-top: var(--space-sm);
}

.host-archive-preview__row-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.host-archive-preview__row-title {
  display: block;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.host-archive-preview__row-note {
  display: block;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 结果标签（检测/验收） */
.host-archive-preview__result {
  flex-shrink: 0;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
  padding: 2rpx 14rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid var(--color-border);
}

.host-archive-preview__result.is-ok {
  color: var(--color-success, #2e7d32);
  border-color: currentColor;
}

.host-archive-preview__result.is-action {
  color: var(--color-warning, #c25705);
  border-color: currentColor;
}

/* 图片：统一每行3张等尺寸小图，超出逢3换行 */
.host-archive-preview__img-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.host-archive-preview__grid-img {
  width: 100%;
  height: 200rpx;
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
}

/* items 容器（报价/施工章节） */
.host-archive-preview__items {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-top: var(--space-xs);
}

.host-archive-preview {
  margin: 0;
  padding: 0 0 0 32rpx;
  border-left: 2rpx solid var(--color-border);
}

.host-archive-preview__step {
  position: relative;
  padding: 0 0 var(--space-xl) 36rpx;
}

.host-archive-preview__step.is-last {
  padding-bottom: 0;
}

.host-archive-preview__dot {
  position: absolute;
  left: -9rpx;
  top: 20rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-primary);
  border: 4rpx solid var(--color-bg-card);
  box-sizing: border-box;
}

.host-archive-preview__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  min-width: 0;
}

/* 一级：节点标题 */
.host-archive-preview__title {
  display: block;
  padding-bottom: var(--space-xs);
  border-bottom: 1rpx solid var(--color-border);
  font-size: var(--font-h2);
  line-height: var(--font-h2-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 章节衔接语：正文语气，承接标题 */
.host-archive-preview__narrative {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 二级：章节内的分组标题（本次检测 / 报价项目 / 施工项目 / 交车验收 / 进店主诉） */
.host-archive-preview__k {
  display: block;
  margin-top: var(--space-sm);
  padding-left: var(--space-sm);
  border-left: 6rpx solid var(--color-border-strong);
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 补充报价这类「新发现」只把标签的竖条换成警示色，不铺大色块 */
.host-archive-preview__k--addon {
  border-left-color: var(--color-warning);
}

/* 正文：主诉等内容 */
.host-archive-preview__p {
  display: block;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-primary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 统一行容器：检测项 / 报价项 / 施工项 / 验收项 共用同一个浅灰底 */
.host-archive-preview__row,
.host-archive-preview__finding {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--space-xs);
  margin-top: var(--space-sm);
  padding: var(--space-sm);
  border-radius: var(--radius-md);
  border-left: 4rpx solid transparent;
  background-color: var(--color-bg-muted);
}

/* 只用一条窄色条区分类型，不做整块彩色：报价蓝、新发现橙 */
.host-archive-preview__row--quote {
  border-left-color: var(--color-primary);
}

.host-archive-preview__row--addon {
  border-left-color: var(--color-warning);
}

.host-archive-preview__row-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

/* 三级：项目名 */
.host-archive-preview__row-title {
  display: block;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 报价金额：明码标价，与项目名同一行右侧 */
.host-archive-preview__row-amount {
  flex-shrink: 0;
  margin-left: var(--space-sm);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 正文：项目说明 */
.host-archive-preview__row-note {
  display: block;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 章节尾部信息（质保等）：正文，和项目区隔开 */
.host-archive-preview__footer {
  display: block;
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--color-border);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-secondary);
  word-break: break-word;
}

/* 结果标签（检测/验收） */
.host-archive-preview__result {
  flex-shrink: 0;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
  padding: 2rpx 14rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid var(--color-border);
}

.host-archive-preview__result.is-ok {
  color: var(--color-success, #2e7d32);
  border-color: currentColor;
}

.host-archive-preview__result.is-action {
  color: var(--color-warning, #c25705);
  border-color: currentColor;
}

/* 图片：统一每行3张等尺寸小图，超出逢3换行 */
.host-archive-preview__img-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.host-archive-preview__grid-img {
  width: 100%;
  height: 200rpx;
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
}

/* items 容器（报价/施工章节） */
.host-archive-preview__items {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-top: var(--space-xs);
}

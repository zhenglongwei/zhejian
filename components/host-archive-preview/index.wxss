.host-archive-preview {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  margin: 0;
  padding: 0;
}

/* 本单概览：整页焦点区，蓝色细条 + 大数字；外层已是纸白卡，这里不再叠卡 */
.host-archive-preview__overview {
  position: relative;
  padding-left: var(--space-md);
}

.host-archive-preview__overview::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background-color: var(--color-primary);
}

.host-archive-preview__overview-label {
  display: block;
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
  color: var(--color-text-tertiary);
}

.host-archive-preview__stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-md) var(--space-sm);
  margin-top: var(--space-sm);
  padding-bottom: var(--space-sm);
}

.host-archive-preview__stat {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.host-archive-preview__stat-value {
  font-size: var(--font-h2);
  line-height: var(--font-h2-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.host-archive-preview__stat-value.is-primary {
  color: var(--color-primary);
}

.host-archive-preview__stat-value.is-success {
  color: var(--color-mch-green);
}

/* 质保这类长文本降一档，避免撑破数字格 */
.host-archive-preview__stat-value.is-plain {
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
  color: var(--color-text-primary);
}

.host-archive-preview__stat-label {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
}

/* 章节：序号 + 标题 + 发丝下划线，靠间距成段，不再用时间线圆点 */
.host-archive-preview__step {
  position: relative;
}

.host-archive-preview__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  min-width: 0;
}

.host-archive-preview__head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: var(--space-sm);
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.host-archive-preview__index {
  flex-shrink: 0;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
}

/* 一级：节点标题 */
.host-archive-preview__title {
  font-size: var(--font-h2);
  line-height: var(--font-h2-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 章节衔接语：正文语气，承接标题 */
.host-archive-preview__narrative {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 二级：章节内的分组标题（本次检测 / 报价项目 / 施工项目 / 交车验收 / 进店主诉） */
.host-archive-preview__k {
  display: block;
  margin-top: var(--space-md);
  padding-left: var(--space-sm);
  border-left: 2rpx solid var(--color-border);
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 补充报价这类「新发现」只把标签的竖条换成警示色，不铺大色块 */
.host-archive-preview__k--addon {
  border-left-color: var(--color-warning);
}

/* 正文：主诉等内容 */
.host-archive-preview__p {
  display: block;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-primary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 统一行容器：检测项 / 报价项 / 施工项 / 验收项，去灰底圆角，靠留白分行；仅报价/新发现保留细色条 */
.host-archive-preview__row,
.host-archive-preview__finding {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--space-xs);
  margin-top: var(--space-md);
  padding-left: var(--space-sm);
  border-left: 4rpx solid transparent;
}

/* 只用一条窄色条区分类型，不做整块彩色：报价蓝、新发现橙 */
.host-archive-preview__row--quote {
  border-left-color: var(--color-primary);
}

.host-archive-preview__row--addon {
  border-left-color: var(--color-warning);
}

.host-archive-preview__row-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

/* 三级：项目名 */
.host-archive-preview__row-title {
  display: block;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 报价金额：明码标价，同一行右侧，蓝色数字作焦点 */
.host-archive-preview__row-amount {
  flex-shrink: 0;
  margin-left: var(--space-sm);
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}

/* 正文：项目说明 */
.host-archive-preview__row-note {
  display: block;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 结果标签（检测/验收）：全站统一的浅底 pill，深前景 */
.host-archive-preview__result {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-secondary);
  background-color: var(--color-bg-muted);
}

.host-archive-preview__result.is-ok {
  color: var(--color-mch-green-deep);
  background-color: var(--color-mch-green-soft);
}

.host-archive-preview__result.is-action {
  color: var(--color-mch-amber-deep);
  background-color: var(--color-mch-amber-soft);
}

/* 图片：克制的小图带，每行3张，降低单张高度让它退到文字之后 */
.host-archive-preview__img-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.host-archive-preview__grid-img {
  width: 100%;
  height: 150rpx;
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-muted);
}

/* items 容器（报价/施工章节） */
.host-archive-preview__items {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-top: var(--space-xs);
}

.image-uploader {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-xs);
}

.image-uploader__item,
.image-uploader__add {
  aspect-ratio: 1;
  position: relative;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.image-uploader__img {
  width: 100%;
  height: 100%;
}

.image-uploader__remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background-color: var(--color-mask);
  color: var(--color-text-inverse);
  font-size: var(--font-caption);
  border-bottom-left-radius: var(--radius-sm);
}

.image-uploader__add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--color-border);
  background-color: var(--color-bg-muted);
}

.image-uploader__add-icon {
  width: 56rpx;
  height: 56rpx;
}

.image-uploader--album .image-uploader__item,
.image-uploader--album .image-uploader__add {
  border-radius: var(--radius-album-list-thumb);
}

.image-uploader--album .image-uploader__item {
  border: 1rpx solid var(--color-album-frame-line);
  background: var(--color-album-frame-inner);
  box-shadow: var(--shadow-album-list-thumb);
}

.image-uploader--album .image-uploader__add {
  border: 2rpx dashed var(--color-album-frame-line);
  background: var(--color-album-frame-inner);
}

.image-uploader--cta {
  display: block;
}

.image-uploader--full-add,
.image-uploader--cols-1 {
  grid-template-columns: 1fr;
}

.image-uploader--full-add .image-uploader__add {
  aspect-ratio: auto;
  min-height: var(--size-album-list-card-min-height);
}

.image-uploader__cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  width: 100%;
  min-height: var(--size-album-list-card-min-height);
  padding: var(--space-lg) var(--space-md);
  margin: 0;
  box-sizing: border-box;
  border: 2rpx dashed var(--color-album-frame-line) !important;
  border-radius: var(--radius-album-list-thumb);
  background: var(--color-album-frame-inner) !important;
  line-height: 1.4;
}

.image-uploader__cta::after {
  border: none;
}

.image-uploader__cta--hover {
  opacity: 0.88;
}

.image-uploader__cta-icon {
  width: 56rpx;
  height: 56rpx;
}

.image-uploader__cta-title {
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: 1.4;
}

.image-uploader__cta-desc {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.5;
}

.image-uploader__cell {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  min-width: 0;
}

.image-uploader__caption {
  width: 100%;
  box-sizing: border-box;
  padding: var(--space-xs) var(--space-sm);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
  background: var(--color-bg-muted);
  border-radius: var(--radius-sm);
  min-height: 64rpx;
}

.image-uploader--caption-prominent .image-uploader__caption {
  min-height: 120rpx;
  padding: var(--space-md);
  margin-top: var(--space-xs);
  font-size: var(--font-body);
  line-height: 1.5;
  color: var(--color-text-primary);
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-album-active);
  border-radius: var(--radius-md);
}

.image-uploader--caption-prominent.image-uploader--cols-1 .image-uploader__caption {
  min-height: 140rpx;
}

.image-uploader__meta {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  min-width: 0;
}

/* 检查项展开：左缩略图 + 右标签/说明，压缩单行高度 */
.image-uploader--stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.image-uploader--stack .image-uploader__cell {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: var(--space-sm);
  width: 100%;
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.image-uploader--stack .image-uploader__cell:last-of-type {
  border-bottom: none;
  padding-bottom: 0;
}

.image-uploader--stack .image-uploader__item {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  aspect-ratio: auto;
}

.image-uploader--stack .image-uploader__meta {
  flex: 1;
}

.image-uploader--stack .image-uploader__caption {
  min-height: 56rpx;
  padding: 8rpx var(--space-sm);
}

.image-uploader--stack .image-uploader__add {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  width: 100%;
  height: 64rpx;
  aspect-ratio: auto;
}

.image-uploader--stack .image-uploader__add-icon {
  width: 28rpx;
  height: 28rpx;
}

.image-uploader__add-text {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1;
}

.image-uploader__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
}

/* 默认：中性描边；选中：主色填充，避免警告色刺目与态不清 */
.image-uploader__tag {
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  font-size: var(--font-caption);
  line-height: 1.2;
  color: var(--color-text-secondary);
  background: var(--color-bg-muted);
}

.image-uploader__tag.is-active {
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.image-uploader__tag--clear {
  border-color: var(--color-border);
  color: var(--color-text-tertiary);
  background: var(--color-bg-card);
  font-weight: var(--font-weight-regular);
}

<view
  class="image-uploader {{variant === 'album' ? 'image-uploader--album' : ''}} {{isCtaLayout ? 'image-uploader--cta' : ''}} {{fullWidthAdd && !displayList.length ? 'image-uploader--full-add' : ''}} {{isSingleColumn ? 'image-uploader--cols-1' : ''}} {{enableCaption ? 'image-uploader--caption' : ''}} {{captionProminent ? 'image-uploader--caption-prominent' : ''}}"
>
  <block wx:if="{{isCtaLayout}}">
    <button
      wx:if="{{displayList.length < maxCount && !disabled}}"
      class="image-uploader__cta"
      hover-class="image-uploader__cta--hover"
      hover-stay-time="80"
      plain
      bindtap="onAdd"
    >
      <image
        class="image-uploader__cta-icon"
        src="{{addIconSrc}}"
        mode="aspectFit"
      />
      <view class="image-uploader__cta-title">{{ctaTitle}}</view>
      <view wx:if="{{ctaDesc}}" class="image-uploader__cta-desc">{{ctaDesc}}</view>
    </button>
  </block>
  <block wx:else>
    <view
      wx:for="{{displayList}}"
      wx:key="url"
      class="image-uploader__cell"
    >
      <view
        class="image-uploader__item image-placeholder"
        data-index="{{index}}"
        bindtap="onPreview"
      >
        <image class="image-uploader__img" src="{{item.url}}" mode="aspectFill" />
        <view
          wx:if="{{!disabled}}"
          class="image-uploader__remove"
          data-index="{{index}}"
          catchtap="onRemove"
        >×</view>
      </view>
      <input
        wx:if="{{enableCaption}}"
        class="image-uploader__caption input"
        value="{{item.caption}}"
        placeholder="{{captionPlaceholder}}"
        disabled="{{disabled}}"
        maxlength="200"
        data-index="{{index}}"
        catchtap=""
        bindinput="onCaptionInput"
      />
    </view>
    <view
      wx:if="{{displayList.length < maxCount && !disabled}}"
      class="image-uploader__add image-placeholder"
      catchtap="onAdd"
    >
      <image
        class="image-uploader__add-icon"
        src="{{addIconSrc}}"
        mode="aspectFit"
      />
    </view>
  </block>
</view>

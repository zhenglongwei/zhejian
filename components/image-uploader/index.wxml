<view
  class="image-uploader {{variant === 'album' ? 'image-uploader--album' : ''}} {{isCtaLayout ? 'image-uploader--cta' : ''}} {{fullWidthAdd && !displayList.length ? 'image-uploader--full-add' : ''}} {{isSingleColumn ? 'image-uploader--cols-1' : ''}} {{enableCaption ? 'image-uploader--caption' : ''}} {{captionProminent ? 'image-uploader--caption-prominent' : ''}} {{isStackLayout ? 'image-uploader--stack' : ''}} {{hasQuickTags ? 'image-uploader--quick-tags' : ''}}"
>
  <block wx:if="{{isCtaLayout}}">
    <button
      wx:if="{{displayList.length < maxCount && !disabled}}"
      class="image-uploader__cta"
      hover-class="image-uploader__cta--hover"
      hover-stay-time="80"
      plain
      bindtap="onAdd"
    >
      <image
        class="image-uploader__cta-icon"
        src="{{addIconSrc}}"
        mode="aspectFit"
      />
      <view class="image-uploader__cta-title">{{ctaTitle}}</view>
      <view wx:if="{{ctaDesc}}" class="image-uploader__cta-desc">{{ctaDesc}}</view>
    </button>
  </block>
  <block wx:else>
    <view
      wx:for="{{displayList}}"
      wx:for-item="imgItem"
      wx:for-index="imgIndex"
      wx:key="url"
      class="image-uploader__cell"
    >
      <view
        class="image-uploader__item image-placeholder"
        data-index="{{imgIndex}}"
        bindtap="onPreview"
      >
        <image class="image-uploader__img" src="{{imgItem.url}}" mode="aspectFill" />
        <view
          wx:if="{{!disabled}}"
          class="image-uploader__remove"
          data-index="{{imgIndex}}"
          catchtap="onRemove"
        >×</view>
      </view>

      <view class="image-uploader__meta" wx:if="{{enableCaption}}">
        <view wx:if="{{hasQuickTags && !disabled}}" class="image-uploader__tags">
          <text
            wx:for="{{captionQuickTags}}"
            wx:for-item="tag"
            wx:for-index="tagIndex"
            wx:key="tagIndex"
            class="image-uploader__tag {{imgItem.activeTag === tag ? 'is-active' : ''}}"
            data-index="{{imgIndex}}"
            data-label="{{tag}}"
            catchtap="onQuickTagTap"
          >{{tag}}</text>
          <text
            wx:if="{{imgItem.showCaption || imgItem.caption}}"
            class="image-uploader__tag image-uploader__tag--clear"
            data-index="{{imgIndex}}"
            catchtap="onClearCaption"
          >清除</text>
        </view>

        <textarea
          wx:if="{{imgItem.showCaption || imgItem.caption || !hasQuickTags}}"
          class="image-uploader__caption input"
          value="{{imgItem.caption}}"
          placeholder="{{captionPlaceholder}}"
          disabled="{{disabled}}"
          maxlength="500"
          auto-height="{{true}}"
          show-confirm-bar="{{false}}"
          focus="{{imgItem.focusCaption}}"
          data-index="{{imgIndex}}"
          catchtap=""
          bindinput="onCaptionInput"
        />
      </view>
    </view>
    <view
      wx:if="{{displayList.length < maxCount && !disabled}}"
      class="image-uploader__add image-placeholder"
      catchtap="onAdd"
    >
      <image
        class="image-uploader__add-icon"
        src="{{addIconSrc}}"
        mode="aspectFit"
      />
      <text wx:if="{{isStackLayout}}" class="image-uploader__add-text">添加图片</text>
    </view>
  </block>
</view>

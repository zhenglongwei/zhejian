<view class="service-doc-sheet service-doc-sheet--{{doc.styleVariant || 'document'}}" wx:if="{{doc && doc.kind}}">
  <view wx:if="{{showHeader}}" class="service-doc-sheet__head">
    <view class="service-doc-sheet__title-row">
      <text class="text-h3 service-doc-sheet__title">{{doc.title}}</text>
      <ui-tag wx:if="{{doc.statusLabel}}" variant="{{doc.needsConfirm ? 'warning' : 'default'}}" text="{{doc.statusLabel}}" />
    </view>
    <text wx:if="{{doc.storeName}}" class="text-caption text-secondary service-doc-sheet__store">{{doc.storeName}}</text>
    <text wx:if="{{doc.metaLine}}" class="text-caption text-secondary service-doc-sheet__meta">{{doc.metaLine}}</text>
  </view>

  <block wx:if="{{doc.kind === 'inspection_report'}}">
    <view wx:if="{{doc.chiefComplaint}}" class="service-doc-sheet__block">
      <text class="text-caption text-secondary service-doc-sheet__label">进店主诉</text>
      <text class="text-body">{{doc.chiefComplaint}}</text>
    </view>
    <view wx:if="{{findingGroups.length}}" class="service-doc-sheet__block">
      <text wx:if="{{mode !== 'owner'}}" class="text-body service-doc-sheet__section">本次检测项目</text>
      <view
        wx:for="{{findingGroups}}"
        wx:for-item="group"
        wx:key="key"
        class="service-doc-sheet__group"
      >
        <text wx:if="{{group.title}}" class="text-body service-doc-sheet__group-title">{{group.title}}</text>
        <view
          wx:for="{{group.items}}"
          wx:for-item="finding"
          wx:key="key"
          class="service-doc-sheet__finding-card"
        >
          <view class="service-doc-sheet__finding-head">
            <text class="text-body service-doc-sheet__finding-name">{{finding.partName}}</text>
            <text wx:if="{{finding.result}}" class="text-caption text-secondary">{{finding.result}}</text>
          </view>
          <view wx:if="{{finding.images.length}}" class="service-doc-sheet__finding-photos">
            <image
              wx:for="{{finding.images}}"
              wx:for-item="shot"
              wx:key="url"
              class="service-doc-sheet__finding-img image-placeholder"
              src="{{shot.url}}"
              mode="aspectFill"
              data-url="{{shot.url}}"
              data-urls="{{finding.previewUrls}}"
              bindtap="onPreviewImage"
            />
          </view>
          <view wx:if="{{finding.advice}}" class="service-doc-sheet__finding-advice">
            <view class="{{expandedAdvice[finding.key] ? '' : 'service-doc-sheet__clamp'}}">
              <text class="text-caption text-secondary">{{finding.advice}}</text>
            </view>
            <text
              wx:if="{{finding.adviceCollapsible}}"
              class="text-caption text-link"
              data-key="{{finding.key}}"
              catchtap="onToggleAdvice"
            >{{expandedAdvice[finding.key] ? '收起' : '展开'}}</text>
          </view>
        </view>
      </view>
    </view>
    <text wx:if="{{doc.conclusion}}" class="text-body service-doc-sheet__block">结论：{{doc.conclusion}}</text>
  </block>

  <block wx:elif="{{doc.kind === 'quote_confirm' || doc.kind === 'addon_quote_confirm'}}">
    <view wx:if="{{doc.isAddon && (doc.discoveryNote || doc.discoveryImages.length)}}" class="service-doc-sheet__block">
      <text class="text-body service-doc-sheet__section">新发现</text>
      <text wx:if="{{doc.discoveryNote}}" class="text-body">{{doc.discoveryNote}}</text>
      <view wx:if="{{doc.discoveryImages.length}}" class="service-doc-sheet__line-thumbs">
        <image
          wx:for="{{doc.discoveryImages}}"
          wx:key="*this"
          class="service-doc-sheet__line-thumb image-placeholder"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          data-urls="{{doc.discoveryImages}}"
          bindtap="onPreviewImage"
        />
      </view>
    </view>
    <view class="service-doc-sheet__block">
      <text class="text-body service-doc-sheet__section">费用明细</text>
      <view class="service-doc-sheet__table-head">
        <text class="text-caption text-secondary">项目</text>
        <text class="text-caption text-secondary service-doc-sheet__col-amount">金额</text>
      </view>
      <view wx:for="{{quoteLineRows}}" wx:for-item="line" wx:key="key" class="service-doc-sheet__table-row">
        <view class="service-doc-sheet__table-main">
          <view class="service-doc-sheet__table-main-left">
            <view
              wx:if="{{doc.isAddon && line.evidenceUrls.length}}"
              class="service-doc-sheet__line-thumbs"
            >
              <image
                wx:for="{{line.evidenceUrls}}"
                wx:for-item="evUrl"
                wx:key="*this"
                class="service-doc-sheet__line-thumb image-placeholder"
                src="{{evUrl}}"
                mode="aspectFill"
                data-url="{{evUrl}}"
                data-urls="{{line.evidenceUrls}}"
                bindtap="onPreviewImage"
              />
            </view>
            <text class="text-body">{{line.name}}</text>
          </view>
          <text wx:if="{{line.amountText}}" class="service-doc-sheet__col-amount">{{line.amountText}}</text>
        </view>
        <text wx:if="{{line.brand}}" class="text-caption text-secondary service-doc-sheet__note">品牌：{{line.brand}}</text>
        <view wx:if="{{line.note}}" class="service-doc-sheet__finding-advice">
          <view class="{{expandedNotes[line.key] ? '' : 'service-doc-sheet__clamp'}}">
            <text class="text-caption text-secondary">{{line.note}}</text>
          </view>
          <text
            wx:if="{{line.noteCollapsible}}"
            class="text-caption text-link"
            data-key="{{line.key}}"
            catchtap="onToggleNote"
          >{{expandedNotes[line.key] ? '收起' : '展开'}}</text>
        </view>
      </view>
      <view wx:if="{{totalAmountText}}" class="service-doc-sheet__total">
        <text class="text-body">合计</text>
        <text class="service-doc-sheet__total-amount">{{totalAmountText}}</text>
      </view>
    </view>
  </block>

  <block wx:elif="{{doc.kind === 'work'}}">
    <view class="service-doc-sheet__block">
      <text class="text-body service-doc-sheet__section">工单内容</text>
      <view class="service-doc-sheet__table-head">
        <text class="text-caption text-secondary">项目</text>
        <text class="text-caption text-secondary service-doc-sheet__col-amount">金额</text>
      </view>
      <view wx:for="{{doc.items}}" wx:for-item="row" wx:key="index" class="service-doc-sheet__table-row">
        <view class="service-doc-sheet__table-main">
          <text class="text-body">{{row.name}}</text>
          <text wx:if="{{row.amount}}" class="text-body service-doc-sheet__col-amount">¥{{row.amount}}</text>
        </view>
        <text wx:if="{{row.material}}" class="text-caption text-secondary service-doc-sheet__note">用料：{{row.material}}</text>
        <text wx:if="{{row.brand}}" class="text-caption text-secondary service-doc-sheet__note">品牌：{{row.brand}}</text>
        <text wx:if="{{row.qty}}" class="text-caption text-secondary service-doc-sheet__note">数量：{{row.qty}}</text>
        <text wx:if="{{row.note}}" class="text-caption text-secondary service-doc-sheet__note">{{row.note}}</text>
      </view>
      <view wx:if="{{totalAmountText}}" class="service-doc-sheet__total">
        <text class="text-body">合计</text>
        <text class="service-doc-sheet__total-amount">{{totalAmountText}}</text>
      </view>
    </view>
  </block>

  <block wx:elif="{{doc.kind === 'repair_report'}}">
    <view class="service-doc-sheet__block">
      <text class="text-body service-doc-sheet__section">已施工项目</text>
      <view class="service-doc-sheet__table-head">
        <text class="text-caption text-secondary">项目</text>
        <text class="text-caption text-secondary service-doc-sheet__col-amount">金额</text>
      </view>
      <view wx:for="{{doc.workItems}}" wx:for-item="row" wx:key="index" class="service-doc-sheet__table-row">
        <view class="service-doc-sheet__table-main">
          <text class="text-body">{{row.name}}</text>
          <text wx:if="{{row.amount}}" class="text-body service-doc-sheet__col-amount">¥{{row.amount}}</text>
        </view>
        <text wx:if="{{row.material}}" class="text-caption text-secondary service-doc-sheet__note">用料：{{row.material}}</text>
        <text wx:if="{{row.brand}}" class="text-caption text-secondary service-doc-sheet__note">品牌：{{row.brand}}</text>
        <text wx:if="{{row.qty}}" class="text-caption text-secondary service-doc-sheet__note">数量：{{row.qty}}</text>
        <text wx:if="{{row.note}}" class="text-caption text-secondary service-doc-sheet__note">{{row.note}}</text>
      </view>
      <view wx:if="{{totalAmountText}}" class="service-doc-sheet__total">
        <text class="text-body">合计</text>
        <text class="service-doc-sheet__total-amount">{{totalAmountText}}</text>
      </view>
    </view>
    <view wx:if="{{doc.deliveryPhotos && doc.deliveryPhotos.length}}" class="service-doc-sheet__block">
      <text class="text-body service-doc-sheet__section">交车照片</text>
      <view class="service-doc-sheet__photos">
        <image
          wx:for="{{doc.deliveryPhotos}}"
          wx:for-item="photo"
          wx:key="url"
          class="service-doc-sheet__photo image-placeholder"
          src="{{photo.url || photo}}"
          mode="aspectFill"
          data-url="{{photo.url || photo}}"
          data-urls="{{doc.deliveryPhotos}}"
          bindtap="onPreviewImage"
        />
      </view>
    </view>
    <view
      wx:if="{{doc.warrantyPeriod || doc.warrantyNotes || doc.warrantyScope || doc.warrantyExclusions}}"
      class="service-doc-sheet__block"
    >
      <text class="text-body service-doc-sheet__section">质保说明</text>
      <text wx:if="{{doc.warrantyPeriod}}" class="text-caption">期限：{{doc.warrantyPeriod}}</text>
      <text wx:if="{{doc.warrantyNotes}}" class="text-caption text-secondary">注意事项：{{doc.warrantyNotes}}</text>
      <block wx:elif="{{doc.warrantyScope || doc.warrantyExclusions}}">
        <text wx:if="{{doc.warrantyScope}}" class="text-caption">范围：{{doc.warrantyScope}}</text>
        <text wx:if="{{doc.warrantyExclusions}}" class="text-caption text-secondary">除外：{{doc.warrantyExclusions}}</text>
      </block>
    </view>
  </block>

  <view
    wx:if="{{doc.ownerRejectReason && !doc.cancelled}}"
    class="service-doc-sheet__block"
  >
    <text class="text-caption text-secondary service-doc-sheet__label">车主未同意</text>
    <text class="text-body">{{doc.ownerRejectReason}}</text>
  </view>

  <view
    wx:if="{{doc.cancelReason}}"
    class="service-doc-sheet__block"
  >
    <text class="text-caption text-secondary service-doc-sheet__label">说明</text>
    <text class="text-body">{{doc.cancelReason}}</text>
  </view>

  <view
    wx:if="{{doc.confirmCopy && !doc.cancelled && (doc.needsConfirm || doc.kind === 'quote_confirm' || doc.kind === 'addon_quote_confirm' || doc.kind === 'repair_report')}}"
    class="service-doc-sheet__protocol"
  >
    <text class="text-caption">{{doc.confirmCopy}}</text>
  </view>

  <ui-button
    wx:if="{{mode === 'owner' && doc.needsConfirm}}"
    type="primary"
    block="{{true}}"
    loading="{{confirming}}"
    bind:btntap="onConfirmTap"
  >确认</ui-button>
  <view wx:if="{{mode === 'owner' && doc.needsConfirm}}" class="service-doc-sheet__reject">
    <ui-button
      type="ghost"
      block="{{true}}"
      disabled="{{confirming}}"
      bind:btntap="onRejectTap"
    >不同意</ui-button>
  </view>
  <view
    wx:if="{{mode === 'owner' && doc.needsConfirm && storePhone}}"
    class="service-doc-sheet__contact"
    bindtap="onContactStore"
  >
    <text class="text-caption text-link">有疑问？电话联系门店</text>
  </view>
</view>

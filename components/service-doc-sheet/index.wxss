.service-doc-sheet {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.service-doc-sheet__paper {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  padding: var(--space-lg) var(--space-md);
  background: #fff;
  border: 2rpx solid var(--color-text-primary);
}

/* 纸面内衬细线：外粗内细，公文感保留、层次更足 */
.service-doc-sheet__paper::after {
  content: '';
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  border: 1rpx solid var(--color-border);
  pointer-events: none;
}

.service-doc-sheet__head {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding-bottom: var(--space-sm);
}

.service-doc-sheet__shop {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
}

.service-doc-sheet__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  background: var(--color-text-primary);
  color: var(--color-text-inverse);
  font-size: var(--font-caption);
  line-height: 1;
  font-weight: var(--font-weight-semibold);
}

.service-doc-sheet__stamp {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border: 3rpx solid var(--color-danger);
  border-radius: var(--radius-sm);
  color: var(--color-danger);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 2rpx;
  transform: rotate(-6deg);
}

/* 已定稿 / 已确认：灰章 */
.service-doc-sheet__stamp--muted {
  border-color: var(--color-text-tertiary);
  color: var(--color-text-tertiary);
}

.service-doc-sheet__title {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: var(--font-h1);
  line-height: var(--font-h1-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.service-doc-sheet__bar {
  width: 72rpx;
  height: 4rpx;
  background: var(--color-text-primary);
}

.service-doc-sheet__rule {
  height: 2rpx;
  background: var(--color-text-primary);
  margin-top: var(--space-xs);
}

.service-doc-sheet__field {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.service-doc-sheet__field-k {
  width: 112rpx;
  flex-shrink: 0;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-tertiary);
}

.service-doc-sheet__field-v {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.service-doc-sheet__actions {
  display: flex;
  flex-direction: row;
  gap: var(--space-sm);
}

.service-doc-sheet__btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  color: var(--color-text-primary);
  border: 2rpx solid var(--color-text-primary);
  font-size: var(--font-body);
  font-weight: var(--font-weight-medium);
}

.service-doc-sheet__btn--ink {
  background: var(--color-text-primary);
  color: var(--color-text-inverse);
}

.service-doc-sheet__btn.is-busy {
  opacity: 0.6;
}

.service-doc-sheet__store,
.service-doc-sheet__meta {
  display: block;
  color: var(--color-text-tertiary);
}

.service-doc-sheet__block {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.service-doc-sheet__block + .service-doc-sheet__block {
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--color-border);
}

.service-doc-sheet__label {
  display: block;
  color: var(--color-text-tertiary);
}

.service-doc-sheet__complaint {
  color: var(--color-text-primary);
}

.service-doc-sheet__section {
  display: block;
  margin-bottom: var(--space-xs);
  padding-left: var(--space-xs);
  border-left: 6rpx solid var(--color-text-primary);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 检测结果文字按分段语义色（不加框，保持「无结果 Tag」口径） */
.service-doc-sheet__finding-result {
  flex-shrink: 0;
  font-weight: var(--font-weight-medium);
}

.service-doc-sheet__finding-result--action {
  color: var(--color-danger);
}

.service-doc-sheet__finding-result--watch {
  color: var(--color-warning);
}

.service-doc-sheet__finding-result--ok {
  color: var(--color-primary);
}

.service-doc-sheet__group {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.service-doc-sheet__group-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
}

.service-doc-sheet__group:first-child .service-doc-sheet__group-head {
  margin-top: 0;
}

.service-doc-sheet__group-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
  background-color: var(--color-text-tertiary);
}

.service-doc-sheet__group-title {
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.service-doc-sheet__group--action .service-doc-sheet__group-head {
  background-color: var(--color-danger-light);
}

.service-doc-sheet__group--action .service-doc-sheet__group-dot {
  background-color: var(--color-danger);
}

.service-doc-sheet__group--action .service-doc-sheet__group-title {
  color: var(--color-danger);
}

.service-doc-sheet__group--watch .service-doc-sheet__group-head {
  background-color: var(--color-warning-light);
}

.service-doc-sheet__group--watch .service-doc-sheet__group-dot {
  background-color: var(--color-warning);
}

.service-doc-sheet__group--watch .service-doc-sheet__group-title {
  color: var(--color-warning);
}

.service-doc-sheet__group--ok .service-doc-sheet__group-head {
  background-color: var(--color-primary-light);
}

.service-doc-sheet__group--ok .service-doc-sheet__group-dot {
  background-color: var(--color-primary);
}

.service-doc-sheet__group--ok .service-doc-sheet__group-title {
  color: var(--color-primary);
}

.service-doc-sheet__finding-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
}

.service-doc-sheet__finding-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
}

.service-doc-sheet__finding-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.service-doc-sheet__finding-photos {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-xs);
}

.service-doc-sheet__finding-img {
  width: 100%;
  height: 196rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
}

.service-doc-sheet__finding-advice {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-xs);
}

.service-doc-sheet__prose {
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
}

.service-doc-sheet__clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
}

.service-doc-sheet__table-head,
.service-doc-sheet__table-main,
.service-doc-sheet__total {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
}

.service-doc-sheet__table-head {
  padding-bottom: var(--space-xs);
  border-bottom: 1rpx solid var(--color-border);
}

.service-doc-sheet__table-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.service-doc-sheet__table-main-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  flex: 1;
  min-width: 0;
}

.service-doc-sheet__line-thumbs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--space-xs);
  flex-shrink: 0;
}

.service-doc-sheet__line-thumb {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
}

.service-doc-sheet__line-name {
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.service-doc-sheet__col-amount {
  flex-shrink: 0;
  text-align: right;
  min-width: 140rpx;
}

.service-doc-sheet__amount {
  font-size: var(--font-price-sm);
  line-height: var(--font-price-sm-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.service-doc-sheet__note {
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
}

/* 验收三段：标签 + 内容 */
.service-doc-sheet__kv {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: var(--space-sm);
  margin-top: var(--space-xs);
}

.service-doc-sheet__kv-label {
  flex-shrink: 0;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
}

/* 费用/施工行内的品牌、用料等附注：缩进加细竖线，体现从属关系 */
.service-doc-sheet__table-row .service-doc-sheet__note {
  padding-left: var(--space-xs);
  border-left: 2rpx solid var(--color-border);
}

.service-doc-sheet__faq {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-sm) 0;
}

.service-doc-sheet__faq + .service-doc-sheet__faq {
  border-top: 1rpx solid var(--color-border);
}

.service-doc-sheet__faq-q {
  display: block;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.service-doc-sheet__total {
  align-items: center;
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 2rpx solid var(--color-text-primary);
}

.service-doc-sheet__total-label {
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.service-doc-sheet__total-amount {
  font-size: var(--font-price);
  line-height: var(--font-price-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.service-doc-sheet__photos {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-xs);
}

.service-doc-sheet__photo {
  width: 100%;
  height: 196rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
}

.service-doc-sheet__protocol {
  margin-top: var(--space-xs);
  padding: var(--space-sm) var(--space-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
}

.service-doc-sheet__protocol-kicker {
  display: block;
  margin-bottom: var(--space-xs);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-tertiary);
}

.service-doc-sheet__protocol-text {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-primary);
}

.service-doc-sheet__seal {
  color: var(--color-text-tertiary);
}

.service-doc-sheet__signoff {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  padding-top: var(--space-sm);
  border-top: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  text-align: right;
}

.service-doc-sheet__contact {
  text-align: center;
  color: var(--color-text-secondary);
}

.service-doc-sheet {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
}

.service-doc-sheet--evidence {
  border-color: var(--color-border);
}

.service-doc-sheet__head {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.service-doc-sheet__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
}

.service-doc-sheet__title {
  flex: 1;
  min-width: 0;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.service-doc-sheet__store,
.service-doc-sheet__meta {
  display: block;
  color: var(--color-text-tertiary);
}

.service-doc-sheet__block {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.service-doc-sheet__label {
  display: block;
  color: var(--color-text-tertiary);
}

.service-doc-sheet__complaint {
  color: var(--color-text-primary);
}

.service-doc-sheet__section {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-secondary);
}

.service-doc-sheet__group {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.service-doc-sheet__group-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
}

.service-doc-sheet__group:first-child .service-doc-sheet__group-head {
  margin-top: 0;
}

.service-doc-sheet__group-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
  background-color: var(--color-text-tertiary);
}

.service-doc-sheet__group-title {
  font-size: var(--font-h3);
  line-height: var(--font-h3-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.service-doc-sheet__group--action .service-doc-sheet__group-head {
  background-color: var(--color-danger-light);
}

.service-doc-sheet__group--action .service-doc-sheet__group-dot {
  background-color: var(--color-danger);
}

.service-doc-sheet__group--action .service-doc-sheet__group-title {
  color: var(--color-danger);
}

.service-doc-sheet__group--watch .service-doc-sheet__group-head {
  background-color: var(--color-warning-light);
}

.service-doc-sheet__group--watch .service-doc-sheet__group-dot {
  background-color: var(--color-warning);
}

.service-doc-sheet__group--watch .service-doc-sheet__group-title {
  color: var(--color-warning);
}

.service-doc-sheet__group--ok .service-doc-sheet__group-head {
  background-color: var(--color-primary-light);
}

.service-doc-sheet__group--ok .service-doc-sheet__group-dot {
  background-color: var(--color-primary);
}

.service-doc-sheet__group--ok .service-doc-sheet__group-title {
  color: var(--color-primary);
}

.service-doc-sheet__finding-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-sm);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
}

.service-doc-sheet__finding-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
}

.service-doc-sheet__finding-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.service-doc-sheet__finding-photos {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-xs);
}

.service-doc-sheet__finding-img {
  width: 100%;
  height: 196rpx;
  border-radius: var(--radius-md);
}

.service-doc-sheet__finding-advice {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-xs);
}

.service-doc-sheet__prose {
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
}

.service-doc-sheet__clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
}

.service-doc-sheet__table-head,
.service-doc-sheet__table-main,
.service-doc-sheet__total {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
}

.service-doc-sheet__table-head {
  padding-bottom: var(--space-xs);
  border-bottom: 1rpx solid var(--color-border);
}

.service-doc-sheet__table-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.service-doc-sheet__table-main-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  flex: 1;
  min-width: 0;
}

.service-doc-sheet__line-thumbs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--space-xs);
  flex-shrink: 0;
}

.service-doc-sheet__line-thumb {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
}

.service-doc-sheet__line-name {
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.service-doc-sheet__col-amount {
  flex-shrink: 0;
  text-align: right;
  min-width: 140rpx;
}

.service-doc-sheet__amount {
  font-size: var(--font-price-sm);
  line-height: var(--font-price-sm-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.service-doc-sheet__note {
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
}

.service-doc-sheet__total {
  align-items: center;
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 2rpx solid var(--color-text-primary);
}

.service-doc-sheet__total-label {
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.service-doc-sheet__total-amount {
  font-size: var(--font-price);
  line-height: var(--font-price-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.service-doc-sheet__photos {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.service-doc-sheet__photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
}

.service-doc-sheet__protocol {
  margin-top: var(--space-xs);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
  border-left: 6rpx solid var(--color-primary);
}

.service-doc-sheet__protocol-text {
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-text-secondary);
}

.service-doc-sheet__reject {
  margin-top: var(--space-sm);
}

.service-doc-sheet__contact {
  margin-top: var(--space-sm);
  text-align: center;
  padding: var(--space-xs) 0;
}

.flow-stepper {
  display: flex;
  flex-direction: column;
}

.flow-stepper__progress {
  margin-bottom: var(--space-md);
  color: var(--color-text-secondary);
}

.flow-stepper__row {
  display: flex;
  flex-direction: row;
  gap: var(--space-md);
}

.flow-stepper__rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 24rpx;
  flex-shrink: 0;
  padding-top: 10rpx;
}

.flow-stepper__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.flow-stepper__dot--done {
  border: 2rpx solid var(--color-primary);
  background-color: var(--color-primary);
}

.flow-stepper__dot--active {
  border: 2rpx solid var(--color-primary);
  background-color: var(--color-primary);
  box-shadow: 0 0 0 6rpx var(--color-primary-light);
}

.flow-stepper__line {
  flex: 1;
  width: 2rpx;
  min-height: 40rpx;
  margin-top: var(--space-xs);
  background-color: var(--color-primary-light);
}

.flow-stepper__line--muted {
  background-color: var(--color-border);
}

.flow-stepper__body {
  flex: 1;
  min-width: 0;
  padding-bottom: var(--space-lg);
}

.flow-stepper__done-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
}

.flow-stepper__done-titles {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  min-width: 0;
}

.flow-stepper__done-title {
  color: var(--color-text-secondary);
}

.flow-stepper__done-detail {
  margin-top: var(--space-sm);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
}

.flow-stepper__active-card {
  border: 2rpx solid var(--color-primary-light);
}

.flow-stepper__active-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
}

.flow-stepper__active-summary {
  display: block;
  margin-top: var(--space-sm);
}

.flow-stepper__active-slot {
  margin-top: var(--space-md);
}

.flow-stepper__hint {
  margin-top: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
}

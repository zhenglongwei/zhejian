<view class="social-card">
  <view wx:if="{{loading}}" class="social-card__loading">
    <text class="text-caption text-secondary">正在准备</text>
  </view>
  <block wx:else>
    <view class="social-card__head">
      <text class="text-caption social-card__refresh" catchtap="onRefresh">{{refreshing ? '正在准备' : '刷新'}}</text>
    </view>
    <view class="social-card__tabs">
      <view
        wx:for="{{platforms}}"
        wx:key="id"
        class="social-card__tab {{item.id === activeId ? 'social-card__tab--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPlatform"
      >
        <text class="text-caption {{item.id === activeId ? 'social-card__tab-label--on' : ''}}">{{item.label}}</text>
      </view>
    </view>

    <block wx:if="{{images.length && activeId === 'moments'}}">
      <view class="social-card__grid">
        <view wx:for="{{images}}" wx:key="id" class="social-card__grid-cell">
          <image class="social-card__grid-img" src="{{item.url}}" mode="aspectFill" />
        </view>
      </view>
    </block>

    <block wx:elif="{{images.length}}">
      <view class="social-card__stage-wrap {{activeId === 'douyin' ? 'social-card__stage-wrap--tall' : ''}}">
        <view class="social-card__stage">
          <image class="social-card__stage-img" src="{{focusUrl}}" mode="aspectFill" />
          <view class="social-card__shade">
            <textarea
              wx:if="{{lineEditing}}"
              class="social-card__onimage text-body"
              focus="{{true}}"
              auto-height="{{true}}"
              disable-default-padding="{{true}}"
              adjust-position="{{false}}"
              maxlength="40"
              value="{{slideLine}}"
              bindinput="onSlideInput"
              bindblur="onLineBlur"
            />
            <text
              wx:else
              class="social-card__onimage text-body {{slideLine ? '' : 'social-card__onimage--empty'}}"
              catchtap="onEditLine"
            >{{slideLine || '写一句'}}</text>
          </view>
        </view>
      </view>
      <scroll-view
        wx:if="{{images.length > 1}}"
        class="social-card__photos"
        scroll-x
        show-scrollbar="{{false}}"
      >
        <view
          wx:for="{{images}}"
          wx:key="id"
          class="social-card__photo {{item.id === focusId ? 'social-card__photo--focus' : ''}}"
          data-id="{{item.id}}"
          bindtap="onFocus"
        >
          <image class="social-card__img" src="{{item.url}}" mode="aspectFill" />
        </view>
      </scroll-view>
    </block>
    <text wx:else class="text-caption text-secondary">{{emptyText}}</text>

    <view class="social-card__caption-head">
      <text class="text-caption text-secondary">{{captionLabel}}</text>
      <text class="text-caption text-link" bindtap="onCopyCurrent">{{copyLabel}}</text>
    </view>
    <textarea
      wx:if="{{bodyEditing && activeId === 'moments'}}"
      class="social-card__text social-card__text--story text-body"
      focus="{{true}}"
      disable-default-padding="{{true}}"
      adjust-position="{{false}}"
      maxlength="500"
      value="{{text}}"
      bindinput="onInput"
      bindblur="onBodyBlur"
    />
    <textarea
      wx:elif="{{bodyEditing}}"
      class="social-card__text text-body"
      focus="{{true}}"
      disable-default-padding="{{true}}"
      adjust-position="{{false}}"
      maxlength="500"
      value="{{caption}}"
      bindinput="onCaptionInput"
      bindblur="onBodyBlur"
    />
    <view
      wx:else
      class="social-card__text {{activeId === 'moments' ? 'social-card__text--story' : ''}}"
      catchtap="onEditBody"
    >
      <text class="text-body {{bodyShown ? '' : 'text-secondary'}}">{{bodyShown || '写一句'}}</text>
    </view>

    <view wx:if="{{showActions}}" class="social-card__actions">
      <ui-button type="primary" block loading="{{exporting}}" disabled="{{exporting}}" bind:btntap="onDownload">下载图文</ui-button>
    </view>
  </block>
  <canvas type="2d" id="socialPoster" class="social-card__canvas" />
</view>

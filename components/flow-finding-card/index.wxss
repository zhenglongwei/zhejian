.flow-finding-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
}

.flow-finding-card__head {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
}

.flow-finding-card__title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.flow-finding-card__meta {
  flex: none;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-mch-kicker);
  line-height: var(--font-mch-kicker-lh);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-secondary);
  background: var(--color-bg-muted);
}

.flow-finding-card__meta--ok {
  color: var(--color-mch-green-deep);
  background: var(--color-mch-green-soft);
}

.flow-finding-card__meta--watch {
  color: var(--color-mch-amber-deep);
  background: var(--color-mch-amber-soft);
}

.flow-finding-card__meta--action,
.flow-finding-card__meta--danger {
  color: var(--color-danger);
  background: var(--color-danger-light);
}

.flow-finding-card__remove {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.flow-finding-card__photos {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-xs);
}

.flow-finding-card__cell {
  position: relative;
}

.flow-finding-card__doc-badge {
  position: absolute;
  left: 0;
  top: 0;
  padding: 0 var(--space-xs);
  border-radius: var(--radius-sm);
  font-size: var(--font-caption);
  line-height: var(--font-caption-lh);
  color: var(--color-warning);
  background-color: var(--color-warning-light);
}

.flow-finding-card__img {
  width: 100%;
  height: 196rpx;
  border-radius: var(--radius-md);
}

.flow-finding-card__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 196rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
}

.flow-finding-card__body {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-secondary);
}

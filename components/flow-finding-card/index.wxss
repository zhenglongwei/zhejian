.flow-finding-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
}

.flow-finding-card__head {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
}

.flow-finding-card__title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.flow-finding-card__remove {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

.flow-finding-card__photos {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-xs);
}

.flow-finding-card__img {
  width: 100%;
  height: 196rpx;
  border-radius: var(--radius-md);
}

.flow-finding-card__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 196rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-muted);
}

.flow-finding-card__body {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
  font-size: var(--font-body);
  line-height: var(--font-body-lh);
  color: var(--color-text-secondary);
}

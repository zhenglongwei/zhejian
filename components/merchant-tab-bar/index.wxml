<view class="mch-tab safe-bottom">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="mch-tab__item {{active === item.key ? 'is-on' : ''}}"
    data-key="{{item.key}}"
    bindtap="onTap"
  >
    <image class="mch-tab__ico" src="{{active === item.key ? item.iconOn : item.icon}}" mode="aspectFit" />
    <text class="mch-tab__label">{{item.label}}</text>
  </view>
</view>

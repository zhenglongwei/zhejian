.mch-tab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-mch-line);
  padding-top: 10rpx;
}

.mch-tab__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: var(--color-mch-muted);
  padding-bottom: 8rpx;
}

.mch-tab__item.is-on {
  color: var(--color-mch-blue);
}

.mch-tab__label {
  font-size: var(--font-caption);
  line-height: 1.2;
}

.mch-tab__ico {
  width: 44rpx;
  height: 44rpx;
}
